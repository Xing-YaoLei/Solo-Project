<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">处理记录</h1>
      <p class="text-gray-500 mt-1">所有业务处理记录</p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="p-4 border-b border-gray-100">
      <%= search_form_for @q, url: processing_records_path, method: :get do |f| %>
        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <%= f.label :action_type_cont, "操作类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.search_field :action_type_cont, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status_eq, ProcessingRecord.statuses.map { |k, v| [status_text(k), v] }, { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :handler_id_eq, "经办人", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :handler_id_eq, options_from_collection_for_select(User.all, :id, :name), { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="flex gap-2">
            <%= f.submit "搜索", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
            <%= link_to "重置", processing_records_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作类型</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联对象</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">经办人</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @processing_records.each do |record| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to record.action_type, record, class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= record.recordable_type %> #<%= record.recordable_id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= record.handler.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(record.status) %>">
                  <%= status_text(record.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_datetime(record.created_at) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "查看", record, class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <%= paginate @processing_records %>
    </div>
  </div>
</div>
