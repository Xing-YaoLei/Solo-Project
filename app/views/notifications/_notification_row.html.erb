<tr id="<%= dom_id notification %>" class="<%= notification.unread? ? "bg-indigo-50/40" : "" %> hover:bg-gray-50 transition-colors">
  <td class="px-6 py-4">
    <div class="flex items-start gap-3">
      <div class="relative flex-shrink-0">
        <% color_class = case notification.notification_type_color
                      when "red" then "bg-red-100 text-red-600"
                      when "orange" then "bg-orange-100 text-orange-600"
                      when "yellow" then "bg-yellow-100 text-yellow-600"
                      when "green" then "bg-green-100 text-green-600"
                      when "blue" then "bg-blue-100 text-blue-600"
                      else "bg-gray-100 text-gray-600"
                      end %>
        <div class="w-10 h-10 rounded-lg <%= color_class %> flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <% case notification.icon %>
            <% when "alert-triangle" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            <% when "alert-octagon" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            <% when "file-x" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            <% when "download" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            <% when "clock" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            <% when "refresh-cw" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            <% when "user-plus" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            <% when "check-circle" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            <% when "info" %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            <% else %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            <% end %>
          </svg>
        </div>
        <% if notification.unread? %>
          <span class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-white"></span>
        <% end %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h4 class="text-sm font-semibold <%= notification.unread? ? "text-gray-900" : "text-gray-600" %> truncate">
              <%= notification.title %>
            </h4>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= notification.content %></p>
          </div>
          <span class="flex-shrink-0 text-xs text-gray-400 whitespace-nowrap mt-0.5">
            <%= notification.time_ago %>
          </span>
        </div>
      </div>
    </div>
  </td>
  <td class="px-6 py-4 text-right whitespace-nowrap">
    <div class="flex items-center justify-end gap-2">
      <% if notification.unread? %>
        <%= button_to notification_path(notification), method: :patch, class: "text-xs text-gray-600 hover:text-indigo-600 transition-colors" do %>
          标记已读
        <% end %>
      <% end %>
      <% if notification.notifiable.present? %>
        <%= link_to "查看", polymorphic_path(notification.notifiable), class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium transition-colors" %>
      <% end %>
    </div>
  </td>
</tr>
