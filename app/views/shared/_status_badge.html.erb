<% status = local_assigns[:status] %>
<% color_class = ApplicationHelper::STATUS_COLORS[status] || "bg-gray-100 text-gray-800" %>
<% label = ApplicationHelper::STATUS_LABELS[status] || status.humanize %>
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= color_class %>"><%= label %></span>
