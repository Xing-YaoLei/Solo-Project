<div id="status_progress_bar" class="bg-white rounded-lg border border-slate-200 p-5">
  <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-5">审计流程进度</h3>

  <%
    statuses = %i[draft pending_materials in_progress pending_evidence pending_checklist pending_notification pending_approval approved archived]
    current_index = statuses.index(audit.status.to_sym) || 0
    labels = {
      draft: "草稿",
      pending_materials: "待材料",
      in_progress: "进行中",
      pending_evidence: "待证据",
      pending_checklist: "待清单",
      pending_notification: "待通报",
      pending_approval: "待审批",
      approved: "已通过",
      archived: "已归档"
    }
    rejected = audit.rejected?
  %>

  <div class="relative">
    <div class="overflow-hidden">
      <div class="flex items-center justify-between relative">
        <% statuses.each_with_index do |status, index| %>
          <%
            is_current = (status == audit.status.to_sym)
            is_passed = index < current_index
            is_rejected_node = rejected && index == current_index

            if is_rejected_node
              line_cls = "bg-slate-200"
              node_cls = "bg-red-600 text-white ring-4 ring-red-100"
              label_cls = "text-red-700"
            elsif is_current
              line_cls = is_passed ? "bg-blue-600" : "bg-slate-200"
              node_cls = "bg-blue-600 text-white ring-4 ring-blue-100"
              label_cls = "text-blue-700"
            elsif is_passed
              line_cls = "bg-blue-600"
              node_cls = "bg-blue-600 text-white"
              label_cls = "text-slate-700"
            else
              line_cls = "bg-slate-200"
              node_cls = "bg-slate-200 text-slate-500"
              label_cls = "text-slate-400"
            end
          %>
          <div class="flex flex-col items-center relative z-10" style="width: 11.11%;">
            <% if index < statuses.size - 1 %>
              <div class="absolute top-4 left-1/2 w-full h-0.5 <%= line_cls %>" style="transform: translateY(-50%);"></div>
            <% end %>

            <div class="relative w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold <%= node_cls %> transition-all duration-300">
              <% if is_passed && !rejected %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              <% elsif is_rejected_node %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              <% else %>
                <%= index + 1 %>
              <% end %>
            </div>

            <span class="mt-3 text-xs font-medium text-center leading-tight <%= label_cls %>">
              <%= labels[status] %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if rejected && audit.state_transition_logs.where(to_state: "rejected").exists? %>
    <% last_reject = audit.state_transition_logs.where(to_state: "rejected").order(created_at: :desc).first %>
    <div class="mt-5 p-3 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-xs font-semibold text-red-700 mb-1">驳回原因</p>
      <p class="text-sm text-red-600"><%= last_reject.remark || "未填写具体原因" %></p>
    </div>
  <% end %>
</div>
