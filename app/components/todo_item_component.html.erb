<div class="bg-white rounded-xl p-5 shadow-card hover:shadow-card-hover transition-all duration-300 group animate-fade-in"
     data-todo-id="<%= @todo_item.id %>"
     data-controller="todo">
  <div class="flex items-start gap-4">
    <div class="pt-1">
      <button class="w-6 h-6 rounded-full border-2 transition-all duration-300 flex items-center justify-center
                     <%= @todo_item.completed? ? 'bg-[#10b981] border-[#10b981]' : 'border-gray-300 hover:border-[#1e3a5f]' %>"
              data-action="todo#toggle">
        <% if @todo_item.completed? %>
          <i data-lucide="check" class="w-4 h-4 text-white"></i>
        <% end %>
      </button>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h4 class="font-semibold text-gray-900 <%= @todo_item.completed? ? 'line-through text-gray-400' : '' %>">
          <%= @todo_item.title %>
        </h4>
        <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= priority_classes %>">
          <%= priority_label %>优先级
        </span>
        <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= status_classes %>">
          <%= status_label %>
        </span>
        <% if overdue? %>
          <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-600 animate-pulse">
            已逾期
          </span>
        <% elsif due_soon? %>
          <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-600">
            即将到期
          </span>
        <% end %>
      </div>
      <% if @todo_item.description.present? %>
        <p class="text-sm text-gray-500 mt-2 line-clamp-2"><%= @todo_item.description %></p>
      <% end %>
      <div class="flex items-center gap-4 mt-3 text-xs text-gray-400">
        <% if @todo_item.due_date %>
          <span class="flex items-center gap-1">
            <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
            <%= @todo_item.due_date.strftime('%Y-%m-%d') %>
          </span>
        <% end %>
        <% if @todo_item.assignee %>
          <span class="flex items-center gap-1">
            <i data-lucide="user" class="w-3.5 h-3.5"></i>
            <%= @todo_item.assignee.name %>
          </span>
        <% end %>
        <% if @todo_item.settlement %>
          <span class="flex items-center gap-1">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            结算单 #<%= @todo_item.settlement.id %>
          </span>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <button class="p-2 rounded-lg hover:bg-gray-100 transition-colors">
        <i data-lucide="edit-2" class="w-4 h-4 text-gray-500"></i>
      </button>
      <button class="p-2 rounded-lg hover:bg-red-50 transition-colors">
        <i data-lucide="trash-2" class="w-4 h-4 text-red-500"></i>
      </button>
    </div>
  </div>
</div>
