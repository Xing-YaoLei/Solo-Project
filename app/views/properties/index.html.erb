<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">房源列表</h1>
    <%= link_to "新建房源", new_property_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
  </div>

  <% if notice %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">名称</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">地址</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">房间数</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">管理员</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @properties.each do |property| %>
            <tr class="hover:bg-gray-50 transition-colors duration-150">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to property.name, property_path(property), class: "text-blue-600 hover:text-blue-800 font-medium" %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-700 max-w-xs truncate" title="<%= property.address %>">
                <%= property.address %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <%= property.room_count %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_color = case property.status
                  when "active" then "bg-green-100 text-green-800"
                  when "inactive" then "bg-gray-100 text-gray-800"
                  when "maintenance" then "bg-yellow-100 text-yellow-800"
                  else "bg-gray-100 text-gray-800"
                  end %>
                <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= status_color %>">
                  <%= property.status_i18n %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                <%= property.manager&.display_name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                <%= link_to "编辑", edit_property_path(property), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "删除", property_path(property), method: :delete, data: { confirm: "确定要删除该房源吗？" }, class: "text-red-600 hover:text-red-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
