<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.usedcar.dashboard.mapper.FilterViewMapper">

    <resultMap id="FilterViewResultMap" type="com.usedcar.dashboard.entity.FilterView">
        <id column="id" property="id"/>
        <result column="view_id" property="viewId"/>
        <result column="name" property="name"/>
        <result column="creator" property="creator"/>
        <result column="is_default" property="isDefault"/>
        <result column="filters_json" property="filtersJson"
                typeHandler="com.usedcar.dashboard.handler.JacksonTypeHandler"
                javaType="com.usedcar.dashboard.dto.DashboardFilter"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, view_id, name, creator, is_default, filters_json, created_at, updated_at
    </sql>

    <select id="selectByViewId" resultMap="FilterViewResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_filter_view
        WHERE view_id = #{viewId}
    </select>

    <select id="selectAll" resultMap="FilterViewResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_filter_view
        ORDER BY is_default DESC, created_at DESC
    </select>

    <select id="selectDefault" resultMap="FilterViewResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM t_filter_view
        WHERE is_default = 1
        LIMIT 1
    </select>

    <update id="resetAllDefault">
        UPDATE t_filter_view SET is_default = 0
    </update>

    <insert id="insert" parameterType="com.usedcar.dashboard.entity.FilterView" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_filter_view (
            view_id, name, creator, is_default, filters_json, created_at, updated_at
        ) VALUES (
            #{viewId}, #{name}, #{creator}, #{isDefault},
            #{filtersJson, typeHandler=com.usedcar.dashboard.handler.JacksonTypeHandler, javaType=com.usedcar.dashboard.dto.DashboardFilter},
            #{createdAt}, #{updatedAt}
        )
    </insert>

    <update id="update" parameterType="com.usedcar.dashboard.entity.FilterView">
        UPDATE t_filter_view
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="filtersJson != null">filters_json = #{filtersJson, typeHandler=com.usedcar.dashboard.handler.JacksonTypeHandler, javaType=com.usedcar.dashboard.dto.DashboardFilter},</if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_filter_view WHERE id = #{id}
    </delete>

</mapper>
