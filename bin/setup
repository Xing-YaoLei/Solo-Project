#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing database =="
  begin
    system! "bin/rails db:prepare"
  rescue
    puts "Database creation may have failed, trying to create..."
    system! "bin/rails db:create"
    system! "bin/rails db:migrate"
  end

  puts "\n== Seeding database =="
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Restarting application server =="
  system! "bin/rails restart"

  puts "\n🎉 Setup completed! Run 'bin/rails s' to start the server."
  puts "Sidekiq (for background jobs): 'bundle exec sidekiq' (in a separate terminal)"
  puts "Default Redis connection: redis://localhost:6379/0"
end
