<div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
  <div class="flex items-center justify-between mb-6">
    <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">审计日志</h3>
    <button class="text-sm text-[#1e3a5f] hover:underline">查看全部</button>
  </div>

  <div class="space-y-4">
    <% @audit_logs.each_with_index do |log, index| %>
      <div class="flex gap-4 animate-fade-in" style="animation-delay: <%= index * 50 %>ms">
        <div class="relative">
          <div class="w-10 h-10 rounded-full <%= action_classes(log.action) %> flex items-center justify-center">
            <i data-lucide="<%= action_icon(log.action) %>" class="w-5 h-5"></i>
          </div>
          <% unless index == @audit_logs.count - 1 %>
            <div class="absolute top-10 left-1/2 w-px h-full bg-gray-200 -translate-x-1/2"></div>
          <% end %>
        </div>
        <div class="flex-1 pb-4">
          <div class="flex items-center gap-2">
            <span class="font-medium text-gray-900"><%= log.operator&.name || '系统' %></span>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= action_classes(log.action) %>">
              <%= action_label(log.action) %>
            </span>
          </div>
          <p class="text-sm text-gray-600 mt-1"><%= log.description %></p>
          <% if log.changed_fields.present? %>
            <div class="mt-2 p-2 bg-gray-50 rounded-lg">
              <% log.changed_fields.each do |field, values| %>
                <div class="text-xs">
                  <span class="text-gray-500"><%= field %>:</span>
                  <span class="text-red-500 line-through"><%= values[0] %></span>
                  <i data-lucide="arrow-right" class="w-3 h-3 inline mx-1 text-gray-400"></i>
                  <span class="text-green-500"><%= values[1] %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <p class="text-xs text-gray-400 mt-2">
            <i data-lucide="clock" class="w-3 h-3 inline mr-1"></i>
            <%= log.created_at.strftime('%Y-%m-%d %H:%M:%S') %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>
