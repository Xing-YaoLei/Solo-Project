<% content_for :page_title, '差异详情' %>
<% content_for :breadcrumb do %>
  <a href="/cs/discrepancies" class="text-gray-500 hover:text-[#1e3a5f]">差异处理</a>
  <span class="mx-2">/</span>
  <span class="text-[#1e3a5f] font-medium">详情</span>
<% end %>

<%
  status_label = { pending: '待处理', resolved: '已解决', rejected: '已驳回', investigating: '调查中' }
  status_color = {
    pending: 'bg-orange-100 text-orange-600',
    resolved: 'bg-green-100 text-green-600',
    rejected: 'bg-red-100 text-red-600',
    investigating: 'bg-yellow-100 text-yellow-700'
  }
%>

<div class="p-6 space-y-6">
  <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-[#1e3a5f] font-serif">差异 #<%= @discrepancy.id[0..7] %></h2>
          <span class="px-3 py-1 rounded-full text-sm font-medium <%= status_color[@discrepancy.status.to_sym] %>">
            <%= status_label[@discrepancy.status.to_sym] || @discrepancy.status %>
          </span>
        </div>
        <p class="text-gray-500">
          <%= @discrepancy.description || '订单金额统计差异' %> ·
          结算单
          <%= link_to "##{@discrepancy.settlement.id[0..7]}", cs_settlement_path(@discrepancy.settlement), class: "text-[#1e3a5f] hover:underline font-medium" %>
        </p>
      </div>
      <div class="flex items-center gap-3 flex-wrap">
        <% unless @discrepancy.resolved? %>
          <% if policy(@discrepancy).escalate? %>
            <button onclick="openModal('escalate-modal')"
              class="px-4 py-2 border border-yellow-500 text-yellow-600 rounded-lg hover:bg-yellow-50 transition-colors font-medium flex items-center gap-2">
              <i data-lucide="triangle-alert" class="w-4 h-4"></i>
              升级调查
            </button>
          <% end %>

          <% if policy(@discrepancy).resolve? %>
            <button onclick="openModal('resolve-modal')"
              class="px-5 py-2 bg-[#10b981] text-white rounded-lg hover:bg-[#059669] transition-colors font-medium flex items-center gap-2">
              <i data-lucide="check-circle-2" class="w-4 h-4"></i>
              标记已解决
            </button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if notice || alert %>
    <div class="rounded-xl p-4 <%= notice ? 'bg-green-50 border border-green-200 text-green-700' : 'bg-red-50 border border-red-200 text-red-700' %>">
      <%= notice || alert %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 100ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">差异信息</h3>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-500 mb-1">商户名称</p>
            <p class="font-semibold text-gray-900"><%= @discrepancy.settlement.merchant&.name || '未知商户' %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">结算周期</p>
            <p class="font-semibold text-gray-900"><%= @discrepancy.settlement.period %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">系统统计金额</p>
            <p class="font-semibold text-[#1e3a5f] text-lg font-serif">¥<%= number_with_delimiter(sprintf('%.2f', @discrepancy.settlement.system_amount)) %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">商户上报金额</p>
            <p class="font-semibold text-[#f59e0b] text-lg font-serif">¥<%= number_with_delimiter(sprintf('%.2f', @discrepancy.settlement.merchant_amount)) %></p>
          </div>
          <div class="col-span-2">
            <p class="text-sm text-gray-500 mb-1">差异金额</p>
            <p class="font-bold <%= @discrepancy.difference_amount > 0 ? 'text-red-600' : 'text-blue-600' %> text-2xl font-serif">
              <%= @discrepancy.difference_amount > 0 ? '+' : '' %>¥<%= number_with_delimiter(sprintf('%.2f', @discrepancy.difference_amount)) %>
            </p>
            <% if @discrepancy.settlement.merchant_amount.to_i != 0 %>
              <p class="text-xs text-gray-400 mt-1">
                差异比例 <%= sprintf('%.2f', (@discrepancy.difference_amount.abs / @discrepancy.settlement.merchant_amount * 100)) %>%
              </p>
            <% end %>
          </div>
          <% if @discrepancy.resolution_type.present? %>
            <div>
              <p class="text-sm text-gray-500 mb-1">处理方式</p>
              <p class="font-semibold text-gray-900"><%= { agreed: '双方同意', merchant_agreed: '商户同意', system_adjusted: '系统调整', waived: '差异免除' }[@discrepancy.resolution_type.to_sym] || @discrepancy.resolution_type %></p>
            </div>
          <% end %>
          <% if @discrepancy.resolved_by_user.present? %>
            <div>
              <p class="text-sm text-gray-500 mb-1">处理人</p>
              <p class="font-semibold text-gray-900"><%= @discrepancy.resolved_by_user.name %></p>
            </div>
          <% end %>
          <% if @discrepancy.resolved_at.present? %>
            <div>
              <p class="text-sm text-gray-500 mb-1">解决时间</p>
              <p class="font-semibold text-gray-900"><%= @discrepancy.resolved_at.strftime('%Y-%m-%d %H:%M') %></p>
            </div>
          <% end %>
          <% if @discrepancy.comment.present? %>
            <div class="col-span-2">
              <p class="text-sm text-gray-500 mb-1">处理备注</p>
              <p class="font-medium text-gray-700 bg-gray-50 p-3 rounded-lg"><%= @discrepancy.comment %></p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 200ms">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">关联待办（<%= @todo_items.count %> 条）</h3>
        </div>
        <% if @todo_items.any? %>
          <div class="space-y-3">
            <% @todo_items.each do |todo| %>
              <div class="p-4 rounded-xl <%= todo.completed? ? 'bg-green-50' : 'bg-gray-50' %>">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="font-medium text-gray-900"><%= todo.title %></span>
                      <span class="px-2 py-0.5 rounded-full text-xs font-medium
                                   <%= todo.urgent? ? 'bg-red-100 text-red-600' : todo.high? ? 'bg-orange-100 text-orange-600' : todo.medium? ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600' %>">
                        <%= { low: '低', medium: '中', high: '高', urgent: '紧急' }[todo.priority.to_sym] %>
                      </span>
                      <span class="px-2 py-0.5 rounded-full text-xs font-medium
                                   <%= todo.completed? ? 'bg-green-100 text-green-600' : todo.in_progress? ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-600' %>">
                        <%= { pending: '待处理', in_progress: '进行中', completed: '已完成', cancelled: '已取消' }[todo.status.to_sym] %>
                      </span>
                    </div>
                    <% if todo.description.present? %>
                      <p class="text-sm text-gray-600 mb-1"><%= todo.description %></p>
                    <% end %>
                    <% if todo.completion_note.present? %>
                      <p class="text-xs text-green-600 mb-1">完成备注：<%= todo.completion_note %></p>
                    <% end %>
                    <p class="text-xs text-gray-400">
                      处理人：<%= todo.assignee&.name %>
                      · 创建人：<%= todo.assigner&.name %>
                      · 截止：<%= todo.due_date&.strftime('%Y-%m-%d') || '无' %>
                      <% if todo.completed_at.present? %>
                        · 完成于 <%= todo.completed_at.strftime('%Y-%m-%d %H:%M') %>
                      <% end %>
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-400">
            <i data-lucide="check-square" class="w-12 h-12 mx-auto mb-3 text-gray-300"></i>
            <p>暂无关联待办</p>
          </div>
        <% end %>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 300ms">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">处理记录</h3>
        </div>

        <div class="space-y-4">
          <% audit_items = [] %>
          <% audit_items << { type: 'created', text: '差异记录自动创建', name: '系统', time: @discrepancy.created_at, color: 'orange' } %>
          <% @supplement_materials.each do |m| %>
            <% audit_items << { type: 'material', text: "上传补充材料：#{m.description}", name: m.uploader&.name || '未知用户', time: m.created_at, color: 'blue' } %>
          <% end %>
          <% if @discrepancy.investigating? %>
            <% audit_items << { type: 'escalated', text: '差异升级为调查中', name: @discrepancy.resolved_by_user&.name || '系统', time: @discrepancy.updated_at, color: 'yellow' } %>
          <% end %>
          <% if @discrepancy.resolved? %>
            <% audit_items << { type: 'resolved', text: "差异已解决#{@discrepancy.comment.present? ? "（#{@discrepancy.comment}）" : ''}", name: @discrepancy.resolved_by_user&.name || '系统', time: @discrepancy.resolved_at || @discrepancy.updated_at, color: 'green' } %>
          <% end %>
          <% @todo_items.each do |todo| %>
            <% audit_items << { type: 'todo', text: "生成待办：#{todo.title}", name: todo.assigner&.name || '系统', time: todo.created_at, color: 'purple' } %>
          <% end %>
          <% audit_items.sort_by { |x| x[:time] }.reverse.each do |item| %>
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-<%= item[:color] %>-500 to-<%= item[:color] %>-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                <%= item[:name].first rescue '系' %>
              </div>
              <div class="flex-1">
                <div class="bg-gray-50 rounded-xl p-4">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-medium text-gray-900"><%= item[:name] %></span>
                    <span class="text-xs text-gray-400"><%= item[:time].strftime('%Y-%m-%d %H:%M') %></span>
                  </div>
                  <p class="text-sm text-gray-600"><%= item[:text] %></p>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <% unless @discrepancy.resolved? %>
          <%= form_tag cs_discrepancy_path(@discrepancy), method: :patch, class: "mt-4 flex gap-3" do %>
            <%= text_area_tag :"discrepancy[comment]", nil, rows: 1, placeholder: "添加处理备注...",
              class: "flex-1 px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none resize-none" %>
            <%= submit_tag "提交", class: "px-5 py-3 bg-[#1e3a5f] text-white rounded-xl hover:bg-[#2d4a6f] transition-colors font-medium cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 150ms">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">补充材料（<%= @supplement_materials.count %> 份）</h3>
        </div>
        <% if @supplement_materials.any? %>
          <div class="space-y-3 max-h-80 overflow-y-auto">
            <% @supplement_materials.each do |material| %>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors">
                <div class="w-10 h-10 rounded-lg bg-[#1e3a5f]/10 flex items-center justify-center flex-shrink-0">
                  <i data-lucide="file-text" class="w-5 h-5 text-[#1e3a5f]"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate"><%= material.description %></p>
                  <p class="text-xs text-gray-400">
                    <%= material.uploader&.name || '未知用户' %>
                    · <%= material.created_at.strftime('%m-%d %H:%M') %>
                  </p>
                </div>
                <% if material.file_url.present? %>
                  <%= link_to material.file_url, target: "_blank", class: "p-2 rounded-lg hover:bg-white transition-colors" do %>
                    <i data-lucide="external-link" class="w-4 h-4 text-gray-400"></i>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-400">
            <i data-lucide="file-text" class="w-10 h-10 mx-auto mb-2 text-gray-300"></i>
            <p class="text-sm">暂无补充材料</p>
          </div>
        <% end %>
        <% unless @discrepancy.resolved? %>
          <button onclick="openModal('material-modal')"
            class="w-full mt-4 py-3 border-2 border-dashed border-gray-200 rounded-xl text-gray-500 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center justify-center gap-2">
            <i data-lucide="upload" class="w-4 h-4"></i>
            上传材料
          </button>
        <% end %>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 250ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">关联结算单</h3>
        <div class="p-4 rounded-xl bg-gray-50">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6f] flex items-center justify-center text-white text-xs font-bold">
              <%= @discrepancy.settlement.merchant&.name&.first || '商' %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-gray-900 truncate"><%= @discrepancy.settlement.merchant&.name %></p>
              <p class="text-xs text-gray-400">#<%= @discrepancy.settlement.id[0..7] %> · <%= @discrepancy.settlement.period %></p>
            </div>
          </div>
          <div class="space-y-2 text-sm mb-3">
            <div class="flex justify-between">
              <span class="text-gray-500">订单数量</span>
              <span class="font-medium text-gray-900"><%= @discrepancy.settlement.order_count %> 单</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-500">状态</span>
              <span class="font-medium text-gray-900"><%= status_label[@discrepancy.settlement.status.to_sym] || @discrepancy.settlement.status %></span>
            </div>
          </div>
          <%= link_to "查看结算单", cs_settlement_path(@discrepancy.settlement), class: "w-full block text-center py-2.5 bg-[#1e3a5f] text-white rounded-lg hover:bg-[#2d4a6f] transition-colors font-medium text-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 解决差异 Modal -->
<div id="resolve-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 animate-fade-in">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-gray-900">处理差异</h3>
      <button onclick="closeModal('resolve-modal')" class="p-2 hover:bg-gray-100 rounded-lg">
        <i data-lucide="x" class="w-5 h-5 text-gray-500"></i>
      </button>
    </div>
    <%= form_tag resolve_cs_discrepancy_path(@discrepancy), method: :post, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">处理方式</label>
        <select name="resolution_type" required
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
          <option value="agreed">双方同意差异</option>
          <option value="merchant_agreed">商户同意系统金额</option>
          <option value="system_adjusted">调整系统统计金额</option>
          <option value="waived">差异免除</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">最终确认的系统金额（元）</label>
        <input type="number" name="new_amount" step="0.01" value="<%= @discrepancy.settlement.system_amount %>" required
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none font-serif">
        <p class="text-xs text-gray-400 mt-1">
          当前：¥<%= sprintf('%.2f', @discrepancy.settlement.system_amount) %>
          · 商户：¥<%= sprintf('%.2f', @discrepancy.settlement.merchant_amount) %>
        </p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">处理备注</label>
        <textarea name="comment" rows="3"
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none resize-none"
          placeholder="请描述处理过程..."></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('resolve-modal')"
          class="flex-1 px-4 py-3 border border-gray-200 text-gray-600 rounded-xl hover:bg-gray-50 transition-colors font-medium">
          取消
        </button>
        <button type="submit"
          class="flex-1 px-4 py-3 bg-[#10b981] text-white rounded-xl hover:bg-[#059669] transition-colors font-medium">
          确认解决
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- 升级调查 Modal -->
<div id="escalate-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 animate-fade-in">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-gray-900">升级调查</h3>
      <button onclick="closeModal('escalate-modal')" class="p-2 hover:bg-gray-100 rounded-lg">
        <i data-lucide="x" class="w-5 h-5 text-gray-500"></i>
      </button>
    </div>
    <%= form_tag escalate_cs_discrepancy_path(@discrepancy), method: :post, class: "space-y-4" do %>
      <div class="p-4 rounded-xl bg-yellow-50 border border-yellow-200">
        <div class="flex items-start gap-3">
          <i data-lucide="triangle-alert" class="w-5 h-5 text-yellow-600 flex-shrink-0 mt-0.5"></i>
          <div>
            <p class="text-sm font-medium text-yellow-700 mb-1">升级调查通知</p>
            <p class="text-xs text-yellow-600">此操作将通知所有城市经理，生成紧急待办事项处理该差异。</p>
          </div>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">升级原因（可选）</label>
        <textarea name="comment" rows="3"
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none resize-none"
          placeholder="请描述需要升级调查的原因..."></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('escalate-modal')"
          class="flex-1 px-4 py-3 border border-gray-200 text-gray-600 rounded-xl hover:bg-gray-50 transition-colors font-medium">
          取消
        </button>
        <button type="submit"
          class="flex-1 px-4 py-3 bg-yellow-500 text-white rounded-xl hover:bg-yellow-600 transition-colors font-medium">
          确认升级
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- 上传材料 Modal -->
<div id="material-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 animate-fade-in">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-gray-900">上传补充材料</h3>
      <button onclick="closeModal('material-modal')" class="p-2 hover:bg-gray-100 rounded-lg">
        <i data-lucide="x" class="w-5 h-5 text-gray-500"></i>
      </button>
    </div>
    <%= form_tag cs_discrepancy_supplement_materials_path(@discrepancy), method: :post, class: "space-y-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">材料描述</label>
        <textarea name="description" rows="3" required
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none resize-none"
          placeholder="请描述补充的材料内容，如：商户对账单、优惠活动说明等..."></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">文件链接（可选）</label>
        <input type="text" name="file_url"
          class="w-full px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none"
          placeholder="https://...">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeModal('material-modal')"
          class="flex-1 px-4 py-3 border border-gray-200 text-gray-600 rounded-xl hover:bg-gray-50 transition-colors font-medium">
          取消
        </button>
        <button type="submit"
          class="flex-1 px-4 py-3 bg-[#1e3a5f] text-white rounded-xl hover:bg-[#2d4a6f] transition-colors font-medium">
          上传
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
function openModal(id) {
  const modal = document.getElementById(id);
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  setTimeout(() => lucide.createIcons(), 10);
}
function closeModal(id) {
  const modal = document.getElementById(id);
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}
</script>
