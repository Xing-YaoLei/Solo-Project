<% content_for :page_title, "趋势报表" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;">趋势报表</h1>
    <%= link_to "返回仪表盘", root_path, class: "text-sm text-gray-500 hover:text-[#1B2A4A] transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
    <%= form_with url: analytics_trends_path, method: :get, class: "flex flex-wrap gap-3 items-end" do |f| %>
      <div class="min-w-[130px]">
        <label class="block text-xs text-gray-500 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">开始日期</label>
        <%= f.date_field :start_date, value: @start_date, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'DM Sans', sans-serif;" %>
      </div>
      <div class="min-w-[130px]">
        <label class="block text-xs text-gray-500 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">结束日期</label>
        <%= f.date_field :end_date, value: @end_date, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'DM Sans', sans-serif;" %>
      </div>
      <div class="min-w-[100px]">
        <label class="block text-xs text-gray-500 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">时间粒度</label>
        <%= f.select :interval, options_for_select([["按天", "day"], ["按周", "week"], ["按月", "month"]], @interval), {}, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'Noto Sans SC', sans-serif;" %>
      </div>
      <button type="submit" class="px-4 py-2 bg-[#1B2A4A] text-white rounded-lg text-sm hover:bg-[#2a3d66] transition-colors" style="font-family: 'Noto Sans SC', sans-serif;">查询</button>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
      <h2 class="text-base font-semibold text-[#1B2A4A] mb-4" style="font-family: 'Noto Sans SC', sans-serif;">完成率趋势</h2>
      <% if @trend_chart_data.any? %>
        <%= line_chart @trend_chart_data, colors: ["#2DD4A8"], library: { chart: { style: { fontFamily: "'DM Sans', sans-serif" } }, yAxis: { title: { text: "完成率 (%)" } } } %>
      <% else %>
        <div class="py-16 text-center text-sm text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">暂无趋势数据</div>
      <% end %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
      <h2 class="text-base font-semibold text-[#1B2A4A] mb-4" style="font-family: 'Noto Sans SC', sans-serif;">区域对比</h2>
      <% if @area_chart_data.any? %>
        <%= bar_chart @area_chart_data, colors: ["#1B2A4A"], library: { chart: { style: { fontFamily: "'Noto Sans SC', sans-serif" } }, yAxis: { title: { text: "完成率 (%)" } } } %>
      <% else %>
        <div class="py-16 text-center text-sm text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">暂无区域数据</div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-base font-semibold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;">异常检测</h2>
      <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">未完成或实际时长为 0 的训练记录</span>
    </div>
    <% if @anomalies.any? %>
      <div class="overflow-hidden">
        <table class="w-full">
          <thead>
            <tr class="bg-[#EF4444]/5 text-[#EF4444] text-sm" style="font-family: 'Noto Sans SC', sans-serif;">
              <th class="px-4 py-3 text-left font-medium">患者</th>
              <th class="px-4 py-3 text-left font-medium">训练日期</th>
              <th class="px-4 py-3 text-left font-medium">计划时长</th>
              <th class="px-4 py-3 text-left font-medium">实际时长</th>
              <th class="px-4 py-3 text-left font-medium">状态</th>
              <th class="px-4 py-3 text-left font-medium">异常类型</th>
            </tr>
          </thead>
          <tbody>
            <% @anomalies.each_with_index do |session, idx| %>
              <tr class="<%= idx.even? ? 'bg-white' : 'bg-[#F5F3EF]/50' %> border-b border-gray-50">
                <td class="px-4 py-3 text-sm text-[#1B2A4A] font-medium" style="font-family: 'Noto Sans SC', sans-serif;"><%= session.prescription&.assessment_record&.patient&.name %></td>
                <td class="px-4 py-3 text-sm text-gray-600" style="font-family: 'DM Sans', sans-serif;"><%= session.session_date&.strftime("%Y-%m-%d") %></td>
                <td class="px-4 py-3 text-sm text-gray-600" style="font-family: 'DM Sans', sans-serif;"><%= session.planned_duration %> 分钟</td>
                <td class="px-4 py-3 text-sm text-gray-600" style="font-family: 'DM Sans', sans-serif;"><%= session.actual_duration %> 分钟</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-[#EF4444]/10 text-[#EF4444]" style="font-family: 'Noto Sans SC', sans-serif;">
                    <%= session.status == "missed" ? "未执行" : session.status %>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% if session.status == "missed" %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-[#EF4444]/10 text-[#EF4444]" style="font-family: 'Noto Sans SC', sans-serif;">未执行</span>
                    <% end %>
                    <% if session.actual_duration == 0 %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-[#F59E0B]/10 text-[#F59E0B]" style="font-family: 'Noto Sans SC', sans-serif;">零时长</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#2DD4A8" class="w-12 h-12 mx-auto mb-3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        <p class="text-sm text-[#2DD4A8] font-medium" style="font-family: 'Noto Sans SC', sans-serif;">未检测到异常记录</p>
      </div>
    <% end %>
  </div>
</div>
