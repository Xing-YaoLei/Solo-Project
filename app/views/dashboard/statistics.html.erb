<% content_for :title, "数据统计" %>

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">按状态分布</h3>
      <div class="space-y-2">
        <% @by_status.each do |status, count| %>
          <% lc = LegalCase.new(status: status) %>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center">
              <span class="w-3 h-3 rounded-full mr-2 <%= lc.status_label.split(' ').first %>"></span>
              <span class="text-sm text-gray-700"><%= lc.status_text %></span>
            </span>
            <span class="text-sm font-semibold text-gray-900"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">按来源渠道</h3>
      <div class="space-y-2">
        <% @by_channel.each do |channel, count| %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-700"><%= channel.presence || "未标注" %></span>
            <span class="text-sm font-semibold text-gray-900"><%= count %></span>
          </div>
        <% end %>
        <% if @by_channel.empty? %>
          <p class="text-sm text-gray-400">暂无数据</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">按责任人</h3>
      <div class="space-y-2 max-h-48 overflow-y-auto">
        <% @by_responsible.each do |person, count| %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-700"><%= person.presence || "未分配" %></span>
            <span class="text-sm font-semibold text-gray-900"><%= count %></span>
          </div>
        <% end %>
        <% if @by_responsible.empty? %>
          <p class="text-sm text-gray-400">暂无数据</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-5">
      <h3 class="text-sm font-medium text-gray-500 mb-3">按案件类别</h3>
      <div class="space-y-2">
        <% @by_category.each do |cat, count| %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-700"><%= cat.presence || "未分类" %></span>
            <span class="text-sm font-semibold text-gray-900"><%= count %></span>
          </div>
        <% end %>
        <% if @by_category.empty? %>
          <p class="text-sm text-gray-400">暂无数据</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-5">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">近6个月案件趋势</h3>
    <% if @monthly_trend.any? %>
      <div class="flex items-end space-x-4 h-48">
        <% max_count = @monthly_trend.values.max || 1 %>
        <% @monthly_trend.each do |month, count| %>
          <div class="flex-1 flex flex-col items-center">
            <div class="text-xs text-gray-500 mb-1"><%= count %></div>
            <div class="w-full bg-blue-500 rounded-t" style="height: <%= (count.to_f / max_count * 100).to_i %>%"></div>
            <div class="mt-1 text-xs text-gray-600"><%= month.strftime("%Y-%m") %></div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 text-center py-8">暂无数据</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-5">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">最近状态变更记录</h3>
    <% if @status_transitions.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">时间</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">案件</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态变更</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作人</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">原因</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @status_transitions.each do |st| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500">
                  <%= st.created_at.strftime("%Y-%m-%d %H:%M") %>
                </td>
                <td class="px-6 py-3 whitespace-nowrap">
                  <%= link_to st.legal_case.title, case_path(st.legal_case), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
                </td>
                <td class="px-6 py-3 whitespace-nowrap">
                  <div class="flex items-center space-x-2">
                    <span class="inline-flex px-2 py-0.5 text-xs rounded-full bg-gray-100 text-gray-600"><%= st.from_status %></span>
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    <span class="inline-flex px-2 py-0.5 text-xs rounded-full <%= st.status_label(to: true) %>"><%= st.to_status %></span>
                  </div>
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500"><%= st.operator %></td>
                <td class="px-6 py-3 text-sm text-gray-500"><%= st.reason.presence || "-" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 text-center py-4">暂无状态变更记录</p>
    <% end %>
  </div>
</div>
