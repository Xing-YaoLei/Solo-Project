<div class="space-y-6">
  <div class="flex items-center">
    <%= link_to performance_path(@performance), class: "mr-3 text-gray-500 hover:text-gray-700" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">上报演出取消</h1>
  </div>

  <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
    <div class="flex items-start">
      <svg class="w-5 h-5 text-yellow-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-yellow-800">取消影响</h3>
        <div class="mt-1 text-sm text-yellow-700">
          <p>演出：<%= @performance.name %></p>
          <p>场馆：<%= @performance.venue %></p>
          <p>时间：<%= @performance.start_time&.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm">
    <%= form_with model: [@performance, @cancellation], local: true do |form| %>
      <div class="p-6 space-y-4">
        <div>
          <%= form.label :reason, "取消原因", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :reason, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true, placeholder: "请详细说明取消原因..." %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :affected_audience_count, "受影响观众数", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :affected_audience_count, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", min: 0 %>
          </div>
          <div>
            <%= form.label :affected_merchant_count, "受影响商户数", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :affected_merchant_count, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", min: 0 %>
          </div>
        </div>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <%= link_to "取消", performance_path(@performance), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= form.submit "确认上报", class: "px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700" %>
      </div>
    <% end %>
  </div>
</div>
