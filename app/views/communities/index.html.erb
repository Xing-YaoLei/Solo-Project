<div class="page-header flex items-center justify-between">
  <div>
    <h1 class="page-title">🏫 学员社群管理</h1>
    <p class="page-subtitle">管理班级社群、负责人和学员</p>
  </div>
  <%= link_to "+ 新增社群", new_community_path, class: "btn-primary" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <% Community::STATUSES.each do |status| %>
    <div class="stat-card">
      <p class="stat-label"><%= status_text(status) %>社群</p>
      <p class="stat-value"><%= @communities.select { |c| c.status == status }.count rescue Community.where(status: status).count %></p>
    </div>
  <% end %>
</div>

<div class="table-container">
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>社群名称</th>
          <th>课程</th>
          <th>负责人</th>
          <th>学员数</th>
          <th>状态</th>
          <th>周期</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @communities.each do |c| %>
          <tr>
            <td class="font-mono text-xs">#<%= c.id %></td>
            <td class="font-medium"><%= link_to c.name, community_path(c), class: "text-blue-600 hover:underline" %></td>
            <td><%= c.course_name %></td>
            <td><%= c.manager&.name || "未分配" %></td>
            <td class="font-semibold"><%= c.students.count %>人</td>
            <td><%= status_badge(c.status) %></td>
            <td class="text-xs"><%= c.start_date %> ~ <%= c.end_date %></td>
            <td>
              <div class="flex space-x-1">
                <%= link_to "详情", community_path(c), class: "btn-secondary text-xs py-1 px-2" %>
                <%= link_to "编辑", edit_community_path(c), class: "btn-primary text-xs py-1 px-2" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
