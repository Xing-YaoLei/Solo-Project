{
  "compilerOptions": {
    "target": "es2017",
    "module": "es2015",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "temp/compiled",
    "declaration": false,
    "sourceMap": false,
    "lib": ["es2017", "dom"],
    "types": [],
    "baseUrl": "./",
    "paths": {
      "cc": ["./temp/declarations/cc.d.ts"]
    }
  },
  "include": [
    "assets/**/*.ts",
    "temp/declarations/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "temp/compiled",
    "library",
    "build"
  ]
}
