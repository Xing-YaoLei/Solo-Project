<%= turbo_frame_tag :work_order_parts do %>
  <div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <h2 class="text-lg font-semibold text-gray-900">配件清单</h2>
      <%= button_tag '添加配件', type: 'button', data: { work_order_part_form_toggle: true }, class: 'inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        添加配件
      <% end %>
    </div>

    <div data-work_order_part_form_container="true" class="hidden bg-gray-50 rounded-lg border border-gray-200 p-4">
      <%= render 'work_order_parts/form', work_order: @work_order, work_order_part: WorkOrderPart.new %>
    </div>

    <% if @work_order_parts.empty? %>
      <div class="text-center py-12 bg-gray-50 rounded-lg border border-gray-200">
        <p class="text-gray-500">暂无配件</p>
      </div>
    <% else %>
      <div class="hidden md:block bg-white rounded-lg border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">配件名称</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">SKU</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">数量</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">单价</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">小计</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">库存状态</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @work_order_parts.each do |work_order_part| %>
                <%= render work_order_part, work_order_part: work_order_part, work_order: @work_order %>
              <% end %>
            </tbody>
            <tfoot class="bg-gray-50">
              <tr>
                <td colspan="4" class="px-4 py-3 text-sm font-medium text-gray-900 text-right">合计:</td>
                <td class="px-4 py-3 text-sm font-bold text-gray-900 text-right"><%= format_money(@work_order_parts.sum(&:subtotal)) %></td>
                <td colspan="2"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <div class="md:hidden space-y-3">
        <% @work_order_parts.each do |work_order_part| %>
          <%= render work_order_part, work_order_part: work_order_part, work_order: @work_order %>
        <% end %>
        <div class="bg-white rounded-lg border border-gray-200 p-4 text-right">
          <span class="text-gray-600">合计:</span>
          <span class="ml-2 font-bold text-gray-900"><%= format_money(@work_order_parts.sum(&:subtotal)) %></span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const toggleBtn = document.querySelector('[data-work_order_part_form_toggle]');
  const formContainer = document.querySelector('[data-work_order_part_form_container]');
  if (toggleBtn && formContainer) {
    toggleBtn.addEventListener('click', function() {
      formContainer.classList.toggle('hidden');
    });
  }
});
</script>
