<div class="space-y-6">
  <div class="flex items-center gap-4">
    <%= link_to merchant_contracts_path, class: "p-2 rounded-lg hover:bg-gray-100" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">新增商户合同</h1>
      <p class="text-gray-500 mt-1">创建新的商户合同</p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <%= render "form", merchant_contract: @merchant_contract %>
  </div>
</div>
