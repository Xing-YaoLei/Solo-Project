<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "职业教育结算台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mp0169">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <div class="flex-shrink-0 flex items-center">
              <span class="text-xl font-bold text-indigo-600">职业教育结算台</span>
            </div>
            <div class="hidden sm:ml-8 sm:flex sm:space-x-4">
              <%= link_to root_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{current_page?(root_path) ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                仪表盘
              <% end %>
              <%= link_to settlements_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{controller_name == 'settlements' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                结算台
              <% end %>
              <%= link_to follow_ups_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{controller_name == 'follow_ups' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                跟进名单
              <% end %>
              <%= link_to appeals_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{controller_name == 'appeals' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                申诉管理
              <% end %>
              <%= link_to enrollments_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{controller_name == 'enrollments' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                学员报名
              <% end %>
              <%= link_to orders_path, class: "inline-flex items-center px-3 pt-1 border-b-2 text-sm font-medium #{controller_name == 'orders' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}" do %>
                订单管理
              <% end %>
            </div>
          </div>
          <div class="flex items-center">
            <span class="text-sm text-gray-500">管理员</span>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <% if notice %>
        <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
