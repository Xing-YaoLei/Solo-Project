<%= turbo_frame_tag "day_detail" do %>
  <div class="bg-white rounded-xl shadow-sm p-5">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-bold" style="color: #1B2A4A;"><%= @date.strftime("%Y年%m月%d日") %> 治疗安排</h3>
      <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-3">
        <% @sessions.each do |session| %>
          <div class="border border-gray-100 rounded-lg p-3
            <%= 'border-red-300 animate-pulse' if session.missed? %>">
            <div class="flex items-center justify-between mb-1">
              <span class="text-xs font-medium" style="color: #1B2A4A;">
                <%= session.prescription&.assessment_record&.patient&.name %>
              </span>
              <span class="px-1.5 py-0.5 rounded text-xs font-medium
                <%= case session.status
                    when 'completed' then 'bg-emerald-100 text-emerald-700'
                    when 'in_progress' then 'bg-blue-100 text-blue-700'
                    when 'missed' then 'bg-red-100 text-red-700'
                    else 'bg-gray-100 text-gray-500'
                    end %>">
                <%= session.status %>
              </span>
            </div>
            <p class="text-xs text-gray-500">设备: <%= session.equipment&.name || "未指定" %></p>
            <p class="text-xs text-gray-500">时长: <%= session.planned_duration %> 分钟</p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 text-center py-4">当日无治疗安排</p>
    <% end %>
  </div>
<% end %>
