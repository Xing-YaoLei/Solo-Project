<div class="page-header flex items-center justify-between">
  <div>
    <h1 class="page-title">👥 学员管理</h1>
    <p class="page-subtitle">职业教育学员信息与会员档案</p>
  </div>
  <%= link_to "+ 新增学员", new_student_path, class: "btn-primary" %>
</div>

<div class="filter-form">
  <%= form_tag students_path, method: :get do %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="form-group">
        <%= label_tag :keyword, "姓名/手机号", class: "form-label" %>
        <%= text_field_tag :keyword, params[:keyword], class: "form-input", placeholder: "搜索..." %>
      </div>
      <div class="form-group">
        <%= label_tag :community_id, "所属社群", class: "form-label" %>
        <%= select_tag :community_id, options_from_collection_for_select(@communities, :id, :name, params[:community_id]), include_blank: "全部", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= label_tag :status, "状态", class: "form-label" %>
        <%= select_tag :status, options_for_select(Student::STATUSES, params[:status]), include_blank: "全部", class: "form-select" %>
      </div>
    </div>
    <div class="mt-4 flex space-x-3">
      <%= submit_tag "筛选", class: "btn-primary" %>
      <%= link_to "重置", students_path, class: "btn-secondary" %>
      <%= link_to "导出名单", new_export_record_path(export_type: "student_list"), class: "btn-secondary" %>
    </div>
  <% end %>
</div>

<div class="table-container">
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>姓名</th>
          <th>联系方式</th>
          <th>学历/职业</th>
          <th>所属社群</th>
          <th>会员等级</th>
          <th>状态</th>
          <th>入学日期</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @students.each do |s| %>
          <tr>
            <td class="font-mono text-xs">#<%= s.id %></td>
            <td class="font-medium">
              <%= link_to s.name, student_path(s), class: "text-blue-600 hover:underline" %>
            </td>
            <td>
              <div><%= s.phone %></div>
              <div class="text-xs text-gray-500"><%= s.email %></div>
            </td>
            <td>
              <div><%= s.education %></div>
              <div class="text-xs text-gray-500"><%= s.occupation %></div>
            </td>
            <td><%= s.community&.name || "未分配" %></td>
            <td><%= member_level_badge(s.member_profile&.member_level) %></td>
            <td><%= status_badge(s.status) %></td>
            <td class="text-xs"><%= s.enrollment_date %></td>
            <td>
              <div class="flex space-x-1">
                <%= link_to "详情", student_path(s), class: "btn-secondary text-xs py-1 px-2" %>
                <%= link_to "编辑", edit_student_path(s), class: "btn-primary text-xs py-1 px-2" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
