<div class="w-full max-w-3xl mx-auto">
  <%= content_for :title, "保洁任务 #{@cleaning_task.task_date}" %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">保洁任务详情</h1>
    <div class="space-x-2">
      <%= link_to "返回列表", cleaning_tasks_path, class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
      <%= link_to "编辑", edit_cleaning_task_path(@cleaning_task), class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-lg font-semibold text-gray-800">任务信息</h2>
    </div>
    <div class="p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">房源</dt>
          <dd class="mt-1 text-sm">
            <%= link_to @cleaning_task.property.name, property_path(@cleaning_task.property), class: "text-blue-600 hover:text-blue-800 font-medium" %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">任务日期</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @cleaning_task.task_date %></dd>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">状态</dt>
          <dd class="mt-1">
            <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= @cleaning_task.status_color %>">
              <%= @cleaning_task.status_i18n %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">优先级</dt>
          <dd class="mt-1 text-sm <%= @cleaning_task.priority_color %> font-medium">
            <%= @cleaning_task.priority_i18n || "-" %>
          </dd>
        </div>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">负责人</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @cleaning_task.assignee&.display_name || "未分配" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500 mb-1">备注</dt>
        <dd class="text-sm text-gray-700 bg-gray-50 rounded-lg p-4 whitespace-pre-wrap"><%= @cleaning_task.note.presence || "暂无备注" %></dd>
      </div>
    </div>
  </div>
</div>
