<%= form_with(model: check_in_document, local: true) do |form| %>
  <% if check_in_document.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
      <h2 class="text-sm font-semibold text-red-800 mb-2"><%= pluralize(check_in_document.errors.count, "个") %> 错误导致无法保存：</h2>
      <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
        <% check_in_document.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="md:col-span-2">
      <%= form.label :channel_order_id, "关联订单", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.collection_select :channel_order_id, ChannelOrder.all.order(created_at: :desc), :id, :order_no, { include_blank: "请选择关联订单" }, { required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :guest_id, "关联客人", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.collection_select :guest_id, Guest.all.order(created_at: :desc), :id, :name, { include_blank: "请选择关联客人" }, { required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
    </div>

    <div>
      <%= form.label :id_type, "证件类型", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :id_type, CheckInDocument::ID_TYPES.map { |t| [I18n.t("id_types.#{t}", default: t), t] }, { include_blank: "请选择证件类型" }, { required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" } %>
    </div>

    <div>
      <%= form.label :id_number, "证件号", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :id_number, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :name, "客人姓名", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :nationality, "国籍", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :nationality, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :gender, "性别", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <div class="flex flex-wrap gap-6 mt-2">
        <% CheckInDocument::GENDERS.each do |g| %>
          <label class="flex items-center cursor-pointer">
            <%= form.radio_button :gender, g, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" %>
            <span class="ml-2 text-sm text-gray-700"><%= I18n.t("genders.#{g}", default: g) %></span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <div class="flex flex-wrap gap-3">
      <%= form.submit class: "px-6 py-2.5 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium transition cursor-pointer" %>
      <%= link_to "取消", check_in_documents_path, class: "px-6 py-2.5 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 text-sm font-medium" %>
    </div>
  </div>
<% end %>
