<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to "← 返回列表", assessment_scales_path, class: "text-sm text-gray-500 hover:text-[#1B2A4A] transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;" %>
    <span class="text-gray-300">|</span>
    <h1 class="text-2xl font-bold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;"><%= @assessment_scale.name %></h1>
    <% if @assessment_scale.active? %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#2DD4A8]/10 text-[#2DD4A8]" style="font-family: 'Noto Sans SC', sans-serif;">启用</span>
    <% else %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500" style="font-family: 'Noto Sans SC', sans-serif;">停用</span>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-4">
        <h2 class="text-lg font-semibold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;">基本信息</h2>
        <div class="space-y-3">
          <div>
            <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">分类</span>
            <p class="text-sm text-gray-700 mt-0.5" style="font-family: 'Noto Sans SC', sans-serif;"><%= @assessment_scale.category.presence || "-" %></p>
          </div>
          <div>
            <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">版本</span>
            <p class="text-sm text-gray-700 mt-0.5" style="font-family: 'DM Sans', sans-serif;"><%= @assessment_scale.version %></p>
          </div>
          <div>
            <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">创建时间</span>
            <p class="text-sm text-gray-700 mt-0.5" style="font-family: 'DM Sans', sans-serif;"><%= @assessment_scale.created_at&.strftime("%Y-%m-%d") %></p>
          </div>
          <div>
            <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">评分配置</span>
            <pre class="text-xs text-gray-600 mt-1 bg-[#F5F3EF] p-2 rounded-lg overflow-auto" style="font-family: 'DM Sans', sans-serif;"><%= JSON.pretty_generate(@assessment_scale.scoring_config || {}) %></pre>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 flex gap-2">
          <%= link_to "编辑量表", edit_assessment_scale_path(@assessment_scale), class: "flex-1 text-center px-3 py-2 bg-[#1B2A4A] text-white rounded-lg text-sm hover:bg-[#2a3d66] transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;", data: { turbo_frame: "_top" } %>
          <%= button_to toggle_active_assessment_scale_path(@assessment_scale), method: :patch, class: "flex-1 text-center px-3 py-2 border rounded-lg text-sm transition-colors #{@assessment_scale.active? ? 'border-[#F59E0B] text-[#F59E0B] hover:bg-[#F59E0B]/10' : 'border-[#2DD4A8] text-[#2DD4A8] hover:bg-[#2DD4A8]/10'}", style: "font-family: 'Noto Sans SC', sans-serif;", form: { data: { turbo_frame: "_top" } } do %>
            <%= @assessment_scale.active? ? "停用" : "启用" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;">评估项目</h2>
        </div>

        <div id="scale_items">
          <% @scale_items.each do |item| %>
            <%= render partial: "assessment_scales/scale_items/scale_item", locals: { scale: @assessment_scale, scale_item: item } %>
          <% end %>
        </div>

        <% if @scale_items.empty? %>
          <div class="text-center py-8 text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">暂无评估项目</div>
        <% end %>

        <div id="scale_item_form" class="mt-4">
          <%= render partial: "assessment_scales/scale_items/form", locals: { scale: @assessment_scale, scale_item: ScaleItem.new(scale: @assessment_scale) } %>
        </div>
      </div>
    </div>
  </div>
</div>
