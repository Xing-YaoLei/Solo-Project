<%= turbo_frame_tag "scale_item_#{scale_item.id}" do %>
  <div class="flex items-center justify-between py-3 px-4 border-b border-gray-50 hover:bg-[#F5F3EF]/50 transition-colors">
    <div class="flex items-center gap-4">
      <span class="text-xs text-gray-400 w-8 text-center" style="font-family: 'DM Sans', sans-serif;"><%= scale_item.sort_order %></span>
      <div>
        <p class="text-sm font-medium text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;"><%= scale_item.name %></p>
        <div class="flex gap-3 mt-0.5">
          <% if scale_item.category.present? %>
            <span class="text-xs text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;"><%= scale_item.category %></span>
          <% end %>
          <span class="text-xs text-gray-400" style="font-family: 'DM Sans', sans-serif;">权重: <%= scale_item.weight %></span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "编辑", "#", class: "text-xs px-2 py-1 text-[#1B2A4A] hover:bg-[#1B2A4A]/5 rounded transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;", data: { turbo_frame: "scale_item_#{scale_item.id}" } %>
      <%= button_to "删除", assessment_scale_scale_item_path(scale, scale_item), method: :delete, class: "text-xs px-2 py-1 text-[#EF4444] hover:bg-[#EF4444]/10 rounded transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;", form: { data: { turbo_confirm: "确认删除该项目？" } } %>
    </div>
  </div>
<% end %>
