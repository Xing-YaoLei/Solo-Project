{
    "id": "level_001",
    "name": "基础处方审核入门",
    "description": "学习识别常规处方的基本要素，掌握基础审核流程",
    "roles": ["reviewer", "sales"],
    "difficulty": "beginner",
    "timeLimit": 300,
    "passingScore": 60,
    "pharmacistAdvice": [
        {
            "id": "advice_001",
            "condition": "task.prescription.dosage > 100",
            "content": "⚠️ 注意：处方剂量{{prescription.dosage}}mg超过常规用量，请仔细核对",
            "type": "warning",
            "priority": 10
        },
        {
            "id": "advice_002",
            "condition": "task.prescription.isExpired === true",
            "content": "⚠️ 警告：该处方已过期，请拒绝处理",
            "type": "warning",
            "priority": 20
        },
        {
            "id": "advice_003",
            "condition": "task.prescription.hasDoctorSignature === false",
            "content": "💡 提示：处方缺少医生签名",
            "type": "hint",
            "priority": 15
        },
        {
            "id": "advice_004",
            "condition": "task.replenishmentOrder.currentStock < 10",
            "content": "ℹ️ 当前库存{{replenishmentOrder.currentStock}}盒，不足请及时补货",
            "type": "info",
            "priority": 5
        },
        {
            "id": "advice_005",
            "condition": "task.insuranceRecord.isReimbursable === false",
            "content": "ℹ️ 该药品不在医保目录内，需自费购买",
            "type": "info",
            "priority": 8
        }
    ],
