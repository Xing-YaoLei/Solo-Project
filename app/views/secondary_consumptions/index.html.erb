<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">二消记录</h1>
    <div class="flex gap-3">
      <%= link_to "导出数据", desktop_exports_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
    </div>
  </div>

  <div class="bg-white rounded-xl p-4 shadow-sm">
    <%= search_form_for @q do |f| %>
      <div class="flex gap-3 items-end">
        <div>
          <%= f.label :merchant_contract_id_eq, "商户合同", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :merchant_contract_id_eq, MerchantContract.pluck(:merchant_name, :id), include_blank: "全部", class: "px-3 py-2 border border-gray-300 rounded-lg" %>
        </div>
        <div>
          <%= f.label :source_eq, "来源", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :source_eq, SecondaryConsumption.sources.map { |k, v| [k.humanize, k] }, include_blank: "全部", class: "px-3 py-2 border border-gray-300 rounded-lg" %>
        </div>
        <div>
          <%= f.label :consumed_at_gteq, "开始时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_field :consumed_at_gteq, class: "px-3 py-2 border border-gray-300 rounded-lg" %>
        </div>
        <div>
          <%= f.label :consumed_at_lteq, "结束时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_field :consumed_at_lteq, class: "px-3 py-2 border border-gray-300 rounded-lg" %>
        </div>
        <%= f.submit "搜索", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-4 gap-4">
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <div class="text-sm text-gray-500">消费总额</div>
      <div class="mt-1 text-xl font-bold text-gray-900">
        <%= format_money(@q.result.total_amount) %>
      </div>
    </div>
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <div class="text-sm text-gray-500">订单数</div>
      <div class="mt-1 text-xl font-bold text-gray-900"><%= @q.result.count %></div>
    </div>
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <div class="text-sm text-gray-500">消费人数</div>
      <div class="mt-1 text-xl font-bold text-gray-900"><%= @q.result.total_customers %></div>
    </div>
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <div class="text-sm text-gray-500">佣金预估</div>
      <div class="mt-1 text-xl font-bold text-gray-900">
        <%# Simple commission estimate - can be refined %>
        <%= format_money(Money.new((@q.result.sum(:amount_cents) * 0.1).to_i, "CNY")) %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商户</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">消费者</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">消费时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @secondary_consumptions.each do |sc| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              #<%= sc.id %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to sc.merchant_contract&.merchant_name || "-", merchant_contract_path(sc.merchant_contract), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= sc.source&.humanize %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              <%= format_money(sc.amount) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= sc.customer_name || "-" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= sc.consumed_at&.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= link_to "查看", secondary_consumption_path(sc), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @secondary_consumptions.total_pages > 1 %>
    <div class="flex justify-center">
      <%= paginate @secondary_consumptions %>
    </div>
  <% end %>
</div>
