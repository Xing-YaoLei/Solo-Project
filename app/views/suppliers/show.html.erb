<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <div class="flex-shrink-0 h-16 w-16">
        <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-700 flex items-center justify-center text-white font-bold text-2xl shadow-lg">
          <%= @supplier.name[0, 1].upcase %>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900"><%= @supplier.name %></h1>
          <% status_configs = {
            active: { class: "bg-emerald-100 text-emerald-800", text: "正常" },
            inactive: { class: "bg-gray-100 text-gray-800", text: "停用" },
            suspended: { class: "bg-amber-100 text-amber-800", text: "暂停" }
          } %>
          <% config = status_configs[@supplier.status.to_sym] || { class: "bg-gray-100 text-gray-800", text: @supplier.status.text } %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= config[:class] %>">
            <%= config[:text] %>
          </span>
        </div>
        <div class="flex items-center gap-4 mt-1 text-sm text-gray-500">
          <span class="font-mono"><%= @supplier.code %></span>
          <span>创建于 <%= @supplier.created_at.strftime("%Y-%m-%d") %></span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "发起审计", new_audit_path(supplier_id: @supplier.id),
        class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition" do %>
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        发起审计
      <% end %>
      <%= link_to edit_supplier_path(@supplier),
        class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" do %>
        <svg class="-ml-1 mr-2 h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        编辑信息
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-4 gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="text-center">
      <p class="text-sm font-medium text-gray-500">审计总数</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @audit_statistics[:total] %></p>
    </div>
    <div class="text-center">
      <p class="text-sm font-medium text-gray-500">已完成</p>
      <p class="mt-1 text-2xl font-bold text-emerald-600"><%= @audit_statistics[:completed] %></p>
    </div>
    <div class="text-center">
      <p class="text-sm font-medium text-gray-500">进行中</p>
      <p class="mt-1 text-2xl font-bold text-blue-600"><%= @audit_statistics[:in_progress] %></p>
    </div>
    <div class="text-center">
      <p class="text-sm font-medium text-gray-500">开放异常</p>
      <p class="mt-1 text-2xl font-bold text-red-600"><%= @audit_statistics[:exceptions] %></p>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 xl:col-span-3 space-y-6">
      <turbo-frame id="supplier_info">
        <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
          <div class="border-b border-gray-200 px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-900">基础信息</h2>
          </div>
          <div class="divide-y divide-gray-100">
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">供应商名称</dt>
              <dd class="mt-1 text-sm font-medium text-gray-900"><%= @supplier.name %></dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">供应商编码</dt>
              <dd class="mt-1 text-sm font-mono text-gray-900"><%= @supplier.code %></dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">联系人</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @supplier.contact_person.present? %>
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <%= @supplier.contact_person %>
                  </div>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">联系电话</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @supplier.phone.present? %>
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <%= @supplier.phone %>
                  </div>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">电子邮箱</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @supplier.email.present? %>
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <%= mail_to @supplier.email, @supplier.email, class: "text-blue-600 hover:text-blue-700" %>
                  </div>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">创建人</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @supplier.created_by&.name || "系统" %></dd>
            </div>
            <div class="px-6 py-4">
              <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">描述备注</dt>
              <dd class="mt-1 text-sm text-gray-600 whitespace-pre-wrap break-words">
                <%= @supplier.description.presence || "暂无描述" %>
              </dd>
            </div>
          </div>
        </div>
      </turbo-frame>

      <%= render "suppliers/materials_stats", supplier: @supplier %>
    </div>

    <div class="col-span-12 xl:col-span-6 space-y-6">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">材料清单</h2>
            <p class="mt-1 text-sm text-gray-500">悬停行可编辑材料信息</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button"
              data-controller="material-form"
              data-action="material-form#toggle"
              class="inline-flex items-center px-3 py-1.5 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition">
              <svg class="-ml-1 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              添加材料
            </button>
          </div>
        </div>

        <div data-material-form-target="formContainer" class="hidden border-b border-gray-200 px-6 py-4 bg-blue-50">
          <%= form_with model: SupplierMaterial.new, url: supplier_materials_path(@supplier),
            data: { turbo_stream: true },
            class: "grid grid-cols-1 md:grid-cols-5 gap-4 items-end" do |f| %>
            <div class="md:col-span-1">
              <%= f.label :material_type, "材料类型", class: "block text-xs font-medium text-gray-700 mb-1" %>
              <%= f.select :material_type,
                SupplierMaterial.material_type_options,
                {},
                class: "block w-full rounded-lg border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :name, "材料名称", class: "block text-xs font-medium text-gray-700 mb-1" %>
              <%= f.text_field :name,
                class: "block w-full rounded-lg border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500",
                placeholder: "请输入材料名称或编号", required: true %>
            </div>
            <div>
              <%= f.label :status, "状态", class: "block text-xs font-medium text-gray-700 mb-1" %>
              <%= f.select :status,
                SupplierMaterial.status.options.map { |text, value| [text, value] },
                {},
                class: "block w-full rounded-lg border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>
            <div>
              <%= f.label :expire_at, "有效期至", class: "block text-xs font-medium text-gray-700 mb-1" %>
              <%= f.date_field :expire_at,
                class: "block w-full rounded-lg border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>
            <div class="md:col-span-5">
              <%= f.label :remark, "备注", class: "block text-xs font-medium text-gray-700 mb-1" %>
              <%= f.text_field :remark,
                class: "block w-full rounded-lg border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500",
                placeholder: "可选备注信息" %>
            </div>
            <div class="md:col-span-5 flex justify-end gap-2">
              <button type="button" data-action="material-form#toggle"
                class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition">
                取消
              </button>
              <%= f.submit "保存材料",
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" %>
            </div>
          <% end %>
        </div>

        <div class="overflow-x-auto" id="materials_list">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">类型</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">名称</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">有效期至</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">备注</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100" id="materials_list">
              <% if @materials.present? %>
                <%= render @materials %>
              <% else %>
                <tr>
                  <td colspan="6" class="px-4 py-12 text-center text-gray-400">
                    <svg class="mx-auto h-10 w-10 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <p>暂无材料，点击上方「添加材料」开始录入</p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">审计历史</h2>
            <p class="mt-1 text-sm text-gray-500">该供应商的所有审计记录</p>
          </div>
          <%= link_to audit_history_supplier_path(@supplier), class: "text-sm font-medium text-blue-600 hover:text-blue-700" do %>
            查看全部
            <svg class="inline ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          <% end %>
        </div>
        <%= render "suppliers/audit_history_table", audits: @recent_audits %>
      </div>
    </div>

    <div class="col-span-12 xl:col-span-3 space-y-6">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4">
          <h2 class="text-lg font-semibold text-gray-900">权限配置</h2>
          <p class="mt-1 text-sm text-gray-500">供应商系统权限设置</p>
        </div>
        <div class="divide-y divide-gray-100">
          <% if @permission_configs.present? %>
            <% @permission_configs.each do |config| %>
              <div class="px-6 py-4">
                <div class="flex items-center justify-between mb-2">
                  <% permission_labels = {
                    data_access: "数据访问",
                    audit_participation: "审计参与",
                    document_upload: "文档上传",
                    report_view: "报告查看",
                    exception_handling: "异常处理",
                    approval: "审批权限"
                  } %>
                  <span class="text-sm font-medium text-gray-900">
                    <%= permission_labels[config.permission_type.to_sym] || config.permission_type.humanize %>
                  </span>
                  <% if config.status_text == :active %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">
                      已启用
                    </span>
                  <% elsif config.status_text == :expired %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                      已过期
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                      已停用
                    </span>
                  <% end %>
                </div>
                <div class="text-xs text-gray-500 space-y-1">
                  <% if config.departments.present? %>
                    <p>部门范围：<%= config.departments.join("、") %></p>
                  <% end %>
                  <% if config.systems.present? %>
                    <p>系统范围：<%= config.systems.join("、") %></p>
                  <% end %>
                  <% if config.data_range.present? %>
                    <% range_labels = { own: "仅本人数据", department: "本部门数据", all: "全部数据" } %>
                    <p>数据权限：<%= range_labels[config.data_range.to_sym] || config.data_range %></p>
                  <% end %>
                  <% if config.access_scope["expires_at"].present? %>
                    <p>有效期至：<%= Time.parse(config.access_scope["expires_at"]).strftime("%Y-%m-%d") rescue config.access_scope["expires_at"] %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="px-6 py-12 text-center text-gray-400">
              <svg class="mx-auto h-10 w-10 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <p>暂无权限配置</p>
            </div>
          <% end %>
        </div>
        <% if policy(PermissionConfig).create? %>
          <div class="border-t border-gray-200 px-6 py-4">
            <button type="button"
              data-controller="permission-form"
              data-action="permission-form#toggle"
              class="w-full inline-flex items-center justify-center px-3 py-2 border border-dashed border-gray-300 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 hover:border-gray-400 transition">
              <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              添加权限配置
            </button>
          </div>
        <% end %>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-4">
          <h2 class="text-lg font-semibold text-gray-900">审计时间线</h2>
          <p class="mt-1 text-sm text-gray-500">关键审计活动记录</p>
        </div>
        <div class="p-6">
          <% if @recent_audits.present? %>
            <div class="relative">
              <div class="absolute top-0 left-5 bottom-0 w-px bg-gray-200" aria-hidden="true"></div>
              <ul class="space-y-6">
                <% @recent_audits.each_with_index do |audit, idx| %>
                  <% timeline_dot_cls = audit.approved? ? 'bg-emerald-500' : audit.rejected? ? 'bg-red-500' : audit.pending? ? 'bg-amber-500' : 'bg-blue-500' %>
                  <li class="relative pl-12">
                    <div class="absolute left-0 top-1 flex items-center justify-center w-10 h-10 rounded-full ring-4 ring-white <%= timeline_dot_cls %>">
                      <% if audit.approved? %>
                        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      <% elsif audit.rejected? %>
                        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      <% else %>
                        <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      <% end %>
                    </div>
                    <div class="pt-1">
                      <div class="flex items-center gap-2 mb-1">
                        <%= link_to audit_path(audit), class: "text-sm font-medium text-gray-900 hover:text-blue-600" do %>
                          <%= audit.title %>
                        <% end %>
                        <% status_badges = {
                          draft: "bg-gray-100 text-gray-700",
                          pending_materials: "bg-orange-100 text-orange-700",
                          in_progress: "bg-blue-100 text-blue-700",
                          pending_evidence: "bg-yellow-100 text-yellow-700",
                          pending_checklist: "bg-yellow-100 text-yellow-700",
                          pending_notification: "bg-yellow-100 text-yellow-700",
                          pending_approval: "bg-purple-100 text-purple-700",
                          approved: "bg-emerald-100 text-emerald-700",
                          rejected: "bg-red-100 text-red-700",
                          archived: "bg-gray-100 text-gray-500"
                        } %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_badges[audit.status.to_sym] || 'bg-gray-100 text-gray-700' %>">
                          <%= audit.status.text %>
                        </span>
                      </div>
                      <p class="text-xs text-gray-500 mb-2">
                        由 <%= audit.creator&.name || "系统" %> 创建
                        · <%= audit.created_at.strftime("%Y-%m-%d %H:%M") %>
                      </p>
                      <% if audit.conclusion.present? %>
                        <p class="text-xs text-gray-600 bg-gray-50 rounded-md p-2">
                          <%= truncate(audit.conclusion, length: 120) %>
                        </p>
                      <% end %>
                      <% ex_count = audit.exception_orders.count %>
                      <% if ex_count > 0 %>
                        <div class="mt-2 flex items-center gap-2">
                          <% open_ex = audit.pending_exceptions_count %>
                          <span class="text-xs text-gray-500">
                            <svg class="inline h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <%= ex_count %> 项异常
                          </span>
                          <% if open_ex > 0 %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">
                              <%= open_ex %> 待处理
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
