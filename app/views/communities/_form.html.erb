<div class="page-header">
  <%= link_to "← 返回列表", communities_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title"><%= @community.new_record? ? "新增社群" : "编辑社群" %></h1>
</div>

<div class="table-container p-6">
  <%= form_with(model: @community, local: true) do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="form-group">
        <%= f.label :name, "社群名称", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :course_name, "课程名称", class: "form-label" %>
        <%= f.text_field :course_name, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :manager_id, "班主任/负责人", class: "form-label" %>
        <%= f.collection_select :manager_id, @users, :id, :name, include_blank: "未指定", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :status, "状态", class: "form-label" %>
        <%= f.select :status, options_for_select(Community::STATUSES.map { |s| [I18n.t("status.#{s}", default: s), s] }, @community.status), {}, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :start_date, "开课日期", class: "form-label" %>
        <%= f.date_field :start_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :end_date, "结业日期", class: "form-label" %>
        <%= f.date_field :end_date, class: "form-input" %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :description, "社群描述", class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 3 %>
      </div>
    </div>

    <div class="mt-8 flex space-x-3">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "取消", communities_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
