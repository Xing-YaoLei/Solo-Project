<div class="space-y-6">
  <div class="flex items-center">
    <%= link_to performance_performance_seats_path(@performance), class: "mr-3 text-gray-500 hover:text-gray-700" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">新增演出座位</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm">
    <%= form_with model: [@performance, @performance_seat], local: true do |form| %>
      <div class="p-6 space-y-4">
        <div class="grid grid-cols-3 gap-4">
          <div>
            <%= form.label :section, "区域", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :section, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true %>
          </div>
          <div>
            <%= form.label :row_number, "排号", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :row_number, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true %>
          </div>
          <div>
            <%= form.label :seat_number, "座位号", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :seat_number, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :price_cents, "价格(元)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :price_cents, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", min: 0 %>
          </div>
          <div>
            <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :status, PerformanceSeat.statuses.map { |k, v| [status_text(k), k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
        </div>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <%= link_to "取消", performance_performance_seats_path(@performance), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= form.submit "保存", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
