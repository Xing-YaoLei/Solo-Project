// This is your Prisma schema file,
// Learn more about Prisma in the docs:
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROPERTY_MANAGER
  MAINTENANCE_WORKER
  FINANCE
  FRONTLINE
  TENANT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  REASSIGNED
  OVERDUE
}

enum TaskType {
  PROPERTY_LISTING
  RENT_OVERDUE
  MAINTENANCE
  CONTRACT_REVIEW
  UTILITY_READING
}

enum PropertyStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  LISTING
  DELISTED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING_RENEWAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  avatar        String?
  role          UserRole @default(TENANT)
  department    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedTasks    Task[] @relation("AssignedTasks")
  createdTasks     Task[] @relation("CreatedTasks")
  createdProperties Property[] @relation("PropertyCreator")
  managedProperties Property[] @relation("PropertyManager")
  tenants          Tenant[]
  maintenanceWorkOrders MaintenanceWorkOrder[] @relation("MaintenanceWorker")
  createdMaintenanceWorkOrders MaintenanceWorkOrder[] @relation("MaintenanceCreator")
  utilityReadings  UtilityReading[]
  financeRecords   FinanceRecord[]
}

model Property {
  id             String   @id @default(cuid())
  propertyNo     String   @unique
  title          String
  address        String
  city           String
  district       String
  building       String?
  roomNo         String?
  area           Float?
  bedrooms       Int?
  bathrooms      Int?
  floor          Int?
  totalFloors    Int?
  orientation    String?
  decoration     String?
  monthlyRent    Decimal?
  deposit        Decimal?
  status         PropertyStatus @default(VACANT)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creatorId      String
  managerId      String?
  creator        User     @relation("PropertyCreator", fields: [creatorId], references: [id])
  manager        User?    @relation("PropertyManager", fields: [managerId], references: [id])

  photos         PropertyPhoto[]
  tenants        Tenant[]
  contracts      Contract[]
  maintenanceRecords MaintenanceRecord[]
  utilityRecords UtilityReading[]
  tasks          Task[]
  filters        PropertyFilter[]
}

model PropertyPhoto {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  thumbnail   String?
  title       String?
  description String?
  sortOrder   Int      @default(0)
  isCover     Boolean  @default(false)
  category    String?
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  idCardNo    String?
  phone       String
  email       String?
  avatar      String?
  gender      String?
  birthday    DateTime?
  occupation  String?
  company     String?
  emergencyContact String?
  emergencyPhone   String?
  idCardFront String?
  idCardBack  String?
  workCertificate String?
  otherDocuments String?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])

  contracts   Contract[]
  tasks       Task[]
  financeRecords FinanceRecord[]

  @@index([phone])
  @@index([propertyId])
}

model Contract {
  id          String   @id @default(cuid())
  contractNo  String   @unique
  version     Int      @default(1)
  versionNote String?
  status      ContractStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime
  monthlyRent Decimal
  deposit     Decimal
  paymentCycle String  @default("MONTHLY")
  paymentDay  Int     @default(1)
  terms       Json?
  signedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId  String
  tenantId    String
  createdById String
  property    Property @relation(fields: [propertyId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])

  tasks       Task[]
  financeRecords FinanceRecord[]
  amendments  ContractAmendment[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
}

model ContractAmendment {
  id         String   @id @default(cuid())
  contractId String
  version    Int
  changeType String
  content    Json?
  reason     String?
  createdAt  DateTime @default(now())
  createdById String

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy  User     @relation(fields: [createdById], references: [id])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  propertyId  String
  type        String
  description String
  cost        Decimal?
  reportedAt  DateTime @default(now())
  completedAt DateTime?
  status      MaintenanceStatus @default(OPEN)
  photos      Json?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id])
  workOrders  MaintenanceWorkOrder[]

  @@index([propertyId])
  @@index([status])
}

model MaintenanceWorkOrder {
  id         String   @id @default(cuid())
  recordId   String
  workerId   String?
  creatorId  String
  priority   Priority @default(MEDIUM)
  status     MaintenanceStatus @default(OPEN)
  scheduledAt DateTime?
  completedAt DateTime?
  description String
  solution   String?
  cost       Decimal?
  photos     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  record     MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  worker     User?    @relation("MaintenanceWorker", fields: [workerId], references: [id])
  creator    User     @relation("MaintenanceCreator", fields: [creatorId], references: [id])
  task       Task?

  @@index([workerId])
  @@index([status])
}

model UtilityReading {
  id          String   @id @default(cuid())
  propertyId  String
  type        String   // WATER, ELECTRIC, GAS
  reading     Decimal
  previousReading Decimal?
  usage       Decimal?
  readingDate DateTime
  imageUrl    String?
  remarks     String?
  createdAt   DateTime @default(now())
  recordedById String

  property    Property @relation(fields: [propertyId], references: [id])
  recordedBy  User     @relation(fields: [recordedById], references: [id])

  @@index([propertyId])
  @@index([type, readingDate])
}

model Task {
  id            String   @id @default(cuid())
  taskNo        String   @unique
  type          TaskType
  title         String
  description   String?
  status        TaskStatus @default(PENDING)
  priority      Priority @default(MEDIUM)
  dueDate       DateTime?
  completedAt   DateTime?
  rejectReason  String?
  materials     Json?
  formData      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  propertyId    String?
  assigneeId    String?
  creatorId     String
  tenantId      String?
  contractId    String?
  parentTaskId  String?

  property      Property? @relation(fields: [propertyId], references: [id])
  assignee      User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creator       User      @relation("CreatedTasks", fields: [creatorId], references: [id])
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  contract      Contract? @relation(fields: [contractId], references: [id])
  parentTask    Task?     @relation("ParentTask", fields: [parentTaskId], references: [id])
  childTasks    Task[]    @relation("ParentTask")
  comments      TaskComment[]
  auditLogs     TaskAuditLog[]

  @@index([status])
  @@index([type])
  @@index([assigneeId])
  @@index([propertyId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  attachments Json?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model TaskAuditLog {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  action    String
  fromStatus String?
  toStatus   String?
  remark    String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model FinanceRecord {
  id          String   @id @default(cuid())
  recordNo    String   @unique
  type        String   // RENT, DEPOSIT, MAINTENANCE_FEE, UTILITY_FEE, OTHER
  amount      Decimal
  direction   String   // INCOME, EXPENSE
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  dueDate     DateTime?
  paidAt      DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId  String?
  tenantId    String?
  contractId  String?
  createdById String
  property    Property? @relation(fields: [propertyId], references: [id])
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([type, status])
  @@index([dueDate])
  @@index([tenantId])
}

model PropertyFilter {
  id        String   @id @default(cuid())
  name      String
  filters   Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  createdById String

  property  Property? @relation(fields: [propertyId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  propertyId String?

  @@index([createdById])
}

model ReportSnapshot {
  id         String   @id @default(cuid())
  reportType String   // OCCUPANCY, REVENUE, MAINTENANCE, TASK
  periodType String   // DAILY, WEEKLY, MONTHLY, YEARLY
  periodStart DateTime
  periodEnd   DateTime
  data       Json
  createdAt  DateTime @default(now())
  createdById String
  createdBy  User     @relation(fields: [createdById], references: [id])

  @@index([reportType, periodType, periodStart])
}
