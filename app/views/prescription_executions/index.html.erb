<div class="px-6 py-8" style="background-color: #F5F3EF; min-height: 100vh;">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-bold" style="color: #1B2A4A;">训练处方执行</h1>

      <div class="flex items-center gap-3">
        <%= form_with url: prescription_executions_path, method: :get, data: { turbo_frame: "prescriptions" }, class: "flex items-center gap-3" do |f| %>
          <select name="status" class="px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white" onchange="this.form.requestSubmit()">
            <option value="">全部状态</option>
            <option value="pending" <%= 'selected' if params[:status] == 'pending' %>>待执行</option>
            <option value="active" <%= 'selected' if params[:status] == 'active' %>>执行中</option>
            <option value="completed" <%= 'selected' if params[:status] == 'completed' %>>已完成</option>
            <option value="cancelled" <%= 'selected' if params[:status] == 'cancelled' %>>已取消</option>
          </select>

          <select name="therapist_id" class="px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white" onchange="this.form.requestSubmit()">
            <option value="">全部治疗师</option>
            <% @therapists.each do |t| %>
              <option value="<%= t.id %>" <%= 'selected' if params[:therapist_id] == t.id.to_s %>><%= t.name %></option>
            <% end %>
          </select>
        <% end %>
      </div>
    </div>

    <%= turbo_frame_tag "prescriptions" do %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @prescriptions.each do |prescription| %>
          <% completion_rate = PrescriptionEngine.calculate_completion_rate(prescription) %>
          <div class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow">
            <div class="p-5">
              <div class="flex items-center justify-between mb-3">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium
                  <%= case prescription.status
                      when 'active' then 'bg-emerald-100 text-emerald-700'
                      when 'pending' then 'bg-amber-100 text-amber-700'
                      when 'completed' then 'bg-blue-100 text-blue-700'
                      else 'bg-gray-100 text-gray-500'
                      end %>">
                  <%= t("prescription_executions.status.#{prescription.status}") %>
                </span>
                <span class="text-xs text-gray-400"><%= prescription.start_date %> ~ <%= prescription.end_date %></span>
              </div>

              <h3 class="font-semibold mb-1" style="color: #1B2A4A;">
                <%= prescription.assessment_record&.patient&.name || "未指定患者" %>
              </h3>
              <p class="text-sm text-gray-500 mb-4">治疗师: <%= prescription.therapist&.name || "未指定" %></p>

              <div class="mb-3">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="text-gray-500">完成进度</span>
                  <span class="font-semibold" style="color: #2DD4A8;"><%= completion_rate.round(0) %>%</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2">
                  <div class="h-2 rounded-full" style="width: <%= completion_rate %>%; background: linear-gradient(90deg, #2DD4A8, #1B2A4A);"></div>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs text-gray-400">
                <span><%= prescription.training_sessions.completed.count %> / <%= prescription.training_sessions.count %> 次训练</span>
                <%= link_to "查看详情", prescription_execution_path(prescription), class: "font-medium hover:underline", style: "color: #2DD4A8;" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @prescriptions.empty? %>
        <div class="text-center py-12 text-gray-400">
          <p>暂无训练处方记录</p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
