<div class="bg-white rounded-xl shadow-sm">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-lg font-semibold text-gray-900">新增处理记录</h2>
  </div>
  <%= form_with model: [parent, @processing_record], local: true, html: { multipart: true } do |form| %>
    <div class="p-6 space-y-4">
      <div>
        <%= form.label :action_type, "处理类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :action_type, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true %>
      </div>

      <div>
        <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, ProcessingRecord.statuses.map { |k, v| [status_text(k), k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :notes, "备注说明", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :notes, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :attachments, "附件上传", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.file_field :attachments, multiple: true, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="mt-1 text-xs text-gray-500">支持多文件上传</p>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
      <%= link_to "取消", parent, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
      <%= form.submit "提交", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
