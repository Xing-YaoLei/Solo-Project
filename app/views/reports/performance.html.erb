<% content_for :title, "绩效统计" %>

<div class="space-y-6">
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <h3 class="text-lg leading-6 font-medium text-gray-900">处理人绩效统计</h3>
        <div class="mt-3 sm:mt-0 flex gap-3 items-center">
          <%= form_tag performance_reports_path, method: :get, class: 'flex gap-3 items-center' do %>
            <%= date_field_tag :start_date, @start_date, class: "px-3 py-1 border border-gray-300 rounded-md text-sm" %>
            <span>至</span>
            <%= date_field_tag :end_date, @end_date, class: "px-3 py-1 border border-gray-300 rounded-md text-sm" %>
            <%= submit_tag "查询", class: "px-3 py-1 bg-indigo-600 text-white rounded-md text-sm" %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @operator_performance.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">处理人</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">处理总数</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">准时完成</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">延迟</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">准时率</th>
              <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @operator_performance.each do |name, stats| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= name %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900 text-center"><%= stats[:total] %></td>
                <td class="px-6 py-4 text-sm text-green-600 text-center font-medium"><%= stats[:on_time] %></td>
                <td class="px-6 py-4 text-sm text-yellow-600 text-center font-medium"><%= stats[:total] - stats[:on_time] %></td>
                <td class="px-6 py-4 text-sm text-center">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= stats[:rate] >= 90 ? 'bg-green-100 text-green-800' : stats[:rate] >= 70 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                    <%= stats[:rate] %>%
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-center">
                  <%= link_to "查看单据", pickup_orders_path(q: { operator_id_eq: User.find_by(name: name)&.id, created_at_gteq: @start_date, created_at_lteq: @end_date }), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-500">
        <p>所选时间范围内无处理人绩效数据</p>
      </div>
    <% end %>
  </div>

  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">来源分布</h3>
    </div>
    <div class="px-4 py-5 sm:p-6">
      <% if @source_performance.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <% @source_performance.each do |source, count| %>
            <% next if source == 'all' %>
            <%= link_to pickup_orders_path(q: { source_eq: source, created_at_gteq: @start_date, created_at_lteq: @end_date }), class: "block bg-blue-50 p-4 rounded-lg border border-blue-100 text-center hover:bg-blue-100 transition-colors" do %>
              <div class="text-sm font-medium text-blue-600"><%= source %></div>
              <div class="mt-1 text-2xl font-bold text-blue-900"><%= count %></div>
              <div class="text-xs text-blue-500 mt-1"><%= percentage(count, @aggregated[:total_orders]) %></div>
              <div class="text-xs text-blue-400 mt-2">点击查看单据 →</div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <p>所选时间范围内无来源数据</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
