<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">新建审计项目</h1>
      <p class="mt-1 text-sm text-slate-500">填写基本信息，创建审计项目后可继续上传证据和填写检查清单</p>
    </div>
    <%= link_to audits_path, class: "inline-flex items-center px-3 py-2 rounded text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      返回列表
    <% end %>
  </div>

  <%= form_with model: @audit, class: "bg-white rounded-lg border border-slate-200 p-6 space-y-6" do |f| %>
    <% if @audit.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h4 class="text-sm font-semibold text-red-800 mb-2">存在以下错误：</h4>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
          <% @audit.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= f.label :title, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          审计标题 <span class="text-red-500">*</span>
        <% end %>
        <%= f.text_field :title, required: true, maxlength: 200, class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm", placeholder: "例如：XX供应商2024年度合规审计" %>
        <p class="mt-1 text-xs text-slate-400"><%= @audit.title&.length || 0 %>/200</p>
      </div>

      <div>
        <%= f.label :supplier_id, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          供应商 <span class="text-red-500">*</span>
        <% end %>
        <%= f.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "请选择供应商" }, { class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" } %>
      </div>

      <div>
        <%= f.label :audit_type, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          审计类型 <span class="text-red-500">*</span>
        <% end %>
        <%= f.select :audit_type, Audit.audit_type_options, { include_blank: "请选择类型" }, { class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" } %>
      </div>

      <div>
        <%= f.label :start_at, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          开始日期
        <% end %>
        <%= f.date_field :start_at, class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
      </div>

      <div>
        <%= f.label :end_at, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          结束日期
        <% end %>
        <%= f.date_field :end_at, class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
      </div>

      <div class="md:col-span-2">
        <%= f.label :template_id, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          通报模板
        <% end %>
        <%= f.collection_select :template_id, @templates, :id, :name, { include_blank: "暂不选择（后续可在审计详情中配置）" }, { class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" } %>
        <p class="mt-1 text-xs text-slate-400">通报模板用于在「待通报」阶段自动生成供应商通报内容</p>
      </div>

      <div class="md:col-span-2">
        <%= f.label :conclusion, class: "block text-sm font-medium text-slate-700 mb-1" do %>
          审计结论
        <% end %>
        <%= f.text_area :conclusion, rows: 4, class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm", placeholder: "可选：填写审计结论，通常在审批阶段填写" %>
      </div>
    </div>

    <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
      <%= link_to "取消", audits_path, class: "px-4 py-2 rounded text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors" %>
      <%= f.submit "创建审计项目", class: "px-5 py-2 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
    </div>
  <% end %>
</div>
