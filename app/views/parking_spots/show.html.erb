<div class="page-header">
  <h1>车位详情</h1>
  <%= link_to "返回列表", parking_spots_path, class: "btn btn-sm" %>
  <%= link_to "编辑", edit_parking_spot_path(@parking_spot), class: "btn btn-sm btn-primary" %>
</div>

<div class="detail-card">
  <div class="detail-row">
    <span class="detail-label">车位号</span>
    <span class="detail-value"><%= @parking_spot.spot_number %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">区域</span>
    <span class="detail-value"><%= @parking_spot.zone %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">类型</span>
    <span class="detail-value">
      <span class="badge badge-<%= @parking_spot.spot_type %>">
        <%= t("parking_spot.spot_type.#{@parking_spot.spot_type}", default: @parking_spot.spot_type) %>
      </span>
    </span>
  </div>
  <div class="detail-row">
    <span class="detail-label">占用状态</span>
    <span class="detail-value">
      <span class="badge badge-<%= @parking_spot.occupied? ? 'occupied' : 'available' %>">
        <%= @parking_spot.occupied? ? "已占用" : "空闲" %>
      </span>
    </span>
  </div>
  <div class="detail-row">
    <span class="detail-label">楼层</span>
    <span class="detail-value"><%= @parking_spot.floor.presence || "-" %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">月费率</span>
    <span class="detail-value">¥<%= @parking_spot.monthly_rate %></span>
  </div>
</div>

<section class="panel">
  <div class="panel-header">
    <h2>近期账单</h2>
    <%= link_to "查看全部", parking_bills_path(parking_spot_id: @parking_spot.id), class: "panel-link" %>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>账单号</th>
        <th>车牌号</th>
        <th>类型</th>
        <th>金额</th>
        <th>状态</th>
      </tr>
    </thead>
    <tbody>
      <% @bills.each do |bill| %>
        <tr>
          <td><%= link_to bill.bill_number, parking_bill_path(bill) %></td>
          <td><%= bill.plate_number %></td>
          <td><%= t("parking_bill.bill_type.#{bill.bill_type}", default: bill.bill_type) %></td>
          <td>¥<%= bill.amount %></td>
          <td><span class="badge badge-<%= bill.status %>"><%= t("parking_bill.status.#{bill.status}", default: bill.status) %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>出入记录</h2>
  </div>
  <table class="data-table">
    <thead>
      <tr>
        <th>车牌号</th>
        <th>方向</th>
        <th>时间</th>
        <th>闸口</th>
      </tr>
    </thead>
    <tbody>
      <% @access_records.each do |record| %>
        <tr>
          <td><%= record.plate_number %></td>
          <td><span class="badge badge-<%= record.direction %>"><%= record.direction == "in" ? "入场" : "离场" %></span></td>
          <td><%= record.accessed_at&.strftime('%Y-%m-%d %H:%M') %></td>
          <td><%= record.gate_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
