<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">全局搜索</h1>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm">
    <%= form_with url: search_path, method: :get, local: true do |f| %>
      <div class="flex gap-3">
        <%= text_field_tag :q, @query, placeholder: "搜索点位、演出、商户、处理记录...", class: "flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <button type="submit" class="px-6 py-3 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700">
          搜索
        </button>
      </div>
    <% end %>
  </div>

  <% if @query.present? %>
    <div class="space-y-6">
      <% if @heat_points.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">热力点位 (<%= @heat_points.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @heat_points.each do |hp| %>
              <%= link_to heat_point_path(hp), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= hp.name %></div>
                <div class="text-sm text-gray-500"><%= hp.zone %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @guide_contents.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">导览内容 (<%= @guide_contents.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @guide_contents.each do |gc| %>
              <%= link_to guide_content_path(gc), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= gc.title %></div>
                <div class="text-sm text-gray-500"><%= truncate(gc.content, length: 80) %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @performances.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">演出 (<%= @performances.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @performances.each do |perf| %>
              <%= link_to performance_path(perf), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= perf.name %></div>
                <div class="text-sm text-gray-500"><%= perf.venue %> · <%= perf.start_time&.strftime("%m-%d %H:%M") %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @merchant_contracts.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">商户合同 (<%= @merchant_contracts.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @merchant_contracts.each do |mc| %>
              <%= link_to merchant_contract_path(mc), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= mc.merchant_name %></div>
                <div class="text-sm text-gray-500"><%= mc.contract_number %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @processing_records.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">处理记录 (<%= @processing_records.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @processing_records.each do |pr| %>
              <%= link_to processing_record_path(pr), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= pr.action_type %></div>
                <div class="text-sm text-gray-500"><%= pr.handler&.name %> · <%= pr.created_at&.strftime("%m-%d %H:%M") %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @todos.present? %>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="font-semibold text-gray-900">待办事项 (<%= @todos.size %>)</h3>
          </div>
          <div class="divide-y divide-gray-200">
            <% @todos.each do |todo| %>
              <%= link_to todo_path(todo), class: "px-6 py-4 hover:bg-gray-50 block" do %>
                <div class="font-medium text-gray-900"><%= todo.title %></div>
                <div class="text-sm text-gray-500"><%= todo.status_text %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if !@heat_points.present? && !@guide_contents.present? && !@performances.present? && !@merchant_contracts.present? && !@processing_records.present? && !@todos.present? %>
        <div class="bg-white rounded-xl p-12 text-center shadow-sm">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">未找到相关结果</h3>
          <p class="mt-1 text-sm text-gray-500">请尝试其他关键词</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
