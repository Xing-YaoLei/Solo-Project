<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "社区团购自提核销结算台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="社区团购核销台">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag :application, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <% if logged_in? %>
      <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <div class="flex-shrink-0 flex items-center">
                <span class="text-xl font-bold text-indigo-600">社区团购核销台</span>
              </div>
              <div class="hidden md:ml-10 md:flex md:space-x-8">
                <%= link_to "核销台", console_path, class: "inline-flex items-center px-1 pt-1 border-b-2 #{current_page?(console_path) ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} text-sm font-medium" %>
                <%= link_to "单据列表", pickup_orders_path, class: "inline-flex items-center px-1 pt-1 border-b-2 #{current_page?(pickup_orders_path) ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} text-sm font-medium" %>
                <%= link_to "已关闭", closed_pickup_orders_path, class: "inline-flex items-center px-1 pt-1 border-b-2 #{current_page?(closed_pickup_orders_path) ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} text-sm font-medium" %>
                <%= link_to "数据报表", daily_summary_reports_path, class: "inline-flex items-center px-1 pt-1 border-b-2 #{params[:controller] == 'reports' ? 'border-indigo-500 text-gray-900' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'} text-sm font-medium" %>
                <%= link_to "新建单据", new_pickup_order_path, class: "inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
              </div>
            </div>
            <div class="flex items-center">
              <%= form_tag search_pickup_orders_path, method: :get, class: "mr-4" do %>
                <div class="flex">
                  <%= text_field_tag :pickup_code, nil, placeholder: "输入自提码", class: "px-3 py-1 border border-gray-300 rounded-l-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
                  <%= submit_tag "查询", class: "px-3 py-1 bg-indigo-600 text-white rounded-r-md text-sm hover:bg-indigo-700" %>
                </div>
              <% end %>
              <div class="ml-3 relative">
                <div class="flex items-center space-x-3">
                  <span class="text-sm text-gray-700"><%= current_user.display_name %></span>
                  <%= link_to "退出", logout_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-700" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="<%= 'py-6' if logged_in? %>">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <% if notice %>
          <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-md">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-green-800"><%= notice %></p>
              </div>
            </div>
          </div>
        <% end %>
        <% if alert %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-md">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-red-800"><%= alert %></p>
              </div>
            </div>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
