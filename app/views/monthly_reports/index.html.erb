<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-6">月度复盘报告</h1>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <%= form_tag monthly_reports_path, method: :get, id: "filter-form" do %>
        <div class="flex flex-wrap items-end gap-4">
          <div>
            <%= label_tag :month, "选择月份", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= month_field_tag :month, (@selected_month.strftime("%Y-%m") if @selected_month), class: "border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <div>
            <%= label_tag :property_id, "房源筛选", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag :property_id,
                options_from_collection_for_select(Property.all, :id, :name, params[:property_id]),
                include_blank: "全部房源",
                class: "border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <div class="flex gap-2">
            <%= submit_tag "筛选", class: "bg-gray-500 hover:bg-gray-600 text-white font-medium py-2 px-4 rounded-md transition-colors" %>
            <%= link_to "重置", monthly_reports_path, class: "bg-white hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-md border border-gray-300 transition-colors" %>
          </div>

          <div class="flex gap-2 ml-auto">
            <%= button_to "生成/更新本月报告", generate_monthly_reports_path(month: @selected_month&.strftime("%Y-%m") || Date.current.strftime("%Y-%m")), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors" %>
            <%= link_to "下载报告",
                download_monthly_reports_path(
                  month: @selected_month&.strftime("%Y-%m") || Date.current.strftime("%Y-%m"),
                  property_id: params[:property_id]
                ),
                class: "bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-md transition-colors" %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @available_months.present? %>
      <div class="bg-white rounded-lg shadow p-4 mb-6">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-sm font-medium text-gray-600">已有报告月份：</span>
          <% @available_months.each do |month| %>
            <% active = @selected_month && @selected_month.beginning_of_month == month %>
            <%= link_to month.strftime("%Y年%m月"), monthly_reports_path(month: month.strftime("%Y-%m")),
              class: "px-3 py-1 rounded-full text-sm font-medium #{active ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'} transition-colors" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @monthly_reports.empty? %>
      <div class="bg-white rounded-lg shadow p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">暂无月度报告数据</h3>
        <p class="mt-2 text-gray-500">点击"生成/更新本月报告"按钮来创建月度复盘报告</p>
        <div class="mt-6">
          <%= button_to "生成本月报告", generate_monthly_reports_path(month: Date.current.strftime("%Y-%m")), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition-colors" %>
        </div>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">月份</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">房源</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">入住率</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">总房间数</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">已入住房间数</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">总收入</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @monthly_reports.each do |report| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= link_to report.month_display, monthly_report_path(report), class: "text-blue-600 hover:text-blue-800" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                  <%= report.property&.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="w-32 bg-gray-200 rounded-full h-3 overflow-hidden">
                      <% rate = report.occupancy_rate.to_f %>
                      <% bar_color = if rate >= 80 then "bg-green-500"
                                     elsif rate >= 60 then "bg-blue-500"
                                     elsif rate >= 40 then "bg-yellow-500"
                                     else "bg-red-500" end %>
                      <div class="<%= bar_color %> h-3 rounded-full transition-all duration-500" style="width: <%= rate %>%"></div>
                    </div>
                    <span class="text-sm font-semibold <%= rate >= 80 ? 'text-green-600' : rate >= 60 ? 'text-blue-600' : rate >= 40 ? 'text-yellow-600' : 'text-red-600' %>">
                      <%= report.occupancy_rate_display %>
                    </span>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                  <%= report.total_rooms %> 间
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                  <%= report.occupied_rooms %> 间
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                  ¥<%= number_with_delimiter(report.total_revenue.to_f.round(2)) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "查看详情", monthly_report_path(report), class: "text-blue-600 hover:text-blue-800 mr-3" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
