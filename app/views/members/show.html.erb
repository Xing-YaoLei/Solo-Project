<div class="card">
  <div class="card-header">
    <h2>会员详情: <%= @member.name %></h2>
    <div class="btn-group">
      <%= link_to "编辑", edit_member_path(@member), class: "btn btn-outline btn-sm" %>
      <%= link_to "列表", members_path, class: "btn btn-outline btn-sm" %>
    </div>
  </div>
  <div class="card-body">
    <div class="form-row">
      <div class="form-group"><label>会员号</label><div style="font-weight: 500;"><%= @member.member_no %></div></div>
      <div class="form-group"><label>姓名</label><div style="font-weight: 500;"><%= @member.name %></div></div>
      <div class="form-group"><label>电话</label><div style="font-weight: 500;"><%= @member.phone %></div></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>来源渠道</label><div><span class="badge badge-blue"><%= @member.source_channel %></span></div></div>
      <div class="form-group" style="grid-column: span 2;"><label>备注</label><div style="font-weight: 500;"><%= @member.notes %></div></div>
    </div>
  </div>
</div>
