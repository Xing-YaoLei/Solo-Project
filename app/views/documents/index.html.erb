<% provide :title, '文书管理' %>

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">文书管理</h1>
    <p class="text-gray-600 mt-1">管理所有法律文书的归档流程</p>
  </div>
  <%= link_to '新建文书', new_document_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
  <div class="p-4 border-b border-gray-200">
    <%= search_form_for @q, url: documents_path, method: :get, html: { class: "flex gap-4 flex-wrap" } do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :title_cont, '标题', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :title_cont, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="w-40">
        <%= f.label :status_eq, '状态', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, [['全部', '']] + Document.aasm.states.map { |s| [Document.new(status: s.name).status_name, s.name.to_s] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="w-40">
        <%= f.label :doc_type_eq, '类型', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :doc_type_eq, [['全部', '']] + Document::DOC_TYPES.map { |k, v| [v, k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex items-end">
        <%= f.submit '搜索', class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">标题</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">类型</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @documents.each do |doc| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to doc.title, document_path(doc), class: "font-medium text-blue-600 hover:text-blue-800" %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= doc.doc_type_name %></td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs rounded-full
              <%= case doc.status
                  when 'draft' then 'bg-gray-100 text-gray-700'
                  when 'pending_review', 'reviewing' then 'bg-yellow-100 text-yellow-700'
                  when 'approved' then 'bg-green-100 text-green-700'
                  when 'rejected' then 'bg-red-100 text-red-700'
                  when 'scheduled' then 'bg-blue-100 text-blue-700'
                  when 'published' then 'bg-green-100 text-green-700'
                  when 'archived' then 'bg-blue-100 text-blue-700'
                  end %>">
              <%= doc.status_name %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= doc.creator&.name %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= doc.created_at.strftime('%Y-%m-%d %H:%M') %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to '查看', document_path(doc), class: "text-blue-600 hover:text-blue-800" %>
          </td>
        </tr>
      <% end %>
      <% if @documents.empty? %>
        <tr>
          <td colspan="6" class="px-6 py-12 text-center text-gray-500">暂无文书数据</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy %>
  <div class="mt-4 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
