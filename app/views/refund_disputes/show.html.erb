<div class="page-header">
  <h1>退票争议详情</h1>
  <div class="page-actions">
    <%= link_to "返回列表", event_refund_disputes_path(@event), class: "btn" %>
  </div>
</div>

<div class="card">
  <h3>争议信息</h3>
  <div class="detail-grid">
    <div class="detail-item">
      <label>订单号</label>
      <span><%= link_to @refund_dispute.ticket_order.order_no, event_ticket_order_path(@event, @refund_dispute.ticket_order) %></span>
    </div>
    <div class="detail-item">
      <label>状态</label>
      <span class="badge badge-<%= @refund_dispute.status %>"><%= @refund_dispute.status %></span>
    </div>
    <div class="detail-item">
      <label>报告人</label>
      <span><%= @refund_dispute.reporter_name %></span>
    </div>
    <div class="detail-item">
      <label>报告人电话</label>
      <span><%= @refund_dispute.reporter_phone %></span>
    </div>
    <div class="detail-item full-width">
      <label>退票原因</label>
      <span><%= @refund_dispute.reason %></span>
    </div>
    <div class="detail-item">
      <label>处理人</label>
      <span><%= @refund_dispute.handler.email %></span>
    </div>
    <div class="detail-item">
      <label>创建时间</label>
      <span><%= @refund_dispute.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
    </div>
    <% if @refund_dispute.closed_at %>
      <div class="detail-item">
        <label>关闭时间</label>
        <span><%= @refund_dispute.closed_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
      </div>
    <% end %>
    <% if @refund_dispute.handler_action %>
      <div class="detail-item">
        <label>处理动作</label>
        <span><%= @refund_dispute.handler_action %></span>
      </div>
    <% end %>
    <% if @refund_dispute.handler_remark %>
      <div class="detail-item full-width">
        <label>处理备注</label>
        <span><%= @refund_dispute.handler_remark %></span>
      </div>
    <% end %>
  </div>
</div>

<% if @refund_dispute.status == "pending" && current_user.can_handle_dispute? %>
  <div class="card">
    <h3>开始处理</h3>
    <%= button_to "开始处理", process_event_refund_dispute_path(@event, @refund_dispute), method: :patch, class: "btn btn-primary" %>
  </div>
<% end %>

<% if @refund_dispute.status == "processing" && current_user.can_handle_dispute? %>
  <div class="card">
    <h3>处理争议</h3>
    <div class="form-row">
      <div class="form-group">
        <%= form_with model: @refund_dispute, url: resolve_event_refund_dispute_path(@event, @refund_dispute), local: true do |f| %>
          <h4>解决争议</h4>
          <div class="form-group">
            <%= f.label :handler_action, "处理动作" %>
            <%= f.select :handler_action, [["退款", "refund"], ["换票", "exchange"], ["其他", "other"]] %>
          </div>
          <div class="form-group">
            <%= f.label :handler_remark, "处理备注" %>
            <%= f.text_area :handler_remark, rows: 3, required: true %>
          </div>
          <%= f.submit "确认解决", class: "btn btn-success" %>
        <% end %>
      </div>
      <div class="form-group">
        <%= form_with model: @refund_dispute, url: reject_event_refund_dispute_path(@event, @refund_dispute), local: true do |f| %>
          <h4>驳回争议</h4>
          <div class="form-group">
            <%= f.label :handler_action, "驳回原因" %>
            <%= f.select :handler_action, [["证据不足", "insufficient_evidence"], ["超出期限", "expired"], ["其他", "other"]] %>
          </div>
          <div class="form-group">
            <%= f.label :handler_remark, "驳回备注" %>
            <%= f.text_area :handler_remark, rows: 3, required: true %>
          </div>
          <%= f.submit "确认驳回", class: "btn btn-danger" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="card">
  <h3>处理日志</h3>
  <% if @dispute_logs.any? %>
    <div class="timeline">
      <% @dispute_logs.each do |log| %>
        <div class="timeline-item">
          <div class="timeline-marker timeline-marker-<%= log.action_type %>"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <strong><%= log.action_label %></strong>
              <span class="timeline-time"><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
              <span class="timeline-operator">操作人: <%= log.operator.email %></span>
            </div>
            <p><%= log.reason %></p>
            <% if log.closed_at %>
              <span class="badge">关闭时间: <%= log.closed_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="empty-text">暂无处理日志</p>
  <% end %>
</div>
