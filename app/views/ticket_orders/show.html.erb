<div class="page-header">
  <h1>订单详情</h1>
  <div class="page-actions">
    <%= link_to "返回列表", event_ticket_orders_path(@event), class: "btn" %>
    <%= link_to "变更记录", history_event_ticket_order_path(@event, @ticket_order), class: "btn" %>
    <% if @ticket_order.can_refund? %>
      <%= link_to "发起退票争议", new_event_refund_dispute_path(@event, ticket_order_id: @ticket_order.id), class: "btn btn-warning" %>
    <% end %>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-item">
    <label>订单号</label>
    <span><%= @ticket_order.order_no %></span>
  </div>
  <div class="detail-item">
    <label>状态</label>
    <span class="badge badge-<%= @ticket_order.status %>"><%= @ticket_order.status %></span>
  </div>
  <div class="detail-item">
    <label>购票人</label>
    <span><%= @ticket_order.buyer_name %></span>
  </div>
  <div class="detail-item">
    <label>邮箱</label>
    <span><%= @ticket_order.buyer_email %></span>
  </div>
  <div class="detail-item">
    <label>电话</label>
    <span><%= @ticket_order.buyer_phone %></span>
  </div>
  <div class="detail-item">
    <label>票种</label>
    <span><%= @ticket_order.ticket_type.name %></span>
  </div>
  <div class="detail-item">
    <label>数量</label>
    <span><%= @ticket_order.quantity %></span>
  </div>
  <div class="detail-item">
    <label>总金额</label>
    <span>¥<%= @ticket_order.total_amount %></span>
  </div>
  <div class="detail-item">
    <label>备注</label>
    <span><%= @ticket_order.remark %></span>
  </div>
  <div class="detail-item">
    <label>创建时间</label>
    <span><%= @ticket_order.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
  </div>
</div>

<% if @check_in_record %>
  <div class="card">
    <h3>核销记录</h3>
    <div class="detail-grid">
      <div class="detail-item">
        <label>核销方式</label>
        <span class="badge"><%= @check_in_record.check_in_method %></span>
      </div>
      <div class="detail-item">
        <label>核销时间</label>
        <span><%= @check_in_record.check_in_time.strftime("%Y-%m-%d %H:%M:%S") %></span>
      </div>
      <div class="detail-item">
        <label>操作人</label>
        <span><%= @check_in_record.operator.email %></span>
      </div>
    </div>
  </div>
<% end %>

<% if @refund_disputes.any? %>
  <div class="card">
    <h3>退票争议</h3>
    <table class="table">
      <thead>
        <tr>
          <th>原因</th>
          <th>状态</th>
          <th>处理人</th>
          <th>创建时间</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @refund_disputes.each do |dispute| %>
          <tr>
            <td><%= truncate(dispute.reason, length: 30) %></td>
            <td><span class="badge badge-<%= dispute.status %>"><%= dispute.status %></span></td>
            <td><%= dispute.handler.email %></td>
            <td><%= dispute.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= link_to "查看", event_refund_dispute_path(@event, dispute), class: "btn btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
