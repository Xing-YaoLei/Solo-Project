<div class="page-header">
  <%= link_to "← 返回列表", assignments_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title"><%= @assignment.new_record? ? "新增作业" : "编辑作业" %></h1>
</div>

<div class="table-container p-6">
  <%= form_with(model: @assignment, local: true) do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="form-group">
        <%= f.label :title, "作业标题", class: "form-label" %>
        <%= f.text_field :title, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :community_id, "所属社群", class: "form-label" %>
        <%= f.collection_select :community_id, @communities, :id, :name, include_blank: "通用", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :due_date, "截止日期", class: "form-label" %>
        <%= f.date_field :due_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :total_score, "满分", class: "form-label" %>
        <%= f.number_field :total_score, class: "form-input", step: "0.1" %>
      </div>
      <div class="form-group flex items-end space-x-4">
        <div class="flex items-center">
          <%= f.check_box :enable_plagiarism_check, class: "mr-2" %>
          <%= f.label :enable_plagiarism_check, "启用抄袭检测" %>
        </div>
      </div>
      <div class="form-group">
        <%= f.label :plagiarism_threshold, "抄袭阈值(%)", class: "form-label" %>
        <%= f.number_field :plagiarism_threshold, class: "form-input", step: "0.1", min: 0, max: 100 %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :description, "作业描述", class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 2 %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :requirements, "详细要求", class: "form-label" %>
        <%= f.text_area :requirements, class: "form-input", rows: 2 %>
      </div>
    </div>
    <div class="mt-8 flex space-x-3">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "取消", assignments_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
