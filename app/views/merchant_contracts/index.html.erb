<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">商户合同</h1>
      <p class="text-gray-500 mt-1">商户合同管理</p>
    </div>
    <%= link_to "新增合同", new_merchant_contract_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="p-4 border-b border-gray-100">
      <%= search_form_for @q, url: merchant_contracts_path, method: :get do |f| %>
        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <%= f.label :merchant_name_cont, "商户名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.search_field :merchant_name_cont, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :contract_number_cont, "合同编号", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.search_field :contract_number_cont, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :category_eq, "分类", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :category_eq, options_for_select(MerchantContract.distinct.pluck(:category).compact), { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status_eq, MerchantContract.statuses.map { |k, v| [status_text(k), v] }, { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="flex gap-2">
            <%= f.submit "搜索", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
            <%= link_to "重置", merchant_contracts_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商户名称</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合同编号</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">分类</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合同金额</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">有效期</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @merchant_contracts.each do |contract| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to contract.merchant_name, contract, class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= contract.contract_number %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= contract.category %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= format_currency(contract.amount_cents) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_date(contract.start_date) %> ~ <%= format_date(contract.end_date) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(contract.status) %>">
                  <%= status_text(contract.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "查看", contract, class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "编辑", edit_merchant_contract_path(contract), class: "text-gray-600 hover:text-gray-900 ml-3" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <%= paginate @merchant_contracts %>
    </div>
  </div>
</div>
