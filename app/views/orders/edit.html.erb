<% content_for :title, "编辑订单" %>

<div class="page-header">
  <h1 class="page-title">📋 编辑订单</h1>
  <div class="btn-group">
    <%= link_to "查看详情", order_path(@order), class: "btn btn-secondary" %>
    <%= link_to "返回列表", orders_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <%= form_with model: @order do |f| %>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :package_id, "套餐", class: "form-label" %>
        <%= f.collection_select :package_id, Package.active, :id, :name, {}, class: "form-select", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :channel_id, "渠道", class: "form-label" %>
        <%= f.collection_select :channel_id, Channel.active, :id, :name, {}, class: "form-select", required: true %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :customer_name, "客户姓名", class: "form-label" %>
        <%= f.text_field :customer_name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :customer_phone, "联系电话", class: "form-label" %>
        <%= f.text_field :customer_phone, class: "form-input" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :customer_email, "邮箱", class: "form-label" %>
      <%= f.email_field :customer_email, class: "form-input" %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :check_in_date, "入住日期", class: "form-label" %>
        <%= f.date_field :check_in_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :check_out_date, "离店日期", class: "form-label" %>
        <%= f.date_field :check_out_date, class: "form-input" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :quantity, "购买数量", class: "form-label" %>
        <%= f.number_field :quantity, class: "form-input", min: 1 %>
      </div>
      <div class="form-group">
        <%= f.label :external_order_id, "外部订单号", class: "form-label" %>
        <%= f.text_field :external_order_id, class: "form-input" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :notes, "备注", class: "form-label" %>
      <%= f.text_area :notes, class: "form-textarea", rows: 3 %>
    </div>

    <div class="form-actions">
      <%= f.submit "保存修改", class: "btn btn-primary" %>
      <%= link_to "取消", order_path(@order), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
