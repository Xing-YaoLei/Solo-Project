<%= form_with(model: channel_order, local: true) do |form| %>
  <% if channel_order.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-red-800 font-medium mb-2"><%= pluralize(channel_order.errors.count, "error") %> 禁止保存该订单:</h2>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% channel_order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :order_no, "订单号", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :order_no, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150", placeholder: "例如: Airbnb-2026062001" %>
      </div>

      <div>
        <%= form.label :property_id, "房源", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.collection_select :property_id, Property.all, :id, :name, { prompt: "请选择房源" }, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :check_in, "入住日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :check_in, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
      </div>

      <div>
        <%= form.label :check_out, "退房日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :check_out, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <%= form.label :channel, "渠道", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% channel_options = ChannelOrder::CHANNELS.map { |c| [I18n.t("channels.#{c}", default: c), c] } %>
        <%= form.select :channel, channel_options, {}, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
      </div>

      <div>
        <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% status_options = ChannelOrder::STATUSES.map { |s| [I18n.t("order_statuses.#{s}", default: s), s] } %>
        <%= form.select :status, status_options, {}, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
      </div>

      <div>
        <%= form.label :guest_count, "客人数", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :guest_count, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150", min: 1 %>
      </div>
    </div>

    <div>
      <%= form.label :price, "单价 (¥)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :price, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150", min: 0, step: 0.01 %>
    </div>

    <div class="border-t border-gray-200 pt-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">客人信息</h3>
      <%= form.fields_for :guest do |guest_fields| %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <%= guest_fields.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= guest_fields.text_field :name, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
          </div>

          <div>
            <%= guest_fields.label :phone, "电话", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= guest_fields.text_field :phone, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
          </div>

          <div>
            <%= guest_fields.label :id_number, "证件号", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= guest_fields.text_field :id_number, class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 transition-colors duration-150" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex justify-end pt-4 border-t border-gray-100">
      <div class="space-x-3">
        <%= link_to "取消", channel_order.persisted? ? channel_order_path(channel_order) : channel_orders_path, class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
        <%= form.submit class: "inline-flex items-center px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
      </div>
    </div>
  </div>
<% end %>
