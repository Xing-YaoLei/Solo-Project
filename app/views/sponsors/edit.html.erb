<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">编辑赞助商</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @sponsor.name %></p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0">
      <%= link_to "返回详情", sponsor_path(@sponsor), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  </div>

  <div class="mt-6 max-w-2xl">
    <%= render "shared/error_messages", object: @sponsor %>

    <%= form_with model: @sponsor, local: true, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :name, "名称", class: "block text-sm font-medium text-gray-900" %>
          <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :contact_person, "联系人", class: "block text-sm font-medium text-gray-900" %>
          <%= f.text_field :contact_person, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :contact_phone, "联系电话", class: "block text-sm font-medium text-gray-900" %>
          <%= f.text_field :contact_phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :contact_email, "联系邮箱", class: "block text-sm font-medium text-gray-900" %>
          <%= f.email_field :contact_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :address, "地址", class: "block text-sm font-medium text-gray-900" %>
          <%= f.text_field :address, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4">
        <%= f.submit "保存修改", class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
