<div class="page-header flex items-center justify-between">
  <div>
    <%= link_to "← 返回列表", benefit_rules_path, class: "btn-secondary mb-4" %>
    <h1 class="page-title">🎁 权益规则管理</h1>
    <p class="page-subtitle">定义会员权益、折扣和服务规则（改动保留前后值）</p>
  </div>
  <%= link_to "+ 新增规则", new_benefit_rule_path, class: "btn-primary" %>
</div>

<div class="table-container">
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>规则名称</th>
          <th>类型</th>
          <th>适用等级</th>
          <th>生效期</th>
          <th>状态</th>
          <th>创建人</th>
          <th>版本数</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @rules.each do |r| %>
          <tr>
            <td class="font-mono text-xs">#<%= r.id %></td>
            <td class="font-medium"><%= link_to r.name, benefit_rule_path(r), class: "text-blue-600 hover:underline" %></td>
            <td><%= member_level_badge(r.rule_type) %></td>
            <td><%= member_level_badge(r.target_member_level) %></td>
            <td class="text-xs"><%= r.effective_date %> ~ <%= r.expiry_date || "长期" %></td>
            <td><%= r.currently_active? ? '<span class="badge-green">生效中</span>'.html_safe : '<span class="badge-gray">未生效</span>'.html_safe %></td>
            <td><%= r.creator&.name %></td>
            <td class="text-center font-semibold text-purple-600"><%= r.versions.count %></td>
            <td>
              <div class="flex space-x-1">
                <%= link_to "历史版本", benefit_rule_versions_path(r), class: "btn-secondary text-xs py-1 px-2" %>
                <%= link_to "编辑", edit_benefit_rule_path(r), class: "btn-primary text-xs py-1 px-2" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
