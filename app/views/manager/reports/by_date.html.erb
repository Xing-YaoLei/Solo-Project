<% content_for :page_title, '按日期统计' %>
<% content_for :breadcrumb do %>
  <span class="text-gray-500">数据报表</span>
  <span class="mx-2">/</span>
  <span class="text-[#1e3a5f] font-medium">按日期统计</span>
<% end %>

<div class="p-6 space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-[#1e3a5f] font-serif">按日期统计报表</h2>
    <div class="flex items-center gap-4">
      <%= form_tag by_date_manager_reports_path, method: :get, class: "flex items-center gap-2" do %>
        <div class="flex items-center gap-2">
          <%= label_tag :start_date, '开始日期:', class: "text-sm text-gray-600" %>
          <%= date_field_tag :start_date, @start_date, class: "px-3 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none" %>
        </div>
        <div class="flex items-center gap-2">
          <%= label_tag :end_date, '结束日期:', class: "text-sm text-gray-600" %>
          <%= date_field_tag :end_date, @end_date, class: "px-3 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none" %>
        </div>
        <%= submit_tag "查询", class: "px-4 py-2 bg-[#1e3a5f] text-white rounded-lg text-sm font-medium hover:bg-[#2d4a6f] transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-2xl p-6 shadow-card">
      <p class="text-sm text-gray-500">结算单数</p>
      <p class="text-3xl font-bold text-[#1e3a5f] mt-2 font-serif"><%= @settlement_count %></p>
      <p class="text-xs text-gray-400 mt-2">共 <%= @settlements_by_date.size %> 天</p>
    </div>
    <div class="bg-white rounded-2xl p-6 shadow-card">
      <p class="text-sm text-gray-500">结算总金额</p>
      <p class="text-3xl font-bold text-[#10b981] mt-2 font-serif">¥<%= number_with_delimiter(sprintf('%.2f', @total_amount)) %></p>
      <p class="text-xs text-gray-400 mt-2">统计期间: <%= @start_date %> ~ <%= @end_date %></p>
    </div>
    <div class="bg-white rounded-2xl p-6 shadow-card">
      <p class="text-sm text-gray-500">日均金额</p>
      <p class="text-3xl font-bold text-[#f59e0b] mt-2 font-serif">
        <% if @settlements_by_date.size > 0 %>
          ¥<%= number_with_delimiter(sprintf('%.2f', @total_amount / @settlements_by_date.size)) %>
        <% else %>
          ¥0.00
        <% end %>
      </p>
      <p class="text-xs text-gray-400 mt-2">按交易日平均</p>
    </div>
    <div class="bg-white rounded-2xl p-6 shadow-card">
      <p class="text-sm text-gray-500">最高日金额</p>
      <p class="text-3xl font-bold text-[#ef4444] mt-2 font-serif">
        <% if @amount_by_date.values.max %>
          ¥<%= number_with_delimiter(sprintf('%.2f', @amount_by_date.values.max)) %>
        <% else %>
          ¥0.00
        <% end %>
      </p>
      <p class="text-xs text-gray-400 mt-2">
        <% if @amount_by_date.max_by { |_, v| v } %>
          日期: <%= @amount_by_date.max_by { |_, v| v }[0]&.strftime('%Y-%m-%d') %>
        <% end %>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-card animate-fade-in">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">每日结算金额趋势</h3>
      </div>
      <div data-controller="chart"
           data-chart-type-value="bar"
           data-chart-data-value="<%= {
             labels: @amount_by_date.keys.map { |d| d&.strftime('%m-%d') },
             series: [
               { name: '结算金额', data: @amount_by_date.values }
             ]
           }.to_json %>"
           style="height: 300px;">
      </div>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 100ms">
      <h3 class="text-lg font-bold text-[#1e3a5f] mb-6 font-serif">每日结算单数量</h3>
      <div data-controller="chart"
           data-chart-type-value="line"
           data-chart-data-value="<%= {
             labels: @settlements_by_date.keys.map { |d| d&.strftime('%m-%d') },
             series: [
               { name: '结算单数', data: @settlements_by_date.values }
             ]
           }.to_json %>"
           style="height: 280px;">
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-card overflow-hidden animate-fade-in" style="animation-delay: 200ms">
    <div class="p-6 border-b border-gray-100">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">结算明细</h3>
        <button class="text-sm text-[#1e3a5f] hover:underline flex items-center gap-1">
          <i data-lucide="download" class="w-4 h-4"></i>
          导出明细
        </button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">结算周期</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase">商户名称</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase">应付金额</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase">付款日期</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase">处理人</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase">状态</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @settlements.each do |settlement| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <span class="font-semibold text-[#1e3a5f]"><%= settlement.period %></span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6f] flex items-center justify-center text-white text-xs font-bold">
                    <%= settlement.merchant&.name&.first(2) %>
                  </div>
                  <span class="text-gray-900"><%= settlement.merchant&.name %></span>
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <span class="font-bold text-gray-900 font-serif">¥<%= number_with_delimiter(sprintf('%.2f', settlement.merchant_amount)) %></span>
              </td>
              <td class="px-6 py-4 text-center text-gray-600"><%= settlement.payment_date&.strftime('%Y-%m-%d') %></td>
              <td class="px-6 py-4 text-center">
                <% if settlement.handler %>
                  <span class="text-gray-700"><%= settlement.handler.name %></span>
                <% else %>
                  <span class="text-gray-400">未分配</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="status-badge status-<%= settlement.status %>">
                  <%= { pending: '待处理', processing: '处理中', approved: '已批准', rejected: '已驳回', completed: '已付款' }[settlement.status.to_sym] %>
                </span>
              </td>
              <td class="px-6 py-4 text-center">
                <%= link_to cs_settlement_path(settlement), class: "p-2 rounded-lg hover:bg-gray-100 transition-colors" do %>
                  <i data-lucide="eye" class="w-4 h-4 text-gray-500"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render PaginationComponent.new(pagy: @pagy) %>
  </div>
</div>
