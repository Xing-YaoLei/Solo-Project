<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">导览内容</h1>
      <p class="text-gray-500 mt-1">景区导览内容管理</p>
    </div>
    <%= link_to "新增内容", new_guide_content_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="p-4 border-b border-gray-100">
      <%= search_form_for @q, url: guide_contents_path, method: :get do |f| %>
        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <%= f.label :title_cont, "标题", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.search_field :title_cont, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :category_eq, "分类", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :category_eq, options_for_select(GuideContent.distinct.pluck(:category).compact), { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status_eq, GuideContent.statuses.map { |k, v| [status_text(k), v] }, { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="flex gap-2">
            <%= f.submit "搜索", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
            <%= link_to "重置", guide_contents_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">排序</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">标题</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">分类</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">时长</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @guide_contents.each do |guide_content| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= guide_content.order_index %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to guide_content.title, guide_content, class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= guide_content.category %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= guide_content.duration_minutes %> 分钟
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(guide_content.status) %>">
                  <%= status_text(guide_content.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "查看", guide_content, class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "编辑", edit_guide_content_path(guide_content), class: "text-gray-600 hover:text-gray-900 ml-3" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <%= paginate @guide_contents %>
    </div>
  </div>
</div>
