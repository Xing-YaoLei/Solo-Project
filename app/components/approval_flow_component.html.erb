<div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
  <h3 class="text-lg font-bold text-[#1e3a5f] mb-6 font-serif">审批流程</h3>

  <div class="relative">
    <% @approval_nodes.each_with_index do |node, index| %>
      <% status = node_status(node, index) %>
      <% record = @approval_records.find_by(approval_node_id: node.id) %>

      <div class="flex items-start gap-4 mb-8 last:mb-0">
        <div class="relative flex flex-col items-center">
          <div class="w-12 h-12 rounded-full <%= status_classes(status) %> flex items-center justify-center z-10 transition-all duration-300">
            <% if status == :approved %>
              <i data-lucide="check" class="w-6 h-6"></i>
            <% elsif status == :rejected %>
              <i data-lucide="x" class="w-6 h-6"></i>
            <% elsif status == :current %>
              <span class="text-sm font-bold"><%= index + 1 %></span>
            <% else %>
              <span class="text-sm font-bold"><%= index + 1 %></span>
            <% end %>
          </div>
          <% unless index == @approval_nodes.count - 1 %>
            <div class="absolute top-12 w-0.5 h-16 <%= line_classes(status) %> transition-all duration-500"></div>
          <% end %>
        </div>

        <div class="flex-1 pt-2">
          <div class="flex items-center gap-3">
            <h4 class="font-semibold text-gray-900"><%= node.name %></h4>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium
                         <%= status == :approved ? 'bg-green-100 text-green-600' : '' %>
                         <%= status == :rejected ? 'bg-red-100 text-red-600' : '' %>
                         <%= status == :current ? 'bg-blue-100 text-blue-600' : '' %>
                         <%= status == :pending ? 'bg-gray-100 text-gray-500' : '' %>">
              <%= { approved: '已通过', rejected: '已拒绝', current: '待审批', pending: '等待中' }[status] %>
            </span>
          </div>
          <p class="text-sm text-gray-500 mt-1"><%= node.role_name %></p>

          <% if record %>
            <div class="mt-3 p-3 rounded-lg bg-gray-50">
              <% if record.comment.present? %>
                <p class="text-sm text-gray-600 italic">"<%= record.comment %>"</p>
              <% end %>
              <div class="flex items-center gap-4 mt-2 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                  <i data-lucide="user" class="w-3 h-3"></i>
                  <%= record.approver&.name || '待处理' %>
                </span>
                <% if record.approved_at || record.rejected_at %>
                  <span class="flex items-center gap-1">
                    <i data-lucide="clock" class="w-3 h-3"></i>
                    <%= (record.approved_at || record.rejected_at).strftime('%Y-%m-%d %H:%M') %>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
