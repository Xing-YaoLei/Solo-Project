<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "民宿房态管理系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="民宿房态管理系统">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-gray-900 shadow-lg">
      <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "flex-shrink-0 flex items-center" do %>
              <svg class="h-8 w-8 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span class="ml-2 text-xl font-bold text-white">民宿房态管理系统</span>
            <% end %>
          </div>

          <div class="hidden md:block">
            <div class="ml-10 flex items-center space-x-1">
              <%= link_to "记录台", records_path, class: nav_link_class(records_path) %>
              <%= link_to "房源", properties_path, class: nav_link_class(properties_path) %>
              <%= link_to "订单", channel_orders_path, class: nav_link_class(channel_orders_path) %>
              <%= link_to "保洁任务", cleaning_tasks_path, class: nav_link_class(cleaning_tasks_path) %>
              <%= link_to room_conflicts_path, class: "#{nav_link_class(room_conflicts_path)} relative" do %>
                房态冲突
                <% if open_conflicts_count > 0 %>
                  <span class="absolute -top-1 -right-1 flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-red-500 rounded-full">
                    <%= open_conflicts_count %>
                  </span>
                <% end %>
              <% end %>
              <%= link_to "入住证件", check_in_documents_path, class: nav_link_class(check_in_documents_path) %>
              <%= link_to "月底复盘", monthly_reports_path, class: nav_link_class(monthly_reports_path) %>
              <%= link_to "下载记录", report_downloads_path, class: nav_link_class(report_downloads_path) %>
            </div>
          </div>

          <div class="hidden md:flex items-center ml-4">
            <div class="relative" id="user-menu-container">
              <button type="button" id="user-menu-button" class="flex items-center text-gray-300 hover:text-white hover:bg-gray-700 px-3 py-2 rounded-md text-sm font-medium">
                <svg class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span><%= current_user&.name || "未登录" %></span>
                <svg class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="user-menu-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-200">
                <div class="px-4 py-2 border-b border-gray-100">
                  <p class="text-sm text-gray-500">当前身份</p>
                  <p class="text-sm font-medium text-gray-900"><%= current_user&.name %></p>
                  <p class="text-xs text-gray-500"><%= current_user&.role_i18n %></p>
                </div>
                <div class="border-t border-gray-100">
                  <p class="px-4 py-1 text-xs text-gray-500">切换身份</p>
                  <% User.all.order(:name).each do |user| %>
                    <%= button_to login_path(user_id: user.id), method: :post, class: "block w-full text-left px-4 py-2 text-sm #{user.id == current_user&.id ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" do %>
                      <span class="font-medium"><%= user.name %></span>
                      <span class="text-xs text-gray-500 ml-1"><%= user.role_i18n %></span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="md:hidden">
            <button type="button" id="mobile-menu-button" class="text-gray-300 hover:text-white hover:bg-gray-700 p-2 rounded-md">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" class="hidden md:hidden bg-gray-800 border-t border-gray-700">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <%= link_to "记录台", records_path, class: mobile_nav_link_class(records_path) %>
          <%= link_to "房源", properties_path, class: mobile_nav_link_class(properties_path) %>
          <%= link_to "订单", channel_orders_path, class: mobile_nav_link_class(channel_orders_path) %>
          <%= link_to "保洁任务", cleaning_tasks_path, class: mobile_nav_link_class(cleaning_tasks_path) %>
          <%= link_to room_conflicts_path, class: "flex items-center justify-between #{mobile_nav_link_class(room_conflicts_path)}" do %>
            <span>房态冲突</span>
            <% if open_conflicts_count > 0 %>
              <span class="flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-red-500 rounded-full">
                <%= open_conflicts_count %>
              </span>
            <% end %>
          <% end %>
          <%= link_to "入住证件", check_in_documents_path, class: mobile_nav_link_class(check_in_documents_path) %>
          <%= link_to "月底复盘", monthly_reports_path, class: mobile_nav_link_class(monthly_reports_path) %>
          <%= link_to "下载记录", report_downloads_path, class: mobile_nav_link_class(report_downloads_path) %>
        </div>
      </div>
    </nav>

    <main class="pt-20 min-h-screen">
      <%= yield %>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const button = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        if (button && menu) {
          button.addEventListener('click', function() {
            menu.classList.toggle('hidden');
          });
        }

        const userButton = document.getElementById('user-menu-button');
        const userDropdown = document.getElementById('user-menu-dropdown');
        const userContainer = document.getElementById('user-menu-container');
        if (userButton && userDropdown) {
          userButton.addEventListener('click', function(e) {
            e.stopPropagation();
            userDropdown.classList.toggle('hidden');
          });
          document.addEventListener('click', function(e) {
            if (!userContainer.contains(e.target)) {
              userDropdown.classList.add('hidden');
            }
          });
        }
      });
    </script>
  </body>
</html>
