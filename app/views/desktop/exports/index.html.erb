<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">数据导出</h1>
  </div>

  <div class="bg-white rounded-xl p-6 shadow-sm">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">新建导出</h3>
    <div class="grid grid-cols-4 gap-4">
      <% Export::EXPORT_TYPES.each do |type| %>
        <%= form_with url: desktop_exports_path, method: :post do |f| %>
          <%= f.hidden_field :export_type, value: type %>
          <button type="submit" class="w-full p-4 border border-gray-200 rounded-lg hover:border-indigo-500 hover:bg-indigo-50 transition-colors text-left">
            <div class="font-medium text-gray-900"><%= type.humanize %></div>
            <div class="text-sm text-gray-500 mt-1">点击导出全部数据</div>
          </button>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">导出记录</h3>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">导出类型</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @exports.each do |export| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="font-medium text-gray-900"><%= export.display_name %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_bg_class(export.status) %>">
                <%= status_text(export.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= export.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if export.completed? && export.file.attached? %>
                <%= link_to "下载", download_desktop_export_path(export), class: "text-indigo-600 hover:text-indigo-900" %>
              <% else %>
                <span class="text-gray-400">处理中...</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
