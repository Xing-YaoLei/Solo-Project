<div id="action_buttons" class="flex flex-wrap items-center gap-3">
  <% if policy(audit).transition? %>
    <% audit.available_transitions.each do |target_state| %>
      <%
        transition_labels = {
          pending_materials: { text: "提交待材料", style: "bg-blue-600 hover:bg-blue-700 text-white" },
          in_progress: { text: "开始审计", style: "bg-blue-600 hover:bg-blue-700 text-white" },
          pending_evidence: { text: "提交待证据", style: "bg-orange-600 hover:bg-orange-700 text-white" },
          pending_checklist: { text: "提交待清单", style: "bg-purple-600 hover:bg-purple-700 text-white" },
          pending_notification: { text: "生成通报", style: "bg-cyan-600 hover:bg-cyan-700 text-white" },
          pending_approval: { text: "提交审批", style: "bg-indigo-600 hover:bg-indigo-700 text-white" },
          approved: { text: "审批通过", style: "bg-green-600 hover:bg-green-700 text-white" },
          rejected: { text: "驳回", style: "bg-red-600 hover:bg-red-700 text-white" },
          archived: { text: "归档", style: "bg-slate-600 hover:bg-slate-700 text-white" }
        }
        config = transition_labels[target_state] || { text: target_state.to_s.humanize, style: "bg-blue-600 hover:bg-blue-700 text-white" }
      %>

      <% if target_state == :rejected %>
        <button type="button"
          data-controller="modal"
          data-action="click->modal#open"
          data-modal-target="rejectModal"
          class="inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold transition-colors <%= config[:style] %>">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <%= config[:text] %>
        </button>
      <% else %>
        <%= button_to transition_audit_path(audit),
          method: :patch,
          params: { target_state: target_state },
          class: "inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold transition-colors #{config[:style]}",
          data: { turbo_confirm: "确认要#{config[:text]}吗？" } do %>
          <% if target_state == :approved %>
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          <% elsif target_state == :archived %>
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
            </svg>
          <% else %>
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          <% end %>
          <%= config[:text] %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if policy(audit).upload_evidence? && !audit.archived? && !audit.rejected? %>
    <button type="button"
      data-controller="modal"
      data-action="click->modal#open"
      data-modal-target="evidenceModal"
      class="inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
      </svg>
      上传证据
    </button>
  <% end %>

  <% if policy(audit).export? && audit.approved? %>
    <%= link_to export_audit_path(audit, format: :xlsx),
      class: "inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors" do %>
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      导出报告
    <% end %>
  <% end %>

  <% if policy(audit).update? && audit.draft? %>
    <%= link_to edit_audit_path(audit),
      class: "inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors" do %>
      <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
      </svg>
      编辑
    <% end %>
  <% end %>
</div>
