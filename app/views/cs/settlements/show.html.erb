<% content_for :page_title, '结算单详情' %>
<% content_for :breadcrumb do %>
  <a href="/cs/settlements" class="text-gray-500 hover:text-[#1e3a5f]">结算单管理</a>
  <span class="mx-2">/</span>
  <span class="text-[#1e3a5f] font-medium">详情</span>
<% end %>

<div class="p-6 space-y-6">
  <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-[#1e3a5f] font-serif">结算单 #10023</h2>
          <span class="px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-600">待处理</span>
        </div>
        <p class="text-gray-500">商户：美味餐饮有限公司 · 结算周期：2024年第24周（6月10日-6月16日）</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center gap-2">
          <i data-lucide="download" class="w-4 h-4"></i>
          导出
        </button>
        <button class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center gap-2">
          <i data-lucide="printer" class="w-4 h-4"></i>
          打印
        </button>
        <button class="px-5 py-2 bg-[#1e3a5f] text-white rounded-lg hover:bg-[#2d4a6f] transition-colors">
          提交审批
        </button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render AmountComparisonComponent.new(settlement: OpenStruct.new(
      system_amount: 528642.50,
      merchant_amount: 512345.00,
      difference_amount: 16297.50,
      period: '2024年第24周',
      payment_date: Date.parse('2024-06-20')
    )) %>

    <%= render ApprovalFlowComponent.new(
      approval_records: [],
      approval_nodes: [
        OpenStruct.new(id: 1, name: '客服审核', role_name: '客服专员', enabled?: true, sequence: 1),
        OpenStruct.new(id: 2, name: '财务复核', role_name: '财务人员', enabled?: true, sequence: 2),
        OpenStruct.new(id: 3, name: '经理审批', role_name: '城市经理', enabled?: true, sequence: 3)
      ]
    ) %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-card overflow-hidden animate-fade-in" style="animation-delay: 100ms">
      <div class="p-6 border-b border-gray-100">
        <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">结算明细</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">日期</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">订单号</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">商品</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">系统金额</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">商户金额</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">差异</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% 8.times do |i| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm text-gray-600">2024-06-<%= 10 + i %></td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900">ORD<%= sprintf('%08d', 12345678 + i) %></td>
                <td class="px-6 py-4 text-sm text-gray-600">商品订单 #<%= i + 1 %></td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900 text-right font-serif">¥<%= sprintf('%.2f', 125.50 + i * 23.5) %></td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900 text-right font-serif">¥<%= sprintf('%.2f', 125.50 + i * 23.5 - (i % 3 == 0 ? 5.5 : 0)) %></td>
                <td class="px-6 py-4 text-sm font-medium text-right">
                  <% if i % 3 == 0 %>
                    <span class="text-red-600 font-serif">+¥5.50</span>
                  <% else %>
                    <span class="text-gray-400">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= render AuditLogComponent.new(
      audit_logs: [
        OpenStruct.new(id: 1, action: 'create', operator: OpenStruct.new(name: '张三'), description: '创建结算单 #10023', changed_fields: nil, created_at: 2.hours.ago),
        OpenStruct.new(id: 2, action: 'update', operator: OpenStruct.new(name: '李四'), description: '更新系统金额', changed_fields: { '系统金额' => ['520,000.00', '528,642.50'] }, created_at: 1.hour.ago),
        OpenStruct.new(id: 3, action: 'update', operator: OpenStruct.new(name: '王五'), description: '上传商户金额凭证', changed_fields: nil, created_at: 30.minutes.ago)
      ],
      limit: 5
    ) %>
  </div>

  <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 200ms">
    <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">差异处理记录</h3>
    <div class="space-y-4">
      <% 3.times do |i| %>
        <div class="p-4 rounded-xl bg-gray-50">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#f59e0b] to-[#f97316] flex items-center justify-center text-white font-bold text-sm">
              差
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-medium text-gray-900">差异 #<%= i + 1 %></span>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-600">处理中</span>
              </div>
              <p class="text-sm text-gray-600">订单金额差异：系统统计 ¥<%= sprintf('%.2f', 125.50 + i * 23.5) %>，商户上报 ¥<%= sprintf('%.2f', 120.00 + i * 23.5) %></p>
              <p class="text-xs text-gray-400 mt-2">创建于 <%= (i + 1).hours.ago.strftime('%Y-%m-%d %H:%M') %></p>
            </div>
            <button class="px-3 py-1.5 text-sm text-[#1e3a5f] border border-[#1e3a5f] rounded-lg hover:bg-[#1e3a5f] hover:text-white transition-colors">
              处理
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
