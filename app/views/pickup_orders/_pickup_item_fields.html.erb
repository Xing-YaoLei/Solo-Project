<div class="pickup-item-fields bg-gray-50 p-4 rounded-lg border border-gray-200">
  <div class="grid grid-cols-1 gap-y-4 gap-x-4 sm:grid-cols-6">
    <div class="sm:col-span-2">
      <%= f.label :product_name, "商品名称", class: "block text-xs font-medium text-gray-700" %>
      <%= f.text_field :product_name, required: true, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :product_tag, "商品标签", class: "block text-xs font-medium text-gray-700" %>
      <%= f.text_field :product_tag, required: true, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :product_code, "商品编码", class: "block text-xs font-medium text-gray-700" %>
      <%= f.text_field :product_code, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :expected_quantity, "应收数量", class: "block text-xs font-medium text-gray-700" %>
      <%= f.number_field :expected_quantity, min: 0, required: true, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :actual_quantity, "实收数量", class: "block text-xs font-medium text-gray-700" %>
      <%= f.number_field :actual_quantity, min: 0, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :unit_price, "单价", class: "block text-xs font-medium text-gray-700" %>
      <%= f.number_field :unit_price, min: 0, step: 0.01, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div class="sm:col-span-5">
      <%= f.label :remark, "备注", class: "block text-xs font-medium text-gray-700" %>
      <%= f.text_field :remark, class: "mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm shadow-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div class="flex items-end">
      <%= f.hidden_field :_destroy %>
      <%= link_to "删除", "#", class: "remove-fields px-3 py-1 bg-red-100 text-red-700 rounded text-sm hover:bg-red-200" %>
    </div>
  </div>
</div>
