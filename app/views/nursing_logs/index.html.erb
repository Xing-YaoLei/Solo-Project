<div class="min-h-screen" style="background-color: #F5F3EF;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-bold" style="color: #1B2A4A;">护理日志</h1>
      <%= link_to "新建日志", new_nursing_log_path, class: "inline-flex items-center px-4 py-2 rounded-lg text-white font-medium shadow-sm hover:opacity-90 transition-opacity", style: "background-color: #2DD4A8;" %>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 mb-6">
      <%= form_with url: nursing_logs_path, method: :get, class: "flex flex-wrap items-end gap-4", data: { turbo_frame: "nursing_logs_list" } do |f| %>
        <div>
          <%= f.label :patient_id, "患者", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :patient_id, @patients.map { |p| [p.class.exists? ? p.try(:name) : "Patient ##{p.id}", p.id] }, { include_blank: "全部患者" }, selected: params[:patient_id], class: "rounded-lg border-gray-300 text-sm py-2 pl-3 pr-8 focus:ring-0 focus:border-gray-400" %>
        </div>
        <div>
          <%= f.label :care_type, "护理类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :care_type, [["日常护理", "daily_care"], ["特殊护理", "special_care"], ["康复护理", "rehabilitation_care"], ["观察", "observation"]], { include_blank: "全部类型" }, selected: params[:care_type], class: "rounded-lg border-gray-300 text-sm py-2 pl-3 pr-8 focus:ring-0 focus:border-gray-400" %>
        </div>
        <div>
          <%= f.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :start_date, value: params[:start_date], class: "rounded-lg border-gray-300 text-sm py-2 focus:ring-0 focus:border-gray-400" %>
        </div>
        <div>
          <%= f.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :end_date, value: params[:end_date], class: "rounded-lg border-gray-300 text-sm py-2 focus:ring-0 focus:border-gray-400" %>
        </div>
        <%= f.submit "筛选", class: "px-4 py-2 rounded-lg text-sm font-medium text-white", style: "background-color: #1B2A4A;" %>
      <% end %>
    </div>

    <%= turbo_frame_tag "nursing_logs_list" do %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr style="background-color: #1B2A4A;">
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">日期</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">患者</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">护理类型</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">内容摘要</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">护士</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% @nursing_logs.each do |log| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  <%= log.logged_at&.strftime("%Y-%m-%d") || log.created_at.strftime("%Y-%m-%d") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium" style="color: #1B2A4A;">
                  <%= log.patient.try(:name) || "Patient ##{log.patient_id}" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                    <% case log.care_type
                       when 'daily_care' %>bg-blue-100 text-blue-800
                    <% when 'special_care' %>bg-purple-100 text-purple-800
                    <% when 'rehabilitation_care' %>bg-green-100 text-green-800
                    <% when 'observation' %>bg-orange-100 text-orange-800
                    <% else %>bg-gray-100 text-gray-800
                    <% end %>">
                    <% care_type_labels = { 'daily_care' => '日常护理', 'special_care' => '特殊护理', 'rehabilitation_care' => '康复护理', 'observation' => '观察' } %>
                    <%= care_type_labels[log.care_type] || log.care_type %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600 max-w-xs truncate">
                  <%= truncate(log.content.to_s, length: 40) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  <%= log.nurse.try(:name) || "Nurse ##{log.nurse_id}" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <%= link_to "查看", nursing_log_path(log), class: "font-medium hover:underline", style: "color: #2DD4A8;" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% if @nursing_logs.empty? %>
          <div class="text-center py-16">
            <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <p class="mt-4 text-gray-400">暂无护理日志</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
