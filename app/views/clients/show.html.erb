<% content_for :title, "客户档案 - #{@client.name}" %>

<div class="space-y-6">
  <div class="bg-white rounded-lg shadow p-5">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @client.name %></h1>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-500">
          <span>电话：<%= @client.phone %></span>
          <% if @client.id_number.present? %><span>身份证：<%= @client.id_number %></span><% end %>
          <% if @client.email.present? %><span>邮箱：<%= @client.email %></span><% end %>
          <% if @client.source_channel.present? %><span>来源：<%= @client.source_channel %></span><% end %>
        </div>
      </div>
      <div class="flex space-x-2">
        <%= link_to "返回列表", clients_path, class: "px-3 py-1.5 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 text-sm" %>
        <%= link_to "编辑", edit_client_path(@client), class: "px-3 py-1.5 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 text-sm" %>
        <%= link_to "新建案件", new_case_path(client_id: @client.id), class: "px-3 py-1.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm" %>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
      <% if @client.address.present? %>
        <div>
          <div class="text-sm font-medium text-gray-700 mb-1">地址</div>
          <div class="text-gray-600"><%= @client.address %></div>
        </div>
      <% end %>
      <% if @client.contact_person.present? %>
        <div>
          <div class="text-sm font-medium text-gray-700 mb-1">联系人</div>
          <div class="text-gray-600"><%= @client.contact_person %></div>
        </div>
      <% end %>
    </div>

    <% if @client.notes.present? %>
      <div class="mt-4 p-4 bg-gray-50 rounded-md">
        <div class="text-sm font-medium text-gray-700 mb-1">备注</div>
        <div class="text-gray-600 whitespace-pre-wrap"><%= @client.notes %></div>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-5">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">关联案件 (<%= @cases.count %>)</h2>
    <% if @cases.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">案件名称</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">类别</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">责任人</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @cases.each do |c| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-3 whitespace-nowrap">
                  <%= link_to c.title, case_path(c), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500"><%= c.category.presence || "-" %></td>
                <td class="px-6 py-3 whitespace-nowrap">
                  <span class="inline-flex px-2.5 py-1 text-xs font-semibold rounded-full <%= c.status_label %>">
                    <%= c.status_text %>
                  </span>
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500"><%= c.responsible_person.presence || "-" %></td>
                <td class="px-6 py-3 whitespace-nowrap text-sm">
                  <%= link_to "查看", case_path(c), class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 text-center py-4">暂无案件</p>
    <% end %>
  </div>
</div>
