<div class="mb-6 flex items-center justify-between">
  <div class="flex items-center space-x-4">
    <%= link_to parts_path, class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h2 class="text-xl font-semibold text-gray-900"><%= @part.name %></h2>
    <% if @part.stock_quantity == 0 %>
      <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">缺货</span>
    <% elsif @part.low_stock? %>
      <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">低库存</span>
    <% else %>
      <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">库存充足</span>
    <% end %>
  </div>
  <div class="flex space-x-3">
    <%= link_to "编辑", edit_part_path(@part), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    <%= button_to "删除", @part, method: :delete, class: "inline-flex items-center rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "确定删除此配件？" } } %>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-6">
    <div class="rounded-lg border border-gray-200 bg-white p-6">
      <h3 class="mb-4 text-lg font-medium text-gray-900">基本信息</h3>
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-gray-500">SKU</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.sku %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">配件名称</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.name %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">分类</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.category.presence || '-' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">品牌</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.brand.presence || '-' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">规格</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.specification.presence || '-' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">单位</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.unit.presence || '-' %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">存放位置</dt>
          <dd class="mt-1 text-sm font-medium text-gray-900"><%= @part.location.presence || '-' %></dd>
        </div>
        <% if @part.description.present? %>
          <div class="col-span-2">
            <dt class="text-sm text-gray-500">描述</dt>
            <dd class="mt-1 text-sm text-gray-700 whitespace-pre-wrap"><%= @part.description %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6">
      <h3 class="mb-4 text-lg font-medium text-gray-900">价格信息</h3>
      <dl class="grid grid-cols-2 gap-4">
        <div>
          <dt class="text-sm text-gray-500">成本价</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900">¥<%= number_with_precision(@part.cost_price, precision: 2) %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">售价</dt>
          <dd class="mt-1 text-lg font-semibold text-blue-600">¥<%= number_with_precision(@part.selling_price, precision: 2) %></dd>
        </div>
        <% if @part.cost_price && @part.selling_price && @part.cost_price > 0 %>
          <div>
            <dt class="text-sm text-gray-500">毛利率</dt>
            <dd class="mt-1 text-sm font-medium text-green-600">
              <%= number_with_precision(((@part.selling_price - @part.cost_price) / @part.cost_price * 100), precision: 2) %>%
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <div class="space-y-6">
    <div class="rounded-lg border border-gray-200 bg-gradient-to-br
      <%= @part.stock_quantity == 0 ? 'from-red-50 to-orange-50' : @part.low_stock? ? 'from-yellow-50 to-orange-50' : 'from-green-50 to-emerald-50' %> p-6">
      <h3 class="mb-4 text-lg font-medium text-gray-900">库存状态</h3>
      <div class="space-y-4">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-gray-600">当前库存</span>
          <span class="text-2xl font-bold
            <%= @part.stock_quantity == 0 ? 'text-red-600' : @part.low_stock? ? 'text-yellow-600' : 'text-green-600' %>">
            <%= @part.stock_quantity %> <%= @part.unit %>
          </span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-gray-600">安全库存</span>
          <span class="text-lg font-semibold text-gray-900"><%= @part.safety_stock %> <%= @part.unit %></span>
        </div>
        <div class="h-3 w-full overflow-hidden rounded-full bg-white">
          <% percentage = @part.safety_stock > 0 ? [(@part.stock_quantity.to_f / @part.safety_stock * 100), 100].min : 0 %>
          <div class="h-full rounded-full
            <%= percentage < 50 ? 'bg-red-500' : percentage < 100 ? 'bg-yellow-500' : 'bg-green-500' %>"
            style="width: <%= percentage %>%"></div>
        </div>
        <p class="text-xs text-gray-500">
          <% if @part.stock_quantity == 0 %>
            当前缺货，请尽快补货
          <% elsif @part.low_stock? %>
            库存低于安全库存，建议补货
          <% else %>
            库存充足
          <% end %>
        </p>
      </div>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-6">
      <h3 class="mb-4 text-lg font-medium text-gray-900">库存价值</h3>
      <dl class="space-y-3">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-gray-600">库存总成本</span>
          <span class="text-lg font-semibold text-gray-900">
            ¥<%= number_with_precision((@part.stock_quantity * @part.cost_price.to_f), precision: 2) %>
          </span>
        </div>
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-gray-600">库存总售价</span>
          <span class="text-lg font-semibold text-blue-600">
            ¥<%= number_with_precision((@part.stock_quantity * @part.selling_price.to_f), precision: 2) %>
          </span>
        </div>
      </dl>
    </div>
  </div>
</div>
