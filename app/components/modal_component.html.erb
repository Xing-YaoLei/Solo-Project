<div class="fixed inset-0 z-50 hidden" data-controller="modal" data-modal-target="container">
  <div class="fixed inset-0 bg-black/50 backdrop-blur-sm transition-opacity duration-300"
       data-action="click->modal#close"
       data-modal-target="backdrop"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="relative bg-white rounded-2xl shadow-2xl w-full <%= size_classes %> transform transition-all duration-300 scale-95 opacity-0"
         data-modal-target="panel">
      <div class="flex items-center justify-between p-6 border-b border-gray-100">
        <h3 class="text-xl font-bold text-[#1e3a5f] font-serif"><%= @title %></h3>
        <% if @closeable %>
          <button class="p-2 rounded-lg hover:bg-gray-100 transition-colors" data-action="click->modal#close">
            <i data-lucide="x" class="w-5 h-5 text-gray-500"></i>
          </button>
        <% end %>
      </div>
      <div class="p-6 max-h-[calc(100vh-200px)] overflow-y-auto">
        <%= content %>
      </div>
      <% if content_for?(:modal_footer) %>
        <div class="flex items-center justify-end gap-3 p-6 border-t border-gray-100 bg-gray-50 rounded-b-2xl">
          <%= yield :modal_footer %>
        </div>
      <% end %>
    </div>
  </div>
</div>
