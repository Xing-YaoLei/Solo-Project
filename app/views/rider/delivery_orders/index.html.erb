<% content_for :page_title, '配送订单' %>

<div class="p-6 space-y-6">
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 bg-white rounded-lg p-1 shadow-sm">
      <button class="px-4 py-2 rounded-md bg-[#1e3a5f] text-white text-sm font-medium">全部</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">待取货</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">配送中</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">已完成</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">已取消</button>
    </div>
    <div class="flex items-center gap-2">
      <input type="date" class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% 12.times do |i| %>
      <div class="bg-white rounded-2xl p-5 shadow-card hover:shadow-card-hover transition-all duration-300 animate-fade-in" style="animation-delay: <%= i * 30 %>ms">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-[#1e3a5f]">#<%= sprintf('%08d', 12345678 + i) %></span>
          <span class="px-3 py-1 rounded-full text-xs font-medium
                       <%= i < 2 ? 'bg-green-100 text-green-600' : '' %>
                       <%= i >= 2 && i < 5 ? 'bg-blue-100 text-blue-600' : '' %>
                       <%= i >= 5 ? 'bg-gray-100 text-gray-600' : '' %>">
            <%= i < 2 ? '待取货' : i >= 2 && i < 5 ? '配送中' : '已完成' %>
          </span>
        </div>

        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#f59e0b]/10 flex items-center justify-center flex-shrink-0">
              <i data-lucide="store" class="w-4 h-4 text-[#f59e0b]"></i>
            </div>
            <div>
              <p class="font-medium text-gray-900">商户<%= i + 1 %></p>
              <p class="text-sm text-gray-500">北京市朝阳区xxx街<%= i + 1 %>号</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div class="flex-1 h-px bg-dashed bg-gray-200"></div>
            <i data-lucide="arrow-down" class="w-4 h-4 text-gray-300"></i>
            <div class="flex-1 h-px bg-dashed bg-gray-200"></div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#1e3a5f]/10 flex items-center justify-center flex-shrink-0">
              <i data-lucide="map-pin" class="w-4 h-4 text-[#1e3a5f]"></i>
            </div>
            <div>
              <p class="font-medium text-gray-900">用户地址</p>
              <p class="text-sm text-gray-500">北京市朝阳区xxx小区<%= i + 1 %>号楼</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
          <div>
            <p class="text-xs text-gray-500">配送费</p>
            <p class="text-lg font-bold text-[#1e3a5f] font-serif">¥<%= sprintf('%.2f', 8 + i * 1.5) %></p>
          </div>
          <% if i < 2 %>
            <button class="px-5 py-2 bg-[#10b981] text-white rounded-lg hover:bg-[#059669] transition-colors font-medium">
              开始配送
            </button>
          <% elsif i >= 2 && i < 5 %>
            <button class="px-5 py-2 bg-[#1e3a5f] text-white rounded-lg hover:bg-[#2d4a6f] transition-colors font-medium">
              确认送达
            </button>
          <% else %>
            <span class="px-4 py-2 text-gray-400 text-sm">
              <%= (i + 1).days.ago.strftime('%Y-%m-%d') %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <nav class="flex items-center gap-1">
      <button class="px-3 py-2 rounded-lg text-gray-400 cursor-not-allowed">
        <i data-lucide="chevron-left" class="w-4 h-4"></i>
      </button>
      <span class="px-4 py-2 rounded-lg bg-[#1e3a5f] text-white font-medium">1</span>
      <button class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium">2</button>
      <button class="px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-100 font-medium">3</button>
      <button class="px-3 py-2 rounded-lg text-gray-600 hover:bg-gray-100">
        <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </button>
    </nav>
  </div>
</div>
