<div class="card">
  <div class="card-header">
    <h2>教练详情: <%= @trainer.name %></h2>
    <div class="btn-group">
      <%= link_to "编辑", edit_trainer_path(@trainer), class: "btn btn-outline btn-sm" %>
      <%= link_to "列表", trainers_path, class: "btn btn-outline btn-sm" %>
    </div>
  </div>
  <div class="card-body">
    <div class="form-row">
      <div class="form-group"><label>工号</label><div style="font-weight: 500;"><%= @trainer.employee_no %></div></div>
      <div class="form-group"><label>姓名</label><div style="font-weight: 500;"><%= @trainer.name %></div></div>
      <div class="form-group"><label>电话</label><div style="font-weight: 500;"><%= @trainer.phone %></div></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>专长</label><div style="font-weight: 500;"><%= @trainer.specialty %></div></div>
      <div class="form-group"><label>状态</label><div><span class="badge <%= @trainer.active? ? 'badge-green' : 'badge-gray' %>"><%= @trainer.active? ? '在职' : '离职' %></span></div></div>
    </div>
  </div>
</div>
