<% content_for :title, "新建订单" %>

<div class="page-header">
  <h1 class="page-title">📋 新建订单</h1>
  <%= link_to "返回列表", orders_path, class: "btn btn-secondary" %>
</div>

<div class="card">
  <%= form_with model: @order do |f| %>
    <div class="card-title" style="font-size: 1rem; margin-bottom: 16px; color: #4a5568;">基本信息</div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :package_id, "套餐", class: "form-label" %>
        <%= f.collection_select :package_id, Package.active, :id, :name, { include_blank: '请选择套餐' }, class: "form-select", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :channel_id, "渠道", class: "form-label" %>
        <%= f.collection_select :channel_id, Channel.active, :id, :name, { include_blank: '请选择渠道' }, class: "form-select", required: true %>
      </div>
    </div>

    <div class="card-title" style="font-size: 1rem; margin-bottom: 16px; color: #4a5568; margin-top: 24px;">客户信息</div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :customer_name, "客户姓名", class: "form-label" %>
        <%= f.text_field :customer_name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :customer_phone, "联系电话", class: "form-label" %>
        <%= f.text_field :customer_phone, class: "form-input" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :customer_email, "邮箱", class: "form-label" %>
      <%= f.email_field :customer_email, class: "form-input" %>
    </div>

    <div class="card-title" style="font-size: 1rem; margin-bottom: 16px; color: #4a5568; margin-top: 24px;">入住信息</div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :check_in_date, "入住日期", class: "form-label" %>
        <%= f.date_field :check_in_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :check_out_date, "离店日期", class: "form-label" %>
        <%= f.date_field :check_out_date, class: "form-input" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :quantity, "购买数量", class: "form-label" %>
        <%= f.number_field :quantity, class: "form-input", min: 1, value: 1 %>
      </div>
      <div class="form-group">
        <%= f.label :external_order_id, "外部订单号", class: "form-label" %>
        <%= f.text_field :external_order_id, class: "form-input" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :notes, "备注", class: "form-label" %>
      <%= f.text_area :notes, class: "form-textarea", rows: 3 %>
    </div>

    <div style="background: #f7fafc; padding: 16px; border-radius: 8px; margin-top: 16px;">
      <div style="font-weight: 500; color: #4a5568; margin-bottom: 8px;">
        💡 价格将根据所选套餐、渠道和数量自动计算
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "创建订单", class: "btn btn-primary" %>
      <%= link_to "取消", orders_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
