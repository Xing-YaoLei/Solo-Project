<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" data-controller="modal" data-action="click->modal#closeBackground">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto m-4">
      <div class="flex items-center justify-between p-6 border-b border-gray-100">
        <h2 class="text-xl font-bold" style="color: #1B2A4A;"><%= @prescription_rule.persisted? ? '编辑处方规则' : '新建处方规则' %></h2>
        <button type="button" data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <%= form_with(model: @prescription_rule, url: @prescription_rule.persisted? ? prescription_rule_path(@prescription_rule) : prescription_rules_path, html: { data: { turbo_frame: "modal" } }) do |f| %>
        <div class="p-6 space-y-5">
          <% if @prescription_rule.errors.any? %>
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-600">
              <ul class="list-disc list-inside">
                <% @prescription_rule.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= f.label :name, "规则名称", class: "block text-sm font-medium mb-1", style: "color: #1B2A4A;" %>
            <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:outline-none", style: "focus: ring-color: #2DD4A8;", placeholder: "输入规则名称" %>
          </div>

          <div>
            <%= f.label :trigger_condition, "触发条件", class: "block text-sm font-medium mb-1", style: "color: #1B2A4A;" %>
            <%= f.text_area :trigger_condition, rows: 3, class: "w-full px-3 py-2 border border-gray-200 rounded-lg focus:ring-2 focus:outline-none", placeholder: "例如: grade=中度 AND score>=30" %>
          </div>

          <div>
            <label class="block text-sm font-medium mb-3" style="color: #1B2A4A;">训练计划</label>
            <div id="training-plan-items" data-controller="training-plan">
              <% Array(@prescription_rule.training_plan).each_with_index do |item, index| %>
                <%= render "training_plan_fields", f: f, index: index, item: item %>
              <% end %>
            </div>
            <button type="button" data-action="click->training-plan#addItem" class="mt-3 inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm font-medium border-2 border-dashed border-gray-300 text-gray-500 hover:border-emerald-400 hover:text-emerald-600 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              添加练习项
            </button>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 p-6 border-t border-gray-100">
          <button type="button" data-action="click->modal#close" class="px-4 py-2 rounded-lg text-gray-600 font-medium hover:bg-gray-100">取消</button>
          <%= f.submit @prescription_rule.persisted? ? "更新规则" : "创建规则", class: "px-6 py-2 rounded-lg text-white font-medium", style: "background-color: #1B2A4A;" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
