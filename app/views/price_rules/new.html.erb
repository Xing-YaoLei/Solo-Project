<% content_for :title, "新建价格规则" %>

<div class="page-header">
  <h1 class="page-title">💰 新建价格规则</h1>
  <% if @package %>
    <%= link_to "返回列表", package_price_rules_path(@package), class: "btn btn-secondary" %>
  <% else %>
    <%= link_to "返回列表", price_rules_path, class: "btn btn-secondary" %>
  <% end %>
</div>

<div class="card">
  <%= form_with model: @price_rule do |f| %>
    <div class="form-group">
      <%= f.label :name, "规则名称", class: "form-label" %>
      <%= f.text_field :name, class: "form-input", required: true %>
    </div>

    <% unless @package %>
      <div class="form-group">
        <%= f.label :package_id, "适用套餐", class: "form-label" %>
        <%= f.collection_select :package_id, Package.active, :id, :name, { include_blank: '请选择套餐' }, class: "form-select", required: true %>
      </div>
    <% end %>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :rule_type, "规则类型", class: "form-label" %>
        <%= f.select :rule_type, [
          ['百分比折扣', 'percentage_discount'],
          ['固定金额优惠', 'fixed_discount'],
          ['固定价格', 'fixed_price'],
          ['加价', 'markup']
        ], {}, class: "form-select", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :value, "值", class: "form-label" %>
        <%= f.number_field :value, class: "form-input", min: 0, step: "0.01", required: true %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :channel_id, "适用渠道", class: "form-label" %>
      <%= f.collection_select :channel_id, Channel.active, :id, :name, { include_blank: '全部渠道' }, class: "form-select" %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :start_date, "开始日期", class: "form-label" %>
        <%= f.date_field :start_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :end_date, "结束日期", class: "form-label" %>
        <%= f.date_field :end_date, class: "form-input" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :min_quantity, "最低购买数量", class: "form-label" %>
        <%= f.number_field :min_quantity, class: "form-input", min: 1, value: 1 %>
      </div>
      <div class="form-group">
        <%= f.label :status, "状态", class: "form-label" %>
        <%= f.select :status, [['启用', 'active'], ['禁用', 'inactive']], {}, class: "form-select" %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "创建规则", class: "btn btn-primary" %>
      <% if @package %>
        <%= link_to "取消", package_price_rules_path(@package), class: "btn btn-secondary" %>
      <% else %>
        <%= link_to "取消", price_rules_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  <% end %>
</div>
