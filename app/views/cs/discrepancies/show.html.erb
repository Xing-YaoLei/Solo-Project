<% content_for :page_title, '差异详情' %>
<% content_for :breadcrumb do %>
  <a href="/cs/discrepancies" class="text-gray-500 hover:text-[#1e3a5f]">差异处理</a>
  <span class="mx-2">/</span>
  <span class="text-[#1e3a5f] font-medium">详情</span>
<% end %>

<div class="p-6 space-y-6">
  <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-[#1e3a5f] font-serif">差异 #1001</h2>
          <span class="px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-600">待处理</span>
        </div>
        <p class="text-gray-500">订单金额统计差异 · 结算单 <a href="/cs/settlements/10023" class="text-[#1e3a5f] hover:underline">#10023</a></p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors">
          转派处理
        </button>
        <button class="px-5 py-2 bg-[#10b981] text-white rounded-lg hover:bg-[#059669] transition-colors">
          标记已解决
        </button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 100ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">差异信息</h3>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <p class="text-sm text-gray-500 mb-1">商户名称</p>
            <p class="font-semibold text-gray-900">美味餐饮有限公司</p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">结算周期</p>
            <p class="font-semibold text-gray-900">2024年第24周（6月10日-6月16日）</p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">系统金额</p>
            <p class="font-semibold text-[#1e3a5f] text-lg font-serif">¥528,642.50</p>
          </div>
          <div>
            <p class="text-sm text-gray-500 mb-1">商户金额</p>
            <p class="font-semibold text-[#f59e0b] text-lg font-serif">¥512,345.00</p>
          </div>
          <div class="col-span-2">
            <p class="text-sm text-gray-500 mb-1">差异金额</p>
            <p class="font-bold text-red-600 text-2xl font-serif">+¥16,297.50</p>
            <p class="text-xs text-gray-400 mt-1">差异比例 3.08%</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 200ms">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">差异明细</h3>
          <button class="text-sm text-[#1e3a5f] hover:underline">批量处理</button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">订单号</th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">日期</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">系统金额</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">商户金额</th>
                <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase">差异</th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">状态</th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% 5.times do |i| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">ORD<%= sprintf('%08d', 12345678 + i) %></td>
                  <td class="px-4 py-3 text-sm text-gray-600">2024-06-<%= 10 + i %></td>
                  <td class="px-4 py-3 text-sm font-medium text-right font-serif">¥<%= sprintf('%.2f', 125.50 + i * 23.5) %></td>
                  <td class="px-4 py-3 text-sm font-medium text-right font-serif">¥<%= sprintf('%.2f', 120.00 + i * 23.5) %></td>
                  <td class="px-4 py-3 text-sm font-bold text-right text-red-600 font-serif">+¥5.50</td>
                  <td class="px-4 py-3 text-center">
                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-600">待处理</span>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <button class="text-sm text-[#1e3a5f] hover:underline">处理</button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 300ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">处理记录</h3>
        <div class="space-y-4">
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6f] flex items-center justify-center text-white font-bold text-sm">
              张
            </div>
            <div class="flex-1">
              <div class="bg-gray-50 rounded-xl p-4">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-medium text-gray-900">张三</span>
                  <span class="text-xs text-gray-400">2024-06-18 14:30</span>
                </div>
                <p class="text-sm text-gray-600">已联系商户确认差异原因，商户表示部分订单优惠活动未被系统正确计算。</p>
              </div>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#f59e0b] to-[#f97316] flex items-center justify-center text-white font-bold text-sm">
              系
            </div>
            <div class="flex-1">
              <div class="bg-orange-50 rounded-xl p-4">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-medium text-gray-900">系统提示</span>
                  <span class="text-xs text-gray-400">2024-06-18 10:00</span>
                </div>
                <p class="text-sm text-gray-600">差异已自动识别，建议核对相关订单的优惠活动配置。</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-4 flex gap-3">
          <input type="text" placeholder="添加处理备注..." class="flex-1 px-4 py-3 border border-gray-200 rounded-xl text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
          <button class="px-5 py-3 bg-[#1e3a5f] text-white rounded-xl hover:bg-[#2d4a6f] transition-colors">
            提交
          </button>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 150ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">补充材料</h3>
        <div class="space-y-3">
          <% 3.times do |i| %>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50 hover:bg-gray-100 transition-colors cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-[#1e3a5f]/10 flex items-center justify-center">
                <i data-lucide="file-text" class="w-5 h-5 text-[#1e3a5f]"></i>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate">商户对账单_<%= i + 1 %>.pdf</p>
                <p class="text-xs text-gray-400"><%= (i + 1) * 256 %> KB</p>
              </div>
              <i data-lucide="download" class="w-4 h-4 text-gray-400"></i>
            </div>
          <% end %>
        </div>
        <button class="w-full mt-4 py-3 border-2 border-dashed border-gray-200 rounded-xl text-gray-500 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center justify-center gap-2">
          <i data-lucide="upload" class="w-4 h-4"></i>
          上传凭证
        </button>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in" style="animation-delay: 250ms">
        <h3 class="text-lg font-bold text-[#1e3a5f] mb-4 font-serif">处理人</h3>
        <div class="flex items-center gap-3 p-3 rounded-xl bg-gray-50">
          <div class="w-12 h-12 rounded-full bg-gradient-to-br from-[#1e3a5f] to-[#2d4a6f] flex items-center justify-center text-white font-bold">
            李
          </div>
          <div>
            <p class="font-semibold text-gray-900">李四</p>
            <p class="text-xs text-gray-500">客服专员</p>
          </div>
        </div>
        <button class="w-full mt-4 py-2 text-sm text-[#1e3a5f] border border-[#1e3a5f] rounded-lg hover:bg-[#1e3a5f] hover:text-white transition-colors">
          转派他人
        </button>
      </div>
    </div>
  </div>
</div>
