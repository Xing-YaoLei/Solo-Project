<% content_for :title, "编辑渠道" %>

<div class="page-header">
  <h1 class="page-title">🔌 编辑渠道</h1>
  <div class="btn-group">
    <%= link_to "查看详情", channel_path(@channel), class: "btn btn-secondary" %>
    <%= link_to "返回列表", channels_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <%= form_with model: @channel do |f| %>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, "渠道名称", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :code, "渠道代码", class: "form-label" %>
        <%= f.text_field :code, class: "form-input", required: true %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :commission_rate, "佣金比例 (%)", class: "form-label" %>
        <%= f.number_field :commission_rate, class: "form-input", min: 0, max: 100, step: "0.01" %>
      </div>
      <div class="form-group">
        <%= f.label :status, "状态", class: "form-label" %>
        <%= f.select :status, [['启用', 'active'], ['禁用', 'inactive']], {}, class: "form-select" %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :description, "描述", class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea", rows: 3 %>
    </div>

    <div class="form-actions">
      <%= f.submit "保存修改", class: "btn btn-primary" %>
      <%= link_to "取消", channel_path(@channel), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
