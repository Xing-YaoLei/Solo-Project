<div class="w-full">
  <%= content_for :title, "订单 #{@channel_order.order_no}" %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">订单详情</h1>
    <div class="space-x-2">
      <%= link_to "返回列表", channel_orders_path, class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
      <%= link_to "编辑", edit_channel_order_path(@channel_order), class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">订单信息</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">订单号</dt>
            <dd class="mt-1 text-sm font-mono text-gray-900"><%= @channel_order.order_no %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">房源</dt>
            <dd class="mt-1 text-sm">
              <%= link_to @channel_order.property.name, property_path(@channel_order.property), class: "text-blue-600 hover:text-blue-800" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">入住日期</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.check_in %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">退房日期</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.check_out %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">间夜数</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.nights %> 晚</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">渠道</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.channel_i18n %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">状态</dt>
            <dd class="mt-1">
              <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= @channel_order.status_color %>">
                <%= @channel_order.status_i18n %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">单价</dt>
            <dd class="mt-1 text-sm text-gray-900">¥<%= @channel_order.price %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">总价</dt>
            <dd class="mt-1 text-lg font-semibold text-gray-900">¥<%= @channel_order.total_price %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">客人数</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.guest_count %></dd>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">客人信息</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">姓名</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.guest.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">电话</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.guest.phone %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">证件号</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @channel_order.guest.id_number.presence || "-" %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <h2 class="text-lg font-semibold text-gray-800">入住证件</h2>
          <%= link_to "新增证件", new_check_in_document_path(channel_order_id: @channel_order.id), class: "inline-flex items-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
        </div>
        <% if @channel_order.check_in_documents.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">姓名</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">证件类型</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">证件号</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">性别</th>
                  <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @channel_order.check_in_documents.each do |doc| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700">
                      <%= link_to doc.name, check_in_document_path(doc), class: "text-blue-600 hover:text-blue-800" %>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= doc.id_type_i18n %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm font-mono text-gray-700"><%= doc.id_number %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= doc.gender_i18n || "-" %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-right text-sm font-medium space-x-2">
                      <%= link_to "编辑", edit_check_in_document_path(doc), class: "text-indigo-600 hover:text-indigo-900" %>
                      <%= link_to "删除", check_in_document_path(doc), method: :delete, data: { confirm: "确定要删除吗？" }, class: "text-red-600 hover:text-red-900" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="p-8 text-center text-gray-500">
            <p>暂无入住证件</p>
            <%= link_to "添加第一个证件", new_check_in_document_path(channel_order_id: @channel_order.id), class: "mt-2 inline-block text-blue-600 hover:text-blue-800" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
