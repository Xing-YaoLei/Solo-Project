<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">演出排期</h1>
      <p class="mt-1 text-sm text-gray-500">管理所有演出排期信息</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "新增演出", new_performance_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
    </div>
  </div>

  <div class="mt-6 bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
    <div class="border-b border-gray-200 px-6 py-4">
      <%= form_with url: performances_path, method: :get, class: "flex items-center gap-4", local: true do |f| %>
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700">状态筛选</label>
          <select name="status" onchange="this.form.submit()" class="rounded-md border-gray-300 py-1.5 pl-3 pr-10 text-sm focus:border-indigo-500 focus:ring-indigo-500">
            <option value="">全部状态</option>
            <% Performance.statuses.each do |key, value| %>
              <option value="<%= value %>" <%= "selected" if params[:status] == value %>><%= t("activerecord.attributes.performance.statuses.#{key}", default: key.humanize) %></option>
            <% end %>
          </select>
        </div>
        <% if params[:status].present? %>
          <%= link_to "清除筛选", performances_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
        <% end %>
      <% end %>
    </div>

    <table class="min-w-full divide-y divide-gray-300">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="py-3.5 pl-6 pr-3 text-left text-sm font-semibold text-gray-900">名称</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">场馆</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">开始时间</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">结束时间</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">状态</th>
          <th scope="col" class="relative py-3.5 pr-6 pl-3 text-right text-sm font-semibold text-gray-900">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @performances.each do |p| %>
          <tr class="hover:bg-gray-50">
            <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm font-medium text-gray-900">
              <%= link_to p.name, performance_path(p), class: "text-indigo-600 hover:text-indigo-500" %>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= p.venue %></td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= l(p.start_time, format: :short) if p.start_time %></td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= l(p.end_time, format: :short) if p.end_time %></td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
              <span class="<%= case p.status
                               when 'draft' then 'bg-gray-100 text-gray-700'
                               when 'published' then 'bg-blue-100 text-blue-700'
                               when 'ongoing' then 'bg-green-100 text-green-700'
                               when 'finished' then 'bg-purple-100 text-purple-700'
                               when 'cancelled' then 'bg-red-100 text-red-700'
                               end %> inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium">
                <%= p.status %>
              </span>
            </td>
            <td class="whitespace-nowrap py-4 pr-6 pl-3 text-right text-sm">
              <div class="flex justify-end gap-2">
                <%= link_to "查看", performance_path(p), class: "text-indigo-600 hover:text-indigo-500" %>
                <%= link_to "编辑", edit_performance_path(p), class: "text-indigo-600 hover:text-indigo-500" %>
                <%= button_to "删除", performance_path(p), method: :delete, form: { data: { turbo_confirm: "确认删除该演出排期？" } }, class: "text-red-600 hover:text-red-500" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @performances.empty? %>
      <div class="py-12 text-center">
        <p class="text-sm text-gray-500">暂无演出排期数据</p>
      </div>
    <% end %>

    <%= pagination_links(pagination_info) %>
  </div>
</div>
