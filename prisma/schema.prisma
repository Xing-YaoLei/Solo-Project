generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id      String   @id @default(cuid())
  name    String
  code    String   @unique
  users   User[]
  members Member[]

  @@map("stores")
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  name       String
  password   String
  role       String     // "admin" | "manager" | "staff"
  storeId    String
  store      Store      @relation(fields: [storeId], references: [id])
  followUps  FollowUp[]
  createdAt  DateTime   @default(now())

  @@map("users")
}

model Member {
  id            String                 @id @default(cuid())
  name          String
  phone         String
  storeId       String
  store         Store                  @relation(fields: [storeId], references: [id])
  riskLevel     String                 // "high" | "medium" | "low"
  age           Int?
  gender        String?
  chronicTypes  String[]               // 慢病类型：高血压、糖尿病等
  registeredAt  DateTime               @default(now())
  prescriptions Prescription[]
  medications   MedicationRecord[]
  followUps     FollowUp[]
  insurance     InsuranceTransaction[]

  @@map("members")
}

model Prescription {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation(fields: [memberId], references: [id])
  drugName      String
  dosage        String
  frequency     String?
  issueDate     DateTime
  doctorName    String?
  isClear       Boolean      @default(true)
  importBatchId String?
  annotations   Annotation[]

  @@map("prescriptions")
}

model MedicationRecord {
  id             String   @id @default(cuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id])
  drugName       String
  drugSku        String?
  quantity       Int
  unitPrice      Decimal? @db.Decimal(10, 2)
  purchaseDate   DateTime
  storeId        String?
  importBatchId  String?

  @@map("medication_records")
}

model FollowUp {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation(fields: [memberId], references: [id])
  assigneeId    String
  assignee      User         @relation(fields: [assigneeId], references: [id])
  status        String       // "pending" | "completed" | "annotated"
  scheduledDate DateTime
  completedDate DateTime?
  notes         String?
  annotations   Annotation[]
  createdAt     DateTime     @default(now())

  @@map("follow_ups")
}

model Annotation {
  id              String        @id @default(cuid())
  followUpId      String
  followUp        FollowUp      @relation(fields: [followUpId], references: [id])
  prescriptionId  String?
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  content         String
  createdById     String
  createdAt       DateTime      @default(now())

  @@map("annotations")
}

model Drug {
  id        String               @id @default(cuid())
  name      String
  sku       String               @unique
  category  String               // 药品分类：心血管、降糖等
  batches   InventoryBatch[]
  replenish ReplenishmentOrder[]

  @@map("drugs")
}

model InventoryBatch {
  id            String   @id @default(cuid())
  drugId        String
  drug          Drug     @relation(fields: [drugId], references: [id])
  batchNo       String
  expiryDate    DateTime
  quantity      Int
  storeId       String?
  importBatchId String?

  @@map("inventory_batches")
}

model ReplenishmentOrder {
  id            String   @id @default(cuid())
  drugId        String
  drug          Drug     @relation(fields: [drugId], references: [id])
  quantity      Int
  orderDate     DateTime
  storeId       String?
  importBatchId String?

  @@map("replenishment_orders")
}

model ImportBatch {
  id           String         @id @default(cuid())
  source       String         // "pos" | "member" | "inventory" | "insurance"
  status       String         // "pending" | "processing" | "completed" | "failed"
  totalRecords Int            @default(0)
  successCount Int            @default(0)
  errorCount   Int            @default(0)
  fileName     String?
  importedBy   String
  importedAt   DateTime       @default(now())
  records      ImportRecord[]

  @@map("import_batches")
}

model ImportRecord {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id])
  rawData   Json
  status    String      // "success" | "skipped" | "error"
  errorMsg  String?
  mappedId  String?
  createdAt DateTime    @default(now())

  @@map("import_records")
}

model InsuranceTransaction {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  count           Int      @default(1)
  transactionDate DateTime
  storeId         String?
  importBatchId   String?

  @@map("insurance_transactions")
}
