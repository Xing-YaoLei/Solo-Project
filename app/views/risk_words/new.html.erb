<% provide :title, '新建风险词' %>

<div class="mb-6">
  <%= link_to '← 返回列表', risk_words_path, class: "text-blue-600 hover:text-blue-800 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h1 class="text-xl font-bold text-gray-900">新建风险词</h1>
  </div>

  <%= form_with model: @risk_word, local: true do |f| %>
    <% if @risk_word.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <h2 class="text-red-700 font-medium"><%= pluralize(@risk_word.errors.count, "个错误") %> 阻止了保存：</h2>
        <ul class="mt-2 text-sm text-red-600">
          <% @risk_word.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :word, '风险词', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :word, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div class="grid grid-cols-2 gap-6">
        <div>
          <%= f.label :category, '分类', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :category, RiskWord::CATEGORIES.map { |k, v| [v, k] }, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        <div>
          <%= f.label :risk_level, '风险等级', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :risk_level, [['高', 'high'], ['中', 'medium'], ['低', 'low']], {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div>
        <%= f.label :description, '描述', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
      <%= link_to '取消', risk_words_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium" %>
      <%= f.submit '创建', class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
    </div>
  <% end %>
</div>
