<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-gray-900">配件库存</h2>
  <div class="flex flex-wrap gap-2">
    <%= link_to "全部", parts_path, class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium #{params[:filter].blank? ? 'bg-blue-600 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
    <%= link_to "低库存", parts_path(filter: 'low_stock'), class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium #{params[:filter] == 'low_stock' ? 'bg-yellow-600 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
    <%= link_to "缺货", parts_path(filter: 'out_of_stock'), class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium #{params[:filter] == 'out_of_stock' ? 'bg-red-600 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
    <%= link_to new_part_path, class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-blue-700" do %>
      <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      新增配件
    <% end %>
  </div>
</div>

<div class="mb-6 rounded-lg border border-gray-200 bg-white p-4">
  <%= search_form_for @q, url: parts_path, method: :get, html: { class: "grid grid-cols-1 gap-4 md:grid-cols-4" } do |f| %>
    <div>
      <%= f.label :name_cont, "名称", class: "block text-sm font-medium text-gray-700" %>
      <%= f.search_field :name_cont, class: "mt-1 block w-full rounded-md border-gray-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :sku_cont, "SKU", class: "block text-sm font-medium text-gray-700" %>
      <%= f.search_field :sku_cont, class: "mt-1 block w-full rounded-md border-gray-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :category_eq, "分类", class: "block text-sm font-medium text-gray-700" %>
      <%= f.search_field :category_eq, class: "mt-1 block w-full rounded-md border-gray-300 py-2 px-3 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
    </div>
    <div class="flex items-end space-x-2">
      <%= f.submit "搜索", class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
      <%= link_to "重置", parts_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
    <% if params[:filter].present? %>
      <%= hidden_field_tag :filter, params[:filter] %>
    <% end %>
  <% end %>
</div>

<% if @parts.any? %>
  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">SKU</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">名称</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">分类</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">库存数量</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">安全库存</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">成本价</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">售价</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @parts.each do |part| %>
          <% row_class = if part.stock_quantity == 0
                          "bg-red-50"
                        elsif part.low_stock?
                          "bg-yellow-50"
                        else
                          ""
                        end %>
          <tr class="<%= row_class %> hover:bg-gray-50">
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to part.sku, part, class: "text-blue-600 hover:text-blue-900" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= part.name %></div>
              <% if part.specification.present? %>
                <div class="text-xs text-gray-500"><%= part.specification %></div>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= part.category.presence || '-' %></td>
            <td class="whitespace-nowrap px-6 py-4">
              <div class="flex items-center space-x-2">
                <span class="text-sm font-medium <%= part.stock_quantity == 0 ? 'text-red-600' : part.low_stock? ? 'text-yellow-600' : 'text-gray-900' %>">
                  <%= part.stock_quantity %> <%= part.unit %>
                </span>
                <% if part.stock_quantity == 0 %>
                  <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800">缺货</span>
                <% elsif part.low_stock? %>
                  <span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800">低库存</span>
                <% end %>
              </div>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= part.safety_stock %> <%= part.unit %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">¥<%= number_with_precision(part.cost_price, precision: 2) %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">¥<%= number_with_precision(part.selling_price, precision: 2) %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
              <%= link_to "查看", part, class: "text-blue-600 hover:text-blue-900" %>
              <%= link_to "编辑", edit_part_path(part), class: "ml-3 text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if defined?(@pagy) && @pagy.pages > 1 %>
    <div class="mt-6">
      <%= pagy_nav(@pagy) if defined?(pagy_nav) %>
    </div>
  <% end %>
<% else %>
  <div class="rounded-lg border border-gray-200 bg-white py-12 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    <h3 class="mt-2 text-sm font-medium text-gray-900">暂无配件</h3>
    <p class="mt-1 text-sm text-gray-500">点击上方按钮新增配件</p>
  </div>
<% end %>
