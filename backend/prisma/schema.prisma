generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATION_MANAGER
  TICKET_STAFF
  FINANCE
  SPONSOR_CONTACT
  PERFORMER
}

enum OrderStatus {
  PENDING
  PAID
  VERIFIED
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUNDED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  PROCESSING
  RESOLVED
  CLOSED
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  REFUND
  DISPUTE_OPEN
  DISPUTE_RESOLVE
  DISPUTE_CLOSE
  ASSIGN
  EXPORT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  name      String
  email     String?  @unique
  phone     String?
  role      Role
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTasks  PerformanceTask[] @relation("assignedTasks")
  createdTasks   PerformanceTask[] @relation("createdTasks")
  createdOrders  Order[]           @relation("orderCreator")
  verifications  VerificationRecord[]
  disputeHandles RefundDispute[]   @relation("disputeHandler")
  notifications  Notification[]
  exports        ExportRecord[]

  @@map("users")
}

model PerformanceSchedule {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  venue       String
  capacity    Int
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticketTypes TicketType[]
  tasks       PerformanceTask[]
  sponsors    Sponsor[]
  orders      Order[]

  @@index([startTime])
  @@map("performance_schedules")
}

model PerformanceTask {
  id          Int        @id @default(autoincrement())
  scheduleId  Int
  title       String
  description String?
  type        String
  priority    Int        @default(1)
  status      TaskStatus @default(PENDING)
  assigneeId  Int?
  creatorId   Int
  startTime   DateTime?
  endTime     DateTime?
  dueTime     DateTime?
  remark      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schedule   PerformanceSchedule @relation(fields: [scheduleId], references: [id])
  assignee   User?               @relation("assignedTasks", fields: [assigneeId], references: [id])
  creator    User                @relation("createdTasks", fields: [creatorId], references: [id])
  changeLogs TaskChangeLog[]

  @@index([scheduleId])
  @@index([assigneeId])
  @@index([status])
  @@map("performance_tasks")
}

model TaskChangeLog {
  id          Int      @id @default(autoincrement())
  taskId      Int
  fieldName   String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  operatorId  Int?
  remark      String?
  createdAt   DateTime @default(now())

  task PerformanceTask @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("task_change_logs")
}

model Sponsor {
  id          Int      @id @default(autoincrement())
  scheduleId  Int
  name        String
  level       String
  amount      Decimal  @db.Decimal(12, 2)
  contactName String?
  contactPhone String?
  benefits    String?  @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule PerformanceSchedule @relation(fields: [scheduleId], references: [id])

  @@index([scheduleId])
  @@map("sponsors")
}

model TicketType {
  id          Int      @id @default(autoincrement())
  scheduleId  Int
  name        String
  price       Decimal  @db.Decimal(10, 2)
  totalCount  Int
  soldCount   Int      @default(0)
  description String?
  rules       String?  @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule PerformanceSchedule @relation(fields: [scheduleId], references: [id])
  orders   Order[]

  @@index([scheduleId])
  @@map("ticket_types")
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNo        String      @unique
  scheduleId     Int
  ticketTypeId   Int
  buyerName      String
  buyerPhone     String
  quantity       Int
  totalAmount    Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  creatorId      Int
  remark         String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  schedule    PerformanceSchedule @relation(fields: [scheduleId], references: [id])
  ticketType  TicketType          @relation(fields: [ticketTypeId], references: [id])
  creator     User                @relation("orderCreator", fields: [creatorId], references: [id])
  changeLogs  OrderChangeLog[]
  verifications VerificationRecord[]
  disputes    RefundDispute[]

  @@index([scheduleId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([buyerPhone])
  @@map("orders")
}

model OrderChangeLog {
  id         Int      @id @default(autoincrement())
  orderId    Int
  fieldName  String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  operatorId Int?
  remark     String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_change_logs")
}

model VerificationRecord {
  id          Int      @id @default(autoincrement())
  orderId     Int
  verifierId  Int
  verifyTime  DateTime @default(now())
  quantity    Int
  verifyMethod String
  remark      String?
  createdAt   DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  verifier User  @relation(fields: [verifierId], references: [id])

  @@index([orderId])
  @@index([verifierId])
  @@index([verifyTime])
  @@map("verification_records")
}

model RefundDispute {
  id           Int            @id @default(autoincrement())
  orderId      Int
  title        String
  reason       String         @db.Text
  status       DisputeStatus  @default(OPEN)
  initiatorId  Int?
  handlerId    Int?
  resolution   String?        @db.Text
  closeTime    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order     Order  @relation(fields: [orderId], references: [id])
  handler   User?  @relation("disputeHandler", fields: [handlerId], references: [id])
  logs      DisputeLog[]

  @@index([orderId])
  @@index([status])
  @@index([handlerId])
  @@map("refund_disputes")
}

model DisputeLog {
  id         Int      @id @default(autoincrement())
  disputeId  Int
  action     LogAction
  description String  @db.Text
  operatorId Int?
  createdAt  DateTime @default(now())

  dispute RefundDispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("dispute_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  content   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  relatedId Int?
  relatedType String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ExportRecord {
  id           Int      @id @default(autoincrement())
  filename     String
  exportType   String
  filterConditions Json
  operatorId   Int
  recordCount  Int
  fileUrl      String?
  createdAt    DateTime @default(now())

  operator User @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@map("export_records")
}

model SystemLog {
  id           Int      @id @default(autoincrement())
  action       LogAction
  module       String
  description  String   @db.Text
  operatorId   Int?
  operatorName String?
  relatedId    Int?
  relatedType  String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([operatorId])
  @@index([createdAt])
  @@map("system_logs")
}
