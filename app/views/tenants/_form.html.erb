<%= form_with model: tenant, local: true do |f| %>
  <% if tenant.errors.any? %>
    <div class="form-errors">
      <ul>
        <% tenant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "名称" %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :contact_person, "联系人" %>
    <%= f.text_field :contact_person %>
  </div>

  <div class="form-group">
    <%= f.label :contact_phone, "联系电话" %>
    <%= f.text_field :contact_phone %>
  </div>

  <div class="form-group">
    <%= f.label :email, "邮箱" %>
    <%= f.email_field :email %>
  </div>

  <div class="form-group">
    <%= f.label :address, "地址" %>
    <%= f.text_field :address %>
  </div>

  <div class="form-group">
    <%= f.label :remark, "备注" %>
    <%= f.text_area :remark, rows: 3 %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "取消", tenants_path, class: "btn" %>
  </div>
<% end %>
