{
  "name": "legal-case-delegation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "cd apps/api && pnpm run start:dev",
    "dev:web": "cd apps/web && pnpm run dev",
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "build:shared": "cd packages/shared && pnpm run build",
    "build:api": "cd apps/api && pnpm run build",
    "build:web": "cd apps/web && pnpm run build",
    "build": "pnpm run build:shared && pnpm run build:api && pnpm run build:web",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  }
}
