<% content_for :title, "价格规则" %>

<div class="page-header">
  <h1 class="page-title">💰 价格规则</h1>
  <% if policy(PriceRule).create? && @package %>
    <%= link_to "新建规则", new_package_price_rule_path(@package), class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card">
  <% if @price_rules.any? %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>规则名称</th>
            <th>套餐</th>
            <th>类型</th>
            <th>值</th>
            <th>适用渠道</th>
            <th>有效期</th>
            <th>状态</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @price_rules.each do |rule| %>
            <tr>
              <td><strong><%= rule.name %></strong></td>
              <td><%= rule.package.name %></td>
              <td><%= rule_type_label(rule) %></td>
              <td><%= rule_value_label(rule) %></td>
              <td><%= rule.channel ? rule.channel.name : '全部渠道' %></td>
              <td>
                <% if rule.start_date || rule.end_date %>
                  <%= rule.start_date&.strftime('%Y-%m-%d') || '不限' %> - <%= rule.end_date&.strftime('%Y-%m-%d') || '不限' %>
                <% else %>
                  永久有效
                <% end %>
              </td>
              <td>
                <span class="badge badge-<%= rule.status %>">
                  <%= rule.active? ? '启用' : '禁用' %>
                </span>
              </td>
              <td>
                <div class="btn-group">
                  <%= link_to "查看", rule, class: "btn btn-secondary btn-sm" %>
                  <% if policy(rule).edit? %>
                    <%= link_to "编辑", edit_price_rule_path(rule), class: "btn btn-secondary btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">💰</div>
      <p>暂无价格规则</p>
    </div>
  <% end %>
</div>
