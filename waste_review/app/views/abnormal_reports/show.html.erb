<% content_for :page_title, "异常单 ##{@abnormal_report.id}" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">异常单 #<%= @abnormal_report.id %></h1>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <h3 class="text-lg font-semibold text-gray-800 mb-4">异常详情</h3>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <div>
      <span class="text-sm text-gray-500">关联报损单</span>
      <p class="text-gray-900 font-medium">
        <%= link_to "##{@abnormal_report.waste_report_id}", waste_report_path(@abnormal_report.waste_report), class: "text-blue-600 hover:text-blue-800" %>
      </p>
    </div>
    <div>
      <span class="text-sm text-gray-500">严重程度</span>
      <p class="mt-1">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
          <%= case @abnormal_report.severity
             when 'low' then 'bg-yellow-100 text-yellow-800'
             when 'medium' then 'bg-orange-100 text-orange-800'
             when 'high' then 'bg-red-100 text-red-800'
             end %>">
          <%= case @abnormal_report.severity
             when 'low' then '低'
             when 'medium' then '中'
             when 'high' then '高'
             end %>
        </span>
      </p>
    </div>
    <div>
      <span class="text-sm text-gray-500">是否解决</span>
      <p class="mt-1">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
          <%= @abnormal_report.resolved? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
          <%= @abnormal_report.resolved? ? "已解决" : "未解决" %>
        </span>
      </p>
    </div>
    <div class="col-span-2 md:col-span-3">
      <span class="text-sm text-gray-500">影响范围</span>
      <p class="text-gray-900 mt-1"><%= @abnormal_report.impact_scope.presence || "-" %></p>
    </div>
    <div class="col-span-2 md:col-span-3">
      <span class="text-sm text-gray-500">责任归属</span>
      <p class="text-gray-900 mt-1"><%= @abnormal_report.responsibility_attribution.presence || "-" %></p>
    </div>
    <div class="col-span-2 md:col-span-3">
      <span class="text-sm text-gray-500">处理结果</span>
      <p class="mt-1">
        <% if @abnormal_report.handling_result.present? %>
          <% if @abnormal_report.resolved? %>
            <span class="font-medium text-green-700"><%= @abnormal_report.handling_result %></span>
          <% else %>
            <span class="text-amber-700 bg-amber-50 px-2 py-1 rounded"><%= @abnormal_report.handling_result %></span>
          <% end %>
        <% else %>
          <span class="text-gray-400">-</span>
        <% end %>
      </p>
    </div>
  </div>
</div>

<% unless @abnormal_report.resolved? %>
  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">处理异常</h3>
    <%= form_with model: @abnormal_report, url: abnormal_report_path(@abnormal_report), method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :handling_result, "处理结果", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :handling_result, rows: 3, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "请输入处理结果..." %>
      </div>
      <div class="flex gap-3">
        <%= f.submit "提交并解决", class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 cursor-pointer" %>
        <%= button_to "直接标记解决", resolve_abnormal_report_path(@abnormal_report), method: :post, class: "bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-green-50 border border-green-200 rounded-lg p-6">
    <div class="flex items-center gap-2">
      <span class="text-green-600 text-lg">✓</span>
      <span class="text-green-800 font-medium">该异常已解决</span>
      <% if @abnormal_report.resolved_at.present? %>
        <span class="text-green-600 text-sm">(<%= @abnormal_report.resolved_at.strftime("%Y-%m-%d %H:%M") %>)</span>
      <% end %>
    </div>
    <% if @abnormal_report.handling_result.present? %>
      <p class="mt-2 text-green-700 text-sm">处理结果: <%= @abnormal_report.handling_result %></p>
    <% end %>
  </div>
<% end %>
