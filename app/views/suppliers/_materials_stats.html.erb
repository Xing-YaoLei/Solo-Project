<div id="materials_stats" class="grid grid-cols-2 gap-3">
  <% total = supplier.materials.count %>
  <% approved = supplier.materials.approved.count %>
  <% pending = supplier.pending_materials_count %>
  <% expired = supplier.expired_materials_count %>
  <% expiring_soon = supplier.materials.expiring_soon(30).count %>

  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium text-gray-500">材料总数</p>
      <span class="text-lg font-bold text-gray-900"><%= total %></span>
    </div>
    <div class="mt-2 w-full bg-gray-200 rounded-full h-1.5">
      <div class="bg-gray-500 h-1.5 rounded-full" style="width: 100%"></div>
    </div>
  </div>

  <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-4">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium text-emerald-700">已通过</p>
      <span class="text-lg font-bold text-emerald-700"><%= approved %></span>
    </div>
    <div class="mt-2 w-full bg-emerald-200 rounded-full h-1.5">
      <div class="bg-emerald-500 h-1.5 rounded-full" style="width: <%= total > 0 ? (approved.to_f / total * 100).round : 0 %>%"></div>
    </div>
  </div>

  <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium text-yellow-700">待审核</p>
      <span class="text-lg font-bold text-yellow-700"><%= pending %></span>
    </div>
    <div class="mt-2 w-full bg-yellow-200 rounded-full h-1.5">
      <div class="bg-yellow-500 h-1.5 rounded-full" style="width: <%= total > 0 ? (pending.to_f / total * 100).round : 0 %>%"></div>
    </div>
  </div>

  <div class="rounded-lg border border-red-200 bg-red-50 p-4">
    <div class="flex items-center justify-between">
      <p class="text-xs font-medium text-red-700">已过期</p>
      <span class="text-lg font-bold text-red-700"><%= expired %></span>
    </div>
    <div class="mt-2 w-full bg-red-200 rounded-full h-1.5">
      <div class="bg-red-500 h-1.5 rounded-full" style="width: <%= total > 0 ? (expired.to_f / total * 100).round : 0 %>%"></div>
    </div>
  </div>

  <% if expiring_soon > 0 %>
    <div class="col-span-2 rounded-lg border border-amber-200 bg-gradient-to-r from-amber-50 to-orange-50 p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-amber-600 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <p class="text-sm font-medium text-amber-800"><%= expiring_soon %> 份材料将在30天内过期</p>
        </div>
        <%= link_to "查看详情", supplier_path(supplier, anchor: "materials_list"), class: "text-xs font-medium text-amber-700 hover:text-amber-900" %>
      </div>
    </div>
  <% end %>
</div>
