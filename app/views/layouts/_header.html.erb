<header class="bg-white border-b border-slate-200 shadow-sm">
  <div class="flex items-center justify-between h-16 px-6">
    <div class="flex items-center">
      <button type="button" id="sidebar-toggle" class="lg:hidden p-2 rounded-lg hover:bg-slate-100 mr-3">
        <i data-lucide="menu" class="w-5 h-5 text-slate-600"></i>
      </button>
      <div>
        <h1 class="text-lg font-semibold text-slate-800"><%= page_title %></h1>
        <p class="text-xs text-slate-500"><%= I18n.l(Date.current, format: :long) %></p>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <div class="hidden md:flex items-center bg-slate-50 rounded-lg px-3 py-2">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 mr-2"></i>
        <input type="text" placeholder="快速搜索..." class="bg-transparent border-none outline-none text-sm text-slate-600 placeholder-slate-400 w-48">
      </div>

      <div class="relative">
        <%= link_to notifications_path, class: "relative p-2 rounded-lg hover:bg-slate-100 transition-colors", data: { turbo: false } do %>
          <i data-lucide="bell" class="w-5 h-5 text-slate-600"></i>
          <% if current_user.unread_notifications_count > 0 %>
            <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-xs rounded-full flex items-center justify-center font-medium">
              <%= current_user.unread_notifications_count > 9 ? "9+" : current_user.unread_notifications_count %>
            </span>
          <% end %>
        <% end %>
      </div>

      <div class="h-6 w-px bg-slate-200"></div>

      <div class="relative" data-controller="dropdown">
        <button type="button" data-action="dropdown#toggle" class="flex items-center space-x-3 p-1.5 rounded-lg hover:bg-slate-100 transition-colors">
          <div class="hidden sm:block text-right">
            <p class="text-sm font-medium text-slate-800"><%= current_user.name %></p>
            <p class="text-xs text-slate-500">
              <%= I18n.t("user_roles.#{current_user.role}", default: current_user.role.to_s.humanize) %>
            </p>
          </div>
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-600 to-orange-500 flex items-center justify-center text-white font-medium text-sm">
            <%= current_user.name.first(1).upcase %>
          </div>
        </button>

        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-slate-200 py-2 z-50">
          <div class="px-4 py-3 border-b border-slate-100 sm:hidden">
            <p class="text-sm font-medium text-slate-800"><%= current_user.name %></p>
            <p class="text-xs text-slate-500"><%= current_user.email %></p>
          </div>

          <%= link_to edit_user_registration_path, class: "flex items-center px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50", data: { turbo: false } do %>
            <i data-lucide="user" class="w-4 h-4 mr-3 text-slate-400"></i>
            个人设置
          <% end %>

          <% if current_user.can_manage_system? %>
            <%= link_to admin_dashboard_path, class: "flex items-center px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50", data: { turbo: false } do %>
              <i data-lucide="settings" class="w-4 h-4 mr-3 text-slate-400"></i>
              系统管理
            <% end %>
          <% end %>

          <%= link_to export_records_path, class: "flex items-center px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50", data: { turbo: false } do %>
            <i data-lucide="download" class="w-4 h-4 mr-3 text-slate-400"></i>
            导出记录
          <% end %>

          <div class="border-t border-slate-100 mt-2 pt-2">
            <%= link_to destroy_user_session_path, method: :delete, class: "flex items-center px-4 py-2.5 text-sm text-red-600 hover:bg-red-50", data: { turbo: false } do %>
              <i data-lucide="log-out" class="w-4 h-4 mr-3"></i>
              退出登录
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
