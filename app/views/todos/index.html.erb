<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">待办事项</h1>
      <p class="text-gray-500 mt-1">我的待办任务列表</p>
    </div>
    <%= link_to "新增待办", new_todo_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <div class="p-4 border-b border-gray-100">
      <%= search_form_for @q, url: todos_path, method: :get do |f| %>
        <div class="flex flex-wrap gap-4 items-end">
          <div>
            <%= f.label :title_cont, "标题", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.search_field :title_cont, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status_eq, Todo.statuses.map { |k, v| [status_text(k), v] }, { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div>
            <%= f.label :priority_eq, "优先级", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :priority_eq, Todo.priorities.map { |k, v| [priority_text(k), v] }, { include_blank: "全部" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="flex gap-2">
            <%= f.submit "搜索", class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
            <%= link_to "重置", todos_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="divide-y divide-gray-200">
      <% @todos.each do |todo| %>
        <div class="p-4 hover:bg-gray-50">
          <div class="flex items-start justify-between">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 mt-2 rounded-full <%= todo.priority == 'urgent' ? 'bg-red-500' : todo.priority == 'high' ? 'bg-orange-500' : 'bg-blue-500' %>"></div>
              <div>
                <%= link_to todo.title, todo, class: "font-medium text-gray-900 hover:text-indigo-600" %>
                <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= todo.description %></p>
                <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                  <span>截止: <%= format_date(todo.due_date) %></span>
                  <span>优先级: <%= priority_text(todo.priority) %></span>
                </div>
              </div>
            </div>
            <span class="px-2 py-1 text-xs rounded-full <%= status_class(todo.status) %>">
              <%= status_text(todo.status) %>
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="px-6 py-4 border-t border-gray-100">
      <%= paginate @todos %>
    </div>
  </div>
</div>
