<div class="space-y-6">
  <div class="flex items-center gap-4">
    <%= link_to processing_records_path, class: "p-2 rounded-lg hover:bg-gray-100" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑处理记录</h1>
      <p class="text-gray-500 mt-1"><%= @processing_record.action_type %></p>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100">
    <%= form_with model: @processing_record, local: true do |form| %>
      <% if @processing_record.errors.any? %>
        <div class="p-4 bg-red-50 border-b border-red-100">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(@processing_record.errors.count, "个错误") %> 禁止保存：
          </h3>
          <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
            <% @processing_record.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="p-6 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :action_type, "处理类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :action_type, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", required: true %>
          </div>

          <div>
            <%= form.label :status, "处理状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :status, ProcessingRecord.statuses.map { |k, v| [status_text(k), k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
        </div>

        <% if @processing_record.recordable.respond_to?(:status) %>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :previous_status, "变更前状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.hidden_field :previous_status %>
              <%= text_field_tag :previous_status_display, @processing_record.previous_status.present? ? status_text(@processing_record.previous_status) : status_text(@processing_record.recordable.status), class: "w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg text-gray-600", readonly: true %>
            </div>
            <div>
              <%= form.label :next_status, "变更后状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :next_status, @processing_record.recordable.class.statuses.map { |k, v| [status_text(k), k] }, { include_blank: "不变更" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
          </div>
        <% end %>

        <div>
          <%= form.label :notes, "备注说明", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :notes, rows: 5, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <%= link_to "取消", processing_record_path(@processing_record), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50" %>
        <%= form.submit "保存更改", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>
