<% content_for :title, "添加核销码" %>

<div class="page-header">
  <h1 class="page-title">🎫 添加核销码</h1>
  <%= link_to "返回订单", order_path(@order), class: "btn btn-secondary" %>
</div>

<div class="card">
  <%= form_with model: @redemption_record, url: order_redemption_records_path(@order) do |f| %>
    <div class="form-group">
      <label class="form-label">关联订单</label>
      <div class="detail-value"><%= @order.order_number %> - <%= @order.package.name %></div>
    </div>

    <div class="form-group">
      <%= f.label :redemption_code, "核销码", class: "form-label" %>
      <%= f.text_field :redemption_code, class: "form-input", placeholder: "留空将自动生成" %>
      <div style="font-size: 0.8rem; color: #718096; margin-top: 4px;">
        留空将自动生成随机核销码
      </div>
    </div>

    <div class="form-group">
      <%= f.label :notes, "备注", class: "form-label" %>
      <%= f.text_area :notes, class: "form-textarea", rows: 3 %>
    </div>

    <div class="form-actions">
      <%= f.submit "创建核销码", class: "btn btn-primary" %>
      <%= link_to "取消", order_path(@order), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
