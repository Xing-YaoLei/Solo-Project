<%= turbo_frame_tag dom_id(work_order_item || WorkOrderItem.new) do %>
  <%= form_with model: [work_order, work_order_item], local: true, html: { class: 'space-y-4' } do |f| %>
    <% if work_order_item&.errors&.any? %>
      <div class="rounded-lg bg-red-50 border border-red-200 p-4">
        <ul class="list-disc pl-5 space-y-1">
          <% work_order_item.errors.each do |error| %>
            <li class="text-sm text-red-700"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, '项目名称', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.text_field :name, class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500', placeholder: '如：更换机油' %>
      </div>
      <div>
        <%= f.label :quantity, '数量', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.number_field :quantity, min: 1, class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500' %>
      </div>
      <div>
        <%= f.label :unit_price, '单价', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.number_field :unit_price, step: '0.01', class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500', placeholder: '0.00' %>
      </div>
      <div>
        <%= f.label :labor_fee, '工时费', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.number_field :labor_fee, step: '0.01', class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500', placeholder: '0.00' %>
      </div>
      <div>
        <%= f.label :status, '状态', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.select :status, WorkOrderItem::STATUSES.map { |s| [{ pending: '待处理', in_progress: '进行中', completed: '已完成' }[s.to_sym] || s, s] }, {}, class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500' %>
      </div>
      <div>
        <%= f.label :technician_id, '技术员', class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= f.select :technician_id, User.all.map { |u| [u.name, u.id] }, { include_blank: '未分配' }, class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500' %>
      </div>
    </div>

    <div>
      <%= f.label :description, '描述', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= f.text_area :description, rows: 2, class: 'w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500', placeholder: '可选描述...' %>
    </div>

    <div class="flex flex-col sm:flex-row justify-end gap-2 pt-2">
      <% if work_order_item.persisted? %>
        <%= button_tag '取消', type: 'button', data: { work_order_item_form_cancel: dom_id(work_order_item) }, class: 'inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
      <% else %>
        <%= button_tag '取消', type: 'button', data: { work_order_item_form_toggle: true }, class: 'inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
      <% end %>
      <%= f.submit class: 'inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>
  <% end %>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-work_order_item_form_cancel]').forEach(btn => {
    btn.addEventListener('click', function() {
      const frameId = this.dataset.work_order_item_form_cancel;
      const frame = document.getElementById(frameId);
      if (frame) frame.reload();
    });
  });
});
</script>
