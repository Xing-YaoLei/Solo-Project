<% content_for :title, "学员报名 - 职业教育结算台" %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">学员报名</h1>
      <p class="mt-1 text-sm text-gray-500">查看所有学员报名记录，包含学习进度、考试记录等</p>
    </div>
    <%= link_to new_enrollment_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" do %>
      <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
      </svg>
      新增报名
    <% end %>
  </div>

  <div class="mt-4 flex space-x-4">
    <%= link_to "全部", enrollments_path, class: "text-sm #{params[:status].blank? ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "学习中", enrollments_path(status: :studying), class: "text-sm #{params[:status] == 'studying' ? 'text-green-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已完成", enrollments_path(status: :completed), class: "text-sm #{params[:status] == 'completed' ? 'text-purple-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已过期", enrollments_path(status: :expired), class: "text-sm #{params[:status] == 'expired' ? 'text-gray-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "进度落后", enrollments_path(behind_schedule: true), class: "text-sm #{params[:behind_schedule] ? 'text-red-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
  </div>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学员</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学习进度</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">考试状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">证书</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">有效期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @enrollments.each do |enrollment| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
                  <span class="text-indigo-600 font-medium"><%= enrollment.user&.name&.first %></span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900"><%= enrollment.user&.name %></div>
                  <div class="text-sm text-gray-500"><%= enrollment.user&.email %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= enrollment.course&.title %></div>
              <div class="text-xs text-gray-500"><%= enrollment.order&.order_no %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-24 bg-gray-200 rounded-full h-2">
                  <div class="h-2 rounded-full <%= enrollment.behind_schedule? ? 'bg-red-500' : 'bg-green-500' %>" style="width: <%= enrollment.progress_percentage %>%"></div>
                </div>
                <span class="ml-2 text-sm <%= enrollment.behind_schedule? ? 'text-red-600' : 'text-green-600' %>"><%= enrollment.progress_percentage %>%</span>
              </div>
              <% if enrollment.behind_schedule? %>
                <div class="text-xs text-red-600 mt-1">进度落后</div>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if enrollment.exam_passed? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">已通过</span>
              <% elsif enrollment.exam_attempts > 0 %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">已考<%= enrollment.exam_attempts %>次</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">未考试</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if enrollment.certificate_issued? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">已颁发</span>
              <% else %>
                <span class="text-sm text-gray-400">-</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= enrollment.expired_at&.strftime("%Y-%m-%d") %></div>
              <% if enrollment.expired_at && enrollment.expired_at < Date.current %>
                <div class="text-xs text-red-600">已过期</div>
              <% elsif enrollment.expired_at && enrollment.expired_at < 30.days.from_now %>
                <div class="text-xs text-orange-600"><%= distance_of_time_in_words_to_now(enrollment.expired_at) %>后过期</div>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= enrollment_status_class(enrollment.status) %>">
                <%= enrollment_status_text(enrollment.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "详情", enrollment, class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @enrollments.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @enrollments %>
    </div>
  <% end %>
</div>
