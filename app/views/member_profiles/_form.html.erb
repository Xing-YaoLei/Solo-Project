<div class="page-header">
  <%= link_to "← 返回学员详情", student_path(@student), class: "btn-secondary mb-4" %>
  <h1 class="page-title">
    <%= @member_profile.new_record? ? "创建会员档案" : "编辑会员档案" %> - <%= @student.name %>
  </h1>
</div>

<div class="table-container p-6">
  <%= form_with(model: [@student, @member_profile], local: true) do |f| %>
    <% if @member_profile.errors.any? %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <h2 class="font-semibold text-red-800 mb-2">存在 <%= @member_profile.errors.count %> 个错误</h2>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="form-group">
        <%= f.label :member_level, "会员等级", class: "form-label" %>
        <%= f.select :member_level, options_for_select([["普通(basic)", "basic"], ["高级(premium)", "premium"], ["VIP(vip)", "vip"]], @member_profile.member_level), {}, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :payment_status, "支付状态", class: "form-label" %>
        <%= f.select :payment_status, options_for_select([["未付款", "unpaid"], ["已付款", "paid"], ["部分付款", "partially_paid"], ["已退款", "refunded"]], @member_profile.payment_status), {}, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :membership_start_date, "入会日期", class: "form-label" %>
        <%= f.date_field :membership_start_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :membership_end_date, "到期日期", class: "form-label" %>
        <%= f.date_field :membership_end_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :total_points, "累计积分", class: "form-label" %>
        <%= f.number_field :total_points, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :available_points, "可用积分", class: "form-label" %>
        <%= f.number_field :available_points, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :total_amount, "累计消费(¥)", class: "form-label" %>
        <%= f.number_field :total_amount, class: "form-input", step: "0.01" %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :benefits_overview, "权益概览", class: "form-label" %>
        <%= f.text_area :benefits_overview, class: "form-input", rows: 3 %>
      </div>
    </div>

    <div class="mt-8 flex space-x-3">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "取消", student_path(@student), class: "btn-secondary" %>
    </div>
  <% end %>
</div>
