generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())

  members     Member[]
  staff       Staff[]
  batches     ImportBatch[]
  transactions Transaction[]
  redemptions Redemption[]
  inventories Inventory[]
}

model Staff {
  id       String @id @default(cuid())
  storeId  String?
  email    String @unique
  name     String
  role     String // "manager" | "store_staff"
  password String

  store      Store?        @relation(fields: [storeId], references: [id])
  memberNotes MemberNote[]
}

model Member {
  id          String   @id @default(cuid())
  storeId     String
  memberNo    String   @unique
  name        String
  phone       String?
  level       String   @default("普通") // 普通 | 银卡 | 金卡 | 钻石
  totalStored Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  store            Store              @relation(fields: [storeId], references: [id])
  accounts         StoredValueAccount[]
  levelLogs        MemberLevelLog[]
  transactions     Transaction[]
  benefits         Benefit[]
  redemptions      Redemption[]
  refunds          Refund[]
  memberNotes      MemberNote[]
  receipts         Receipt[]
}

model StoredValueAccount {
  id         String   @id @default(cuid())
  memberId   String
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  expireAt   DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  member Member       @relation(fields: [memberId], references: [id])
  flows  AccountFlow[]
}

model AccountFlow {
  id         String   @id @default(cuid())
  accountId  String
  type       String // "deposit" | "consume" | "refund" | "expire"
  amount     Decimal  @db.Decimal(12, 2)
  occurredAt DateTime @default(now())
  source     String? // "pos" | "online" | "adjust"

  account StoredValueAccount @relation(fields: [accountId], references: [id])
}

model MemberLevelLog {
  id         String   @id @default(cuid())
  memberId   String
  fromLevel  String?
  toLevel    String
  changedAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
}

model Benefit {
  id         String   @id @default(cuid())
  memberId   String
  type       String // "coupon" | "stored_value" | "points"
  name       String
  value      Decimal  @db.Decimal(12, 2)
  expireAt   DateTime?
  status     String   @default("active") // active | redeemed | expired

  member      Member       @relation(fields: [memberId], references: [id])
  redemptions Redemption[]
  memberNotes MemberNote[]
}

model Redemption {
  id           String   @id @default(cuid())
  memberId     String
  benefitId    String?
  inventoryId  String?
  storeId      String
  redeemedAt   DateTime @default(now())
  value        Decimal  @db.Decimal(12, 2)
  productName  String?

  member     Member     @relation(fields: [memberId], references: [id])
  benefit    Benefit?   @relation(fields: [benefitId], references: [id])
  inventory  Inventory? @relation(fields: [inventoryId], references: [id])
  store      Store      @relation(fields: [storeId], references: [id])
}

model Refund {
  id            String   @id @default(cuid())
  memberId      String
  transactionId String?
  reason        String
  amount        Decimal  @db.Decimal(12, 2)
  refundedAt    DateTime @default(now())

  member      Member       @relation(fields: [memberId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
}

model Transaction {
  id             String   @id @default(cuid())
  memberId       String?
  storeId        String
  batchId        String?
  type           String // "deposit" | "consume" | "refund"
  amount         Decimal  @db.Decimal(12, 2)
  paymentMethod  String // "stored_value" | "wechat" | "alipay" | "cash"
  transactedAt   DateTime @default(now())

  member     Member?      @relation(fields: [memberId], references: [id])
  store      Store        @relation(fields: [storeId], references: [id])
  batch      ImportBatch? @relation(fields: [batchId], references: [id])
  receipts   Receipt[]
  refunds    Refund[]
}

model Receipt {
  id                   String   @id @default(cuid())
  batchId              String
  transactionId        String?
  memberId             String?
  rawData              String   @db.Text
  totalAmount          Decimal  @db.Decimal(12, 2)
  storedValueDeduction Decimal  @default(0) @db.Decimal(12, 2)

  batch       ImportBatch  @relation(fields: [batchId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
  member      Member?      @relation(fields: [memberId], references: [id])
}

model Inventory {
  id          String   @id @default(cuid())
  batchId     String
  storeId     String
  sku         String
  productName String
  quantity    Int
  costPrice   Decimal  @db.Decimal(12, 2)

  batch       ImportBatch  @relation(fields: [batchId], references: [id])
  store       Store        @relation(fields: [storeId], references: [id])
  redemptions Redemption[]
}

model ImportBatch {
  id            String   @id @default(cuid())
  storeId       String?
  sourceType    String // "receipt" | "inventory" | "pos"
  status        String   @default("pending") // pending | processing | completed | failed
  totalRecords  Int      @default(0)
  successCount  Int      @default(0)
  errorCount    Int      @default(0)
  errorLog      String?  @db.Text
  fileName      String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  store      Store?          @relation(fields: [storeId], references: [id])
  records    ImportRecord[]
  receipts   Receipt[]
  inventories Inventory[]
  transactions Transaction[]
}

model ImportRecord {
  id            String   @id @default(cuid())
  batchId       String
  recordType    String
  rawData       String   @db.Text
  isProcessed   Boolean  @default(false)
  errorMessage  String?  @db.Text

  batch ImportBatch @relation(fields: [batchId], references: [id])
}

model MemberNote {
  id         String   @id @default(cuid())
  memberId   String
  benefitId  String?
  staffId    String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  member   Member   @relation(fields: [memberId], references: [id])
  benefit  Benefit? @relation(fields: [benefitId], references: [id])
  staff    Staff?   @relation(fields: [staffId], references: [id])
}
