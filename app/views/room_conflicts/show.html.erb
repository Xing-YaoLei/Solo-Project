<% content_for :title, "房态冲突详情" %>

<div class="w-full">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">房态冲突详情</h1>
    <%= link_to "返回列表", room_conflicts_path, class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 text-sm font-medium" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">冲突信息</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">冲突日期</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @conflict.conflict_date.strftime("%Y-%m-%d") %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">房源</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @conflict.property.name %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">状态</p>
            <span class="mt-1 px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= @conflict.status_color %>">
              <%= @conflict.status_i18n %>
            </span>
          </div>
          <div>
            <p class="text-sm text-gray-500">处理人</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @conflict.handler&.name || "未分配" %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">创建时间</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @conflict.created_at.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
          <% if @conflict.closed_at.present? %>
            <div>
              <p class="text-sm text-gray-500">关闭时间</p>
              <p class="mt-1 text-sm font-medium text-gray-900"><%= @conflict.closed_at.strftime("%Y-%m-%d %H:%M") %></p>
            </div>
          <% end %>
          <div class="md:col-span-2">
            <p class="text-sm text-gray-500">冲突原因</p>
            <p class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded-md whitespace-pre-wrap"><%= @conflict.reason %></p>
          </div>
        </div>
      </div>

      <% if @conflict.status == "open" %>
        <div class="bg-white shadow-md rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">操作</h2>
          <%= button_to "确认受理", acknowledge_room_conflict_path(@conflict), method: :post, class: "px-6 py-2.5 bg-yellow-500 text-white rounded-md hover:bg-yellow-600 text-sm font-medium transition" %>
        </div>
      <% end %>

      <% if @conflict.status == "acknowledged" %>
        <div class="bg-white shadow-md rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">解决冲突</h2>
          <%= form_with url: resolve_room_conflict_path(@conflict), method: :post, local: true do |f| %>
            <div class="mb-4">
              <%= f.label :action_note, "解决说明", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.text_area :action_note, rows: 4, required: true, placeholder: "请输入解决冲突的具体说明...", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            </div>
            <%= f.submit "提交解决", class: "px-6 py-2.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium transition cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <% if @conflict.status == "resolved" %>
        <div class="bg-white shadow-md rounded-lg p-6">
          <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">操作</h2>
          <%= button_to "关闭冲突", close_room_conflict_path(@conflict), method: :post, class: "px-6 py-2.5 bg-green-600 text-white rounded-md hover:bg-green-700 text-sm font-medium transition" %>
        </div>
      <% end %>

      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">处理动作历史</h2>

        <% if @conflict_actions.any? %>
          <div class="relative">
            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>
            <div class="space-y-6">
              <% @conflict_actions.each do |action| %>
                <div class="relative pl-10">
                  <div class="absolute left-2 w-4 h-4 rounded-full bg-indigo-500 border-4 border-white shadow"></div>
                  <div class="bg-gray-50 rounded-lg p-4">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <span class="text-sm font-semibold text-gray-800"><%= action.action %></span>
                      <span class="text-xs text-gray-500"><%= action.created_at.strftime("%Y-%m-%d %H:%M") %></span>
                    </div>
                    <div class="text-sm text-gray-600 mb-1">
                      <span class="text-gray-500">操作人：</span><%= action.actor&.name %>
                    </div>
                    <% if action.note.present? %>
                      <div class="text-sm text-gray-600">
                        <span class="text-gray-500">备注：</span><%= action.note %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="text-center text-gray-500 py-8">
            暂无处理记录
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
