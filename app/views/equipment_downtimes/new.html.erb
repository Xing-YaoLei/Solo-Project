<div class="page-header">
  <h1>登记设备停机</h1>
  <%= link_to "返回列表", equipment_downtimes_path, class: "btn btn-sm" %>
</div>

<%= form_with model: @equipment_downtime, url: equipment_downtimes_path, local: true do |f| %>
  <% if @equipment_downtime.errors.any? %>
    <div class="form-errors">
      <ul>
        <% @equipment_downtime.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :equipment_name, "设备名称" %>
    <%= f.text_field :equipment_name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :equipment_type, "设备类型" %>
    <%= f.select :equipment_type, options_for_select([
      ["道闸摄像头", "barrier_camera"],
      ["缴费终端", "payment_terminal"],
      ["门禁闸机", "access_gate"],
      ["传感器", "sensor"]
    ]), required: true %>
  </div>

  <div class="form-group">
    <%= f.label :reason, "停机原因" %>
    <%= f.text_field :reason, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :description, "详细描述" %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <div class="form-group">
    <%= f.label :started_at, "停机时间" %>
    <%= f.datetime_local_field :started_at, required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit "登记停机", class: "btn btn-primary" %>
    <%= link_to "取消", equipment_downtimes_path, class: "btn" %>
  </div>
<% end %>
