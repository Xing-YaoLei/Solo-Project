<div class="space-y-6">
  <div class="flex items-center gap-3">
    <%= link_to "← 返回列表", assessment_records_path, class: "text-sm text-gray-500 hover:text-[#1B2A4A] transition-colors", style="font-family: 'Noto Sans SC', sans-serif;" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-[#1B2A4A] mb-6" style="font-family: 'Noto Sans SC', sans-serif;">新建评估记录</h2>

    <%= form_with model: @assessment_record, url: assessment_records_path, class: "space-y-6" do |f| %>
      <% if @assessment_record.errors.any? %>
        <div class="bg-[#EF4444]/10 border border-[#EF4444]/20 rounded-lg p-3">
          <ul class="text-sm text-[#EF4444] list-disc list-inside" style="font-family: 'Noto Sans SC', sans-serif;">
            <% @assessment_record.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm text-gray-600 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">患者 <span class="text-[#EF4444]">*</span></label>
          <%= f.select :patient_id, options_for_select(@patients.map { |p| [p.name, p.id] }, @assessment_record.patient_id), { prompt: "选择患者" }, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'Noto Sans SC', sans-serif;" %>
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">评估量表 <span class="text-[#EF4444]">*</span></label>
          <%= f.select :scale_id, options_for_select(@scales.map { |s| [s.name, s.id] }, @assessment_record.scale_id), { prompt: "选择量表" }, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'Noto Sans SC', sans-serif;", data: { action: "change->assessment#loadItems" } %>
        </div>
        <div>
          <label class="block text-sm text-gray-600 mb-1" style="font-family: 'Noto Sans SC', sans-serif;">评估日期</label>
          <%= f.date_field :assessed_at, value: @assessment_record.assessed_at, class: "w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'DM Sans', sans-serif;" %>
        </div>
      </div>

      <%= f.hidden_field :assessor_id, value: 1 %>
      <%= f.hidden_field :status, value: "completed" %>

      <div id="scale_items_scoring">
        <% if @scale_items.present? %>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-3 bg-[#1B2A4A]/5 border-b border-gray-100">
              <h3 class="text-sm font-semibold text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;">评估项目评分</h3>
            </div>
            <table class="w-full">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500" style="font-family: 'Noto Sans SC', sans-serif;">项目名称</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500" style="font-family: 'Noto Sans SC', sans-serif;">分类</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500" style="font-family: 'DM Sans', sans-serif;">权重</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500" style="font-family: 'Noto Sans SC', sans-serif;">评分 <span class="text-[#EF4444]">*</span></th>
                </tr>
              </thead>
              <tbody>
                <% @scale_items.each_with_index do |item, idx| %>
                  <tr class="<%= idx.even? ? 'bg-white' : 'bg-[#F5F3EF]/50' %> border-b border-gray-50">
                    <td class="px-4 py-3 text-sm text-[#1B2A4A]" style="font-family: 'Noto Sans SC', sans-serif;"><%= item.name %></td>
                    <td class="px-4 py-3 text-sm text-gray-500" style="font-family: 'Noto Sans SC', sans-serif;"><%= item.category %></td>
                    <td class="px-4 py-3 text-sm text-gray-500" style="font-family: 'DM Sans', sans-serif;"><%= item.weight %></td>
                    <td class="px-4 py-3">
                      <%= f.number_field "item_scores[#{item.id}]", value: @assessment_record.item_scores&.dig(item.id.to_s), step: 0.5, placeholder: "输入分数", class: "w-24 px-3 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-[#2DD4A8] focus:border-transparent", style: "font-family: 'DM Sans', sans-serif;" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="bg-[#F5F3EF] rounded-xl p-8 text-center text-gray-400" style="font-family: 'Noto Sans SC', sans-serif;">
            请先选择评估量表
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "提交评估", class: "px-6 py-2 bg-[#2DD4A8] text-white rounded-lg text-sm font-medium hover:bg-[#22b893] transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;" %>
        <%= link_to "取消", assessment_records_path, class: "px-4 py-2 text-gray-500 border border-gray-200 rounded-lg text-sm hover:bg-gray-50 transition-colors", style: "font-family: 'Noto Sans SC', sans-serif;" %>
      </div>
    <% end %>
  </div>
</div>
