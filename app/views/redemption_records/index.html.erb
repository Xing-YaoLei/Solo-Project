<% content_for :title, "核销记录" %>

<div class="page-header">
  <h1 class="page-title">🎫 核销记录</h1>
</div>

<div class="filters-bar">
  <div class="filter-item">
    <label>状态</label>
    <%= select_tag :status, options_for_select([
      ['全部状态', ''],
      ['待核销', 'pending'],
      ['已核销', 'redeemed'],
      ['已过期', 'expired']
    ], params[:status]), class: 'filter-select', onchange: 'this.form.submit()' %>
  </div>
</div>

<div class="card">
  <% if @redemption_records.any? %>
    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>核销码</th>
            <th>订单号</th>
            <th>套餐</th>
            <th>客户</th>
            <th>状态</th>
            <th>核销时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @redemption_records.each do |record| %>
            <tr>
              <td><code><%= record.redemption_code %></code></td>
              <td><%= link_to record.order.order_number, record.order %></td>
              <td><%= record.order.package.name %></td>
              <td><%= record.order.customer_name %></td>
              <td>
                <span class="badge badge-<%= record.status %>">
                  <%= redemption_status_label(record) %>
                </span>
              </td>
              <td>
                <% if record.redeemed_at.present? %>
                  <%= record.redeemed_at.strftime('%Y-%m-%d %H:%M') %>
                <% else %>
                  -
                <% end %>
              </td>
              <td>
                <div class="btn-group">
                  <%= link_to "详情", record.order, class: "btn btn-secondary btn-sm" %>
                  <% if record.pending? && policy(record).redeem? %>
                    <%= button_to "核销", redeem_redemption_record_path(record), method: :post, class: "btn btn-success btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🎫</div>
      <p>暂无核销记录</p>
    </div>
  <% end %>
</div>
