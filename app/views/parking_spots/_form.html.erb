<%= form_with model: parking_spot, local: true do |f| %>
  <% if parking_spot.errors.any? %>
    <div class="form-errors">
      <ul>
        <% parking_spot.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :spot_number, "车位号" %>
    <%= f.text_field :spot_number %>
  </div>

  <div class="form-group">
    <%= f.label :zone, "区域" %>
    <%= f.text_field :zone %>
  </div>

  <div class="form-group">
    <%= f.label :spot_type, "类型" %>
    <%= f.select :spot_type, options_for_select([["普通", "regular"], ["预留", "reserved"], ["无障碍", "disabled"], ["充电桩", "ev"]], parking_spot.spot_type) %>
  </div>

  <div class="form-group">
    <%= f.label :occupied, "占用状态" %>
    <%= f.check_box :occupied %>
  </div>

  <div class="form-group">
    <%= f.label :floor, "楼层" %>
    <%= f.text_field :floor %>
  </div>

  <div class="form-group">
    <%= f.label :monthly_rate, "月费率" %>
    <%= f.number_field :monthly_rate, step: 0.01, min: 0 %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "取消", parking_spots_path, class: "btn" %>
  </div>
<% end %>
