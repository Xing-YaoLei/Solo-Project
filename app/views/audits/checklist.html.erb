<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <% type_map = {
          routine_audit: "常规审计",
          special_audit: "专项审计",
          compliance_audit: "合规审计",
          quality_audit: "质量审计",
          safety_audit: "安全审计",
          financial_audit: "财务审计"
        } %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
          <%= type_map[@audit.audit_type.to_sym] || @audit.audit_type.humanize %>
        </span>
      </div>
      <h1 class="text-2xl font-bold text-slate-900"><%= @audit.title %></h1>
      <p class="mt-1 text-sm text-slate-500">检查清单 · 逐项核验检查项状态</p>
    </div>
    <%= link_to audit_path(@audit, tab: "checklist"), class: "inline-flex items-center px-3 py-2 rounded text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      返回审计详情
    <% end %>
  </div>

  <%= render partial: "checklist_progress", locals: { audit: @audit } %>

  <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
    <%= form_with url: checklist_audit_path(@audit), method: :patch, class: "", data: { turbo_frame: "_top" } do |f| %>
      <div class="border-b border-slate-200 px-6 py-4 flex items-center justify-between bg-slate-50">
        <div class="flex items-center gap-4 text-sm">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-400"></span>
            <span class="text-slate-600">待处理</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
            <span class="text-slate-600">已通过</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="text-slate-600">不通过</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-slate-400"></span>
            <span class="text-slate-600">不适用</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button type="reset" class="px-3 py-1.5 rounded text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors">
            重置
          </button>
          <%= f.submit "保存修改", class: "px-4 py-1.5 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-16">#</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-24">项编号</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">检查内容</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-20">需证据</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-40">状态</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">备注说明</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider w-36">核验信息</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-100">
            <% if @checklist_items.any? %>
              <% @checklist_items.each do |item| %>
                <%
                  status_options = [
                    ["待处理", "pending"],
                    ["已通过", "completed"],
                    ["不通过", "rejected"],
                    ["不适用", "not_applicable"]
                  ]
                  row_class = if item.completed? then "bg-green-50/50"
                              elsif item.rejected? then "bg-red-50/50"
                              elsif item.not_applicable? then "bg-slate-50/50"
                              else "" end
                  item_badge_cls = if item.completed? then 'bg-green-100 text-green-700'
                                   elsif item.rejected? then 'bg-red-100 text-red-700'
                                   elsif item.not_applicable? then 'bg-slate-100 text-slate-500'
                                   else 'bg-amber-100 text-amber-700' end
                  item_badge_content = if item.completed? then '✓'
                                       elsif item.rejected? then '✕'
                                       elsif item.not_applicable? then 'N/A'
                                       else item.sort_order.presence || item.id end
                  select_status_cls = if item.completed? then 'border-green-300 bg-green-50 text-green-700'
                                      elsif item.rejected? then 'border-red-300 bg-red-50 text-red-700'
                                      elsif item.not_applicable? then 'border-slate-300 bg-slate-50 text-slate-600'
                                      else 'border-amber-300 bg-amber-50 text-amber-700' end
                  select_cls = "w-full px-2.5 py-1.5 border border-slate-300 rounded text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 #{select_status_cls}"
                %>
                <tr class="<%= row_class %> hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded text-xs font-bold <%= item_badge_cls %>">
                      <%= item_badge_content %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <code class="text-xs font-mono text-slate-600 bg-slate-100 px-2 py-0.5 rounded"><%= item.item_code %></code>
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-sm text-slate-900"><%= item.content %></p>
                    <% if item.evidence_required.present? %>
                      <p class="mt-1 text-xs text-blue-600 bg-blue-50 inline-block px-2 py-0.5 rounded mt-1">
                        证据要求：<%= item.evidence_required %>
                      </p>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if item.requires_evidence? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-blue-50 text-blue-700 font-medium">是</span>
                    <% else %>
                      <span class="text-xs text-slate-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= fields_for "checklist_items[#{item.id}]", item do |cif| %>
                      <%= cif.select :status, status_options, {}, { class: select_cls } %>
                  </td>
                  <td class="px-6 py-4">
                      <%= cif.text_field :remark, class: "w-full px-2.5 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", placeholder: "可选：填写核验备注" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% if item.checked_by.present? && item.checked_at.present? %>
                      <div class="text-xs">
                        <p class="text-slate-700 font-medium"><%= item.checked_by&.name %></p>
                        <p class="text-slate-400 mt-0.5"><%= item.checked_at.strftime("%Y-%m-%d %H:%M") %></p>
                      </div>
                    <% else %>
                      <span class="text-xs text-slate-400">未核验</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="px-6 py-16 text-center">
                  <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <h3 class="mt-2 text-sm font-medium text-slate-900">暂无检查项</h3>
                  <p class="mt-1 text-sm text-slate-500">请联系管理员配置检查清单模板</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @checklist_items.any? %>
        <div class="border-t border-slate-200 px-6 py-4 flex items-center justify-between bg-slate-50">
          <div class="text-sm text-slate-500">
            共 <%= @checklist_items.count %> 项检查点
          </div>
          <div class="flex items-center gap-2">
            <button type="reset" class="px-4 py-2 rounded text-sm font-medium bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors">
              重置修改
            </button>
            <%= f.submit "保存所有修改", class: "px-5 py-2 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
