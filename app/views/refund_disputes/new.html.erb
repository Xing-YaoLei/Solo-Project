<div class="page-header">
  <h1>发起退票争议</h1>
  <div class="page-actions">
    <%= link_to "返回", event_ticket_orders_path(@event), class: "btn" %>
  </div>
</div>

<div class="card">
  <%= form_with model: RefundDispute.new, url: event_refund_disputes_path(@event), local: true do |f| %>
    <%= f.hidden_field :ticket_order_id, value: params[:ticket_order_id] %>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :reporter_name, "报告人姓名" %>
        <%= f.text_field :reporter_name, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :reporter_phone, "报告人电话" %>
        <%= f.text_field :reporter_phone %>
      </div>
      <div class="form-group">
        <%= f.label :handler_id, "指定处理人" %>
        <%= f.select :handler_id, User.where(role: %w[admin manager]).map { |u| [u.email, u.id] }, required: true %>
      </div>
      <div class="form-group full-width">
        <%= f.label :reason, "退票原因" %>
        <%= f.text_area :reason, rows: 4, required: true %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "提交争议", class: "btn btn-warning" %>
    </div>
  <% end %>
</div>
