<div class="page-header">
  <h1>租户合同</h1>
  <%= link_to "新增合同", new_tenant_contract_path, class: "btn btn-primary" %>
</div>

<%= form_with url: tenant_contracts_path, method: :get, class: "filter-form" do |f| %>
  <%= f.select :scope, options_for_select([["全部", ""], ["生效中", "active"], ["已过期", "expired"]], params[:scope]) %>
  <%= f.submit "筛选", class: "btn btn-sm" %>
<% end %>

<table class="data-table">
  <thead>
    <tr>
      <th>合同编号</th>
      <th>租户</th>
      <th>车位</th>
      <th>起始日期</th>
      <th>结束日期</th>
      <th>月租金额</th>
      <th>状态</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @tenant_contracts.each do |contract| %>
      <tr>
        <td><%= link_to contract.contract_number, tenant_contract_path(contract) %></td>
        <td><%= contract.tenant.name %></td>
        <td><%= contract.parking_spot&.spot_number || "-" %></td>
        <td><%= contract.start_date %></td>
        <td><%= contract.end_date %></td>
        <td>¥<%= contract.rent_amount %></td>
        <td>
          <% if contract.end_date >= Date.current && contract.status != "terminated" %>
            <span class="badge badge-active">生效中</span>
          <% else %>
            <span class="badge badge-expired"><%= contract.status == "terminated" ? "已终止" : "已过期" %></span>
          <% end %>
        </td>
        <td>
          <%= link_to "详情", tenant_contract_path(contract), class: "btn btn-sm" %>
          <%= link_to "编辑", edit_tenant_contract_path(contract), class: "btn btn-sm" %>
          <%= link_to "变更记录", audit_trail_tenant_contract_path(contract), class: "btn btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
