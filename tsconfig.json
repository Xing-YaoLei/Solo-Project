{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "./temp/dist-ts",
    "rootDir": "./assets",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "cc": ["./temp/cocos-types/cc.d.ts"],
      "cc.env": ["./temp/cocos-types/cc.env.d.ts"]
    },
    "baseUrl": "."
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "profiles",
    "settings"
  ]
}
