<% content_for :title, "创建结算单 - 职业教育结算台" %>

<div class="mb-6">
  <%= link_to "← 返回结算台", settlements_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="text-2xl font-bold text-gray-900 mt-2">创建结算单</h1>
  <p class="mt-1 text-sm text-gray-500">选择结算周期，系统将自动计算该周期内的订单和分成</p>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6 max-w-2xl">
  <%= form_with model: @settlement, local: true do |form| %>
    <% if @settlement.errors.any? %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
        <h3 class="font-medium"><%= pluralize(@settlement.errors.count, "error") %> prohibited this settlement from being saved:</h3>
        <ul class="mt-2 list-disc list-inside text-sm">
          <% @settlement.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-6">
      <div>
        <%= form.label :period_start, "开始日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.date_field :period_start, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
      <div>
        <%= form.label :period_end, "结束日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.date_field :period_end, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
      </div>
    </div>

    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
      <h4 class="text-sm font-medium text-blue-800">结算说明</h4>
      <ul class="mt-2 text-sm text-blue-700 space-y-1">
        <li>• 系统将统计该时间段内所有已支付订单</li>
        <li>• 自动计算完课数量、考试通过数量</li>
        <li>• 自动计算退款金额和渠道分成</li>
        <li>• 生成结算明细后可导出Excel给财务复查</li>
      </ul>
    </div>

    <div class="mt-6 flex justify-end space-x-3">
      <%= link_to "取消", settlements_path, class: "px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
      <%= form.submit "创建结算单", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
