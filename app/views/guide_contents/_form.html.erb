<%= form_with(model: guide_content) do |form| %>
  <% if guide_content.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-red-800 font-semibold mb-2"><%= pluralize(guide_content.errors.count, "个错误") %> 导致提交失败：</h2>
      <ul class="list-disc list-inside text-red-600 text-sm">
        <% guide_content.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <%= form.label :title, "内容标题", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :category, "分类", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :category, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :order_index, "排序序号", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :order_index, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :duration_minutes, "时长（分钟）", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :duration_minutes, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :point_of_interest, "关联景点", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :point_of_interest, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status, GuideContent.statuses.map { |k, v| [status_text(k), v] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="lg:col-span-2">
      <%= form.label :content, "内容详情", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :content, rows: 8, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
  </div>

  <div class="mt-8 flex justify-end gap-3">
    <%= link_to "取消", guide_contents_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>
<% end %>
