<% content_for :title, "申诉管理 - 职业教育结算台" %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">申诉管理</h1>
      <p class="mt-1 text-sm text-gray-500">处理学员退款、补考、延期等申诉，所有记录进入同一条报名记录</p>
    </div>
  </div>

  <div class="mt-4 flex space-x-4">
    <%= link_to "全部", appeals_path, class: "text-sm #{params[:status].blank? ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "待处理", appeals_path(status: :pending), class: "text-sm #{params[:status] == 'pending' ? 'text-orange-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "处理中", appeals_path(status: :processing), class: "text-sm #{params[:status] == 'processing' ? 'text-yellow-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已通过", appeals_path(status: :approved), class: "text-sm #{params[:status] == 'approved' ? 'text-green-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已驳回", appeals_path(status: :rejected), class: "text-sm #{params[:status] == 'rejected' ? 'text-red-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
  </div>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">申诉编号</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学员</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">类型</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">申诉内容</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">提交时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @appeals.each do |appeal| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-indigo-600">
              <%= appeal.appeal_no %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-8 w-8 bg-indigo-100 rounded-full flex items-center justify-center">
                  <span class="text-indigo-600 text-sm font-medium"><%= appeal.user&.name&.first %></span>
                </div>
                <div class="ml-3">
                  <div class="text-sm font-medium text-gray-900"><%= appeal.user&.name %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= appeal.course&.title %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= appeal_type_text(appeal.appeal_type) %>
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900 max-w-xs truncate"><%= appeal.content %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= appeal_status_class(appeal.status) %>">
                <%= appeal_status_text(appeal.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= time_ago_in_words(appeal.created_at) %>前
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "查看", appeal, class: "text-indigo-600 hover:text-indigo-900" %>
              <% if appeal.pending? %>
                <%= button_to "开始处理", process_appeal_appeal_path(appeal), method: :post, class: "text-yellow-600 hover:text-yellow-900 ml-3" %>
              <% end %>
              <% if appeal.processing? %>
                <%= button_to "通过", approve_appeal_path(appeal), method: :post, class: "text-green-600 hover:text-green-900 ml-3" %>
                <%= button_to "驳回", reject_appeal_path(appeal), method: :post, class: "text-red-600 hover:text-red-900 ml-3" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @appeals.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @appeals %>
    </div>
  <% end %>
</div>
