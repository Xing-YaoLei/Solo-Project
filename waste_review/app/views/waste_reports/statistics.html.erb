<% content_for :page_title, "损耗率统计分析" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-4">损耗率统计分析</h1>

  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <%= form_with url: statistics_waste_reports_path, method: :get, class: "flex flex-wrap items-end gap-4" do |f| %>
      <div class="flex flex-col">
        <label class="text-sm font-medium text-gray-700 mb-1">开始日期</label>
        <%= f.date_field :start_date, value: @start_date, class: "border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <div class="flex flex-col">
        <label class="text-sm font-medium text-gray-700 mb-1">结束日期</label>
        <%= f.date_field :end_date, value: @end_date, class: "border border-gray-300 rounded-md px-3 py-2 text-sm" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "查询", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 text-sm cursor-pointer" %>
        <%= link_to "重置", statistics_waste_reports_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 text-sm" %>
        <%= link_to "导出CSV", waste_reports_path(format: :csv, start_date: @start_date, end_date: @end_date), class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 text-sm" %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-gray-500 text-sm font-medium mb-2">整体损耗率</h3>
    <div class="flex items-baseline gap-2">
      <span class="text-3xl font-bold <%= @overall_stats[:overall_rate] > 5 ? 'text-red-600' : 'text-gray-900' %>"><%= @overall_stats[:overall_rate] %>%</span>
      <% if @overall_stats[:overall_rate] > 5 %>
        <span class="text-xs bg-red-100 text-red-800 px-2 py-0.5 rounded">异常</span>
      <% end %>
    </div>
    <p class="text-xs text-gray-500 mt-2">阈值: 5%</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-gray-500 text-sm font-medium mb-2">报损总成本</h3>
    <span class="text-3xl font-bold text-gray-900">¥<%= number_to_currency(@overall_stats[:total_cost], unit: '', precision: 2) %></span>
    <p class="text-xs text-gray-500 mt-2">统计期内</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-gray-500 text-sm font-medium mb-2">报损单数</h3>
    <span class="text-3xl font-bold text-gray-900"><%= @overall_stats[:report_count] %></span>
    <p class="text-xs text-gray-500 mt-2">统计期内</p>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-gray-500 text-sm font-medium mb-2">异常单数</h3>
    <span class="text-3xl font-bold <%= @overall_stats[:abnormal_count] > 0 ? 'text-red-600' : 'text-gray-900' %>"><%= @overall_stats[:abnormal_count] %></span>
    <p class="text-xs text-gray-500 mt-2">统计期内</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-800">损耗率趋势</h3>
    </div>
    <div class="p-6">
      <% if @trend_data.any? %>
        <div class="space-y-4">
          <% @trend_data.each do |data| %>
            <div class="flex items-center gap-4">
              <div class="w-20 text-sm text-gray-600"><%= data[:month] %></div>
              <div class="flex-1">
                <div class="h-8 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full <%= data[:avg_rate] > 10 ? 'bg-red-500' : data[:avg_rate] > 5 ? 'bg-orange-500' : 'bg-green-500' %> rounded-full transition-all duration-500"
                       style="width: <%= [data[:avg_rate] * 5, 100].min %>%">
                  </div>
                </div>
              </div>
              <div class="w-24 text-right">
                <span class="font-semibold <%= data[:avg_rate] > 5 ? 'text-red-600' : 'text-gray-900' %>"><%= data[:avg_rate] %>%</span>
                <span class="text-xs text-gray-500 block">¥<%= number_to_currency(data[:total_cost], unit: '', precision: 0) %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无数据</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-800">损耗原因分析</h3>
    </div>
    <div class="p-6">
      <% if @reason_analysis.any? %>
        <div class="space-y-4">
          <% @reason_analysis.each do |data| %>
            <div class="flex items-center gap-4">
              <div class="w-24 text-sm text-gray-600 truncate" title="<%= data[:reason] %>"><%= data[:reason] %></div>
              <div class="flex-1">
                <div class="h-6 bg-gray-100 rounded-full overflow-hidden">
                  <div class="h-full bg-blue-500 rounded-full transition-all duration-500"
                       style="width: <%= data[:percentage] %>%">
                  </div>
                </div>
              </div>
              <div class="w-32 text-right">
                <span class="font-semibold text-gray-900"><%= data[:percentage] %>%</span>
                <span class="text-xs text-gray-500 ml-2">¥<%= number_to_currency(data[:amount], unit: '', precision: 0) %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无数据</p>
      <% end %>
    </div>
  </div>
</div>

<div class="bg-white rounded-lg shadow mb-8">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-800">门店损耗率排名</h3>
  </div>
  <% if @store_ranking.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">排名</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">门店</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">报损总成本</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">月度采购额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">损耗率</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @store_ranking.each_with_index do |data, index| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold
                <%= index == 0 ? 'bg-yellow-100 text-yellow-800' : index == 1 ? 'bg-gray-100 text-gray-800' : index == 2 ? 'bg-orange-100 text-orange-800' : 'bg-gray-50 text-gray-600' %>">
                <%= index + 1 %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= data[:store].name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">¥<%= number_to_currency(data[:cost], unit: '', precision: 2) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">¥<%= number_to_currency(data[:store].monthly_purchase || 100_000, unit: '', precision: 2) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium <%= data[:rate] > 5 ? 'text-red-600' : 'text-gray-900' %>"><%= data[:rate] %>%</td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if data[:rate] > 10 %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">高风险</span>
              <% elsif data[:rate] > 5 %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">中风险</span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">正常</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="p-8 text-center text-gray-500">暂无数据</div>
  <% end %>
</div>

<div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
  <h3 class="text-lg font-semibold text-blue-800 mb-3">📊 损耗率变化分析说明</h3>
  <div class="text-sm text-blue-700 space-y-2">
    <p><strong>计算公式：</strong>损耗率 = 报损总成本 / 门店月度采购总额 × 100%</p>
    <p><strong>统计口径：</strong>按报损日期所在自然月统计，月度采购总额取自门店配置的monthly_purchase字段（默认值100,000元）</p>
    <p><strong>异常判定：</strong>损耗率 > 5% 触发异常单；5%-10%为低级别，10%-20%为中级别，> 20%为高级别</p>
    <p><strong>分析建议：</strong>重点关注损耗率排名前三的门店，分析其主要损耗原因，制定针对性改进措施。对于连续3个月损耗率超标的门店，应启动专项调查。</p>
  </div>
</div>
