<% content_for :title, "结算台 - 职业教育结算台" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">结算台</h1>
    <p class="mt-1 text-sm text-gray-500">按周期生成结算，核对完课、考试、退款和渠道分成</p>
  </div>
  <%= link_to new_settlement_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" do %>
    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
    </svg>
    创建结算单
  <% end %>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <h3 class="text-lg font-medium text-gray-900">结算单列表</h3>
      <div class="flex space-x-2">
        <%= link_to "全部", settlements_path, class: "text-sm #{params[:status].blank? ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
        <%= link_to "待复核", settlements_path(status: :pending_review), class: "text-sm #{params[:status] == 'pending_review' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
        <%= link_to "已通过", settlements_path(status: :approved), class: "text-sm #{params[:status] == 'approved' ? 'text-indigo-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
      </div>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">结算周期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">订单数</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">总金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">完课数</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">退款</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">渠道分成</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">净收入</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @settlements.each do |settlement| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">
                <%= settlement.period_start %> 至 <%= settlement.period_end %>
              </div>
              <div class="text-sm text-gray-500"><%= time_ago_in_words(settlement.created_at) %>前创建</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= settlement.total_orders %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">¥<%= number_with_precision settlement.total_amount, precision: 2 %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= settlement.completed_courses_count %> 完课</div>
              <div class="text-sm text-gray-500"><%= settlement.passed_exams_count %> 通过考试</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-red-600"><%= settlement.refund_count %> 笔</div>
              <div class="text-sm text-gray-500">¥<%= number_with_precision settlement.refund_amount, precision: 2 %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-orange-600">¥<%= number_with_precision settlement.channel_commission_amount, precision: 2 %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-green-600">¥<%= number_with_precision settlement.net_revenue, precision: 2 %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= settlement_status_class(settlement.status) %>">
                <%= settlement_status_text(settlement.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "查看", settlement, class: "text-indigo-600 hover:text-indigo-900" %>
              <% if settlement.draft? %>
                <%= button_to "计算", calculate_settlement_path(settlement), method: :post, class: "text-blue-600 hover:text-blue-900 ml-3" %>
              <% end %>
              <% if settlement.pending_review? %>
                <%= button_to "通过", approve_settlement_path(settlement), method: :post, class: "text-green-600 hover:text-green-900 ml-3" %>
                <%= button_to "驳回", reject_settlement_path(settlement), method: :post, class: "text-red-600 hover:text-red-900 ml-3" %>
              <% end %>
              <% if settlement.approved? %>
                <%= link_to "导出", export_settlement_path(settlement, format: :xlsx), class: "text-purple-600 hover:text-purple-900 ml-3" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @settlements.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @settlements %>
    </div>
  <% end %>
</div>
