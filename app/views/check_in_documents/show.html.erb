<% content_for :title, "入住证件详情" %>

<div class="w-full">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold text-gray-800">入住证件详情</h1>
    <div class="flex gap-2">
      <%= link_to "返回列表", check_in_documents_path, class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 text-sm font-medium" %>
      <%= link_to "编辑", edit_check_in_document_path(@check_in_document), class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">证件信息</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-500">客人姓名</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.name %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">证件类型</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.id_type_i18n %></p>
          </div>
          <div class="md:col-span-2">
            <p class="text-sm text-gray-500">证件号</p>
            <p class="mt-1 text-sm font-medium text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded-md"><%= @check_in_document.id_number %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">性别</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.gender_i18n || "-" %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">国籍</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.nationality || "-" %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">关联客人</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.guest.name %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">关联订单</p>
            <p class="mt-1 text-sm font-medium">
              <%= link_to @check_in_document.channel_order.order_no, channel_order_path(@check_in_document.channel_order), class: "text-indigo-600 hover:text-indigo-900" %>
            </p>
          </div>
          <div>
            <p class="text-sm text-gray-500">创建时间</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.created_at.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
          <div>
            <p class="text-sm text-gray-500">更新时间</p>
            <p class="mt-1 text-sm font-medium text-gray-900"><%= @check_in_document.updated_at.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
        </div>
      </div>

      <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">变更日志</h2>

        <% if @document_change_logs.any? %>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">修改时间</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作人</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">修改字段</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">旧值</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">新值</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @document_change_logs.each do |log| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">
                      <%= log.created_at.strftime("%Y-%m-%d %H:%M") %>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                      <%= log.operator&.name %>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
                      <span class="px-2 py-1 bg-gray-100 rounded text-xs"><%= log.changed_field_i18n %></span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 max-w-xs truncate">
                      <%= log.old_value.presence || "-" %>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-900 max-w-xs truncate">
                      <%= log.new_value.presence || "-" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center text-gray-500 py-8">
            暂无变更记录
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
