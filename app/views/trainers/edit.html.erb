<div class="card">
  <div class="card-header">
    <h2>编辑教练: <%= @trainer.name %></h2>
    <%= link_to "返回", trainer_path(@trainer), class: "btn btn-outline btn-sm" %>
  </div>
  <div class="card-body">
    <%= form_with model: @trainer do |f| %>
      <div class="form-row">
        <div class="form-group"><%= f.label :employee_no, "工号" %><%= f.text_field :employee_no %></div>
        <div class="form-group"><%= f.label :name, "姓名" %><%= f.text_field :name %></div>
        <div class="form-group"><%= f.label :phone, "电话" %><%= f.text_field :phone %></div>
      </div>
      <div class="form-row">
        <div class="form-group"><%= f.label :specialty, "专长" %><%= f.text_field :specialty %></div>
        <div class="form-group"><%= f.label :active, "在职状态" %><%= f.check_box :active %></div>
      </div>
      <div style="margin-top: 20px;"><%= f.submit "保存", class: "btn btn-primary" %></div>
    <% end %>
  </div>
</div>
