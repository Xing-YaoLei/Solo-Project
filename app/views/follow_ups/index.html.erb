<% content_for :title, "跟进名单 - 职业教育结算台" %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">跟进名单</h1>
      <p class="mt-1 text-sm text-gray-500">进度落后学员自动生成，助教记录跟进原因和下一次提醒</p>
    </div>
    <div class="flex space-x-3">
      <%= button_to "生成今日跟进", generate_follow_ups_path, method: :post, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50" %>
    </div>
  </div>

  <div class="mt-4 flex space-x-4">
    <%= link_to "待跟进", follow_ups_path(status: :pending), class: "text-sm #{params[:status] == 'pending' ? 'text-red-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已联系", follow_ups_path(status: :contacted), class: "text-sm #{params[:status] == 'contacted' ? 'text-yellow-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已解决", follow_ups_path(status: :resolved), class: "text-sm #{params[:status] == 'resolved' ? 'text-green-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
    <%= link_to "已关闭", follow_ups_path(status: :closed), class: "text-sm #{params[:status] == 'closed' ? 'text-gray-600 font-medium' : 'text-gray-500 hover:text-gray-700'}" %>
  </div>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学员</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学习进度</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">落后原因</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">跟进状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">下次跟进</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @follow_ups.each do |follow_up| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
                  <span class="text-indigo-600 font-medium"><%= follow_up.enrollment&.user&.name&.first %></span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900"><%= follow_up.enrollment&.user&.name %></div>
                  <div class="text-sm text-gray-500"><%= follow_up.enrollment&.user&.email %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900"><%= follow_up.enrollment&.course&.title %></div>
              <div class="text-sm text-gray-500"><%= follow_up.enrollment&.expired_at&.strftime("%Y-%m-%d") %> 到期</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-24 bg-gray-200 rounded-full h-2">
                  <div class="bg-red-500 h-2 rounded-full" style="width: <%= follow_up.enrollment&.progress || 0 %>%"></div>
                </div>
                <span class="ml-2 text-sm text-red-600"><%= follow_up.enrollment&.progress&.to_i || 0 %>%</span>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900 max-w-xs truncate"><%= follow_up.reason || "未记录" %></div>
              <div class="text-xs text-gray-500 mt-1"><%= follow_up.description %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= follow_up_status_class(follow_up.status) %>">
                <%= follow_up_status_text(follow_up.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if follow_up.next_follow_up_at %>
                <div class="text-sm text-gray-900"><%= follow_up.next_follow_up_at.strftime("%Y-%m-%d %H:%M") %></div>
                <% if follow_up.next_follow_up_at < Time.current %>
                  <div class="text-xs text-red-600">已到期</div>
                <% end %>
              <% else %>
                <span class="text-sm text-gray-400">未设置</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "跟进", edit_follow_up_path(follow_up), class: "text-indigo-600 hover:text-indigo-900" %>
              <% if follow_up.pending? || follow_up.contacted? %>
                <%= button_to "标记已解决", resolve_follow_up_path(follow_up), method: :post, class: "text-green-600 hover:text-green-900 ml-3" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @follow_ups.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @follow_ups %>
    </div>
  <% end %>
</div>
