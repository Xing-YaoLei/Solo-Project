<% if notifications.any? %>
  <div class="divide-y divide-gray-100">
    <table class="w-full">
      <tbody>
        <% notifications.each do |notification| %>
          <%= render "notifications/notification_row", notification: notification %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if notifications.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-100 bg-gray-50">
      <%= paginate notifications, theme: "tailwind" %>
    </div>
  <% end %>
<% else %>
  <div class="py-20 text-center">
    <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
    </svg>
    <h3 class="text-lg font-medium text-gray-900 mb-2">暂无消息</h3>
    <p class="text-sm text-gray-500">目前没有新的消息通知</p>
  </div>
<% end %>
