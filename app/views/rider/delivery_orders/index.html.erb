<% content_for :page_title, '配送订单' %>

<div class="p-6 space-y-6">
  <div class="flex items-center gap-4">
    <div class="flex items-center gap-2 bg-white rounded-lg p-1 shadow-sm">
      <%= link_to rider_delivery_orders_path, class: "px-4 py-2 rounded-md #{params[:status].nil? ? 'bg-[#1e3a5f] text-white' : 'text-gray-600 hover:bg-gray-100'} text-sm font-medium" do %>
        全部 (<%= @pending_count + @in_progress_count + @delivered_count %>)
      <% end %>
      <%= link_to rider_delivery_orders_path(status: :pending), class: "px-4 py-2 rounded-md #{params[:status] == 'pending' ? 'bg-[#1e3a5f] text-white' : 'text-gray-600 hover:bg-gray-100'} text-sm font-medium" do %>
        待取货 (<%= @pending_count %>)
      <% end %>
      <%= link_to rider_delivery_orders_path(status: :in_progress), class: "px-4 py-2 rounded-md #{params[:status] == 'in_progress' ? 'bg-[#1e3a5f] text-white' : 'text-gray-600 hover:bg-gray-100'} text-sm font-medium" do %>
        配送中 (<%= @in_progress_count %>)
      <% end %>
      <%= link_to rider_delivery_orders_path(status: :delivered), class: "px-4 py-2 rounded-md #{params[:status] == 'delivered' ? 'bg-[#1e3a5f] text-white' : 'text-gray-600 hover:bg-gray-100'} text-sm font-medium" do %>
        已完成 (<%= @delivered_count %>)
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= form_tag rider_delivery_orders_path, method: :get, class: "flex items-center gap-2" do %>
        <%= date_field_tag :delivery_date, params[:delivery_date], class: "px-4 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none" %>
        <%= submit_tag "筛选", class: "px-4 py-2 bg-[#1e3a5f] text-white rounded-lg text-sm font-medium hover:bg-[#2d4a6f] transition-colors" %>
      <% end %>
    </div>
  </div>

  <% if @delivery_orders.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @delivery_orders.each_with_index do |order, i| %>
        <div class="bg-white rounded-2xl p-5 shadow-card hover:shadow-card-hover transition-all duration-300 animate-fade-in" style="animation-delay: <%= i * 30 %>ms">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-[#1e3a5f]">#<%= order.order_no %></span>
            <span class="px-3 py-1 rounded-full text-xs font-medium
                         <%= order.pending? ? 'bg-green-100 text-green-600' : '' %>
                         <%= order.assigned? || order.picked_up? ? 'bg-blue-100 text-blue-600' : '' %>
                         <%= order.delivered? ? 'bg-gray-100 text-gray-600' : '' %>
                         <%= order.cancelled? ? 'bg-red-100 text-red-600' : '' %>">
              <%= { pending: '待取货', assigned: '已分配', picked_up: '配送中', delivered: '已完成', cancelled: '已取消' }[order.status.to_sym] %>
            </span>
          </div>

          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#f59e0b]/10 flex items-center justify-center flex-shrink-0">
                <i data-lucide="store" class="w-4 h-4 text-[#f59e0b]"></i>
              </div>
              <div>
                <p class="font-medium text-gray-900"><%= order.merchant&.name %></p>
                <p class="text-sm text-gray-500"><%= order.merchant&.address || '地址信息' %></p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <div class="flex-1 h-px bg-dashed bg-gray-200"></div>
              <i data-lucide="arrow-down" class="w-4 h-4 text-gray-300"></i>
              <div class="flex-1 h-px bg-dashed bg-gray-200"></div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-[#1e3a5f]/10 flex items-center justify-center flex-shrink-0">
                <i data-lucide="map-pin" class="w-4 h-4 text-[#1e3a5f]"></i>
              </div>
              <div>
                <p class="font-medium text-gray-900">配送时间</p>
                <p class="text-sm text-gray-500"><%= order.delivery_time&.strftime('%Y-%m-%d %H:%M') || '待安排' %></p>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
            <div>
              <p class="text-xs text-gray-500">配送费</p>
              <p class="text-lg font-bold text-[#1e3a5f] font-serif">¥<%= sprintf('%.2f', order.amount) %></p>
            </div>
            <% if order.pending? %>
              <%= button_to "开始配送", rider_delivery_order_path(order), method: :patch, params: { delivery_order: { status: :picked_up } }, class: "px-5 py-2 bg-[#10b981] text-white rounded-lg hover:bg-[#059669] transition-colors font-medium" %>
            <% elsif order.picked_up? %>
              <%= button_to "确认送达", rider_delivery_order_path(order), method: :patch, params: { delivery_order: { status: :delivered } }, class: "px-5 py-2 bg-[#1e3a5f] text-white rounded-lg hover:bg-[#2d4a6f] transition-colors font-medium" %>
            <% else %>
              <span class="px-4 py-2 text-gray-400 text-sm">
                <%= order.updated_at.strftime('%Y-%m-%d') %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%= render PaginationComponent.new(pagy: @pagy) %>
  <% else %>
    <div class="text-center py-16 bg-white rounded-2xl shadow-card">
      <i data-lucide="package" class="w-16 h-16 text-gray-300 mx-auto mb-4"></i>
      <p class="text-gray-500 text-lg">暂无配送订单</p>
      <p class="text-gray-400 text-sm mt-2">请稍后再查看</p>
    </div>
  <% end %>
</div>
