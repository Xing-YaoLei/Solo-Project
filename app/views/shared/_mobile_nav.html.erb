<nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-40 pb-[env(safe-area-inset-bottom)]">
  <div class="flex items-center justify-around h-16">
    <%= link_to work_orders_path, class: "flex flex-col items-center justify-center w-full h-full text-gray-500 #{request.path.start_with?('/work_orders') ? 'text-blue-600' : 'hover:text-gray-700'} transition-colors" do %>
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <span class="text-xs">工单</span>
    <% end %>

    <%= link_to parts_path, class: "flex flex-col items-center justify-center w-full h-full text-gray-500 #{request.path.start_with?('/parts') ? 'text-blue-600' : 'hover:text-gray-700'} transition-colors" do %>
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
      </svg>
      <span class="text-xs">配件</span>
    <% end %>

    <%= link_to new_work_order_path, class: "flex flex-col items-center justify-center w-full h-full -mt-6" do %>
      <div class="w-14 h-14 rounded-full bg-blue-600 hover:bg-blue-700 flex items-center justify-center shadow-lg shadow-blue-500/30 text-white transition-colors">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
        </svg>
      </div>
      <span class="text-xs text-gray-500 mt-0.5">新建</span>
    <% end %>

    <%= link_to stock_alerts_path, class: "flex flex-col items-center justify-center w-full h-full text-gray-500 #{request.path.start_with?('/stock_alerts') ? 'text-blue-600' : 'hover:text-gray-700'} transition-colors relative" do %>
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <span class="text-xs">提醒</span>
      <% stock_alerts_count = StockAlert.where.not(status: 'resolved').count %>
      <% if stock_alerts_count > 0 %>
        <span class="absolute top-1 right-1/4 inline-flex items-center justify-center min-w-[16px] h-4 px-1 text-[10px] font-bold text-white bg-red-500 rounded-full"><%= stock_alerts_count %></span>
      <% end %>
    <% end %>

    <%= link_to admin_dashboard_path, class: "flex flex-col items-center justify-center w-full h-full text-gray-500 #{request.path.start_with?('/admin') ? 'text-blue-600' : 'hover:text-gray-700'} transition-colors" do %>
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="text-xs">我的</span>
    <% end %>
  </div>
</nav>

<div class="lg:hidden h-16"></div>
