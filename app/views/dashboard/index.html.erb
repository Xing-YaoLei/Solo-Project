<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold text-gray-900">仪表盘</h2>
    <span class="text-sm text-gray-500"><%= l(Time.current, format: :long) %></span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-indigo-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">演出总数</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:total_performances] %></p>
        </div>
        <div class="text-3xl">🗓️</div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">进行中演出</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:ongoing_performances] %></p>
        </div>
        <div class="text-3xl">🎭</div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">订单总数</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:total_orders] %></p>
        </div>
        <div class="text-3xl">📋</div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-cyan-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">已支付订单</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:paid_orders] %></p>
        </div>
        <div class="text-3xl">💰</div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-emerald-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">已签到票券</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:checked_in_tickets] %></p>
        </div>
        <div class="text-3xl">✅</div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 border-l-4 border-red-500">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">未关闭异常</p>
          <p class="text-3xl font-bold text-gray-900 mt-1"><%= @stats[:open_exceptions] %></p>
        </div>
        <div class="text-3xl">⚠️</div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">最近订单</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">订单号</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">客户</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @recent_orders.each do |order| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-indigo-600">
                  <%= link_to order.order_no, order_path(order) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= order.customer_name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= format_currency(order.total_amount) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm"><%= status_badge(order) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= format_datetime(order.created_at) %></td>
              </tr>
            <% end %>
            <% if @recent_orders.empty? %>
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">暂无订单数据</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="px-6 py-3 border-t border-gray-200 text-right">
        <%= link_to "查看全部订单 →", orders_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">待处理异常</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @open_exceptions.each do |ex| %>
            <div class="px-6 py-4 hover:bg-gray-50">
              <div class="flex items-center justify-between">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">
                    <%= link_to ex.title, exception_record_path(ex), class: "hover:text-indigo-600" %>
                  </p>
                  <p class="text-xs text-gray-500 mt-1">
                    <%= t("enums.exception_record.exception_type.#{ex.exception_type}", default: ex.exception_type.to_s.humanize) %> · <%= format_datetime(ex.created_at) %>
                  </p>
                </div>
                <%= status_badge(ex) %>
              </div>
            </div>
          <% end %>
          <% if @open_exceptions.empty? %>
            <div class="px-6 py-8 text-center text-sm text-gray-500">暂无待处理异常</div>
          <% end %>
        </div>
        <div class="px-6 py-3 border-t border-gray-200 text-right">
          <%= link_to "查看全部异常 →", exception_records_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">最近状态变更</h3>
        </div>
        <div class="divide-y divide-gray-200 max-h-64 overflow-y-auto">
          <% @recent_logs.each do |log| %>
            <div class="px-6 py-3">
              <div class="flex items-center justify-between">
                <p class="text-sm text-gray-900">
                  <span class="font-medium"><%= log.trackable_type %>#<%= log.trackable_id %></span>
                  <span class="text-gray-500 mx-1">→</span>
                  <span class="text-xs"><%= log.event %></span>
                </p>
                <span class="text-xs text-gray-400"><%= format_datetime(log.created_at) %></span>
              </div>
              <p class="text-xs text-gray-500 mt-0.5">
                <%= log.from_state %> → <%= log.to_state %> · 操作人: <%= log.operator %>
              </p>
            </div>
          <% end %>
          <% if @recent_logs.empty? %>
            <div class="px-6 py-8 text-center text-sm text-gray-500">暂无状态日志</div>
          <% end %>
        </div>
        <div class="px-6 py-3 border-t border-gray-200 text-right">
          <%= link_to "查看全部日志 →", status_logs_path, class: "text-sm text-indigo-600 hover:text-indigo-800" %>
        </div>
      </div>
    </div>
  </div>
</div>
