<% provide :title, '风险词库管理' %>

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">风险词库</h1>
    <p class="text-gray-600 mt-1">管理风险词，用于文书内容扫描</p>
  </div>
  <%= link_to '新建风险词', new_risk_word_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
  <div class="p-4 border-b border-gray-200">
    <%= search_form_for @q, url: risk_words_path, method: :get, html: { class: "flex gap-4 flex-wrap" } do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :word_cont, '风险词', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :word_cont, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="w-40">
        <%= f.label :risk_level_eq, '风险等级', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :risk_level_eq, [['全部', ''], ['高', 'high'], ['中', 'medium'], ['低', 'low']], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="w-40">
        <%= f.label :category_eq, '分类', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :category_eq, [['全部', '']] + RiskWord::CATEGORIES.map { |k, v| [v, k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex items-end">
        <%= f.submit '搜索', class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">风险词</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">分类</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">风险等级</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">描述</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @risk_words.each do |word| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to word.word, risk_word_path(word), class: "font-medium text-red-600 hover:text-red-800" %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= word.category_name %></td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs rounded-full
              <%= case word.risk_level
                  when 'high' then 'bg-red-100 text-red-700'
                  when 'medium' then 'bg-yellow-100 text-yellow-700'
                  else 'bg-orange-100 text-orange-700'
                  end %>">
              <%= word.risk_level_name %>级
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= word.description %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to '编辑', edit_risk_word_path(word), class: "text-blue-600 hover:text-blue-800" %>
            <%= link_to '删除', risk_word_path(word), method: :delete, data: { confirm: '确定删除？' }, class: "text-red-600 hover:text-red-800 ml-3" %>
          </td>
        </tr>
      <% end %>
      <% if @risk_words.empty? %>
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-gray-500">暂无风险词</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy %>
  <div class="mt-4 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
