<% provide :title, '编辑异常单' %>

<div class="mb-6">
  <%= link_to '← 返回', exception_order_path(@exception_order), class: "text-blue-600 hover:text-blue-800 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h1 class="text-xl font-bold text-gray-900">编辑异常单 - <%= @exception_order.order_no %></h1>
  </div>

  <%= form_with model: @exception_order, local: true do |f| %>
    <% if @exception_order.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <h2 class="text-red-700 font-medium"><%= pluralize(@exception_order.errors.count, "个错误") %> 阻止了保存：</h2>
        <ul class="mt-2 text-sm text-red-600">
          <% @exception_order.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :impact_scope, '影响范围', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :impact_scope, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :responsibility, '责任归属', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :responsibility, rows: 3, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :handling_result, '处理结果', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :handling_result, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.label :handler_id, '处理人', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.select :handler_id, User.all.map { |u| [u.name, u.id] }, { include_blank: '请选择处理人' }, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
      <%= link_to '取消', exception_order_path(@exception_order), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium" %>
      <%= f.submit '保存', class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
    </div>
  <% end %>
</div>
