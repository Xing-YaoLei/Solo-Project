<div class="mb-6 flex items-center justify-between">
  <h2 class="text-xl font-semibold text-gray-900">质检照片</h2>
  <button type="button" data-inspection-photos-target="toggleForm" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
    <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    上传照片
  </button>
</div>

<div data-inspection-photos-target="formContainer" class="mb-6 hidden">
  <%= render "inspection_photos/form", work_order: @work_order %>
</div>

<% before_photos = @work_order.inspection_photos.where(photo_type: 'before').order(created_at: :desc) %>
<% process_photos = @work_order.inspection_photos.where(photo_type: 'process').order(created_at: :desc) %>
<% after_photos = @work_order.inspection_photos.where(photo_type: 'after').order(created_at: :desc) %>

<% [["before", "维修前", before_photos, "bg-orange-100 text-orange-800"], ["process", "维修中", process_photos, "bg-blue-100 text-blue-800"], ["after", "维修后", after_photos, "bg-green-100 text-green-800"]].each do |type, label, photos, badge_class| %>
  <div class="mb-8">
    <div class="mb-4 flex items-center space-x-3">
      <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium <%= badge_class %>"><%= label %></span>
      <span class="text-sm text-gray-500"><%= photos.size %> 张</span>
    </div>

    <% if photos.any? %>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        <% photos.each do |photo| %>
          <div class="group relative overflow-hidden rounded-lg border border-gray-200 bg-white">
            <button type="button" data-action="click->lightbox#open" data-lightbox-url="<%= url_for(photo.image) if photo.image.attached? %>" class="block aspect-square w-full overflow-hidden bg-gray-100">
              <% if photo.image.attached? %>
                <%= image_tag photo.image, class: "h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center text-gray-400">
                  <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
              <% end %>
            </button>
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-2 opacity-0 transition-opacity group-hover:opacity-100">
              <p class="truncate text-xs text-white"><%= photo.caption.presence || photo.description.presence || '无描述' %></p>
              <div class="mt-1 flex items-center justify-between">
                <span class="text-xs text-white/80"><%= photo.taken_by&.name || '-' %></span>
                <%= button_to [@work_order, photo], method: :delete, class: "text-white/80 hover:text-white", form: { data: { turbo_confirm: "确定删除此照片？" } } do %>
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 py-8 text-center">
        <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p class="mt-2 text-sm text-gray-500">暂无<%= label %>照片</p>
      </div>
    <% end %>
  </div>
<% end %>

<div data-lightbox-target="modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4" data-action="click->lightbox#closeBackground keydown@window->lightbox#handleKeydown">
  <button type="button" data-action="click->lightbox#close" class="absolute top-4 right-4 text-white hover:text-gray-300">
    <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <img data-lightbox-target="image" src="" alt="" class="max-h-full max-w-full object-contain">
</div>
