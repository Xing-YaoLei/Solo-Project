<div class="page-header">
  <%= link_to "← 返回列表", benefit_rules_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title"><%= @rule.new_record? ? "新增权益规则" : "编辑权益规则" %></h1>
</div>

<div class="table-container p-6">
  <%= form_with(model: @rule, local: true) do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="form-group">
        <%= f.label :name, "规则名称", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :rule_type, "规则类型", class: "form-label" %>
        <%= f.select :rule_type, options_for_select(BenefitRule::RULE_TYPES.map { |t| [t.humanize, t] }, @rule.rule_type), {}, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :target_member_level, "适用会员等级", class: "form-label" %>
        <%= f.select :target_member_level, options_for_select(BenefitRule::MEMBER_LEVELS.map { |l| [l.humanize, l] }, @rule.target_member_level), {}, class: "form-select" %>
      </div>
      <div class="form-group flex items-end space-x-4">
        <div class="flex items-center">
          <%= f.check_box :is_active, class: "mr-2" %>
          <%= f.label :is_active, "是否启用" %>
        </div>
      </div>
      <div class="form-group">
        <%= f.label :effective_date, "生效日期", class: "form-label" %>
        <%= f.date_field :effective_date, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :expiry_date, "失效日期", class: "form-label" %>
        <%= f.date_field :expiry_date, class: "form-input" %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :description, "规则描述", class: "form-label" %>
        <%= f.text_area :description, class: "form-input", rows: 2 %>
      </div>
    </div>

    <div class="mt-8 flex space-x-3">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "取消", benefit_rules_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
