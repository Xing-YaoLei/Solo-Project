<% content_for :title, "编辑客户 - #{@client.name}" %>

<div class="max-w-2xl mx-auto">
  <div class="bg-white rounded-lg shadow p-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">编辑客户</h1>
    <%= form_with model: @client, local: true do |f| %>
      <% if @client.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
          <div class="text-red-700 font-medium mb-2">请修正以下错误：</div>
          <ul class="text-red-600 text-sm list-disc list-inside">
            <% @client.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div>
            <%= f.label :phone, "电话", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :phone, required: true, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div>
            <%= f.label :id_number, "身份证号", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :id_number, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div>
            <%= f.label :email, "邮箱", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div class="md:col-span-2">
            <%= f.label :address, "地址", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :address, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div>
            <%= f.label :source_channel, "来源渠道", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :source_channel, Client::SOURCE_CHANNELS, { include_blank: "请选择" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
          <div>
            <%= f.label :contact_person, "联系人", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :contact_person, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
          </div>
        </div>
        <div>
          <%= f.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :notes, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
      </div>
      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", client_path(@client), class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= f.submit "保存", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
