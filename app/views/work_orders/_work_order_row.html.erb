<tr id="<%= dom_id(work_order) %>" class="hover:bg-gray-50 transition-colors <%= work_order_tr_class(work_order) %>">
  <td class="px-4 py-4">
    <input type="checkbox" name="work_order_ids[]" value="<%= work_order.id %>" class="work_order_checkbox h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <%= link_to work_order.work_order_no, work_order_path(work_order), class: 'text-blue-600 hover:text-blue-900 font-medium' %>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <div class="text-sm font-medium text-gray-900"><%= work_order.customer_name %></div>
    <div class="text-sm text-gray-500"><%= work_order.customer_phone %></div>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <div class="text-sm text-gray-900"><%= work_order.vehicle_plate %></div>
    <div class="text-sm text-gray-500"><%= work_order_vehicle_info(work_order) %></div>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <%= render_work_order_status_badge(work_order.status) %>
  </td>
  <td class="px-4 py-4 whitespace-nowrap">
    <%= render_work_order_priority_badge(work_order.priority) %>
  </td>
  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
    <%= work_order_assigned_to_name(work_order) %>
  </td>
  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
    <%= format_work_order_created_at(work_order) %>
  </td>
  <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
    <%= link_to '查看', work_order_path(work_order), class: 'text-blue-600 hover:text-blue-900 mr-3' %>
    <%= link_to '编辑', edit_work_order_path(work_order), class: 'text-gray-600 hover:text-gray-900' %>
  </td>
</tr>
