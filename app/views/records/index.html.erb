<div class="page-header">
  <h1 class="page-title">📂 记录中心</h1>
  <p class="page-subtitle">核销记录、退款原因和会员档案统一视图</p>
</div>

<div class="filter-form">
  <%= form_tag records_path, method: :get do %>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
      <div class="form-group">
        <%= label_tag :keyword, "学员姓名/手机号", class: "form-label" %>
        <%= text_field_tag :keyword, params[:keyword], class: "form-input", placeholder: "搜索..." %>
      </div>
      <div class="form-group">
        <%= label_tag :community_id, "所属社群", class: "form-label" %>
        <%= select_tag :community_id, options_from_collection_for_select(Community.all, :id, :name, params[:community_id]), include_blank: "全部", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= label_tag :student_id, "指定学员ID", class: "form-label" %>
        <%= text_field_tag :student_id, params[:student_id], class: "form-input", placeholder: "学员ID" %>
      </div>
      <div class="form-group">
        <%= label_tag :member_level, "会员等级", class: "form-label" %>
        <%= select_tag :member_level, options_for_select(%w[basic premium vip], params[:member_level]), include_blank: "全部", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= label_tag :status, "状态/退款状态", class: "form-label" %>
        <%= text_field_tag :status, params[:status], class: "form-input", placeholder: "状态筛选" %>
      </div>
      <div class="form-group">
        <%= label_tag :refund_reason_code, "退款原因", class: "form-label" %>
        <%= select_tag :refund_reason_code, options_for_select(RefundRecord::REFUND_REASON_CODES, params[:refund_reason_code]), include_blank: "全部", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= label_tag :start_date, "开始日期", class: "form-label" %>
        <%= date_field_tag :start_date, params[:start_date], class: "form-input" %>
      </div>
      <div class="form-group">
        <%= label_tag :end_date, "结束日期", class: "form-label" %>
        <%= date_field_tag :end_date, params[:end_date], class: "form-input" %>
      </div>
    </div>
    <div class="mt-4 flex space-x-3">
      <%= submit_tag "筛选", class: "btn-primary" %>
      <%= link_to "重置", records_path, class: "btn-secondary" %>
      <%= link_to "导出当前结果", new_export_record_path(export_type: "redemption_records", filter_conditions: @filter_params), class: "btn-secondary" %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="stat-card">
    <p class="stat-label">核销总数</p>
    <p class="stat-value text-blue-600"><%= @total_redemptions %></p>
    <p class="mt-2 text-sm">已完成: <%= @completed_redemptions %> · 完成率 <%= @total_redemptions > 0 ? (@completed_redemptions * 100.0 / @total_redemptions).round(1) : 0 %>%</p>
  </div>
  <div class="stat-card">
    <p class="stat-label">退款总数</p>
    <p class="stat-value text-yellow-600"><%= @total_refunds %></p>
    <p class="mt-2 text-sm">已批准: <%= @approved_refunds %> · 金额 ¥<%= @total_refund_amount %></p>
  </div>
  <div class="stat-card">
    <p class="stat-label">活跃会员</p>
    <p class="stat-value text-green-600"><%= @active_members %></p>
    <p class="mt-2 text-sm">已过期: <%= @expired_members %></p>
  </div>
  <div class="stat-card">
    <p class="stat-label">会员消费总额</p>
    <p class="stat-value text-purple-600">¥<%= @total_member_value %></p>
    <p class="mt-2 text-sm">会员总数: <%= @active_members + @expired_members %></p>
  </div>
</div>

<div class="tabs-nav">
  <div class="flex space-x-1">
    <div class="tab-active">💳 核销记录</div>
    <div class="tab-item">↩️ 退款原因</div>
    <div class="tab-item">🎫 会员档案</div>
  </div>
</div>

<div class="space-y-8">
  <div class="table-container">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold">💳 权益核销记录</h3>
      <%= link_to "查看全部", redemption_records_path(@filter_params), class: "btn-secondary text-xs py-1 px-3" %>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>学员</th>
            <th>会员等级</th>
            <th>权益名称</th>
            <th>核销码</th>
            <th>核销时间</th>
            <th>渠道</th>
            <th>状态</th>
            <th>操作员</th>
          </tr>
        </thead>
        <tbody>
          <% @redemption_records.each do |r| %>
            <tr>
              <td class="font-mono text-xs">#<%= r.id %></td>
              <td>
                <div><%= link_to r.student&.name, student_path(r.student), class: "font-medium text-blue-600 hover:underline" %></div>
                <div class="text-xs text-gray-500"><%= r.student&.phone %></div>
              </td>
              <td><%= member_level_badge(r.student&.member_profile&.member_level) %></td>
              <td class="font-medium"><%= r.benefit_name %></td>
              <td class="font-mono text-xs"><%= r.redemption_code %></td>
              <td class="text-xs"><%= r.redeemed_at&.strftime("%Y-%m-%d %H:%M") %></td>
              <td><%= r.channel %></td>
              <td><%= status_badge(r.status) %></td>
              <td class="text-xs"><%= r.operator&.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-container">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold">↩️ 退款记录与原因</h3>
      <%= link_to "查看全部", refund_records_path(@filter_params), class: "btn-secondary text-xs py-1 px-3" %>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>学员</th>
            <th>退款金额</th>
            <th>原因代码</th>
            <th>退款原因详情</th>
            <th>状态</th>
            <th>支付方式</th>
            <th>审批备注</th>
            <th>操作员</th>
          </tr>
        </thead>
        <tbody>
          <% @refund_records.each do |r| %>
            <tr>
              <td class="font-mono text-xs">#<%= r.id %></td>
              <td>
                <div><%= link_to r.student&.name, student_path(r.student), class: "font-medium text-blue-600 hover:underline" %></div>
                <div class="text-xs text-gray-500">会员ID: #<%= r.member_profile_id %></div>
              </td>
              <td class="font-semibold text-red-600">¥<%= r.refund_amount %></td>
              <td><span class="badge-yellow"><%= r.refund_reason_code %></span></td>
              <td class="max-w-xs truncate" title="<%= r.refund_reason %>"><%= r.refund_reason %></td>
              <td><%= refund_status_badge(r.refund_status) %></td>
              <td><%= r.payment_method %></td>
              <td class="max-w-xs truncate text-xs text-gray-600"><%= r.approval_notes %></td>
              <td class="text-xs"><%= r.operator&.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-container">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold">🎫 会员档案</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>档案ID</th>
            <th>学员</th>
            <th>会员等级</th>
            <th>入会日期</th>
            <th>到期日期</th>
            <th>剩余天数</th>
            <th>积分</th>
            <th>支付状态</th>
            <th>累计消费</th>
          </tr>
        </thead>
        <tbody>
          <% @member_profiles.each do |mp| %>
            <tr>
              <td class="font-mono text-xs">#<%= mp.id %></td>
              <td>
                <div><%= link_to mp.student&.name, student_path(mp.student), class: "font-medium text-blue-600 hover:underline" %></div>
                <div class="text-xs text-gray-500"><%= mp.student&.community&.name %></div>
              </td>
              <td><%= member_level_badge(mp.member_level) %></td>
              <td class="text-xs"><%= mp.membership_start_date %></td>
              <td class="text-xs"><%= mp.membership_end_date %></td>
              <td>
                <% days = mp.days_remaining %>
                <% if days <= 0 %>
                  <span class="badge-red">已过期</span>
                <% elsif days <= 30 %>
                  <span class="badge-yellow"><%= days %>天</span>
                <% else %>
                  <span class="badge-green"><%= days %>天</span>
                <% end %>
              </td>
              <td>
                <div class="font-medium"><%= mp.available_points %></div>
                <div class="text-xs text-gray-500">累计 <%= mp.total_points %></div>
              </td>
              <td><%= payment_status_badge(mp.payment_status) %></td>
              <td class="font-semibold text-blue-600">¥<%= mp.total_amount %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
