<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2 class="text-xl font-semibold text-gray-900">缺货提醒</h2>
  <div class="flex flex-wrap gap-2">
    <%= link_to "全部", stock_alerts_path, class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium #{params[:status].blank? ? 'bg-blue-600 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
    <% StockAlert::STATUSES.each do |status| %>
      <% status_label = { pending: '待处理', processing: '处理中', resolved: '已解决' }[status.to_sym] %>
      <%= link_to status_label, stock_alerts_path(status: status), class: "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium #{params[:status] == status ? 'bg-blue-600 text-white' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50'}" %>
    <% end %>
  </div>
</div>

<% if @stock_alerts.any? %>
  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">配件信息</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">关联工单</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">责任人</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">创建时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @stock_alerts.each do |stock_alert| %>
          <%= render stock_alert %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if defined?(@pagy) && @pagy.pages > 1 %>
    <div class="mt-6">
      <%= pagy_nav(@pagy) if defined?(pagy_nav) %>
    </div>
  <% end %>
<% else %>
  <div class="rounded-lg border border-gray-200 bg-white py-12 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <h3 class="mt-2 text-sm font-medium text-gray-900">暂无缺货提醒</h3>
    <p class="mt-1 text-sm text-gray-500">所有配件库存充足</p>
  </div>
<% end %>
