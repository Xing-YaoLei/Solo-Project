<% provide :title, "#{@document.title} - 文书详情" %>

<div class="mb-6">
  <%= link_to '← 返回列表', documents_path, class: "text-blue-600 hover:text-blue-800 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @document.title %></h1>
        <div class="flex items-center gap-4 mt-2 text-sm text-gray-500">
          <span>类型：<%= @document.doc_type_name %></span>
          <span>创建人：<%= @document.creator&.name %></span>
          <span>创建时间：<%= @document.created_at.strftime('%Y-%m-%d %H:%M') %></span>
        </div>
      </div>
      <span class="px-3 py-1 text-sm rounded-full
        <%= case @document.status
            when 'draft' then 'bg-gray-100 text-gray-700'
            when 'pending_review', 'reviewing' then 'bg-yellow-100 text-yellow-700'
            when 'approved' then 'bg-green-100 text-green-700'
            when 'rejected' then 'bg-red-100 text-red-700'
            when 'scheduled' then 'bg-blue-100 text-blue-700'
            when 'published' then 'bg-green-100 text-green-700'
            when 'archived' then 'bg-blue-100 text-blue-700'
            end %>">
        <%= @document.status_name %>
      </span>
    </div>
  </div>

  <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
    <div class="flex flex-wrap gap-2">
      <% if @document.may_submit_for_review? %>
        <%= button_to '提交审核', submit_for_review_document_path(@document), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_start_review? %>
        <%= button_to '开始审核', start_review_document_path(@document), method: :post, class: "bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_approve? %>
        <%= button_to '审核通过', approve_document_path(@document), method: :post, class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_reject? %>
        <button type="button" onclick="document.getElementById('reject-modal').classList.remove('hidden')" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
          审核退回
        </button>
      <% end %>
      <% if @document.may_resubmit? %>
        <%= button_to '重新提交', resubmit_document_path(@document), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_schedule? %>
        <button type="button" onclick="document.getElementById('schedule-modal').classList.remove('hidden')" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
          排期发布
        </button>
      <% end %>
      <% if @document.may_publish? %>
        <%= button_to '立即发布', publish_document_path(@document), method: :post, class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_archive? %>
        <%= button_to '归档', archive_document_path(@document), method: :post, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>
      <% if @document.may_unarchive? %>
        <%= button_to '取消归档', unarchive_document_path(@document), method: :post, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      <% end %>

      <%= link_to '编辑', edit_document_path(@document), class: "bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium border border-gray-300" %>
      <%= button_to '扫描风险词', scan_risk_words_document_path(@document), method: :post, class: "bg-white hover:bg-gray-50 text-orange-600 px-4 py-2 rounded-lg text-sm font-medium border border-orange-300" %>
      <%= link_to '导出', export_document_path(@document, format: :xlsx), class: "bg-white hover:bg-gray-50 text-green-600 px-4 py-2 rounded-lg text-sm font-medium border border-green-300" %>
    </div>
  </div>

  <div class="p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">文书内容</h3>
    <div class="p-4 bg-gray-50 rounded-lg border border-gray-200 font-mono text-sm whitespace-pre-wrap">
      <%= @document.content %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">审核意见</h2>
    </div>
    <div class="p-4 max-h-80 overflow-y-auto">
      <% if @review_opinions.any? %>
        <div class="space-y-4">
          <% @review_opinions.each do |opinion| %>
            <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
              <div class="flex justify-between items-start mb-2">
                <span class="font-medium text-gray-900"><%= opinion.reviewer&.name %></span>
                <span class="px-2 py-0.5 text-xs rounded-full
                  <%= opinion.result == 'approved' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= opinion.result_name %>
                </span>
              </div>
              <p class="text-sm text-gray-700"><%= opinion.opinion %></p>
              <div class="text-xs text-gray-400 mt-2"><%= opinion.reviewed_at&.strftime('%Y-%m-%d %H:%M') %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无审核意见</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">发布排期</h2>
    </div>
    <div class="p-4 max-h-80 overflow-y-auto">
      <% if @publish_schedules.any? %>
        <div class="space-y-3">
          <% @publish_schedules.each do |schedule| %>
            <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
              <div class="flex justify-between items-center mb-2">
                <span class="font-medium text-gray-900"><%= schedule.channel_name %></span>
                <span class="text-xs px-2 py-0.5 rounded-full <%= schedule.published? ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= schedule.published? ? '已发布' : '待发布' %>
                </span>
              </div>
              <p class="text-sm text-gray-600">计划发布：<%= schedule.planned_publish_at&.strftime('%Y-%m-%d %H:%M') %></p>
              <% if schedule.actual_publish_at %>
                <p class="text-sm text-gray-600">实际发布：<%= schedule.actual_publish_at.strftime('%Y-%m-%d %H:%M') %></p>
              <% end %>
              <% if schedule.note.present? %>
                <p class="text-sm text-gray-500 mt-2">备注：<%= schedule.note %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无发布排期</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900">风险词命中</h2>
      <span class="text-sm
        <%= case @document.risk_level
            when 'high' then 'text-red-600'
            when 'medium' then 'text-yellow-600'
            when 'low' then 'text-orange-600'
            else 'text-green-600'
            end %>">
        风险等级：<%= @document.risk_level_name %>
      </span>
    </div>
    <div class="p-4 max-h-80 overflow-y-auto">
      <% if @risk_word_hits.any? %>
        <div class="space-y-2">
          <% @risk_word_hits.each do |hit| %>
            <div class="p-2 bg-gray-50 rounded border border-gray-200">
              <div class="flex justify-between items-center">
                <span class="font-medium text-red-600"><%= hit.risk_word.word %></span>
                <span class="text-xs px-2 py-0.5 rounded-full
                  <%= case hit.risk_word.risk_level
                      when 'high' then 'bg-red-100 text-red-700'
                      when 'medium' then 'bg-yellow-100 text-yellow-700'
                      else 'bg-orange-100 text-orange-700'
                      end %>">
                  <%= hit.risk_word.risk_level_name %>级
                </span>
              </div>
              <p class="text-xs text-gray-500 mt-1">分类：<%= hit.risk_word.category_name %></p>
              <% if hit.context.present? %>
                <p class="text-sm text-gray-600 mt-2"><%= hit.context %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无风险词命中</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900">互动记录</h2>
      <button type="button" onclick="document.getElementById('comment-modal').classList.remove('hidden')" class="text-sm text-blue-600 hover:text-blue-800">
        + 添加
      </button>
    </div>
    <div class="p-4 max-h-80 overflow-y-auto">
      <% if @interaction_records.any? %>
        <div class="space-y-2">
          <% @interaction_records.each do |record| %>
            <div class="flex items-start gap-3 p-2 hover:bg-gray-50 rounded">
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-gray-900"><%= record.operator&.name %></span>
                  <span class="text-xs px-2 py-0.5 bg-blue-100 text-blue-700 rounded"><%= record.action_type_name %></span>
                </div>
                <% if record.content.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= record.content %></p>
                <% end %>
                <p class="text-xs text-gray-400 mt-1"><%= record.created_at.strftime('%Y-%m-%d %H:%M') %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无互动记录</p>
      <% end %>
    </div>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900">内容版本</h2>
      <%= link_to '全部', versions_document_path(@document), class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>
    <div class="p-4 max-h-60 overflow-y-auto">
      <% if @content_versions.any? %>
        <div class="space-y-2">
          <% @content_versions.limit(5).each do |version| %>
            <div class="p-2 bg-gray-50 rounded border border-gray-200">
              <div class="flex justify-between items-center">
                <span class="font-medium text-gray-900">v<%= version.version %></span>
                <span class="text-xs text-gray-500"><%= version.editor&.name %></span>
              </div>
              <% if version.change_summary.present? %>
                <p class="text-sm text-gray-600 mt-1"><%= version.change_summary %></p>
              <% end %>
              <p class="text-xs text-gray-400 mt-1"><%= version.created_at.strftime('%Y-%m-%d %H:%M') %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无版本记录</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200 flex justify-between items-center">
      <h2 class="text-lg font-semibold text-gray-900">状态历史</h2>
      <%= link_to '全部', history_document_path(@document), class: "text-sm text-blue-600 hover:text-blue-800" %>
    </div>
    <div class="p-4 max-h-60 overflow-y-auto">
      <% if @status_histories.any? %>
        <div class="relative">
          <% @status_histories.limit(5).each do |history| %>
            <div class="flex gap-4 pb-4 last:pb-0">
              <div class="flex flex-col items-center">
                <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                <div class="w-0.5 h-full bg-gray-200"></div>
              </div>
              <div class="flex-1 pb-4">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-700">
                    <%= history.from_status_name %> → <%= history.to_status_name %>
                  </span>
                  <span class="text-sm text-gray-500"><%= history.operator&.name %></span>
                </div>
                <% if history.remark.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= history.remark %></p>
                <% end %>
                <p class="text-xs text-gray-400 mt-1"><%= history.created_at.strftime('%Y-%m-%d %H:%M') %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无状态记录</p>
      <% end %>
    </div>
  </div>
</div>

<% if @exception_orders.any? %>
  <div class="mt-6 bg-white rounded-lg shadow border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">相关异常单</h2>
    </div>
    <div class="divide-y divide-gray-100">
      <% @exception_orders.each do |exc| %>
        <div class="p-4 hover:bg-gray-50">
          <%= link_to exception_order_path(exc), class: "block" do %>
            <div class="flex justify-between items-center">
              <div>
                <span class="font-medium text-gray-900"><%= exc.order_no %></span>
                <span class="ml-3 px-2 py-0.5 text-xs rounded-full
                  <%= case exc.status
                      when 'pending' then 'bg-red-100 text-red-700'
                      when 'processing' then 'bg-yellow-100 text-yellow-700'
                      when 'resolved' then 'bg-green-100 text-green-700'
                      when 'closed' then 'bg-gray-100 text-gray-700'
                      end %>">
                  <%= exc.status_name %>
                </span>
              </div>
              <span class="text-sm text-gray-500"><%= exc.created_at.strftime('%Y-%m-%d %H:%M') %></span>
            </div>
            <% if exc.impact_scope.present? %>
              <p class="text-sm text-gray-600 mt-2">影响范围：<%= exc.impact_scope %></p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div id="reject-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">审核退回</h3>
    </div>
    <%= form_with model: @document.review_opinions.new, url: document_review_opinions_path(@document), local: true do |f| %>
      <div class="p-6">
        <div class="mb-4">
          <%= f.label :opinion, '退回原因', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :opinion, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-red-500 focus:border-red-500", required: true %>
        </div>
        <%= f.hidden_field :result, value: 'rejected' %>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('reject-modal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium">
          取消
        </button>
        <%= f.submit '确认退回', class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>

<div id="schedule-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">排期发布</h3>
    </div>
    <%= form_with model: @document.publish_schedules.new, url: document_publish_schedules_path(@document), local: true do |f| %>
      <div class="p-6 space-y-4">
        <div>
          <%= f.label :planned_publish_at, '计划发布时间', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.datetime_field :planned_publish_at, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>
        <div>
          <%= f.label :channel, '发布渠道', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :channel, PublishSchedule::CHANNELS.map { |k, v| [v, k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>
        <div>
          <%= f.label :note, '备注', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :note, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('schedule-modal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium">
          取消
        </button>
        <%= f.submit '确认排期', class: "bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>

<div id="comment-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">添加互动记录</h3>
    </div>
    <%= form_with model: @document.interaction_records.new, url: document_interaction_records_path(@document), local: true do |f| %>
      <div class="p-6 space-y-4">
        <div>
          <%= f.label :action_type, '操作类型', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :action_type, InteractionRecord::ACTION_TYPES.map { |k, v| [v, k] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>
        <div>
          <%= f.label :content, '内容', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :content, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('comment-modal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium">
          取消
        </button>
        <%= f.submit '添加', class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>
