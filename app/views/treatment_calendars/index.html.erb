<div class="px-6 py-8" style="background-color: #F5F3EF; min-height: 100vh;">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-bold" style="color: #1B2A4A;">治疗日历</h1>
      <div class="flex items-center gap-3">
        <%= link_to "←", treatment_calendars_path(month: @current_month.prev_month.strftime("%Y-%m")), class: "px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-sm font-medium hover:bg-gray-50" %>
        <span class="text-lg font-semibold" style="color: #1B2A4A;"><%= @current_month.strftime("%Y年%m月") %></span>
        <%= link_to "→", treatment_calendars_path(month: @current_month.next_month.strftime("%Y-%m")), class: "px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-sm font-medium hover:bg-gray-50" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <div class="lg:col-span-3">
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="grid grid-cols-7" style="background-color: #1B2A4A;">
            <% %w[周一 周二 周三 周四 周五 周六 周日].each do |day| %>
              <div class="px-2 py-3 text-center text-xs font-medium text-white"><%= day %></div>
            <% end %>
          </div>

          <div class="grid grid-cols-7">
            <% start_day = @current_month.beginning_of_month %>
            <% start_wday = (start_day.wday - 1) % 7 %>
            <% end_day = @current_month.end_of_month %>
            <% (start_wday).times do %>
              <div class="border border-gray-100 p-2 min-h-[100px] bg-gray-50"></div>
            <% end %>

            <% (start_day..end_day).each do |date| %>
              <% day_sessions = @sessions_by_date[date] || [] %>
              <% threshold = @thresholds.values.first %>
              <% is_overloaded = threshold && day_sessions.count >= threshold.max_daily_treatments %>

              <div class="border border-gray-100 p-2 min-h-[100px] hover:bg-gray-50 transition-colors <%= 'bg-red-50' if is_overloaded %>">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-medium <%= date == Date.current ? 'px-1.5 py-0.5 rounded-full text-white' : '' %>" style="<%= date == Date.current ? 'background-color: #2DD4A8;' : 'color: #1B2A4A;' %>">
                    <%= date.day %>
                  </span>
                  <% if is_overloaded %>
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                  <% end %>
                </div>

                <div class="space-y-1">
                  <% day_sessions.first(3).each do |session| %>
                    <%= link_to treatment_calendar_path(date), class: "block", data: { turbo_frame: "day_detail" } do %>
                      <div class="text-xs px-1.5 py-0.5 rounded truncate
                        <%= case session.status
                            when 'completed' then 'bg-emerald-100 text-emerald-700'
                            when 'in_progress' then 'bg-blue-100 text-blue-700'
                            when 'missed' then 'bg-red-100 text-red-700'
                            else 'bg-gray-100 text-gray-600'
                            end %>">
                        <%= session.prescription&.assessment_record&.patient&.name || "训练" %>
                      </div>
                    <% end %>
                  <% end %>

                  <% if day_sessions.count > 3 %>
                    <span class="text-xs text-gray-400">+<%= day_sessions.count - 3 %> 更多</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="lg:col-span-1">
        <%= turbo_frame_tag "threshold_settings" do %>
          <div class="bg-white rounded-xl shadow-sm p-5">
            <h3 class="text-sm font-bold mb-4" style="color: #1B2A4A;">区域阈值设置</h3>

            <% @areas.each do |area| %>
              <% threshold = @thresholds[area.id] || TreatmentCalendarThreshold.new(area: area) %>
              <div class="mb-4 pb-4 border-b border-gray-100 last:border-0 last:mb-0 last:pb-0">
                <h4 class="text-xs font-semibold text-gray-600 mb-3"><%= area.name %></h4>
                <%= form_with model: threshold, url: update_threshold_treatment_calendars_path, method: :patch, data: { turbo_frame: "threshold_settings" } do |f| %>
                  <%= f.hidden_field :area_id, value: area.id %>
                  <div class="space-y-2">
                    <div>
                      <label class="block text-xs text-gray-500 mb-0.5">每日最大治疗数</label>
                      <%= f.number_field :max_daily_treatments, min: 1, class: "w-full px-2 py-1 border border-gray-200 rounded text-xs" %>
                    </div>
                    <div>
                      <label class="block text-xs text-gray-500 mb-0.5">最小间隔(分钟)</label>
                      <%= f.number_field :min_interval_minutes, min: 5, class: "w-full px-2 py-1 border border-gray-200 rounded text-xs" %>
                    </div>
                    <%= f.submit "保存", class: "w-full px-2 py-1 rounded text-xs text-white font-medium", style: "background-color: #1B2A4A;" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= turbo_frame_tag "day_detail" do %>
        <% end %>
      </div>
    </div>
  </div>
</div>
