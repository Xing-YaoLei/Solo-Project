<% content_for :page_title, '结算单' %>

<div class="p-6 space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2 bg-white rounded-lg p-1 shadow-sm">
        <button class="px-4 py-2 rounded-md bg-[#1e3a5f] text-white text-sm font-medium">全部</button>
        <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">待确认</button>
        <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">处理中</button>
        <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">已完成</button>
        <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">有差异</button>
      </div>
      <div class="flex items-center gap-2">
        <input type="date" class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
        <span class="text-gray-400">至</span>
        <input type="date" class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
      </div>
    </div>
    <button class="px-4 py-2.5 border border-gray-200 rounded-lg text-gray-600 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center gap-2">
      <i data-lucide="download" class="w-4 h-4"></i>
      导出
    </button>
  </div>

  <div class="bg-white rounded-2xl shadow-card overflow-hidden animate-fade-in">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">结算单号</th>
            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">结算周期</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">系统金额</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">商户金额</th>
            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">差异金额</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">付款日期</th>
            <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @settlements.each do |settlement| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="font-semibold text-[#1e3a5f]">#<%= settlement.id %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-gray-600"><%= settlement.period %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <span class="font-bold text-gray-900 font-serif">¥<%= number_with_delimiter(sprintf('%.2f', settlement.system_amount)) %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <span class="font-bold text-[#f59e0b] font-serif">¥<%= number_with_delimiter(sprintf('%.2f', settlement.merchant_amount)) %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <% if settlement.difference_amount != 0 %>
                  <span class="font-bold <%= settlement.difference_amount > 0 ? 'text-red-600' : 'text-blue-600' %> font-serif">
                    <%= settlement.difference_amount > 0 ? '+' : '' %>¥<%= number_with_delimiter(sprintf('%.2f', settlement.difference_amount)) %>
                  </span>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <span class="status-badge status-<%= settlement.status %>">
                  <%= { pending: '待确认', processing: '处理中', approved: '已批准', rejected: '已拒绝', completed: '已完成' }[settlement.status.to_sym] || settlement.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center text-gray-600">
                <%= settlement.payment_date&.strftime('%Y-%m-%d') || '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-center">
                <%= link_to merchants_settlement_path(settlement), class: 'p-2 rounded-lg hover:bg-gray-100 transition-colors inline-block' do %>
                  <i data-lucide="eye" class="w-4 h-4 text-gray-500"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <%= render PaginationComponent.new(pagy: @pagy) %>
    <% end %>
  </div>
</div>
