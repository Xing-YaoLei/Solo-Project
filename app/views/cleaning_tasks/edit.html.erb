<div class="w-full max-w-3xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">编辑保洁任务</h1>
    <div class="space-x-2">
      <%= link_to "返回详情", cleaning_task_path(@cleaning_task), class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
      <%= link_to "列表", cleaning_tasks_path, class: "inline-flex items-center px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <%= render "form", cleaning_task: @cleaning_task %>
  </div>
</div>
