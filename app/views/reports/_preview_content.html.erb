<% if export_type.blank? %>
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
    </svg>
    <h3 class="text-lg font-medium text-gray-900 mb-2">选择导出类型开始预览</h3>
    <p class="text-sm text-gray-500 max-w-md">从左侧面板选择导出类型和筛选条件，点击「预览」按钮查看数据预览</p>
  </div>
<% else %>
  <div class="space-y-6">
    <% if caliber_note.present? %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-5">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="flex-1">
            <h4 class="text-sm font-semibold text-amber-900 mb-2">口径说明</h4>
            <pre class="text-xs text-amber-800 whitespace-pre-wrap font-sans leading-relaxed"><%= caliber_note %></pre>
          </div>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-gray-900">
            <%= case export_type
                when "audit_summary" then "审计汇总预览"
                when "exception_summary" then "异常汇总预览"
                when "rectification_report" then "整改报告预览"
                when "supplier_audit" then "供应商审计预览"
                when "full_audit_record" then "完整审计记录预览"
                else "数据预览"
                end %>
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">统计周期：<%= start_date %> 至 <%= end_date %></p>
        </div>
      </div>

      <% case export_type %>
      <% when "audit_summary", "full_audit_record" %>
        <% if preview_data[:sample].present? %>
          <div class="grid grid-cols-4 gap-4 px-5 py-4 border-b border-gray-100 bg-gray-50">
            <div class="text-center">
              <div class="text-2xl font-bold text-gray-900"><%= preview_data[:total] %></div>
              <div class="text-xs text-gray-500 mt-1">审计总数</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-green-600"><%= preview_data[:completed] %></div>
              <div class="text-xs text-gray-500 mt-1">已完成</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-blue-600"><%= preview_data[:in_progress] %></div>
              <div class="text-xs text-gray-500 mt-1">进行中</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-red-600"><%= preview_data[:rejected] %></div>
              <div class="text-xs text-gray-500 mt-1">已拒绝</div>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">审计项目</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">供应商</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">类型</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">状态</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">创建人</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">创建时间</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% preview_data[:sample].each do |audit| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-5 py-3.5 font-medium text-gray-900"><%= audit.title %></td>
                    <td class="px-5 py-3.5 text-gray-600"><%= audit.supplier&.name %></td>
                    <td class="px-5 py-3.5">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">
                        <%= audit.audit_type.humanize %>
                      </span>
                    </td>
                    <td class="px-5 py-3.5">
                      <% status_color = audit.status.to_s.in?(%w[approved archived]) ? "bg-green-100 text-green-700" :
                                         audit.status.to_s == "rejected" ? "bg-red-100 text-red-700" :
                                         audit.status.to_s == "draft" ? "bg-gray-100 text-gray-700" :
                                         "bg-blue-100 text-blue-700" %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_color %>">
                        <%= audit.status.text rescue audit.status.to_s.humanize %>
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-gray-600"><%= audit.creator&.name %></td>
                    <td class="px-5 py-3.5 text-gray-500 text-xs"><%= audit.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="px-5 py-3 border-t border-gray-100 bg-gray-50 text-xs text-gray-500">
            仅显示前 10 条记录，导出将包含完整数据
          </div>
        <% else %>
          <div class="px-5 py-12 text-center text-gray-500 text-sm">
            暂无符合条件的数据
          </div>
        <% end %>

      <% when "exception_summary", "rectification_report" %>
        <% if preview_data.present? %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">统计项</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">数值</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">占比</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-3.5 text-gray-900 font-medium">异常单总数</td>
                  <td class="px-5 py-3.5 text-gray-900"><%= preview_data[:total] || "-" %></td>
                  <td class="px-5 py-3.5 text-gray-500">100%</td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-3.5 text-gray-900 font-medium">已完成整改</td>
                  <td class="px-5 py-3.5 text-green-600 font-medium"><%= preview_data[:resolved] || "-" %></td>
                  <td class="px-5 py-3.5 text-gray-500"><%= preview_data[:total].to_i > 0 ? "#{((preview_data[:resolved].to_i / preview_data[:total].to_f) * 100).round(1)}%" : "-" %></td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-3.5 text-gray-900 font-medium">进行中</td>
                  <td class="px-5 py-3.5 text-blue-600 font-medium"><%= preview_data[:in_progress] || "-" %></td>
                  <td class="px-5 py-3.5 text-gray-500"><%= preview_data[:total].to_i > 0 ? "#{((preview_data[:in_progress].to_i / preview_data[:total].to_f) * 100).round(1)}%" : "-" %></td>
                </tr>
                <tr class="hover:bg-gray-50">
                  <td class="px-5 py-3.5 text-gray-900 font-medium">整改完成率</td>
                  <td class="px-5 py-3.5">
                    <span class="inline-flex items-center gap-2">
                      <span class="text-lg font-bold text-indigo-600"><%= preview_data[:rate] ? "#{preview_data[:rate].round(1)}%" : "-" %></span>
                    </span>
                  </td>
                  <td class="px-5 py-3.5 text-gray-500">-</td>
                </tr>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="px-5 py-12 text-center text-gray-500 text-sm">
            暂无符合条件的数据
          </div>
        <% end %>

      <% when "supplier_audit" %>
        <% if preview_data[:suppliers].present? %>
          <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 text-sm">
            共 <span class="font-semibold text-gray-900"><%= preview_data[:total] %></span> 家供应商，显示前 20 家数据
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">供应商</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">编码</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">审计次数</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">待处理异常</th>
                  <th class="px-5 py-3 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">材料完整率</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% preview_data[:suppliers].each do |supplier| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-5 py-3.5 font-medium text-gray-900"><%= supplier.name %></td>
                    <td class="px-5 py-3.5 text-gray-600 font-mono text-xs"><%= supplier.code %></td>
                    <td class="px-5 py-3.5 text-gray-900"><%= supplier.audits.count %></td>
                    <td class="px-5 py-3.5">
                      <% count = supplier.audits.sum { |a| a.exception_orders.open.count } %>
                      <span class="<%= count > 0 ? 'text-red-600 font-medium' : 'text-gray-500' %>"><%= count %></span>
                    </td>
                    <td class="px-5 py-3.5">
                      <div class="flex items-center gap-2">
                        <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden">
                          <div class="h-full bg-emerald-500 rounded-full" style="width: <%= supplier.material_completeness %>%"></div>
                        </div>
                        <span class="text-xs text-gray-600"><%= supplier.material_completeness %>%</span>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="px-5 py-12 text-center text-gray-500 text-sm">
            暂无符合条件的数据
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
