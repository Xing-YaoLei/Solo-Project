<div class="page-header">
  <%= link_to "← 返回记录中心", records_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title">💳 核销记录详情 #<%= @record.id %></h1>
  <p class="page-subtitle">学员：<%= @student&.name %> · <%= @record.benefit_name %></p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="stat-card p-5">
      <h3 class="font-semibold mb-4">核销信息</h3>
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div><dt class="text-gray-500">核销码</dt><dd class="font-mono"><%= @record.redemption_code %></dd></div>
        <div><dt class="text-gray-500">状态</dt><dd><%= status_badge(@record.status) %></dd></div>
        <div><dt class="text-gray-500">权益名称</dt><dd><%= @record.benefit_name %></dd></div>
        <div><dt class="text-gray-500">对应规则</dt><dd><%= @record.benefit_rule&.name || "自定义" %></dd></div>
        <div><dt class="text-gray-500">核销时间</dt><dd><%= @record.redeemed_at&.strftime("%Y-%m-%d %H:%M") %></dd></div>
        <div><dt class="text-gray-500">核销渠道</dt><dd><%= @record.channel %></dd></div>
        <div><dt class="text-gray-500">消耗积分</dt><dd class="font-semibold text-yellow-600"><%= @record.points_used %> 分</dd></div>
        <div><dt class="text-gray-500">操作员</dt><dd><%= @record.operator&.name || "系统" %></dd></div>
        <div class="col-span-2"><dt class="text-gray-500">备注</dt><dd><%= @record.notes || "-" %></dd></div>
      </dl>
    </div>

    <div class="table-container">
      <div class="p-4 border-b font-semibold">↩️ 该学员的退款记录</div>
      <table class="data-table">
        <thead><tr><th>ID</th><th>金额</th><th>原因</th><th>状态</th><th>时间</th></tr></thead>
        <tbody>
          <% @related_refunds.each do |r| %>
            <tr>
              <td class="font-mono text-xs">#<%= r.id %></td>
              <td class="text-red-600 font-semibold">¥<%= r.refund_amount %></td>
              <td><%= r.refund_reason_code %></td>
              <td><%= refund_status_badge(r.refund_status) %></td>
              <td class="text-xs"><%= r.created_at.strftime("%m-%d") %></td>
            </tr>
          <% end %>
          <% if @related_refunds.empty? %>
            <tr><td colspan="5" class="text-center py-4 text-gray-500">暂无退款记录</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="space-y-6">
    <div class="stat-card p-5">
      <h3 class="font-semibold mb-3">🎫 会员档案</h3>
      <% if @member_profile %>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">会员等级</span><%= member_level_badge(@member_profile.member_level) %></div>
          <div class="flex justify-between"><span class="text-gray-500">支付状态</span><%= payment_status_badge(@member_profile.payment_status) %></div>
          <div class="flex justify-between"><span class="text-gray-500">累计消费</span><span class="font-semibold text-blue-600">¥<%= @member_profile.total_amount %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">可用积分</span><span class="font-semibold"><%= @member_profile.available_points %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">到期日期</span><span class="text-xs"><%= @member_profile.membership_end_date %></span></div>
        </dl>
      <% else %>
        <p class="text-gray-500">暂无会员档案</p>
      <% end %>
      <%= link_to "查看学员详情", student_path(@record.student), class: "btn-secondary w-full mt-4 justify-center" %>
    </div>
  </div>
</div>
