<div class="page-header">
  <%= link_to "← 返回列表", operation_logs_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title">📋 操作日志详情 #<%= @log.id %></h1>
  <p class="page-subtitle"><%= action_text(@log.action) %> · <%= @log.operator&.name || "系统" %></p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="stat-card p-5">
    <h3 class="font-semibold mb-4">基本信息</h3>
    <dl class="space-y-3 text-sm">
      <div class="flex justify-between">
        <dt class="text-gray-500">操作动作</dt>
        <dd><span class="badge-blue"><%= action_text(@log.action) %></span></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">操作人</dt>
        <dd class="font-medium"><%= @log.operator&.name || "系统" %> (#<%= @log.operator_id %>)</dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">目标对象</dt>
        <dd class="font-medium text-blue-600"><%= @log.target_name %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">对象类型</dt>
        <dd class="font-mono text-xs"><%= @log.target_type %>#<%= @log.target_id %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">IP地址</dt>
        <dd class="font-mono text-xs"><%= @log.ip_address %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">状态</dt>
        <dd><%= status_badge(@log.status) %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">操作时间</dt>
        <dd class="text-xs"><%= @log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
      </div>
      <div class="border-t pt-3 flex justify-between">
        <dt class="text-gray-500 font-semibold">关闭时间</dt>
        <dd class="text-xs font-semibold text-blue-600"><%= @log.closed_at&.strftime("%Y-%m-%d %H:%M:%S") || "未关闭" %></dd>
      </div>
    </dl>
  </div>

  <div class="space-y-6">
    <div class="stat-card p-5">
      <h3 class="font-semibold mb-2">📋 原因</h3>
      <p class="text-gray-700 bg-gray-50 p-3 rounded"><%= @log.reason || "无特殊说明" %></p>
    </div>

    <div class="stat-card p-5">
      <h3 class="font-semibold mb-2">📝 操作详情</h3>
      <p class="text-gray-700 bg-gray-50 p-3 rounded text-sm"><%= @log.details || "无" %></p>
    </div>

    <div class="stat-card p-5">
      <h3 class="font-semibold mb-2">User-Agent</h3>
      <p class="text-gray-600 bg-gray-50 p-3 rounded text-xs font-mono break-all"><%= @log.user_agent || "-" %></p>
    </div>
  </div>
</div>

<% if @log.before_data.present? || @log.after_data.present? %>
  <div class="table-container mt-6">
    <div class="p-4 border-b">
      <h3 class="font-semibold">⚙️ 数据变更对比</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 divide-x divide-gray-200">
      <div class="p-4">
        <h4 class="font-semibold text-red-700 mb-3">🔙 修改前数据</h4>
        <pre class="bg-red-50 p-3 rounded text-xs overflow-auto"><%= JSON.pretty_generate(@log.before_data) %></pre>
      </div>
      <div class="p-4">
        <h4 class="font-semibold text-green-700 mb-3">🔜 修改后数据</h4>
        <pre class="bg-green-50 p-3 rounded text-xs overflow-auto"><%= JSON.pretty_generate(@log.after_data) %></pre>
      </div>
    </div>
  </div>
<% end %>
