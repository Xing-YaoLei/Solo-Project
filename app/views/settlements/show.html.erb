<% content_for :title, "结算单详情 - 职业教育结算台" %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "← 返回结算台", settlements_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="text-2xl font-bold text-gray-900 mt-2">结算单详情</h1>
      <p class="mt-1 text-sm text-gray-500">
        <%= @settlement.period_start %> 至 <%= @settlement.period_end %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= settlement_status_class(@settlement.status) %> ml-2">
          <%= settlement_status_text(@settlement.status) %>
        </span>
      </p>
    </div>
    <div class="flex space-x-3">
      <% if @settlement.draft? %>
        <%= button_to "开始计算", calculate_settlement_path(@settlement), method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700" %>
      <% end %>
      <% if @settlement.pending_review? %>
        <%= button_to "通过", approve_settlement_path(@settlement), method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700" %>
        <%= button_to "驳回", reject_settlement_path(@settlement), method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700" %>
      <% end %>
      <% if @settlement.approved? || @settlement.exported? %>
        <%= link_to "导出Excel", export_settlement_path(@settlement, format: :xlsx), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-purple-600 hover:bg-purple-700" do %>
          <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          导出Excel
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">订单总数</p>
    <p class="text-3xl font-bold text-gray-900 mt-1"><%= @settlement.total_orders %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">总金额</p>
    <p class="text-3xl font-bold text-gray-900 mt-1">¥<%= number_with_precision @settlement.total_amount, precision: 2 %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">渠道分成</p>
    <p class="text-3xl font-bold text-orange-600 mt-1">¥<%= number_with_precision @settlement.channel_commission_amount, precision: 2 %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">净收入</p>
    <p class="text-3xl font-bold text-green-600 mt-1">¥<%= number_with_precision @settlement.net_revenue, precision: 2 %></p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">完课数量</p>
    <p class="text-2xl font-bold text-purple-600 mt-1"><%= @settlement.completed_courses_count %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">通过考试</p>
    <p class="text-2xl font-bold text-blue-600 mt-1"><%= @settlement.passed_exams_count %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">退款</p>
    <p class="text-2xl font-bold text-red-600 mt-1"><%= @settlement.refund_count %> 笔 / ¥<%= number_with_precision @settlement.refund_amount, precision: 2 %></p>
  </div>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-medium text-gray-900">结算明细</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">订单号</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学员</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">渠道</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">类型</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">分成</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">完课状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">考试状态</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @settlement_items.each do |item| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-indigo-600">
              <%= link_to item.order.order_no, order_path(item.order) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= item.order.user&.name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= item.order.course&.title %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= item.order.channel&.name %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                <%= settlement_item_type_text(item.item_type) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">¥<%= number_with_precision item.amount, precision: 2 %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-orange-600">¥<%= number_with_precision item.commission_amount, precision: 2 %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if item.enrollment&.completed? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">已完课</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">未完课</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if item.enrollment&.exam_passed? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">通过</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">未通过</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @settlement_items.total_pages > 1 %>
    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @settlement_items %>
    </div>
  <% end %>
</div>
