{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./assets/scripts",
    "baseUrl": "./assets/scripts",
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "paths": {
      "@core/*": ["core/*"],
      "@models/*": ["models/*"],
      "@game/*": ["game/*"],
      "@config/*": ["config/*"],
      "@scenes/*": ["scenes/*"],
      "@ui/*": ["ui/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": [
    "assets/scripts/**/*.ts",
    "assets/scripts/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "temp",
    "library"
  ]
}
