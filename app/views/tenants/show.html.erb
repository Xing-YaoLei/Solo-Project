<div class="page-header">
  <h1>租户详情</h1>
  <div>
    <%= link_to "编辑", edit_tenant_path(@tenant), class: "btn btn-primary" %>
    <%= button_to "删除", tenant_path(@tenant), method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "确认删除该租户？" } } %>
    <%= link_to "返回列表", tenants_path, class: "btn" %>
  </div>
</div>

<div class="detail-card">
  <dl>
    <dt>名称</dt>
    <dd><%= @tenant.name %></dd>

    <dt>联系人</dt>
    <dd><%= @tenant.contact_person %></dd>

    <dt>联系电话</dt>
    <dd><%= @tenant.contact_phone %></dd>

    <dt>邮箱</dt>
    <dd><%= @tenant.email %></dd>

    <dt>地址</dt>
    <dd><%= @tenant.address %></dd>

    <dt>备注</dt>
    <dd><%= @tenant.remark %></dd>
  </dl>
</div>

<%= turbo_frame_tag "tenant_contracts" do %>
  <section class="panel">
    <div class="panel-header">
      <h2>关联合同</h2>
    </div>

    <% if @contracts.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>合同编号</th>
            <th>开始日期</th>
            <th>结束日期</th>
            <th>月租金额</th>
            <th>状态</th>
          </tr>
        </thead>
        <tbody>
          <% @contracts.each do |contract| %>
            <tr>
              <td><%= link_to contract.contract_number, tenant_contract_path(contract) %></td>
              <td><%= contract.start_date %></td>
              <td><%= contract.end_date %></td>
              <td>¥<%= contract.rent_amount %></td>
              <td>
                <% if contract.end_date >= Date.current %>
                  <span class="badge badge-active">生效中</span>
                <% else %>
                  <span class="badge badge-expired">已过期</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>暂无关联合同</p>
    <% end %>
  </section>
<% end %>
