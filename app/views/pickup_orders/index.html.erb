<% content_for :title, "单据列表" %>

<div class="bg-white shadow rounded-lg">
  <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        <%= params[:action] == 'closed' ? '已关闭单据' : '单据列表' %>
      </h3>
      <div class="mt-3 sm:mt-0">
        <%= form_tag params[:action] == 'closed' ? closed_pickup_orders_path : pickup_orders_path, method: :get, class: 'flex flex-wrap gap-3 items-center' do %>
          <%= text_field_tag 'q[pickup_code_or_customer_name_or_customer_phone_cont]', params.dig(:q, :pickup_code_or_customer_name_or_customer_phone_cont), placeholder: "搜索自提码/客户", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= select_tag 'q[status_eq]', options_for_select(PickupOrder::STATUS_DISPLAY.map { |k, v| [v, k] }, params.dig(:q, :status_eq)), include_blank: "所有状态", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= select_tag 'q[source_eq]', options_for_select(PickupOrder::SOURCES.map { |s| [s, s] }, params.dig(:q, :source_eq)), include_blank: "所有来源", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= select_tag 'q[operator_id_eq]', options_for_select(User.all.map { |u| [u.name, u.id] }, params.dig(:q, :operator_id_eq)), include_blank: "所有处理人", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= date_field_tag 'q[created_at_gteq]', params.dig(:q, :created_at_gteq), placeholder: "开始日期", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= date_field_tag 'q[created_at_lteq]', params.dig(:q, :created_at_lteq), placeholder: "结束日期", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
          <%= submit_tag "筛选", class: "px-3 py-1 bg-indigo-600 text-white rounded-md text-sm hover:bg-indigo-700" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">自提码</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">客户</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商品</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">处理人</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @pickup_orders.each do |order| %>
          <%= turbo_frame_tag dom_id(order) do %>
            <tr class="hover:bg-gray-50 <%= 'bg-red-50' if order.has_shortage? %>">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="text-sm font-medium text-indigo-600">
                    <%= link_to order.pickup_code, order, class: "hover:text-indigo-900" %>
                  </div>
                  <% if order.has_shortage? %>
                    <span class="ml-2 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                      短少
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= order.customer_name %></div>
                <% if order.customer_phone.present? %>
                  <div class="text-sm text-gray-500"><%= order.customer_phone %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                  <%= order.source %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_badge_class(order.status) %>">
                  <%= order.full_status_display %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= order.total_items_count %> 件
                <% if order.total_shortage_count > 0 %>
                  <span class="text-red-600">(缺<%= order.total_shortage_count %>件)</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= order.operator&.name || '-' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= order.created_at.strftime('%m-%d %H:%M') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "查看", order, class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="px-4 py-3 border-t border-gray-200 sm:px-6">
    <%= paginate @pickup_orders %>
  </div>
</div>
