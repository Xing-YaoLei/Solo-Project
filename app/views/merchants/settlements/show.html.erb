<% content_for :page_title, '结算单详情' %>
<% content_for :breadcrumb do %>
  <a href="/merchants/settlements" class="text-gray-500 hover:text-[#1e3a5f]">结算单</a>
  <span class="mx-2">/</span>
  <span class="text-[#1e3a5f] font-medium">详情</span>
<% end %>

<div class="p-6 space-y-6">
  <div class="bg-white rounded-2xl p-6 shadow-card animate-fade-in">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-2xl font-bold text-[#1e3a5f] font-serif">结算单 #10023</h2>
          <span class="px-3 py-1 rounded-full text-sm font-medium bg-orange-100 text-orange-600">待确认</span>
        </div>
        <p class="text-gray-500">结算周期：2024年第24周（6月10日-6月16日）</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-4 py-2 border border-gray-200 rounded-lg text-gray-600 hover:border-[#1e3a5f] hover:text-[#1e3a5f] transition-colors flex items-center gap-2">
          <i data-lucide="download" class="w-4 h-4"></i>
          下载凭证
        </button>
        <button class="px-5 py-2 bg-[#ef4444] text-white rounded-lg hover:bg-[#dc2626] transition-colors">
          提出异议
        </button>
        <button class="px-5 py-2 bg-[#10b981] text-white rounded-lg hover:bg-[#059669] transition-colors">
          确认结算
        </button>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <%= render AmountComparisonComponent.new(settlement: OpenStruct.new(
      system_amount: 528642.50,
      merchant_amount: 512345.00,
      difference_amount: 16297.50,
      period: '2024年第24周',
      payment_date: Date.parse('2024-06-20')
    )) %>

    <%= render ApprovalFlowComponent.new(
      approval_records: [
        OpenStruct.new(approval_node_id: 1, status: 'approved', comment: '数据核对无误', approver: OpenStruct.new(name: '客服张三'), approved_at: 2.hours.ago)
      ],
      approval_nodes: [
        OpenStruct.new(id: 1, name: '客服审核', role_name: '客服专员', enabled?: true, sequence: 1),
        OpenStruct.new(id: 2, name: '商户确认', role_name: '商户', enabled?: true, sequence: 2),
        OpenStruct.new(id: 3, name: '财务复核', role_name: '财务人员', enabled?: true, sequence: 3),
        OpenStruct.new(id: 4, name: '经理审批', role_name: '城市经理', enabled?: true, sequence: 4)
      ]
    ) %>
  </div>

  <div class="bg-white rounded-2xl shadow-card overflow-hidden animate-fade-in" style="animation-delay: 100ms">
    <div class="p-6 border-b border-gray-100">
      <h3 class="text-lg font-bold text-[#1e3a5f] font-serif">结算明细</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">日期</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">订单号</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">商品</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">订单金额</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">平台服务费</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">配送费</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">结算金额</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% 10.times do |i| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 text-sm text-gray-600">2024-06-<%= 10 + (i % 7) %></td>
              <td class="px-6 py-4 text-sm font-medium text-gray-900">ORD<%= sprintf('%08d', 12345678 + i) %></td>
              <td class="px-6 py-4 text-sm text-gray-600">商品订单 #<%= i + 1 %></td>
              <td class="px-6 py-4 text-sm font-medium text-right font-serif">¥<%= sprintf('%.2f', 68.50 + i * 15.5) %></td>
              <td class="px-6 py-4 text-sm text-right text-gray-500">-¥<%= sprintf('%.2f', 6.85 + i * 1.55) %></td>
              <td class="px-6 py-4 text-sm text-right text-gray-500">-¥<%= sprintf('%.2f', 5.00 + i * 0.5) %></td>
              <td class="px-6 py-4 text-sm font-bold text-right font-serif">¥<%= sprintf('%.2f', 56.65 + i * 13.45) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="p-6 bg-gray-50 border-t border-gray-100">
      <div class="flex justify-end">
        <div class="w-80 space-y-2">
          <div class="flex justify-between">
            <span class="text-gray-500">订单总额</span>
            <span class="font-medium font-serif">¥528,642.50</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">平台服务费</span>
            <span class="font-medium text-gray-500 font-serif">-¥52,864.25</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">配送费</span>
            <span class="font-medium text-gray-500 font-serif">-¥42,291.40</span>
          </div>
          <div class="flex justify-between pt-3 border-t border-gray-200">
            <span class="font-semibold text-gray-900">应结算金额</span>
            <span class="text-xl font-bold text-[#1e3a5f] font-serif">¥433,486.85</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
