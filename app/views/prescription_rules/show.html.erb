<div class="px-6 py-8" style="background-color: #F5F3EF; min-height: 100vh;">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <%= link_to "← 返回列表", prescription_rules_path, class: "text-sm font-medium hover:underline", style: "color: #2DD4A8;" %>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold" style="color: #1B2A4A;"><%= @prescription_rule.name %></h1>
        <span class="px-3 py-1 rounded-full text-xs font-medium <%= @prescription_rule.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-100 text-gray-500' %>">
          <%= @prescription_rule.active? ? '启用' : '停用' %>
        </span>
      </div>

      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">触发条件</h3>
          <p class="text-gray-700 bg-gray-50 rounded-lg p-4"><%= @prescription_rule.trigger_condition %></p>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2">训练计划</h3>
          <div class="space-y-3">
            <% Array(@prescription_rule.training_plan).each_with_index do |item, i| %>
              <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-medium" style="color: #1B2A4A;"><%= item['exercise_name'].presence || "练习 #{i + 1}" %></span>
                  <span class="text-xs px-2 py-1 rounded-full" style="background-color: #2DD4A8; color: white;"><%= item['frequency'] %></span>
                </div>
                <div class="grid grid-cols-3 gap-4 text-sm text-gray-600">
                  <div><span class="font-medium">组数:</span> <%= item['sets'] %></div>
                  <div><span class="font-medium">次数:</span> <%= item['reps'] %></div>
                  <div><span class="font-medium">时长:</span> <%= item['duration'] %> 分钟</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-100 flex gap-3">
        <%= link_to "编辑", edit_prescription_rule_path(@prescription_rule), class: "px-4 py-2 rounded-lg text-white font-medium", style: "background-color: #1B2A4A;" %>
        <%= button_to "删除", prescription_rule_path(@prescription_rule), method: :delete, class: "px-4 py-2 rounded-lg text-white font-medium bg-red-500", form: { data: { turbo_confirm: "确认删除此规则？" } } %>
      </div>
    </div>
  </div>
</div>
