<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← 返回月度报告列表", monthly_reports_path, class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-8 py-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-white">月度复盘报告详情</h1>
          <p class="text-blue-100 mt-1"><%= @monthly_report.month_display %> · <%= @monthly_report.property&.name %></p>
        </div>
        <div class="text-right">
          <p class="text-blue-100 text-sm">物业经理</p>
          <p class="text-white font-semibold"><%= @monthly_report.property&.manager&.name %></p>
        </div>
      </div>
    </div>

    <div class="p-8">
      <div class="mb-10">
        <div class="text-center">
          <p class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-3">入住率</p>
          <% rate = @monthly_report.occupancy_rate.to_f %>
          <div class="inline-flex items-baseline">
            <span class="text-7xl font-bold <%= rate >= 80 ? 'text-green-600' : rate >= 60 ? 'text-blue-600' : rate >= 40 ? 'text-yellow-600' : 'text-red-600' %>">
              <%= rate.round(1) %>
            </span>
            <span class="text-3xl font-semibold <%= rate >= 80 ? 'text-green-600' : rate >= 60 ? 'text-blue-600' : rate >= 40 ? 'text-yellow-600' : 'text-red-600' %> ml-1">
              %
            </span>
          </div>
          <div class="mt-6 max-w-md mx-auto">
            <div class="bg-gray-200 rounded-full h-4 overflow-hidden">
              <% bar_color = if rate >= 80 then "bg-green-500"
                             elsif rate >= 60 then "bg-blue-500"
                             elsif rate >= 40 then "bg-yellow-500"
                             else "bg-red-500" end %>
              <div class="<%= bar_color %> h-4 rounded-full transition-all duration-500" style="width: <%= rate %>%"></div>
            </div>
            <div class="flex justify-between mt-2 text-xs text-gray-500">
              <span>0%</span>
              <span>50%</span>
              <span>100%</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-1">总房间数</p>
          <p class="text-3xl font-bold text-gray-900"><%= @monthly_report.total_rooms %></p>
          <p class="text-xs text-gray-400 mt-1">间</p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 text-green-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-1">已入住房间数</p>
          <p class="text-3xl font-bold text-gray-900"><%= @monthly_report.occupied_rooms %></p>
          <p class="text-xs text-gray-400 mt-1">间</p>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-yellow-100 text-yellow-600 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-1">总收入</p>
          <p class="text-3xl font-bold text-gray-900">¥<%= number_with_delimiter(@monthly_report.total_revenue.to_f.round(2)) %></p>
          <p class="text-xs text-gray-400 mt-1">人民币</p>
        </div>
      </div>

      <div class="border-t border-gray-200 pt-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">报告信息</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
          <div class="flex justify-between py-2 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-500">房源地址</dt>
            <dd class="text-sm text-gray-900"><%= @monthly_report.property&.address %></dd>
          </div>
          <div class="flex justify-between py-2 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-500">房源状态</dt>
            <dd class="text-sm text-gray-900"><%= @monthly_report.property&.status_i18n %></dd>
          </div>
          <div class="flex justify-between py-2 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-500">报告生成时间</dt>
            <dd class="text-sm text-gray-900"><%= @monthly_report.created_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
          </div>
          <div class="flex justify-between py-2 border-b border-gray-100">
            <dt class="text-sm font-medium text-gray-500">最后更新时间</dt>
            <dd class="text-sm text-gray-900"><%= @monthly_report.updated_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
          </div>
        </dl>
      </div>

      <div class="mt-8 flex justify-end gap-3">
        <%= button_to "重新生成该月报告", generate_monthly_reports_path(month: @monthly_report.report_month.strftime("%Y-%m")), method: :post, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition-colors" %>
        <%= link_to "下载该月报告", download_monthly_reports_path(month: @monthly_report.report_month.strftime("%Y-%m"), property_id: @monthly_report.property_id), class: "bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-6 rounded-md transition-colors" %>
      </div>
    </div>
  </div>
</div>
