<div id="audit_status_card" class="bg-white rounded-lg border border-slate-200 p-5">
  <div class="flex items-start justify-between mb-4">
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider">审计状态</h3>
    <% if audit.overdue? %>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
        已逾期
      </span>
    <% end %>
  </div>

  <div class="flex items-center gap-3 mb-4">
    <% status_config = {
      draft: { color: "bg-slate-100 text-slate-700 border-slate-200", label: "草稿" },
      pending_materials: { color: "bg-amber-100 text-amber-700 border-amber-200", label: "待材料" },
      in_progress: { color: "bg-blue-100 text-blue-700 border-blue-200", label: "进行中" },
      pending_evidence: { color: "bg-orange-100 text-orange-700 border-orange-200", label: "待证据" },
      pending_checklist: { color: "bg-purple-100 text-purple-700 border-purple-200", label: "待检查清单" },
      pending_notification: { color: "bg-cyan-100 text-cyan-700 border-cyan-200", label: "待通报" },
      pending_approval: { color: "bg-indigo-100 text-indigo-700 border-indigo-200", label: "待审批" },
      approved: { color: "bg-green-100 text-green-700 border-green-200", label: "已通过" },
      rejected: { color: "bg-red-100 text-red-700 border-red-200", label: "已拒绝" },
      archived: { color: "bg-slate-100 text-slate-600 border-slate-200", label: "已归档" }
    } %>
    <% config = status_config[audit.status.to_sym] || { color: "bg-slate-100 text-slate-700 border-slate-200", label: audit.status.humanize } %>
    <% status_dot_cls = if audit.approved? || audit.archived? then 'bg-green-500'
                        elsif audit.rejected? then 'bg-red-500'
                        elsif audit.draft? then 'bg-slate-400'
                        else 'bg-amber-500 animate-pulse' end %>
    <span class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold border <%= config[:color] %>">
      <span class="w-2 h-2 rounded-full mr-2 <%= status_dot_cls %>">
      </span>
      <%= config[:label] %>
    </span>
  </div>

  <div class="grid grid-cols-2 gap-4 text-sm">
    <div>
      <p class="text-slate-500 mb-1">开始日期</p>
      <p class="font-medium text-slate-900"><%= audit.start_at&.strftime("%Y-%m-%d") || "—" %></p>
    </div>
    <div>
      <p class="text-slate-500 mb-1">结束日期</p>
      <p class="font-medium <%= audit.overdue? ? 'text-red-600' : 'text-slate-900' %>">
        <%= audit.end_at&.strftime("%Y-%m-%d") || "—" %>
        <% if audit.days_remaining.present? && !audit.overdue? %>
          <span class="text-xs text-slate-500 ml-1">(剩 <%= audit.days_remaining %> 天)</span>
        <% end %>
      </p>
    </div>
  </div>

  <% if audit.duration_days.present? %>
    <div class="mt-4 pt-4 border-t border-slate-100">
      <div class="flex items-center justify-between text-sm">
        <span class="text-slate-500">审计周期</span>
        <span class="font-mono font-semibold text-slate-900"><%= audit.duration_days %> 天</span>
      </div>
    </div>
  <% end %>
</div>
