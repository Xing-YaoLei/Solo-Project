<% content_for :page_title, '待办事项' %>

<div class="p-6 space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl p-5 shadow-card border-l-4 border-[#1e3a5f]">
      <p class="text-sm text-gray-500">全部待办</p>
      <p class="text-2xl font-bold text-[#1e3a5f] mt-2 font-serif"><%= @pending_count + @in_progress_count + @completed_count %></p>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-card border-l-4 border-[#ef4444]">
      <p class="text-sm text-gray-500">紧急</p>
      <p class="text-2xl font-bold text-[#ef4444] mt-2 font-serif"><%= @overdue_count %></p>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-card border-l-4 border-[#f59e0b]">
      <p class="text-sm text-gray-500">处理中</p>
      <p class="text-2xl font-bold text-[#f59e0b] mt-2 font-serif"><%= @in_progress_count %></p>
    </div>
    <div class="bg-white rounded-xl p-5 shadow-card border-l-4 border-[#10b981]">
      <p class="text-sm text-gray-500">已完成</p>
      <p class="text-2xl font-bold text-[#10b981] mt-2 font-serif"><%= @completed_count %></p>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 bg-white rounded-lg p-1 shadow-sm">
      <button class="px-4 py-2 rounded-md bg-[#1e3a5f] text-white text-sm font-medium">全部</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">待处理</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">处理中</button>
      <button class="px-4 py-2 rounded-md text-gray-600 hover:bg-gray-100 text-sm font-medium">已完成</button>
    </div>
    <div class="flex items-center gap-3">
      <select class="px-4 py-2 border border-gray-200 rounded-lg text-sm focus:border-[#1e3a5f] focus:ring-2 focus:ring-[#1e3a5f]/10 outline-none">
        <option>全部优先级</option>
        <option>紧急</option>
        <option>高</option>
        <option>中</option>
        <option>低</option>
      </select>
      <button class="px-5 py-2.5 bg-[#1e3a5f] text-white rounded-lg hover:bg-[#2d4a6f] transition-colors flex items-center gap-2 font-medium">
        <i data-lucide="plus" class="w-4 h-4"></i>
        新建待办
      </button>
    </div>
  </div>

  <div class="space-y-4">
    <% @todo_items.each do |todo_item| %>
      <%= render TodoItemComponent.new(todo_item: todo_item) %>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <%= render PaginationComponent.new(pagy: @pagy) %>
  <% end %>
</div>
