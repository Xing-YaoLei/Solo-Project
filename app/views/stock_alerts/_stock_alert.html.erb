<tr class="hover:bg-gray-50">
  <td class="whitespace-nowrap px-6 py-4">
    <div class="text-sm font-medium text-gray-900"><%= stock_alert.part&.name || '-' %></div>
    <div class="text-xs text-gray-500"><%= stock_alert.part&.sku || '-' %></div>
  </td>
  <td class="whitespace-nowrap px-6 py-4">
    <% if stock_alert.work_order %>
      <%= link_to stock_alert.work_order.work_order_no, stock_alert.work_order, class: "text-sm text-blue-600 hover:text-blue-800" %>
    <% else %>
      <span class="text-sm text-gray-500">-</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap px-6 py-4">
    <% status_colors = { pending: "bg-yellow-100 text-yellow-800", processing: "bg-blue-100 text-blue-800", resolved: "bg-green-100 text-green-800" } %>
    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_colors[stock_alert.status.to_sym] %>">
      <%= { pending: '待处理', processing: '处理中', resolved: '已解决' }[stock_alert.status.to_sym] %>
    </span>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
    <%= stock_alert.handler&.name || '未指派' %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
    <%= stock_alert.created_at.strftime('%Y-%m-%d %H:%M') %>
  </td>
  <td class="whitespace-nowrap px-6 py-4 text-sm font-medium">
    <%= link_to "查看", stock_alert, class: "text-blue-600 hover:text-blue-900" %>
  </td>
</tr>
