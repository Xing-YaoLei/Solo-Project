<% content_for :title, @user.name %>

<div class="space-y-6">
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <div class="flex items-center justify-between">
        <h3 class="text-lg leading-6 font-medium text-gray-900">用户详情</h3>
        <%= link_to "返回列表", users_path, class: "text-sm text-indigo-600 hover:text-indigo-900" %>
      </div>
    </div>

    <div class="px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-2">
          <div class="text-sm font-medium text-gray-500">姓名</div>
          <div class="mt-1 text-lg font-semibold text-gray-900"><%= @user.name %></div>
        </div>
        <div class="sm:col-span-2">
          <div class="text-sm font-medium text-gray-500">邮箱</div>
          <div class="mt-1 text-lg font-semibold text-gray-900"><%= @user.email %></div>
        </div>
        <div class="sm:col-span-2">
          <div class="text-sm font-medium text-gray-500">角色</div>
          <div class="mt-1">
            <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full <%= @user.admin? ? 'bg-purple-100 text-purple-800' : @user.reviewer? ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-800' %>">
              <%= { 'admin' => '管理员', 'reviewer' => '复核员', 'operator' => '操作员' }[@user.role] %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">处理的单据（最近50条）</h3>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">自提码</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">客户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">处理时间</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @operated_orders.each do |order| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to order.pickup_code, order, class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= order.customer_name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                  <%= order.source %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_badge_class(order.status) %>">
                  <%= order.status_display %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= order.processed_at&.strftime('%Y-%m-%d %H:%M') || '-' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
