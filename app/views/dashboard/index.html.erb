<% content_for :title, "仪表盘 - 职业教育结算台" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">仪表盘</h1>
  <p class="mt-1 text-sm text-gray-500">职业教育在线课程结算管理平台</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
        <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
      <div class="ml-5 w-0 flex-1">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">学员总数</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= @total_students %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div class="ml-5 w-0 flex-1">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">在线课程</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= @total_courses %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
        <svg class="h-6 w-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="ml-5 w-0 flex-1">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">总报名数</dt>
          <dd class="text-2xl font-semibold text-gray-900"><%= @total_enrollments %></dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0 bg-yellow-100 rounded-lg p-3">
        <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="ml-5 w-0 flex-1">
        <dl>
          <dt class="text-sm font-medium text-gray-500 truncate">总营收</dt>
          <dd class="text-2xl font-semibold text-gray-900">¥<%= number_with_precision @total_revenue, precision: 2 %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-medium text-gray-900">待处理事项</h3>
    </div>
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-600">待跟进学员</span>
        <%= link_to follow_ups_path(status: :pending) do %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
            <%= @pending_follow_ups %> 条
          </span>
        <% end %>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-600">待处理申诉</span>
        <%= link_to appeals_path(status: :pending) do %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
            <%= @pending_appeals %> 条
          </span>
        <% end %>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-600">待复核结算</span>
        <%= link_to settlements_path do %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
            <%= @pending_settlements %> 条
          </span>
        <% end %>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-600">进度落后学员</span>
        <%= link_to enrollments_path(behind_schedule: true) do %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
            <%= @behind_schedule_count %> 人
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="lg:col-span-2 bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-medium text-gray-900">最近订单</h3>
      <%= link_to "查看全部", orders_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">订单号</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">学员</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @recent_orders.each do |order| %>
            <tr>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900"><%= order.order_no %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= order.user&.name %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500"><%= order.course&.title %></td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">¥<%= number_with_precision order.amount, precision: 2 %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= order_status_class(order.status) %>">
                  <%= order_status_text(order.status) %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">最近报名</h3>
    <div class="space-y-3">
      <% @recent_enrollments.each do |enrollment| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= enrollment.user&.name %></p>
            <p class="text-xs text-gray-500"><%= enrollment.course&.title %></p>
          </div>
          <div class="text-right">
            <p class="text-sm text-gray-900"><%= enrollment.progress.to_i %>%</p>
            <p class="text-xs text-gray-500"><%= time_ago_in_words(enrollment.created_at) %>前</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4">快捷操作</h3>
    <div class="grid grid-cols-2 gap-4">
      <%= link_to new_settlement_path, class: "p-4 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition" do %>
        <p class="text-sm font-medium text-indigo-700">创建结算单</p>
        <p class="text-xs text-indigo-500 mt-1">按周期生成结算</p>
      <% end %>
      <%= link_to follow_ups_path(status: :pending), class: "p-4 bg-yellow-50 rounded-lg hover:bg-yellow-100 transition" do %>
        <p class="text-sm font-medium text-yellow-700">查看跟进名单</p>
        <p class="text-xs text-yellow-500 mt-1">待跟进学员列表</p>
      <% end %>
      <%= link_to appeals_path(status: :pending), class: "p-4 bg-orange-50 rounded-lg hover:bg-orange-100 transition" do %>
        <p class="text-sm font-medium text-orange-700">处理申诉</p>
        <p class="text-xs text-orange-500 mt-1">待处理申诉列表</p>
      <% end %>
      <%= link_to new_order_path, class: "p-4 bg-green-50 rounded-lg hover:bg-green-100 transition" do %>
        <p class="text-sm font-medium text-green-700">创建订单</p>
        <p class="text-xs text-green-500 mt-1">新建学员订单</p>
      <% end %>
    </div>
  </div>
</div>
