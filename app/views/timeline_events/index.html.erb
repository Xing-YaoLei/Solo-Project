<div class="mb-6">
  <h2 class="text-xl font-semibold text-gray-900">操作时间线</h2>
</div>

<% if @timeline_events.any? %>
  <div class="relative">
    <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200"></div>

    <div class="space-y-6">
      <% @timeline_events.each do |event| %>
        <% event_config = case event.event_type
                           when 'status_change' then { icon: 'status', color: 'bg-blue-100 text-blue-600', label: '状态变更' }
                           when 'note_added' then { icon: 'note', color: 'bg-green-100 text-green-600', label: '添加备注' }
                           when 'part_shortage' then { icon: 'shortage', color: 'bg-red-100 text-red-600', label: '配件缺货' }
                           when 'photo_added' then { icon: 'photo', color: 'bg-purple-100 text-purple-600', label: '添加照片' }
                           when 'quote_created' then { icon: 'quote', color: 'bg-indigo-100 text-indigo-600', label: '创建报价' }
                           when 'quote_approved' then { icon: 'approved', color: 'bg-emerald-100 text-emerald-600', label: '报价批准' }
                           when 'work_order_created' then { icon: 'created', color: 'bg-gray-100 text-gray-600', label: '创建工单' }
                           when 'assignment_change' then { icon: 'assignment', color: 'bg-orange-100 text-orange-600', label: '指派变更' }
                           else { icon: 'default', color: 'bg-gray-100 text-gray-600', label: event.event_type }
                         end %>

        <div class="relative pl-10">
          <div class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-white <%= event_config[:color] %>">
            <% case event_config[:icon]
               when 'status' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <% when 'note' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            <% when 'shortage' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <% when 'photo' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <% when 'quote' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <% when 'approved' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <% when 'created' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            <% when 'assignment' %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <% else %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <% end %>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
            <div class="mb-1 flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="inline-flex items-center rounded-full <%= event_config[:color] %> px-2.5 py-0.5 text-xs font-medium">
                  <%= event_config[:label] %>
                </span>
                <span class="text-sm font-medium text-gray-900"><%= event.user&.name || '系统' %></span>
              </div>
              <span class="text-xs text-gray-500"><%= event.created_at.strftime('%Y-%m-%d %H:%M') %></span>
            </div>
            <div class="text-sm text-gray-700"><%= event.content %></div>
            <% if event.metadata.present? && event.metadata.is_a?(Hash) && event.metadata.any? %>
              <div class="mt-2 rounded-md bg-gray-50 p-2 text-xs text-gray-500">
                <% event.metadata.each do |key, value| %>
                  <span class="mr-3"><strong><%= key %>:</strong> <%= value %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if defined?(@pagy) && @pagy.pages > 1 %>
    <div class="mt-6">
      <%= pagy_nav(@pagy) if defined?(pagy_nav) %>
    </div>
  <% end %>
<% else %>
  <div class="rounded-lg border border-gray-200 bg-white py-12 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <h3 class="mt-2 text-sm font-medium text-gray-900">暂无操作记录</h3>
    <p class="mt-1 text-sm text-gray-500">工单的操作记录将显示在这里</p>
  </div>
<% end %>
