<div class="card">
  <div class="card-header">
    <h2>编辑会员: <%= @member.name %></h2>
    <%= link_to "返回", member_path(@member), class: "btn btn-outline btn-sm" %>
  </div>
  <div class="card-body">
    <%= form_with model: @member do |f| %>
      <div class="form-row">
        <div class="form-group"><%= f.label :member_no, "会员号" %><%= f.text_field :member_no %></div>
        <div class="form-group"><%= f.label :name, "姓名" %><%= f.text_field :name %></div>
        <div class="form-group"><%= f.label :phone, "电话" %><%= f.text_field :phone %></div>
      </div>
      <div class="form-row">
        <div class="form-group"><%= f.label :source_channel, "来源渠道" %><%= f.select :source_channel, Member::SOURCE_CHANNELS.map { |s| [s, s] }, include_blank: "请选择" %></div>
        <div class="form-group" style="grid-column: span 2;"><%= f.label :notes, "备注" %><%= f.text_area :notes %></div>
      </div>
      <div style="margin-top: 20px;"><%= f.submit "保存", class: "btn btn-primary" %></div>
    <% end %>
  </div>
</div>
