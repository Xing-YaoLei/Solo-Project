{
  "compilerOptions": {
    "target": "es2017",
    "module": "es2015",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "temp",
    "declaration": true,
    "lib": ["es2017", "dom"],
    "types": []
  },
  "include": [
    "assets/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "temp",
    "library"
  ]
}
