<%= form_with(model: performance) do |form| %>
  <% if performance.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-red-800 font-semibold mb-2"><%= pluralize(performance.errors.count, "个错误") %> 导致提交失败：</h2>
      <ul class="list-disc list-inside text-red-600 text-sm">
        <% performance.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <%= form.label :name, "演出名称", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :venue, "演出场馆", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :venue, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :start_time, "开始时间", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.datetime_local_field :start_time, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :end_time, "结束时间", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.datetime_local_field :end_time, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :total_seats, "总座位数", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :total_seats, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :ticket_price, "票价（元）", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :ticket_price, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status, Performance.statuses.map { |k, v| [status_text(k), v] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="lg:col-span-2">
      <%= form.label :description, "演出描述", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
  </div>

  <div class="mt-8 flex justify-end gap-3">
    <%= link_to "取消", performances_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>
<% end %>
