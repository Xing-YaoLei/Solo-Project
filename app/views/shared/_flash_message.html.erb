<%
  flash_type_mapping = {
    "notice" => { bg: "bg-green-50", border: "border-green-200", text: "text-green-800", icon: "check-circle", icon_color: "text-green-500", close_btn: "bg-green-50 hover:bg-green-100 text-green-500" },
    "success" => { bg: "bg-green-50", border: "border-green-200", text: "text-green-800", icon: "check-circle", icon_color: "text-green-500", close_btn: "bg-green-50 hover:bg-green-100 text-green-500" },
    "alert" => { bg: "bg-red-50", border: "border-red-200", text: "text-red-800", icon: "alert-circle", icon_color: "text-red-500", close_btn: "bg-red-50 hover:bg-red-100 text-red-500" },
    "error" => { bg: "bg-red-50", border: "border-red-200", text: "text-red-800", icon: "alert-circle", icon_color: "text-red-500", close_btn: "bg-red-50 hover:bg-red-100 text-red-500" },
    "warning" => { bg: "bg-amber-50", border: "border-amber-200", text: "text-amber-800", icon: "alert-triangle", icon_color: "text-amber-500", close_btn: "bg-amber-50 hover:bg-amber-100 text-amber-500" },
    "info" => { bg: "bg-blue-50", border: "border-blue-200", text: "text-blue-800", icon: "info", icon_color: "text-blue-500", close_btn: "bg-blue-50 hover:bg-blue-100 text-blue-500" }
  }
  style = flash_type_mapping[type.to_s] || flash_type_mapping["info"]
%>

<div data-controller="flash-message"
     class="flash-message mb-4 flex items-start p-4 rounded-xl border shadow-sm animate-[fadeIn_0.3s_ease-out] <%= style[:bg] %> <%= style[:border] %>"
     role="alert">
  <i data-lucide="<%= style[:icon] %>" class="w-5 h-5 <%= style[:icon_color] %> mt-0.5 flex-shrink-0"></i>

  <div class="ms-3 text-sm font-medium flex-1 <%= style[:text] %>">
    <%= message %>
  </div>

  <button type="button"
          data-action="flash-message#dismiss"
          class="<%= style[:close_btn] %> flex-shrink-0 ms-auto -mx-1.5 -my-1.5 rounded-lg p-1.5 inline-flex items-center justify-center transition-colors">
    <i data-lucide="x" class="w-4 h-4"></i>
  </button>
</div>
