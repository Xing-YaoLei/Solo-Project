<%
  search_form_id = "ransack_search_form_#{SecureRandom.hex(4)}"
  search_url ||= url_for(action: :index)
  field_configs ||= []
  show_clear = defined?(show_clear) ? show_clear : true
  compact = defined?(compact) ? compact : false
%>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm <%= compact ? 'p-4' : 'p-6' %>">
  <%= search_form_for @q, url: search_url, method: :get, html: { id: search_form_id, class: "", data: { turbo: false } } do |f| %>
    <div class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% if field_configs.any? %>
          <% field_configs.each do |field| %>
            <%
              field_name = field[:name]
              field_type = field[:type] || :string
              label = field[:label] || field_name.to_s.humanize
              placeholder = field[:placeholder] || "请输入#{label}"
              collection = field[:collection]
              include_blank = field.fetch(:include_blank, true)
              prompt = field[:prompt] || "全部#{label}"
            %>

            <div>
              <%= f.label field_name, label, class: "block text-sm font-medium text-slate-700 mb-1.5" %>

              <% if field_type == :select && collection.present? %>
                <%= f.select field_name, collection,
                    { include_blank: include_blank ? prompt : false },
                    class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% elsif field_type == :date_range %>
                <div class="flex items-center gap-2">
                  <%= f.search_field field_name, placeholder: placeholder, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
                </div>
              <% elsif field_type == :date_start %>
                <%= f.date_field field_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% elsif field_type == :date_end %>
                <%= f.date_field field_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% elsif field_type == :number %>
                <%= f.number_field field_name, placeholder: placeholder, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% elsif field_type == :cont %>
                <%= f.search_field field_name, placeholder: placeholder, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% else %>
                <%= f.search_field field_name, placeholder: placeholder, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <% if @q.respond_to?(:sorts) %>
            <div class="md:col-span-2 lg:col-span-4">
              <%= f.label :title_or_supplier_name_cont, "关键词搜索", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <%= f.search_field :title_or_supplier_name_cont, placeholder: "请输入搜索关键词，支持标题、供应商名称等", class: "w-full rounded-lg border border-slate-300 pl-10 pr-4 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              </div>
            </div>

            <% if @q.klass.new.respond_to?(:status) %>
              <div>
                <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
                <% status_values = @q.klass.respond_to?(:status_values) ? @q.klass.status_values.map { |s| [I18n.t("audit_statuses.#{s}", default: s.to_s.humanize), s] } : [] %>
                <%= f.select :status_eq, status_values,
                    { include_blank: "全部状态" },
                    class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
              </div>
            <% end %>

            <div>
              <%= f.label :created_at_gteq, "创建时间从", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.date_field :created_at_gteq, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
            </div>

            <div>
              <%= f.label :created_at_lteq, "创建时间至", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
              <%= f.date_field :created_at_lteq, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-100">
        <% if @q.respond_to?(:s) %>
          <div class="flex items-center gap-2">
            <span class="text-sm text-slate-500">排序：</span>
            <%= f.sort_link :created_at, "创建时间", class: "text-sm text-slate-600 hover:text-blue-600" %>
            <span class="text-slate-300">|</span>
            <%= f.sort_link :updated_at, "更新时间", class: "text-sm text-slate-600 hover:text-blue-600" %>
          </div>
        <% else %>
          <div></div>
        <% end %>

        <div class="flex items-center gap-3">
          <% if show_clear %>
            <%= link_to request.path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors", data: { turbo: false } do %>
              <i data-lucide="rotate-ccw" class="w-4 h-4 mr-1.5"></i>
              重置
            <% end %>
          <% end %>

          <button type="submit" class="inline-flex items-center px-5 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 shadow-sm transition-colors">
            <i data-lucide="search" class="w-4 h-4 mr-1.5"></i>
            搜索
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
