<%= content_for(:title, "记录台") %>

<div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">记录台</h1>

  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <%= form_tag(records_path, method: :get, class: "flex flex-wrap items-end gap-4") do %>
      <div class="flex-1 min-w-48">
        <%= label_tag :property_id, "房源", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= select_tag :property_id,
            options_from_collection_for_select(@properties, :id, :name, @selected_property&.id),
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border",
            include_blank: "全部房源" %>
      </div>
      <div class="flex-1 min-w-40">
        <%= label_tag :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= date_field_tag :start_date, @start_date,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border" %>
      </div>
      <div class="flex-1 min-w-40">
        <%= label_tag :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= date_field_tag :end_date, @end_date,
            class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm py-2 px-3 border" %>
      </div>
      <div>
        <%= submit_tag "筛选", class: "bg-indigo-600 text-white px-6 py-2 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @room_conflicts.exists? %>
    <div class="mb-6 bg-white shadow rounded-lg overflow-hidden border-l-4 border-red-500">
      <div class="bg-red-50 px-6 py-4 border-b border-red-100">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <svg class="h-6 w-6 text-red-500 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <h3 class="text-base font-semibold text-red-800">
                房态冲突待办（<%= @room_conflicts.count %> 项待处理）
              </h3>
              <p class="text-sm text-red-600 mt-0.5">请及时处理以下冲突，避免影响客人入住</p>
            </div>
          </div>
          <%= link_to "查看全部 →", room_conflicts_path, class: "text-sm font-medium text-red-600 hover:text-red-500" %>
        </div>
      </div>
      <div class="divide-y divide-gray-100 max-h-80 overflow-y-auto">
        <% @room_conflicts.limit(10).each do |conflict| %>
          <div class="px-6 py-3 hover:bg-red-50 transition-colors">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full <%= conflict.status_color %>">
                    <%= conflict.status_i18n %>
                  </span>
                  <span class="text-sm font-medium text-gray-900">
                    <%= conflict.property.name %>
                  </span>
                  <span class="text-sm text-gray-500">
                    · <%= conflict.conflict_date.strftime("%Y-%m-%d") %>
                  </span>
                </div>
                <p class="text-sm text-gray-600 mt-1 line-clamp-2">
                  <%= conflict.reason %>
                </p>
                <% if conflict.handler.present? %>
                  <p class="text-xs text-gray-400 mt-1">
                    处理人：<%= conflict.handler.name %>
                  </p>
                <% end %>
              </div>
              <div class="flex-shrink-0">
                <%= link_to "处理", room_conflict_path(conflict),
                    class: "inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-md bg-red-600 text-white hover:bg-red-700 transition-colors" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <div class="flex items-center">
          <svg class="h-5 w-5 text-indigo-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <h2 class="text-lg font-semibold text-gray-900">
            房源日历
            <% if @selected_property.present? %>
              <span class="text-sm font-normal text-gray-500 ml-2"><%= @selected_property.name %></span>
            <% end %>
          </h2>
        </div>
      </div>
      <div class="p-4 max-h-[700px] overflow-y-auto">
        <% if @calendar_dates.present? && @selected_property.present? %>
          <div class="space-y-2">
            <% @calendar_dates.each do |date| %>
              <% room_status = @selected_property.status_on(date) %>
              <% date_orders = @selected_property.orders_between(date, date) %>
              <div class="border border-gray-200 rounded-lg p-3 hover:bg-gray-50 transition-colors">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center">
                    <span class="text-sm font-semibold text-gray-900"><%= l(date, format: :short) %></span>
                    <span class="ml-2 text-xs text-gray-500"><%= %w[日 一 二 三 四 五 六][date.wday] %></span>
                  </div>
                  <% if room_status.present? %>
                    <%= status_badge(room_status.status_i18n, room_status.status_color) %>
                  <% else %>
                    <%= status_badge("未设置", "bg-gray-100 text-gray-600") %>
                  <% end %>
                </div>
                <% if date_orders.present? %>
                  <div class="space-y-1 mt-2 pt-2 border-t border-gray-100">
                    <% date_orders.each do |order| %>
                      <div class="flex items-center justify-between text-xs bg-indigo-50 rounded px-2 py-1">
                        <span class="text-indigo-700 truncate"><%= order.guest&.name %></span>
                        <span class="text-indigo-600 ml-2 flex-shrink-0"><%= order.nights %>晚</span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm">请选择房源查看日历</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <div class="flex items-center">
          <svg class="h-5 w-5 text-indigo-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <h2 class="text-lg font-semibold text-gray-900">
            渠道订单
            <span class="ml-2 text-sm font-normal text-gray-500">(<%= @channel_orders.count %>)</span>
          </h2>
        </div>
      </div>
      <div class="p-4 max-h-[700px] overflow-y-auto">
        <% if @channel_orders.present? %>
          <div class="space-y-3">
            <% @channel_orders.each do |order| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <div class="font-mono text-sm font-semibold text-gray-900"><%= order.order_no %></div>
                    <div class="mt-1 flex items-center gap-2">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">
                        <%= channel_display(order.channel) %>
                      </span>
                      <%= status_badge(order.status_i18n, order.status_color) %>
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="text-lg font-bold text-gray-900">¥<%= number_with_precision(order.total_price, precision: 2) %></div>
                    <div class="text-xs text-gray-500"><%= order.nights %> 晚</div>
                  </div>
                </div>
                <div class="space-y-2 text-sm border-t border-gray-100 pt-3">
                  <div class="flex items-center text-gray-600">
                    <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span><%= order.guest&.name %></span>
                    <% if order.guest&.phone.present? %>
                      <span class="ml-2 text-gray-400"><%= order.guest.phone %></span>
                    <% end %>
                  </div>
                  <div class="flex items-center text-gray-600">
                    <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>入住: <%= l(order.check_in, format: :short) %></span>
                  </div>
                  <div class="flex items-center text-gray-600">
                    <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span>退房: <%= l(order.check_out, format: :short) %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <p class="text-sm">当前筛选条件下暂无订单</p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <div class="flex items-center">
          <svg class="h-5 w-5 text-indigo-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <h2 class="text-lg font-semibold text-gray-900">
            保洁任务
            <span class="ml-2 text-sm font-normal text-gray-500">(<%= @cleaning_tasks.count %>)</span>
          </h2>
        </div>
      </div>
      <div class="p-4 max-h-[700px] overflow-y-auto">
        <% if @cleaning_tasks.present? %>
          <div class="space-y-3">
            <% @cleaning_tasks.each do |task| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center">
                    <svg class="h-5 w-5 text-gray-400 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="text-sm font-semibold text-gray-900"><%= l(task.task_date, format: :short) %></span>
                    <span class="ml-2 text-xs text-gray-500"><%= %w[日 一 二 三 四 五 六][task.task_date.wday] %></span>
                  </div>
                  <%= status_badge(task.status_i18n, task.status_color) %>
                </div>
                <div class="space-y-2 text-sm border-t border-gray-100 pt-3">
                  <% if task.priority.present? %>
                    <div class="flex items-center">
                      <span class="text-gray-500 mr-2">优先级:</span>
                      <span class="font-medium <%= task.priority_color %>">
                        <%= task.priority_i18n %>
                      </span>
                    </div>
                  <% end %>
                  <% if task.assignee.present? %>
                    <div class="flex items-center text-gray-600">
                      <svg class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span>指派人: <%= task.assignee.name %></span>
                    </div>
                  <% end %>
                  <% if task.note.present? %>
                    <div class="flex items-start text-gray-600">
                      <svg class="h-4 w-4 mr-2 mt-0.5 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      <span class="break-words"><%= task.note %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12 text-gray-500">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            <p class="text-sm">当前筛选条件下暂无保洁任务</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
