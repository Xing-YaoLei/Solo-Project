<% if defined?(breadcrumbs) && breadcrumbs.present? %>
  <nav class="flex items-center gap-2 text-sm" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1">
      <% breadcrumbs.each_with_index do |crumb, index| %>
        <li class="inline-flex items-center">
          <% if index == breadcrumbs.length - 1 %>
            <span class="text-gray-700 font-medium"><%= crumb[:name] %></span>
          <% else %>
            <% if crumb[:path].present? %>
              <%= link_to crumb[:path], class: "text-gray-500 hover:text-indigo-600 transition-colors" do %>
                <% if index == 0 %>
                  <svg class="w-4 h-4 mr-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                <% end %>
                <span><%= crumb[:name] %></span>
              <% end %>
            <% else %>
              <span class="text-gray-500"><%= crumb[:name] %></span>
            <% end %>
            <% if index < breadcrumbs.length - 1 %>
              <svg class="w-4 h-4 mx-1 text-gray-300 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>
<% end %>
