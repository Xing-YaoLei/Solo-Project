    "TUT_TASK_FLOW": {
      "id": "TUT_TASK_FLOW",
      "name": "任务流程：接任务→看线索→做选择",
      "order": 2,
      "triggerCondition": "ENTER_LEVEL_LV001",
      "steps": [
        {
          "id": 1,
          "type": "DIALOG",
          "target": null,
          "content": "每局游戏分为三个阶段：接任务、观察线索、选择动作。\n让我们逐步体验这个流程。",
          "highlightArea": null,
          "duration": 0
        },
        {
          "id": 2,
          "type": "POINTER",
          "target": "TASK_PANEL",
          "content": "这里是任务面板，显示当前任务目标和要求。\n先仔细阅读任务描述，明确需要做什么。",
          "highlightArea": "task_panel",
          "duration": 0
        },
        {
          "id": 3,
          "type": "POINTER",
          "target": "CLUE_TAB",
          "content": "点击线索标签页，查看与任务相关的患者资料、检查报告等。\n仔细阅读线索是做出正确选择的关键！",
          "highlightArea": "clue_tab",
          "duration": 0
        },
        {
          "id": 4,
          "type": "POINTER",
          "target": "CLUE_CARD",
          "content": "点击线索卡片可以查看详细内容。\n注意线索上的重要性标记，CRITICAL标记的线索务必仔细阅读！",
          "highlightArea": "clue_card_first",
          "duration": 0
        },
        {
          "id": 5,
          "type": "POINTER",
          "target": "ACTION_PANEL",
          "content": "查看完线索后，回到动作面板，从多个选项中做出你的专业判断。",
          "highlightArea": "action_panel",
          "duration": 0
        }
      ]
    },
    "TUT_SCORING": {
      "id": "TUT_SCORING",
      "name": "评分规则：得分、错因与医保拒付",
      "order": 3,
      "triggerCondition": "FIRST_ACTION_COMPLETE",
      "steps": [
        {
          "id": 1,
          "type": "DIALOG",
          "target": null,
          "content": "每次选择后都会有即时反馈，让我们了解评分规则。",
          "highlightArea": null,
          "duration": 0
        },
        {
          "id": 2,
          "type": "DIALOG",
          "target": null,
          "content": "【得分系统】\n✅ 正确选择：获得正向得分\n❌ 错误选择：被扣分\n\n选择越专业、越符合规范，得分越高！",
          "highlightArea": null,
          "duration": 0
        },
        {
          "id": 3,
          "type": "DIALOG",
          "target": null,
          "content": "【错因标记】\n错误会被归类为：\n• 流程错误(PROCEDURAL)\n• 诊断错误(DIAGNOSTIC)\n• 评估错误(EVALUATION)\n• 文档错误(DOCUMENTATION)\n• 医疗安全(SAFETY)\n• 医保违规(BILLING/OVERTREATMENT)\n\n复盘时可以针对弱项重点提升！",
          "highlightArea": null,
          "duration": 0
        },
        {
          "id": 4,
          "type": "DIALOG",
          "target": null,
          "content": "【医保拒付风险】\n每个错误选项都有医保拒付触发概率。\n高风险操作（如过度治疗、串换编码）有很高概率触发医保稽核！\n累计触发3次以上会直接影响通关和排行榜名次。",
          "highlightArea": null,
          "duration": 0
        }
      ]
    },
