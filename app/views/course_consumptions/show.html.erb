<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
  <div class="card">
    <div class="card-header">
      <div>
        <h2><%= @course_consumption.bill_no %></h2>
        <div style="margin-top: 8px;">
          <% case @course_consumption.status %>
          <% when "draft" %><span class="badge badge-gray"><%= @course_consumption.status_label %></span>
          <% when "pending_review", "reviewing" %><span class="badge badge-yellow"><%= @course_consumption.status_label %></span>
          <% when "approved", "processing" %><span class="badge badge-blue"><%= @course_consumption.status_label %></span>
          <% when "needs_more_info" %><span class="badge badge-yellow"><%= @course_consumption.status_label %></span>
          <% when "escalated" %><span class="badge badge-red"><%= @course_consumption.status_label %></span>
          <% when "settled", "reviewed" %><span class="badge badge-green"><%= @course_consumption.status_label %></span>
          <% when "closed", "rejected" %><span class="badge badge-gray"><%= @course_consumption.status_label %></span>
          <% end %>
          <% case @course_consumption.processing_status %>
          <% when "normal" %><span class="badge badge-green" style="margin-left: 6px;"><%= @course_consumption.processing_status_label %></span>
          <% when "needs_more_info" %><span class="badge badge-yellow" style="margin-left: 6px;"><%= @course_consumption.processing_status_label %></span>
          <% when "escalated" %><span class="badge badge-red" style="margin-left: 6px;"><%= @course_consumption.processing_status_label %></span>
          <% when "completed" %><span class="badge badge-blue" style="margin-left: 6px;"><%= @course_consumption.processing_status_label %></span>
          <% end %>
          <% if @course_consumption.behind_schedule? && !@course_consumption.closed? %>
            <span class="badge badge-red" style="margin-left: 6px;">⚠️ 进度落后</span>
          <% end %>
        </div>
      </div>
      <div class="btn-group">
        <%= link_to "编辑", edit_course_consumption_path(@course_consumption), class: "btn btn-outline btn-sm" %>
        <%= link_to "列表", course_consumptions_path, class: "btn btn-outline btn-sm" %>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">会员</label>
          <div style="font-weight: 500;"><%= @course_consumption.member&.name %></div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">教练</label>
          <div style="font-weight: 500;"><%= @course_consumption.trainer&.name %></div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">课程包</label>
          <div style="font-weight: 500;"><%= @course_consumption.course_package&.name %></div>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">消耗日期</label>
          <div style="font-weight: 500;"><%= @course_consumption.consumption_date %></div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">消耗课时</label>
          <div style="font-weight: 500;"><%= @course_consumption.sessions_consumed %> / 剩余 <%= @course_consumption.sessions_remaining %></div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">责任人</label>
          <div style="font-weight: 500;"><%= @course_consumption.responsible_person || "-" %></div>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">来源渠道</label>
          <div style="font-weight: 500;"><%= @course_consumption.source_channel || "-" %></div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">当前进度</label>
          <div>
            <div class="progress-bar" style="margin-top: 4px;">
              <div class="progress-bar-inner" style="width: <%= @course_consumption.progress_rate %>%"></div>
            </div>
            <div style="font-size: 12px; color: #6b7280; margin-top: 2px;"><%= @course_consumption.progress_rate %>% 完成</div>
          </div>
        </div>
        <div class="form-group" style="margin-bottom: 8px;">
          <label style="font-size: 12px; color: #6b7280;">复盘标签</label>
          <div>
            <% @course_consumption.review_tags.each do |tag| %>
              <span class="tag" style="background: <%= tag.color %>; color: white;"><%= tag.name %></span>
            <% end %>
            <% if @course_consumption.review_tags.empty? %>
              <span style="font-size: 13px; color: #9ca3af;">暂无标签</span>
            <% end %>
          </div>
        </div>
      </div>

      <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
        <div class="btn-group">
          <% if @course_consumption.may_submit_for_review? %>
            <%= button_to "提交审核", submit_for_review_course_consumption_path(@course_consumption), method: :post, class: "btn btn-primary btn-sm" %>
          <% end %>
          <% if @course_consumption.may_approve? %>
            <%= button_to "审核通过", approve_course_consumption_path(@course_consumption), method: :post, class: "btn btn-success btn-sm" %>
          <% end %>
          <% if @course_consumption.may_reject? %>
            <%= button_to "拒绝", reject_course_consumption_path(@course_consumption), method: :post, class: "btn btn-danger btn-sm" %>
          <% end %>
          <% if @course_consumption.may_process_settlement? %>
            <%= button_to "开始结算", process_settlement_course_consumption_path(@course_consumption), method: :post, class: "btn btn-primary btn-sm" %>
          <% end %>
          <% if @course_consumption.may_request_more_info? %>
            <%= button_to "要求补资料", request_more_info_course_consumption_path(@course_consumption), method: :post, class: "btn btn-warning btn-sm" %>
          <% end %>
          <% if @course_consumption.may_escalate? %>
            <%= button_to "升级复核", escalate_course_consumption_path(@course_consumption), method: :post, class: "btn btn-danger btn-sm" %>
          <% end %>
          <% if @course_consumption.may_complete? %>
            <%= button_to "完成结算", complete_course_consumption_path(@course_consumption), method: :post, class: "btn btn-success btn-sm" %>
          <% end %>
          <% if @course_consumption.may_review_after_settlement? %>
            <%= button_to "完成复盘", review_after_settlement_course_consumption_path(@course_consumption), method: :post, class: "btn btn-success btn-sm" %>
          <% end %>
          <% if @course_consumption.may_close? %>
            <%= button_to "关闭单据", close_course_consumption_path(@course_consumption), method: :post, class: "btn btn-secondary btn-sm", data: { confirm: "确定关闭？关闭后仍可查看。" } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>📜 状态流转记录</h2></div>
    <div class="card-body">
      <div class="event-timeline">
        <% @course_consumption.settlement_events.each do |event| %>
          <div class="event-item">
            <div class="event-time"><%= event.created_at.strftime("%Y-%m-%d %H:%M") %> · <%= event.operator || "系统" %></div>
            <div class="event-content">
              <strong><%= event.event_type %></strong>
              <% if event.from_status && event.to_status %>
                <span style="color: #6b7280;">(<%= event.from_status %> → <%= event.to_status %>)</span>
              <% end %>
              <% if event.notes.present? %>
                <div style="color: #4b5563; margin-top: 2px; font-size: 13px;"><%= event.notes %></div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @course_consumption.settlement_events.empty? %>
          <div style="color: #9ca3af; font-size: 14px;">暂无记录</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="three-panel">
  <div class="card">
    <div class="card-header">
      <h2>📚 课程章节</h2>
      <span class="badge badge-blue"><%= @course_consumption.course_chapters.where(chapter_status: "completed").count %> / <%= @course_consumption.course_chapters.count %> 完成</span>
    </div>
    <div class="card-body">
      <%= form_with model: [@course_consumption, @course_chapter], id: "new_chapter_form" do |f| %>
        <div class="chapter-item" style="margin-bottom: 12px; background: #f9fafb;">
          <div class="chapter-info" style="width: 100%;">
            <%= f.text_field :title, placeholder: "新增章节标题...", style: "width: 100%; margin-bottom: 6px; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
            <%= f.text_area :content, placeholder: "章节内容说明...", rows: 2, style: "width: 100%; margin-bottom: 6px; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; resize: vertical;" %>
            <div style="display: flex; gap: 8px;">
              <%= f.select :chapter_status, CourseChapter::CHAPTER_STATUSES.map { |s| [s, s] }, {}, style: "padding: 6px; border: 1px solid #d1d5db; border-radius: 6px; flex: 1;" %>
              <%= f.submit "添加章节", class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>

      <% @course_consumption.course_chapters.each do |chapter| %>
        <div class="chapter-item" id="chapter_<%= chapter.id %>">
          <div class="chapter-info">
            <div class="chapter-title">
              <%= chapter.position %>. <%= chapter.title %>
              <% case chapter.chapter_status %>
              <% when "completed" %><span class="badge badge-green" style="margin-left: 6px;">已完成</span>
              <% when "in_progress" %><span class="badge badge-blue" style="margin-left: 6px;">进行中</span>
              <% when "skipped" %><span class="badge badge-gray" style="margin-left: 6px;">已跳过</span>
              <% else %><span class="badge badge-yellow" style="margin-left: 6px;">待处理</span>
              <% end %>
            </div>
            <% if chapter.content.present? %>
              <div class="chapter-content"><%= chapter.content %></div>
            <% end %>
          </div>
          <div class="btn-group">
            <%= button_to "完成", course_consumption_course_chapter_path(@course_consumption, chapter, course_chapter: { chapter_status: "completed" }), method: :patch, class: "btn btn-success btn-sm" unless chapter.chapter_status == "completed" %>
            <%= button_to "删除", course_consumption_course_chapter_path(@course_consumption, chapter), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "确定删除？" } %>
          </div>
        </div>
      <% end %>
      <% if @course_consumption.course_chapters.empty? %>
        <div style="color: #9ca3af; text-align: center; padding: 20px;">暂无章节</div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>📊 成绩反馈</h2>
      <span class="badge badge-green"><%= @course_consumption.performance_feedbacks.count %> 条</span>
    </div>
    <div class="card-body">
      <%= form_with model: [@course_consumption, @performance_feedback], id: "new_feedback_form" do |f| %>
        <div class="feedback-item" style="background: #f9fafb;">
          <div class="form-row" style="grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
            <%= f.number_field :score, placeholder: "分数 0-100", min: 0, max: 100, style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
            <%= f.select :performance_level, PerformanceFeedback::PERFORMANCE_LEVELS.map { |s| [s, s] }, { include_blank: "选择等级" }, style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
          </div>
          <%= f.text_field :body_metrics, placeholder: "身体数据（体重/体脂率）", style: "width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 8px;" %>
          <%= f.text_area :coach_feedback, placeholder: "教练反馈...", rows: 2, style: "width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 8px; resize: vertical;" %>
          <%= f.submit "添加反馈", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>

      <% @course_consumption.performance_feedbacks.each do |pf| %>
        <div class="feedback-item" id="feedback_<%= pf.id %>">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div>
              <% if pf.score.present? %>
                <span class="badge badge-blue"><%= pf.score %>分</span>
              <% end %>
              <% if pf.performance_level.present? %>
                <span class="badge badge-green" style="margin-left: 4px;"><%= pf.performance_level %></span>
              <% end %>
              <% if pf.body_metrics.present? %>
                <span style="font-size: 12px; color: #6b7280; margin-left: 8px;"><%= pf.body_metrics %></span>
              <% end %>
            </div>
            <%= button_to "删除", course_consumption_performance_feedback_path(@course_consumption, pf), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "确定删除？" } %>
          </div>
          <% if pf.coach_feedback.present? %>
            <div style="font-size: 13px; color: #374151; margin-bottom: 4px;"><strong>教练：</strong><%= pf.coach_feedback %></div>
          <% end %>
          <% if pf.member_feedback.present? %>
            <div style="font-size: 13px; color: #374151; margin-bottom: 4px;"><strong>会员：</strong><%= pf.member_feedback %></div>
          <% end %>
          <% if pf.improvement_points.present? %>
            <div style="font-size: 13px; color: #92400e; background: #fef3c7; padding: 6px 10px; border-radius: 6px;"><strong>改进点：</strong><%= pf.improvement_points %></div>
          <% end %>
        </div>
      <% end %>
      <% if @course_consumption.performance_feedbacks.empty? %>
        <div style="color: #9ca3af; text-align: center; padding: 20px;">暂无反馈</div>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>🔔 提醒规则</h2>
      <span class="badge badge-yellow"><%= @course_consumption.reminder_rules.enabled.count %> 条启用中</span>
    </div>
    <div class="card-body">
      <%= form_with model: [@course_consumption, @reminder_rule], id: "new_reminder_form" do |f| %>
        <div class="feedback-item" style="background: #f9fafb;">
          <div class="form-row" style="grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
            <%= f.select :rule_type, ReminderRule::RULE_TYPES.map { |s| [s, s] }, {}, style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
            <%= f.select :notification_method, ReminderRule::NOTIFICATION_METHODS.map { |s| [s, s] }, {}, style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
          </div>
          <div class="form-row" style="grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
            <%= f.number_field :threshold_value, placeholder: "阈值", style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
            <%= f.text_field :threshold_unit, placeholder: "单位(percent/hours)", style: "padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
          </div>
          <%= f.text_area :message_template, placeholder: "提醒消息模板...", rows: 2, style: "width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 8px; resize: vertical;" %>
          <%= f.submit "添加规则", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>

      <% @course_consumption.reminder_rules.each do |rr| %>
        <div class="feedback-item" id="reminder_<%= rr.id %>">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
              <div style="margin-bottom: 4px;">
                <span class="badge <%= rr.enabled ? 'badge-green' : 'badge-gray' %>"><%= rr.rule_type %></span>
                <% if rr.threshold_value.present? %>
                  <span style="font-size: 13px; color: #6b7280; margin-left: 6px;">阈值: <%= rr.threshold_value %> <%= rr.threshold_unit %></span>
                <% end %>
              </div>
              <div style="font-size: 12px; color: #6b7280;">通知: <%= rr.notification_method %></div>
              <% if rr.last_triggered_at.present? %>
                <div style="font-size: 12px; color: #9ca3af; margin-top: 2px;">上次触发: <%= rr.last_triggered_at.strftime("%m-%d %H:%M") %></div>
              <% end %>
              <% if rr.message_template.present? %>
                <div style="font-size: 13px; color: #4b5563; background: #f9fafb; padding: 6px 10px; border-radius: 6px; margin-top: 6px;"><%= rr.message_template %></div>
              <% end %>
            </div>
            <div class="btn-group">
              <%= button_to rr.enabled ? "停用" : "启用", course_consumption_reminder_rule_path(@course_consumption, rr, reminder_rule: { enabled: !rr.enabled }), method: :patch, class: "btn btn-outline btn-sm" %>
              <%= button_to "删除", course_consumption_reminder_rule_path(@course_consumption, rr), method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "确定删除？" } %>
            </div>
          </div>
        </div>
      <% end %>
      <% if @course_consumption.reminder_rules.empty? %>
        <div style="color: #9ca3af; text-align: center; padding: 20px;">暂无提醒规则</div>
      <% end %>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
  <div class="card">
    <div class="card-header"><h2>🏷️ 复盘标签管理</h2></div>
    <div class="card-body">
      <%= form_with model: [@course_consumption, ReviewTag.new], url: course_consumption_review_tags_path(@course_consumption) do |f| %>
        <div style="display: flex; gap: 8px; margin-bottom: 12px;">
          <%= f.text_field :name, placeholder: "新增或关联标签...", style: "flex: 1; padding: 8px; border: 1px solid #d1d5db; border-radius: 6px;" %>
          <%= f.submit "添加", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
      <% if @available_tags.present? %>
        <div style="margin-bottom: 12px;">
          <div style="font-size: 12px; color: #6b7280; margin-bottom: 6px;">可添加的标签：</div>
          <% @available_tags.each do |tag| %>
            <%= button_to tag.name, course_consumption_review_tags_path(@course_consumption, review_tag: { name: tag.name }), method: :post, class: "btn btn-outline btn-sm", style: "margin: 2px; background: #{tag.color}; color: white; border: none;" %>
          <% end %>
        </div>
      <% end %>
      <div>
        <% @course_consumption.review_tags.each do |tag| %>
          <div class="tag" style="display: inline-flex; align-items: center; padding: 6px 12px; background: <%= tag.color %>; color: white; border-radius: 6px; margin: 3px;">
            <%= tag.name %>
            <%= button_to "×", course_consumption_review_tag_path(@course_consumption, tag), method: :delete, class: "", style: "background: none; border: none; color: white; cursor: pointer; margin-left: 6px; padding: 0; font-size: 16px; line-height: 1;" %>
          </div>
        <% end %>
        <% if @course_consumption.review_tags.empty? %>
          <div style="color: #9ca3af; font-size: 13px;">暂无标签</div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card" style="grid-column: span 2;">
    <div class="card-header"><h2>📝 备注</h2></div>
    <div class="card-body">
      <div class="form-row">
        <div class="form-group">
          <label style="font-size: 13px; color: #6b7280;">审核备注</label>
          <div style="padding: 12px; background: #f9fafb; border-radius: 8px; min-height: 60px; font-size: 14px;"><%= @course_consumption.review_notes.presence || "-" %></div>
        </div>
        <div class="form-group">
          <label style="font-size: 13px; color: #6b7280;">结算备注</label>
          <div style="padding: 12px; background: #f9fafb; border-radius: 8px; min-height: 60px; font-size: 14px;"><%= @course_consumption.settlement_notes.presence || "-" %></div>
        </div>
        <div class="form-group">
          <label style="font-size: 13px; color: #6b7280;">复盘总结</label>
          <div style="padding: 12px; background: #f9fafb; border-radius: 8px; min-height: 60px; font-size: 14px;"><%= @course_consumption.review_summary.presence || "-" %></div>
        </div>
      </div>
    </div>
  </div>
</div>
