<% provide :title, '编辑文书' %>

<div class="mb-6">
  <%= link_to '← 返回', document_path(@document), class: "text-blue-600 hover:text-blue-800 text-sm" %>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h1 class="text-xl font-bold text-gray-900">编辑文书</h1>
  </div>

  <%= form_with model: @document, local: true do |f| %>
    <% if @document.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <h2 class="text-red-700 font-medium"><%= pluralize(@document.errors.count, "个错误") %> 阻止了保存：</h2>
        <ul class="mt-2 text-sm text-red-600">
          <% @document.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :title, '文书标题', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :title, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div class="grid grid-cols-2 gap-6">
        <div>
          <%= f.label :doc_type, '文书类型', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :doc_type, Document::DOC_TYPES.map { |k, v| [v, k] }, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div>
        <%= f.label :content, '文书内容', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :content, rows: 15, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 font-mono text-sm" %>
      </div>

      <div>
        <%= label_tag :change_summary, '变更说明', class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= text_field_tag :change_summary, nil, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500", placeholder: "请简要说明本次修改内容" %>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end gap-3">
      <%= link_to '取消', document_path(@document), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 text-sm font-medium" %>
      <%= f.submit '保存修改', class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
    </div>
  <% end %>
</div>
