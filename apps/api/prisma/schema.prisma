generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  DISPATCHER
  VERIFIER
  RIDER
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  VERIFIED
  COMPLETED
  CANCELLED
  DAMAGED
}

enum VerificationStep {
  PHOTO_UPLOADED
  TAG_REVIEWED
  ADDRESS_CHECKED
  TRACKING_CONFIRMED
  SUBSIDY_APPLIED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DamageStatus {
  REPORTED
  UNDER_REVIEW
  COMMUNICATING
  REVIEW_CONFIRMED
  RESOLVED
  REJECTED
}

enum RiderStatus {
  OFFLINE
  IDLE
  ON_DELIVERY
  ON_BREAK
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  phone     String?  @unique
  role      UserRole
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  riderProfile     RiderProfile?
  assignedTasks    VerificationTask[] @relation("AssignedTasks")
  createdTasks     VerificationTask[] @relation("CreatedTasks")
  dispatchedTasks  VerificationTask[] @relation("DispatchedTasks")
  createdDamages   DamageReport[]     @relation("CreatedDamages")
  handledDamages   DamageReport[]     @relation("HandledDamages")
  communications   DamageCommunication[]
  reviews          DamageReview[]
  stepLogs         TaskStepLog[]
}

model RiderProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  riderCode     String       @unique
  status        RiderStatus  @default(IDLE)
  totalOrders   Int          @default(0)
  rating        Float        @default(5.0)
  vehicleType   String
  vehiclePlate  String?
  idCardNo      String
  joinDate      DateTime     @default(now())
  lastActiveAt  DateTime?
  currentLat    Float?
  currentLng    Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  tasks         VerificationTask[]
  tracks        RiderTrack[]
  subsidies     SubsidyRecord[]
  activities    RiderActivity[]
}

model VerificationTask {
  id                String            @id @default(uuid())
  taskNo            String            @unique
  orderNo           String
  riderId           String
  assignedToId      String?
  createdById       String
  dispatchedById    String?
  status            TaskStatus        @default(PENDING)
  currentStep       VerificationStep?
  pickupAddress     String
  pickupLat         Float?
  pickupLng         Float?
  deliveryAddress   String
  deliveryLat       Float?
  deliveryLng       Float?
  itemName          String
  itemQuantity      Int               @default(1)
  itemValue         Float?
  estimatedAmount   Float?
  photos            Json[]
  evaluationTags    String[]
  addressMatched    Boolean?
  addressNote       String?
  note              String?
  assignedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  rider             RiderProfile      @relation(fields: [riderId], references: [id])
  assignedTo        User?             @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy         User              @relation("CreatedTasks", fields: [createdById], references: [id])
  dispatchedBy      User?             @relation("DispatchedTasks", fields: [dispatchedById], references: [id])
  tracks            RiderTrack[]
  subsidy           SubsidyRecord?
  damageReport      DamageReport?
  stepLogs          TaskStepLog[]
}

model TaskStepLog {
  id        String           @id @default(uuid())
  taskId    String
  step      VerificationStep
  operatorId String
  remark    String?
  createdAt DateTime         @default(now())

  task      VerificationTask @relation(fields: [taskId], references: [id])
  operator  User             @relation(fields: [operatorId], references: [id])
}

model RiderTrack {
  id            String            @id @default(uuid())
  taskId        String
  riderId       String
  latitude      Float
  longitude     Float
  speed         Float?
  heading       Float?
  recordedAt    DateTime

  task          VerificationTask  @relation(fields: [taskId], references: [id])
  rider         RiderProfile      @relation(fields: [riderId], references: [id])
}

model SubsidyRecord {
  id          String            @id @default(uuid())
  taskId      String            @unique
  riderId     String
  subsidyType String
  amount      Float
  ruleDetail  Json
  remark      String?
  appliedAt   DateTime          @default(now())
  approvedAt  DateTime?
  approvedBy  String?

  task        VerificationTask  @relation(fields: [taskId], references: [id])
  rider       RiderProfile      @relation(fields: [riderId], references: [id])
}

model RiderActivity {
  id           String       @id @default(uuid())
  riderId      String
  date         DateTime
  loginCount   Int          @default(0)
  orderCount   Int          @default(0)
  workDuration Int          @default(0)
  distance     Float        @default(0)
  createdAt    DateTime     @default(now())

  rider        RiderProfile @relation(fields: [riderId], references: [id])

  @@unique([riderId, date])
}

model DamageReport {
  id              String            @id @default(uuid())
  reportNo        String            @unique
  taskId          String            @unique
  riderId         String
  createdById     String
  handledById     String?
  riskLevel       RiskLevel
  status          DamageStatus      @default(REPORTED)
  damageType      String
  description     String
  photos          Json[]
  estimatedLoss   Float?
  actualLoss      Float?
  compensation    Float?
  responsibility  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  task            VerificationTask  @relation(fields: [taskId], references: [id])
  createdBy       User              @relation("CreatedDamages", fields: [createdById], references: [id])
  handledBy       User?             @relation("HandledDamages", fields: [handledById], references: [id])
  communications  DamageCommunication[]
  reviews         DamageReview[]
}

model DamageCommunication {
  id         String       @id @default(uuid())
  damageId   String
  senderId   String
  content    String
  attachments Json[]
  createdAt  DateTime     @default(now())

  damage     DamageReport @relation(fields: [damageId], references: [id])
  sender     User         @relation(fields: [senderId], references: [id])
}

model DamageReview {
  id           String       @id @default(uuid())
  damageId     String
  reviewerId   String
  conclusion   String
  suggestion   String?
  approved     Boolean
  reviewedAt   DateTime     @default(now())

  damage       DamageReport @relation(fields: [damageId], references: [id])
  reviewer     User         @relation(fields: [reviewerId], references: [id])
}
