<% content_for :title, "新建套餐" %>

<div class="page-header">
  <h1 class="page-title">📦 新建套餐</h1>
  <%= link_to "返回列表", packages_path, class: "btn btn-secondary" %>
</div>

<div class="card">
  <%= form_with model: @package do |f| %>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :name, "套餐名称", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :base_price, "基础价格 (¥)", class: "form-label" %>
        <%= f.number_field :base_price, class: "form-input", min: 0, step: "0.01", required: true %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :description, "套餐描述", class: "form-label" %>
      <%= f.text_area :description, class: "form-textarea", rows: 4 %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= f.label :total_inventory, "总库存", class: "form-label" %>
        <%= f.number_field :total_inventory, class: "form-input", min: 0, required: true %>
        <div style="font-size: 0.8rem; color: #718096; margin-top: 4px;">
          可用库存将自动设置为总库存数量
        </div>
      </div>
      <div class="form-group">
        <%= f.label :status, "状态", class: "form-label" %>
        <%= f.select :status, [['上架', 'active'], ['下架', 'inactive']], {}, class: "form-select" %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit "创建套餐", class: "btn btn-primary" %>
      <%= link_to "取消", packages_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
