<%= form_with(model: merchant_contract) do |form| %>
  <% if merchant_contract.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h2 class="text-red-800 font-semibold mb-2"><%= pluralize(merchant_contract.errors.count, "个错误") %> 导致提交失败：</h2>
      <ul class="list-disc list-inside text-red-600 text-sm">
        <% merchant_contract.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <%= form.label :merchant_name, "商户名称", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :merchant_name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :contract_number, "合同编号", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :contract_number, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :category, "分类", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :category, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :amount_cents, "合同金额（分）", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :amount_cents, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :start_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.date_field :end_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :commission_rate, "佣金率（%）", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.number_field :commission_rate, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :status, MerchantContract.statuses.map { |k, v| [status_text(k), v] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :contact_person, "联系人", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :contact_person, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= form.label :contact_phone, "联系电话", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :contact_phone, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="lg:col-span-2">
      <%= form.label :shop_location, "店铺位置", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :shop_location, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div class="lg:col-span-2">
      <%= form.label :terms, "合同条款", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :terms, rows: 6, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
  </div>

  <div class="mt-8 flex justify-end gap-3">
    <%= link_to "取消", merchant_contracts_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
    <%= form.submit "保存", class: "px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700" %>
  </div>
<% end %>
