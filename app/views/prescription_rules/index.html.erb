<div class="px-6 py-8" style="background-color: #F5F3EF; min-height: 100vh;">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-bold" style="color: #1B2A4A;">处方规则管理</h1>
      <%= link_to "新建规则", new_prescription_rule_path, class: "inline-flex items-center px-4 py-2 rounded-lg text-white font-medium", style: "background-color: #1B2A4A;", data: { turbo_frame: "modal" } %>
    </div>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
      <table class="w-full">
        <thead>
          <tr style="background-color: #1B2A4A;" class="text-white">
            <th class="px-6 py-3 text-left text-sm font-medium">规则名称</th>
            <th class="px-6 py-3 text-left text-sm font-medium">触发条件</th>
            <th class="px-6 py-3 text-left text-sm font-medium">状态</th>
            <th class="px-6 py-3 text-left text-sm font-medium">创建时间</th>
            <th class="px-6 py-3 text-right text-sm font-medium">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @prescription_rules.each do |rule| %>
            <tr id="<%= dom_id(rule) %>" class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 text-sm font-medium" style="color: #1B2A4A;"><%= rule.name %></td>
              <td class="px-6 py-4 text-sm text-gray-600"><%= truncate(rule.trigger_condition, length: 50) %></td>
              <td class="px-6 py-4">
                <%= button_to toggle_active_prescription_rule_path(rule), method: :patch, data: { turbo_frame: dom_id(rule) }, class: "inline-flex items-center gap-2" do %>
                  <span class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors <%= rule.active? ? 'bg-emerald-500' : 'bg-gray-300' %>">
                    <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform <%= rule.active? ? 'translate-x-6' : 'translate-x-1' %>"></span>
                  </span>
                  <span class="text-xs font-medium <%= rule.active? ? 'text-emerald-600' : 'text-gray-400' %>"><%= rule.active? ? '启用' : '停用' %></span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= l(rule.created_at, format: :short) %></td>
              <td class="px-6 py-4 text-right space-x-2">
                <%= link_to "查看", prescription_rule_path(rule), class: "text-sm font-medium hover:underline", style: "color: #2DD4A8;" %>
                <%= link_to "编辑", edit_prescription_rule_path(rule), class: "text-sm font-medium text-blue-600 hover:underline", data: { turbo_frame: "modal" } %>
                <%= button_to "删除", prescription_rule_path(rule), method: :delete, class: "text-sm font-medium hover:underline text-red-500", form: { data: { turbo_confirm: "确认删除此规则？" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @prescription_rules.empty? %>
        <div class="px-6 py-12 text-center text-gray-400">
          <p>暂无处方规则，点击"新建规则"开始创建</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
