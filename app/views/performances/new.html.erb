<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">新增演出排期</h1>
      <p class="mt-1 text-sm text-gray-500">填写演出排期信息</p>
    </div>
  </div>

  <div class="mt-6 max-w-2xl">
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
      <%= render "shared/error_messages", object: @performance %>

      <%= form_with model: @performance, local: true, class: "px-6 py-6" do |f| %>
        <div class="space-y-6">
          <div>
            <%= f.label :name, "名称", class: "block text-sm font-medium text-gray-900" %>
            <div class="mt-2">
              <%= f.text_field :name, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", maxlength: 200 %>
            </div>
          </div>

          <div>
            <%= f.label :description, "描述", class: "block text-sm font-medium text-gray-900" %>
            <div class="mt-2">
              <%= f.text_area :description, rows: 3, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= f.label :start_time, "开始时间", class: "block text-sm font-medium text-gray-900" %>
              <div class="mt-2">
                <%= f.datetime_local_field :start_time, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= f.label :end_time, "结束时间", class: "block text-sm font-medium text-gray-900" %>
              <div class="mt-2">
                <%= f.datetime_local_field :end_time, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <%= f.label :venue, "场馆", class: "block text-sm font-medium text-gray-900" %>
              <div class="mt-2">
                <%= f.text_field :venue, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div>
              <%= f.label :total_seats, "总座位数", class: "block text-sm font-medium text-gray-900" %>
              <div class="mt-2">
                <%= f.number_field :total_seats, min: 1, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <%= f.submit "创建演出排期", class: "inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
          <%= link_to "取消", performances_path, class: "inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
