<div class="w-full">
  <%= content_for :title, @property.name %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800"><%= @property.name %></h1>
    <div class="space-x-2">
      <%= link_to "返回列表", properties_path, class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition-colors duration-150" %>
      <%= link_to "编辑", edit_property_path(@property), class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors duration-150 shadow-sm" %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">房源信息</h2>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">地址</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @property.address %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">房间数</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @property.room_count %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">状态</dt>
            <dd class="mt-1">
              <% status_color = case @property.status
                when "active" then "bg-green-100 text-green-800"
                when "inactive" then "bg-gray-100 text-gray-800"
                when "maintenance" then "bg-yellow-100 text-yellow-800"
                else "bg-gray-100 text-gray-800"
                end %>
              <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= status_color %>">
                <%= @property.status_i18n %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">管理员</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @property.manager&.display_name %></dd>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">房态记录</h2>
        </div>
        <div class="overflow-x-auto">
          <% if @property.room_statuses.any? %>
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">日期</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @property.room_statuses.order(status_date: :desc).limit(10).each do |rs| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= rs.status_date %></td>
                    <td class="px-6 py-3 whitespace-nowrap">
                      <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= rs.status_color %>">
                        <%= rs.status_i18n %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-6 text-center text-gray-500">暂无房态记录</div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <h2 class="text-lg font-semibold text-gray-800">订单</h2>
          <%= link_to "全部订单", channel_orders_path(scope: "property_#{@property.id}"), class: "text-sm text-blue-600 hover:text-blue-800" %>
        </div>
        <div class="overflow-x-auto">
          <% if @property.channel_orders.any? %>
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">订单号</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">入住</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">退房</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">渠道</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">价格</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @property.channel_orders.order(created_at: :desc).limit(10).each do |order| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 whitespace-nowrap">
                      <%= link_to order.order_no, channel_order_path(order), class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= order.check_in %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= order.check_out %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= order.channel_i18n %></td>
                    <td class="px-6 py-3 whitespace-nowrap">
                      <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= order.status_color %>">
                        <%= order.status_i18n %>
                      </span>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700">¥<%= order.price %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-6 text-center text-gray-500">暂无订单</div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
          <h2 class="text-lg font-semibold text-gray-800">保洁任务</h2>
          <%= link_to "新建任务", new_cleaning_task_path(property_id: @property.id), class: "text-sm text-blue-600 hover:text-blue-800" %>
        </div>
        <div class="overflow-x-auto">
          <% if @property.cleaning_tasks.any? %>
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">日期</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">负责人</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">优先级</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @property.cleaning_tasks.order(task_date: :desc).limit(10).each do |task| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700">
                      <%= link_to task.task_date.to_s, cleaning_task_path(task), class: "text-blue-600 hover:text-blue-800" %>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap">
                      <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= task.status_color %>">
                        <%= task.status_i18n %>
                      </span>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= task.assignee&.name %></td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm <%= task.priority_color %>"><%= task.priority_i18n %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-6 text-center text-gray-500">暂无保洁任务</div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <h2 class="text-lg font-semibold text-gray-800">冲突</h2>
        </div>
        <div class="overflow-x-auto">
          <% if @property.room_conflicts.any? %>
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">日期</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">原因</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">处理人</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @property.room_conflicts.order(conflict_date: :desc).limit(10).each do |conflict| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700">
                      <%= link_to conflict.conflict_date.to_s, room_conflict_path(conflict), class: "text-blue-600 hover:text-blue-800" %>
                    </td>
                    <td class="px-6 py-3 text-sm text-gray-700 max-w-xs truncate"><%= conflict.reason %></td>
                    <td class="px-6 py-3 whitespace-nowrap">
                      <span class="inline-flex px-2.5 py-0.5 text-xs font-medium rounded-full <%= conflict.status_color %>">
                        <%= conflict.status_i18n %>
                      </span>
                    </td>
                    <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700"><%= conflict.handler&.name %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="p-6 text-center text-gray-500">暂无冲突记录</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
