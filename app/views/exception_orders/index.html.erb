<% provide :title, '异常单管理' %>

<div class="flex justify-between items-center mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">异常单管理</h1>
    <p class="text-gray-600 mt-1">审核退回自动生成的异常单</p>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 mb-6">
  <div class="p-4 border-b border-gray-200">
    <%= search_form_for @q, url: exception_orders_path, method: :get, html: { class: "flex gap-4 flex-wrap" } do |f| %>
      <div class="flex-1 min-w-[200px]">
        <%= f.label :order_no_cont, '单号', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :order_no_cont, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="w-40">
        <%= f.label :status_eq, '状态', class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, [['全部', ''], ['待处理', 'pending'], ['处理中', 'processing'], ['已解决', 'resolved'], ['已关闭', 'closed']], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex items-end">
        <%= f.submit '搜索', class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">异常单号</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联文书</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">处理人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @exception_orders.each do |exc| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to exc.order_no, exception_order_path(exc), class: "font-medium text-blue-600 hover:text-blue-800" %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <%= link_to exc.document&.title, document_path(exc.document), class: "text-gray-600 hover:text-blue-600" if exc.document %>
          </td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs rounded-full
              <%= case exc.status
                  when 'pending' then 'bg-red-100 text-red-700'
                  when 'processing' then 'bg-yellow-100 text-yellow-700'
                  when 'resolved' then 'bg-green-100 text-green-700'
                  when 'closed' then 'bg-gray-100 text-gray-700'
                  end %>">
              <%= exc.status_name %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= exc.handler&.name || '未分配' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= exc.created_at.strftime('%Y-%m-%d %H:%M') %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to '查看', exception_order_path(exc), class: "text-blue-600 hover:text-blue-800" %>
          </td>
        </tr>
      <% end %>
      <% if @exception_orders.empty? %>
        <tr>
          <td colspan="6" class="px-6 py-12 text-center text-gray-500">暂无异常单</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy %>
  <div class="mt-4 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
