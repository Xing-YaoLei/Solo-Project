<div class="page-header">
  <h1>设备停机详情</h1>
  <%= link_to "返回列表", equipment_downtimes_path, class: "btn btn-sm" %>
</div>

<div class="detail-card">
  <div class="detail-row">
    <span class="detail-label">设备名称</span>
    <span class="detail-value"><%= @equipment_downtime.equipment_name %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">设备类型</span>
    <span class="detail-value"><%= t("equipment_downtime.equipment_type.#{@equipment_downtime.equipment_type}", default: @equipment_downtime.equipment_type) %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">停机原因</span>
    <span class="detail-value"><%= @equipment_downtime.reason %></span>
  </div>
  <% if @equipment_downtime.description.present? %>
    <div class="detail-row">
      <span class="detail-label">详细描述</span>
      <span class="detail-value"><%= @equipment_downtime.description %></span>
    </div>
  <% end %>
  <div class="detail-row">
    <span class="detail-label">开始时间</span>
    <span class="detail-value"><%= @equipment_downtime.started_at.strftime('%Y-%m-%d %H:%M:%S') %></span>
  </div>
  <div class="detail-row">
    <span class="detail-label">状态</span>
    <span class="detail-value">
      <span class="badge badge-<%= @equipment_downtime.status %>">
        <%= @equipment_downtime.status == "active" ? "停机中" : "已关闭" %>
      </span>
    </span>
  </div>
  <% if @equipment_downtime.status == "resolved" %>
    <div class="detail-row">
      <span class="detail-label">处理动作</span>
      <span class="detail-value"><%= @equipment_downtime.action_taken %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">处理人</span>
      <span class="detail-value"><%= @equipment_downtime.resolved_by %></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">关闭时间</span>
      <span class="detail-value"><%= @equipment_downtime.closed_at&.strftime('%Y-%m-%d %H:%M:%S') %></span>
    </div>
  <% end %>
</div>

<% if @equipment_downtime.status == "active" %>
  <div class="form-actions">
    <h3>关闭停机</h3>
    <%= form_with url: resolve_equipment_downtime_path(@equipment_downtime), method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :action_taken, "处理动作" %>
        <%= f.text_area :action_taken, required: true, rows: 3 %>
      </div>
      <div class="form-group">
        <%= f.label :resolved_by, "处理人" %>
        <%= f.text_field :resolved_by, value: current_operator_name %>
      </div>
      <%= f.submit "关闭停机", class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="form-actions">
    <h3>记录处理动作</h3>
    <%= form_with url: add_action_equipment_downtime_path(@equipment_downtime), method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :action_description, "动作描述" %>
        <%= f.text_area :action_description, required: true, rows: 2 %>
      </div>
      <div class="form-group">
        <%= f.label :performed_by, "执行人" %>
        <%= f.text_field :performed_by, value: current_operator_name %>
      </div>
      <%= f.submit "记录动作", class: "btn" %>
    <% end %>
  </div>
<% end %>

<section class="panel">
  <div class="panel-header">
    <h2>处理动作记录</h2>
  </div>
  <% if @downtime_actions.any? %>
    <table class="data-table">
      <thead>
        <tr>
          <th>动作描述</th>
          <th>执行人</th>
          <th>执行时间</th>
        </tr>
      </thead>
      <tbody>
        <% @downtime_actions.each do |action| %>
          <tr>
            <td><%= action.action_description %></td>
            <td><%= action.performed_by %></td>
            <td><%= action.performed_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty-text">暂无处理动作记录</p>
  <% end %>
</section>
