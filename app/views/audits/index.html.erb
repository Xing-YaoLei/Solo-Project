<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">审计工作台</h1>
      <p class="mt-1 text-sm text-slate-500">管理所有审计项目，跟踪审计流程，追踪异常处理</p>
    </div>
    <% if policy(Audit).create? %>
      <%= link_to new_audit_path, class: "inline-flex items-center px-4 py-2.5 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        新建审计
      <% end %>
    <% end %>
  </div>

  <% status_tabs = [
    { key: :all, label: "全部", count: @audits.total_count, scope: nil },
    { key: :pending, label: "待处理", count: @status_counts.values_at("pending_materials", "pending_evidence", "pending_checklist", "pending_notification", "pending_approval").compact.sum, scope: :pending },
    { key: :in_progress, label: "进行中", count: @status_counts["in_progress"] || 0, scope: :in_progress },
    { key: :completed, label: "已完成", count: (@status_counts["approved"] || 0) + (@status_counts["archived"] || 0), scope: :completed },
    { key: :rejected, label: "已驳回", count: @status_counts["rejected"] || 0, scope: nil }
  ] %>
  <div class="bg-white rounded-lg border border-slate-200 p-1 inline-flex gap-1">
    <% status_tabs.each do |tab|
      tab_active = (params[:status_scope] == tab[:key].to_s) || (params[:status_scope].blank? && tab[:key] == :all)
      link_params = params.permit(:q, :page, :per).merge(status_scope: tab[:key] == :all ? nil : tab[:key])
      link_url = audits_path(link_params)
    %>
      <%= link_to link_url, class: "inline-flex items-center px-4 py-2 rounded text-sm font-medium transition-colors #{tab_active ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50'}" do %>
        <%= tab[:label] %>
        <span class="ml-1.5 px-2 py-0.5 rounded-full text-xs font-semibold #{tab_active ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-600'}"><%= tab[:count] %></span>
      <% end %>
    <% end %>
  </div>

  <%= search_form_for @q, url: audits_path, method: :get, class: "bg-white rounded-lg border border-slate-200 p-4", html: { data: { turbo_frame: "_top" } } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div>
        <%= f.label :title_cont, class: "block text-sm font-medium text-slate-700 mb-1" do %>审计标题<% end %>
        <%= f.search_field :title_cont, class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm", placeholder: "输入标题关键词" %>
      </div>
      <div>
        <%= f.label :audit_type_eq, class: "block text-sm font-medium text-slate-700 mb-1" do %>审计类型<% end %>
        <%= f.select :audit_type_eq, Audit.audit_type_options, include_blank: "全部类型", class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
      </div>
      <div>
        <%= f.label :supplier_id_eq, class: "block text-sm font-medium text-slate-700 mb-1" do %>供应商<% end %>
        <%= f.collection_select :supplier_id_eq, Supplier.active.order(:name), :id, :name, { include_blank: "全部供应商" }, { class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" } %>
      </div>
      <div>
        <%= f.label :status_in, class: "block text-sm font-medium text-slate-700 mb-1" do %>状态<% end %>
        <% status_options = %w[draft pending_materials in_progress pending_evidence pending_checklist pending_notification pending_approval approved rejected archived].map { |s| [I18n.t("audit_statuses.#{s}", default: s.humanize), s] } %>
        <%= f.select :status_in, status_options, { include_blank: "全部状态", multiple: true }, { class: "w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm", size: 1 } %>
      </div>
    </div>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div>
          <%= f.label :created_at_gteq, class: "block text-sm font-medium text-slate-700 mb-1" do %>创建起<% end %>
          <%= f.date_field :created_at_gteq, class: "px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
        </div>
        <span class="text-slate-400 mt-5">至</span>
        <div>
          <%= f.label :created_at_lteq, class: "block text-sm font-medium text-slate-700 mb-1" do %>创建止<% end %>
          <%= f.date_field :created_at_lteq, class: "px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm" %>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "重置", audits_path, class: "px-4 py-2 rounded text-sm font-medium bg-slate-600 bg-slate-100 hover:bg-slate-200 transition-colors" %>
        <%= f.submit "筛选", class: "px-4 py-2 rounded text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors" %>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">审计项目</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">供应商</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">类型</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">进度</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">创建人</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">截止日期</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-slate-200">
        <% @audits.each do |audit| %>
          <tr id="<%= dom_id(audit) %>" class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <%= link_to audit_path(audit), class: "block" do %>
                <div class="text-sm font-semibold text-slate-900 hover:text-blue-600"><%= audit.title %></div>
                <div class="mt-1 flex items-center gap-2">
                  <% if audit.pending_exceptions_count > 0 %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                    <%= audit.pending_exceptions_count %> 异常
                  </span>
                  <% end %>
                  <% if audit.overdue? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700">已逾期</span>
                  <% elsif audit.days_remaining.present? && audit.days_remaining <= 7 && audit.days_remaining > 0 %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">剩 <%= audit.days_remaining %> 天</span>
                  <% end %>
                </div>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-slate-900"><%= audit.supplier&.name %></div>
              <div class="text-xs text-slate-500"><%= audit.supplier&.code %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% type_map = {
                routine_audit: "常规审计",
                special_audit: "专项审计",
                compliance_audit: "合规审计",
                quality_audit: "质量审计",
                safety_audit: "安全审计",
                financial_audit: "财务审计"
              } %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                <%= type_map[audit.audit_type.to_sym] || audit.audit_type.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status_map = {
                draft: { cls: "bg-slate-100 text-slate-700", label: "草稿" },
                pending_materials: { cls: "bg-amber-100 text-amber-700", label: "待材料" },
                in_progress: { cls: "bg-blue-100 text-blue-700", label: "进行中" },
                pending_evidence: { cls: "bg-orange-100 text-orange-700", label: "待证据" },
                pending_checklist: { cls: "bg-purple-100 text-purple-700", label: "待清单" },
                pending_notification: { cls: "bg-cyan-100 text-cyan-700", label: "待通报" },
                pending_approval: { cls: "bg-indigo-100 text-indigo-700", label: "待审批" },
                approved: { cls: "bg-green-100 text-green-700", label: "已通过" },
                rejected: { cls: "bg-red-100 text-red-700", label: "已驳回" },
                archived: { cls: "bg-slate-100 text-slate-600", label: "已归档" }
              } %>
              <% cfg = status_map[audit.status.to_sym] || { cls: "bg-slate-100 text-slate-700", label: audit.status.humanize } %>
              <% list_dot_cls = if audit.approved? || audit.archived? then 'bg-green-500'
                                elsif audit.rejected? then 'bg-red-500'
                                elsif audit.draft? then 'bg-slate-400'
                                else 'bg-amber-500' end %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= cfg[:cls] %>">
                <span class="w-1.5 h-1.5 rounded-full mr-1.5 <%= list_dot_cls %>">
                </span>
                <%= cfg[:label] %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center gap-3">
                <div class="w-24 h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-blue-500 to-blue-600 rounded-full" style="width: <%= audit.checklist_progress %>%"></div>
                </div>
                <span class="text-xs font-mono font-semibold text-slate-700"><%= audit.checklist_progress %>%</span>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= audit.creator&.name %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-sm <%= audit.overdue? ? 'text-red-600 font-semibold' : 'text-slate-900' %>"><%= audit.end_at&.strftime("%Y-%m-%d") %></span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "查看", audit_path(audit), class: "text-blue-600 hover:text-blue-700 font-medium" %>
                <% if policy(audit).update? && audit.draft? %>
                  <%= link_to "编辑", edit_audit_path(audit), class: "text-slate-600 hover:text-slate-700 font-medium" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @audits.empty? %>
          <tr>
            <td colspan="8" class="px-6 py-12 text-center">
              <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-slate-900">暂无审计项目</h3>
              <p class="mt-1 text-sm text-slate-500">点击右上角「新建审计」开始创建</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>

    <% if @audits.total_pages > 1 %>
      <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between">
      <div class="text-sm text-slate-500">
        显示第 <%= @audits.offset_value + 1 %> - <%= [@audits.offset_value + @audits.limit_value, @audits.total_count].min %> 条，共 <%= @audits.total_count %> 条
      </div>
      <div>
        <%= paginate @audits, window: 2, outer_window: 1, theme: "tailwind" %>
      </div>
    </div>
    <% end %>
  </div>
</div>
