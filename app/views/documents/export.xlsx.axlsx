require 'axlsx'

xlsx_package = Axlsx::Package.new
workbook = xlsx_package.workbook

header_style = workbook.styles.add_style(
  bg_color: '4472C4',
  fg_color: 'FFFFFF',
  font_name: '微软雅黑',
  sz: 11,
  b: true,
  alignment: { horizontal: :center, vertical: :center },
  border: { style: :thin, color: 'B4B4B4' }
)

cell_style = workbook.styles.add_style(
  font_name: '微软雅黑',
  sz: 10,
  alignment: { vertical: :center, wrap_text: true },
  border: { style: :thin, color: 'B4B4B4' }
)

title_style = workbook.styles.add_style(
  font_name: '微软雅黑',
  sz: 14,
  b: true,
  alignment: { horizontal: :center, vertical: :center }
)

meta_style = workbook.styles.add_style(
  font_name: '微软雅黑',
  sz: 10,
  fg_color: '666666',
  alignment: { vertical: :center, wrap_text: true }
)

workbook.add_worksheet(name: '文书详情') do |sheet|
  sheet.add_row ['法律文书归档结算台 - 文书详情导出'], style: title_style, height: 30
  sheet.merge_cells('A1:H1')

  sheet.add_row ['', '', '', '', '', '', '', '']
  sheet.add_row ['导出说明', '本文档为法律文书归档结算台的文书详情导出，包含文书基本信息、审核意见、风险词命中、内容版本和状态历史等信息。', '', '', '', '', '', '']
  sheet.merge_cells('B3:H3')
  sheet.rows[2].cells[0].style = meta_style
  sheet.rows[2].cells[1].style = meta_style

  sheet.add_row ['取数口径', '1. 导出时间：' + Time.current.strftime('%Y-%m-%d %H:%M:%S'), '', '', '', '', '', '']
  sheet.merge_cells('B4:H4')
  sheet.rows[3].cells[0].style = meta_style
  sheet.rows[3].cells[1].style = meta_style

  sheet.add_row ['', '2. 数据范围：单篇文书全量信息', '', '', '', '', '', '']
  sheet.merge_cells('B5:H5')
  sheet.rows[4].cells[1].style = meta_style

  sheet.add_row ['', '3. 状态说明：草稿/待审核/审核中/审核通过/审核退回/待发布/已发布/已归档', '', '', '', '', '', '']
  sheet.merge_cells('B6:H6')
  sheet.rows[5].cells[1].style = meta_style

  sheet.add_row ['', '4. 风险等级：高/中/低/无，基于风险词库命中结果自动判定', '', '', '', '', '', '']
  sheet.merge_cells('B7:H7')
  sheet.rows[6].cells[1].style = meta_style

  sheet.add_row ['', '', '', '', '', '', '', '']

  sheet.add_row %w[字段名 内容], style: header_style
  sheet.add_row ['文书标题', @document.title]
  sheet.add_row ['文书类型', @document.doc_type_name]
  sheet.add_row ['当前状态', @document.status_name]
  sheet.add_row ['创建人', @document.creator&.name]
  sheet.add_row ['创建时间', @document.created_at&.strftime('%Y-%m-%d %H:%M:%S')]
  sheet.add_row ['审核人', @document.reviewer&.name]
  sheet.add_row ['归档时间', @document.archived_at&.strftime('%Y-%m-%d %H:%M:%S') || '未归档']
  sheet.add_row ['风险等级', @document.risk_level_name]
  sheet.add_row ['风险词命中数', @document.risk_word_hits.count]
  sheet.add_row ['内容版本数', @document.content_versions.count]
  sheet.add_row ['互动记录数', @document.interaction_records.count]

  sheet.add_row ['文书内容', '']
  sheet.add_row [@document.content, '']
  sheet.merge_cells("A19:H19")

  sheet.column_widths 15, 25, 15, 15, 15, 15, 15, 15
  sheet.rows.each_with_index do |row, i|
    next if i == 0 || i == 8
    row.cells.each_with_index do |cell, j|
      next if i >= 2 && i <= 6 && j == 0
      cell.style = cell_style
    end
  end
end

workbook.add_worksheet(name: '审核意见') do |sheet|
  sheet.add_row ['审核意见列表'], style: title_style, height: 30
  sheet.merge_cells('A1:E1')

  sheet.add_row %w[序号 审核人 审核结果 审核意见 审核时间], style: header_style

  @document.review_opinions.order(reviewed_at: :desc).each_with_index do |opinion, i|
    sheet.add_row [
      i + 1,
      opinion.reviewer&.name,
      opinion.result_name,
      opinion.opinion,
      opinion.reviewed_at&.strftime('%Y-%m-%d %H:%M:%S')
    ]
  end

  if @document.review_opinions.empty?
    sheet.add_row ['暂无审核意见数据', '', '', '', '']
  end

  sheet.column_widths 8, 15, 12, 50, 20
  sheet.rows.each_with_index do |row, i|
    next if i == 0 || i == 1
    row.cells.each { |cell| cell.style = cell_style }
  end
end

workbook.add_worksheet(name: '风险词命中') do |sheet|
  sheet.add_row ['风险词命中列表'], style: title_style, height: 30
  sheet.merge_cells('A1:F1')

  sheet.add_row ['取数口径：基于当前风险词库对文书内容进行全文匹配，记录命中位置及上下文', '', '', '', '', '']
  sheet.merge_cells('A2:F2')
  sheet.rows[1].cells[0].style = meta_style

  sheet.add_row %w[序号 风险词 分类 风险等级 命中位置 上下文], style: header_style

  @document.risk_word_hits.includes(:risk_word).each_with_index do |hit, i|
    sheet.add_row [
      i + 1,
      hit.risk_word.word,
      hit.risk_word.category_name,
      hit.risk_word.risk_level_name,
      hit.position,
      hit.context
    ]
  end

  if @document.risk_word_hits.empty?
    sheet.add_row ['暂无风险词命中数据', '', '', '', '', '']
  end

  sheet.column_widths 8, 20, 15, 10, 10, 50
  sheet.rows.each_with_index do |row, i|
    next if i == 0 || i == 1 || i == 2
    row.cells.each { |cell| cell.style = cell_style }
  end
end

workbook.add_worksheet(name: '内容版本') do |sheet|
  sheet.add_row ['内容版本列表'], style: title_style, height: 30
  sheet.merge_cells('A1:E1')

  sheet.add_row %w[版本号 编辑人 变更说明 创建时间 内容摘要], style: header_style

  @document.content_versions.ordered.each do |version|
    summary = version.content.to_s[0..100] + (version.content.to_s.length > 100 ? '...' : '')
    sheet.add_row [
      "v#{version.version}",
      version.editor&.name,
      version.change_summary || '-',
      version.created_at.strftime('%Y-%m-%d %H:%M:%S'),
      summary
    ]
  end

  if @document.content_versions.empty?
    sheet.add_row ['暂无版本数据', '', '', '', '']
  end

  sheet.column_widths 10, 15, 30, 20, 50
  sheet.rows.each_with_index do |row, i|
    next if i == 0 || i == 1
    row.cells.each { |cell| cell.style = cell_style }
  end
end

workbook.add_worksheet(name: '状态历史') do |sheet|
  sheet.add_row ['状态历史记录'], style: title_style, height: 30
  sheet.merge_cells('A1:E1')

  sheet.add_row %w[序号 原状态 新状态 操作人 操作时间 备注], style: header_style

  @document.status_histories.ordered.each_with_index do |history, i|
    sheet.add_row [
      i + 1,
      history.from_status_name,
      history.to_status_name,
      history.operator&.name,
      history.created_at.strftime('%Y-%m-%d %H:%M:%S'),
      history.remark || '-'
    ]
  end

  if @document.status_histories.empty?
    sheet.add_row ['暂无状态历史', '', '', '', '', '']
  end

  sheet.column_widths 8, 15, 15, 15, 20, 30
  sheet.rows.each_with_index do |row, i|
    next if i == 0 || i == 1
    row.cells.each { |cell| cell.style = cell_style }
  end
end

xlsx_package
