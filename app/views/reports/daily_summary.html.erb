<% content_for :title, "每日汇总" %>

<div class="space-y-6">
  <div class="bg-white shadow rounded-lg">
    <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <h3 class="text-lg leading-6 font-medium text-gray-900">每日汇总报表</h3>
        <div class="mt-3 sm:mt-0 flex gap-3 items-center">
          <%= form_tag daily_summary_reports_path, method: :get, class: 'flex flex-wrap gap-3 items-center' do %>
            <%= date_field_tag :start_date, @start_date, class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
            <span class="text-gray-500">至</span>
            <%= date_field_tag :end_date, @end_date, class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
            <%= select_tag :source, options_for_select(PickupOrder::SOURCES.map { |s| [s, s] }, @source), { include_blank: "所有来源", class: "px-3 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500" } %>
            <%= submit_tag "查询", class: "px-3 py-1 bg-indigo-600 text-white rounded-md text-sm hover:bg-indigo-700" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-6">
        <div class="bg-blue-50 p-4 rounded-lg border border-blue-100">
          <div class="text-sm font-medium text-blue-600">总单据数</div>
          <div class="mt-1 text-2xl font-bold text-blue-900"><%= @aggregated[:total_orders] %></div>
        </div>
        <div class="bg-green-50 p-4 rounded-lg border border-green-100">
          <div class="text-sm font-medium text-green-600">已完成</div>
          <div class="mt-1 text-2xl font-bold text-green-900"><%= @aggregated[:completed_orders] %></div>
        </div>
        <div class="bg-emerald-50 p-4 rounded-lg border border-emerald-100">
          <div class="text-sm font-medium text-emerald-600">准时完成</div>
          <div class="mt-1 text-2xl font-bold text-emerald-900"><%= @aggregated[:on_time_orders] %></div>
        </div>
        <div class="bg-yellow-50 p-4 rounded-lg border border-yellow-100">
          <div class="text-sm font-medium text-yellow-600">延迟</div>
          <div class="mt-1 text-2xl font-bold text-yellow-900"><%= @aggregated[:delayed_orders] %></div>
        </div>
        <div class="bg-red-50 p-4 rounded-lg border border-red-100">
          <div class="text-sm font-medium text-red-600">有短少</div>
          <div class="mt-1 text-2xl font-bold text-red-900"><%= @aggregated[:shortage_orders] %></div>
        </div>
        <div class="bg-purple-50 p-4 rounded-lg border border-purple-100">
          <div class="text-sm font-medium text-purple-600">履约准时率</div>
          <div class="mt-1 text-2xl font-bold text-purple-900"><%= @aggregated[:average_on_time_rate] %>%</div>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">日期</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">总数</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">已完成</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">准时</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">延迟</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">短少</th>
            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">准时率</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @daily_summaries.each do |summary| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= summary.summary_date.strftime('%Y-%m-%d') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                  <%= summary.source %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center"><%= summary.total_orders %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center"><%= summary.completed_orders %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-green-600 text-center font-medium"><%= summary.on_time_orders %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-yellow-600 text-center font-medium"><%= summary.delayed_orders %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600 text-center font-medium"><%= summary.shortage_orders %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= summary.on_time_rate >= 90 ? 'bg-green-100 text-green-800' : summary.on_time_rate >= 70 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                  <%= summary.on_time_rate %>%
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-4 py-3 border-t border-gray-200 sm:px-6">
      <%= paginate @daily_summaries %>
    </div>
  </div>

  <% if @aggregated[:by_abnormal_reason].any? %>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">异常原因分布</h3>
      </div>
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <% @aggregated[:by_abnormal_reason].each do |reason, count| %>
            <div class="bg-red-50 p-4 rounded-lg border border-red-100 text-center">
              <div class="text-sm font-medium text-red-600"><%= reason %></div>
              <div class="mt-1 text-2xl font-bold text-red-900"><%= count %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @aggregated[:by_product_tag].any? %>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">商品标签分布</h3>
      </div>
      <div class="px-4 py-5 sm:p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4">
          <% @aggregated[:by_product_tag].first(16).each do |tag, count| %>
            <div class="bg-indigo-50 p-4 rounded-lg border border-indigo-100 text-center">
              <div class="text-sm font-medium text-indigo-600 truncate" title="<%= tag %>"><%= tag %></div>
              <div class="mt-1 text-xl font-bold text-indigo-900"><%= count %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
