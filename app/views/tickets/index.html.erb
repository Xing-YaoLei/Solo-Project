<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">票务管理</h1>
      <p class="mt-1 text-sm text-gray-500">查看和管理所有票据信息</p>
    </div>
  </div>

  <div class="mt-6 bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
    <div class="border-b border-gray-200 px-6 py-4">
      <form class="flex flex-wrap gap-3 items-end" method="get">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">状态</label>
          <select name="status" class="rounded-md border-gray-300 bg-white py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:ring-indigo-500">
            <option value="">全部状态</option>
            <option value="reserved" <%= "selected" if params[:status] == "reserved" %>>已预留</option>
            <option value="issued" <%= "selected" if params[:status] == "issued" %>>已出票</option>
            <option value="checked_in" <%= "selected" if params[:status] == "checked_in" %>>已签到</option>
            <option value="cancelled" <%= "selected" if params[:status] == "cancelled" %>>已取消</option>
            <option value="expired" <%= "selected" if params[:status] == "expired" %>>已过期</option>
          </select>
        </div>
        <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">筛选</button>
        <%= link_to "重置", tickets_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-3.5 pl-6 pr-3 text-left text-sm font-semibold text-gray-900">票号</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">订单号</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">票种</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">座位</th>
            <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">状态</th>
            <th class="py-3.5 pl-3 pr-6 text-right text-sm font-semibold text-gray-900">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @tickets.each do |ticket| %>
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap py-4 pl-6 pr-3 text-sm font-medium text-indigo-600">
                <%= link_to ticket.ticket_no, ticket_path(ticket) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-indigo-600">
                <%= link_to ticket.order.order_no, order_path(ticket.order) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900"><%= ticket.ticket_type.name %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= ticket.seat&.display_name || "-" %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% status_styles = { "reserved" => "bg-yellow-100 text-yellow-800", "issued" => "bg-blue-100 text-blue-800", "checked_in" => "bg-green-100 text-green-800", "cancelled" => "bg-gray-100 text-gray-800", "expired" => "bg-red-100 text-red-800" } %>
                <% status_labels = { "reserved" => "已预留", "issued" => "已出票", "checked_in" => "已签到", "cancelled" => "已取消", "expired" => "已过期" } %>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_styles[ticket.status] %>"><%= status_labels[ticket.status] %></span>
              </td>
              <td class="whitespace-nowrap py-4 pl-3 pr-6 text-right text-sm">
                <%= link_to "查看", ticket_path(ticket), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= pagination_links(pagination_info) %>
  </div>
</div>
