            "type": "warning",
            "priority": 10
        },
        {
            "id": "advice_021",
            "condition": "task.replenishmentOrder.isUrgent === true",
            "content": "💡 该补货单为紧急订单，请优先处理",
            "type": "hint",
            "priority": 15
        },
        {
            "id": "advice_022",
            "condition": "task.replenishmentOrder.expiryDate < '2027-01-01'",
            "content": "⚠️ 药品有效期临近，请谨慎补货",
            "type": "warning",
            "priority": 12
        }
