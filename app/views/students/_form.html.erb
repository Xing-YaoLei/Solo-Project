<div class="page-header">
  <%= link_to "← 返回列表", students_path, class: "btn-secondary mb-4" %>
  <h1 class="page-title"><%= @student.new_record? ? "新增学员" : "编辑学员" %></h1>
</div>

<div class="table-container p-6">
  <%= form_with(model: @student, local: true) do |f| %>
    <% if @student.errors.any? %>
      <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
        <h2 class="font-semibold text-red-800 mb-2">存在 <%= @student.errors.count %> 个错误：</h2>
        <ul class="list-disc list-inside text-red-700">
          <% @student.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="form-group">
        <%= f.label :name, "姓名", class: "form-label" %>
        <%= f.text_field :name, class: "form-input", required: true %>
      </div>
      <div class="form-group">
        <%= f.label :phone, "手机号", class: "form-label" %>
        <%= f.text_field :phone, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :email, "邮箱", class: "form-label" %>
        <%= f.email_field :email, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :id_number, "身份证号", class: "form-label" %>
        <%= f.text_field :id_number, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :birthday, "出生日期", class: "form-label" %>
        <%= f.date_field :birthday, class: "form-input" %>
      </div>
      <div class="form-group">
        <%= f.label :gender, "性别", class: "form-label" %>
        <%= f.select :gender, options_for_select(Student::GENDERS.map { |g| [g == 'male' ? '男' : (g == 'female' ? '女' : '其他'), g] }, @student.gender), include_blank: "请选择", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :education, "学历", class: "form-label" %>
        <%= f.text_field :education, class: "form-input", placeholder: "如：本科、硕士" %>
      </div>
      <div class="form-group">
        <%= f.label :occupation, "职业", class: "form-label" %>
        <%= f.text_field :occupation, class: "form-input", placeholder: "如：在职、学生" %>
      </div>
      <div class="form-group">
        <%= f.label :community_id, "所属社群", class: "form-label" %>
        <%= f.collection_select :community_id, @communities, :id, :name, include_blank: "未分配", class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :status, "状态", class: "form-label" %>
        <%= f.select :status, options_for_select(Student::STATUSES.map { |s| [I18n.t("status.#{s}", default: s), s] }, @student.status), {}, class: "form-select" %>
      </div>
      <div class="form-group">
        <%= f.label :enrollment_date, "入学日期", class: "form-label" %>
        <%= f.date_field :enrollment_date, class: "form-input" %>
      </div>
      <div class="form-group col-span-2">
        <%= f.label :notes, "备注", class: "form-label" %>
        <%= f.text_area :notes, class: "form-input", rows: 3 %>
      </div>
    </div>

    <div class="mt-8 flex space-x-3">
      <%= f.submit class: "btn-primary" %>
      <%= link_to "取消", students_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
