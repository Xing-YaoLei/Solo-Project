<%= form_with model: [waste_report, ReviewOpinion.new], class: "flex flex-wrap items-end gap-3" do |f| %>
  <div class="flex flex-col">
    <%= f.label :reviewer, "复核人", class: "text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :reviewer, class: "border border-gray-300 rounded-md px-2 py-1.5 text-sm w-28" %>
  </div>
  <div class="flex flex-col">
    <%= f.label :opinion, "意见", class: "text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :opinion, class: "border border-gray-300 rounded-md px-2 py-1.5 text-sm w-48" %>
  </div>
  <div class="flex flex-col">
    <%= f.label :result, "结果", class: "text-xs font-medium text-gray-600 mb-1" %>
    <%= f.select :result, [["待处理", "pending"], ["通过", "approved"], ["驳回", "rejected"]], {}, class: "border border-gray-300 rounded-md px-2 py-1.5 text-sm" %>
  </div>
  <%= f.submit "提交意见", class: "bg-blue-600 text-white px-3 py-1.5 rounded-md hover:bg-blue-700 text-sm cursor-pointer" %>
<% end %>
