<div class="page-header flex items-center justify-between">
  <div>
    <%= link_to "← 返回学员详情", student_path(@student), class: "btn-secondary mb-4" %>
    <h1 class="page-title">会员档案 - <%= @student.name %></h1>
  </div>
  <%= link_to "编辑档案", edit_student_member_profile_path(@student, @member_profile), class: "btn-primary" %>
</div>

<div class="stat-card p-6">
  <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div><dt class="stat-label">会员等级</dt><dd class="text-xl"><%= member_level_badge(@member_profile.member_level) %></dd></div>
    <div><dt class="stat-label">支付状态</dt><dd class="text-xl"><%= payment_status_badge(@member_profile.payment_status) %></dd></div>
    <div><dt class="stat-label">入会日期</dt><dd><%= @member_profile.membership_start_date %></dd></div>
    <div><dt class="stat-label">到期日期</dt><dd><%= @member_profile.membership_end_date %></dd></div>
    <div><dt class="stat-label">累计积分</dt><dd><%= @member_profile.total_points %></dd></div>
    <div><dt class="stat-label">可用积分</dt><dd><%= @member_profile.available_points %></dd></div>
    <div><dt class="stat-label">累计消费</dt><dd class="text-blue-600 font-semibold text-lg">¥<%= @member_profile.total_amount %></dd></div>
    <div><dt class="stat-label">剩余天数</dt><dd class="<%= @member_profile.days_remaining <= 30 ? 'text-red-600 font-semibold' : '' %>"><%= @member_profile.days_remaining %>天</dd></div>
  </dl>
  <div class="mt-6 pt-4 border-t border-gray-100">
    <h3 class="font-semibold mb-2">权益概览</h3>
    <p><%= @member_profile.benefits_overview %></p>
  </div>
</div>
