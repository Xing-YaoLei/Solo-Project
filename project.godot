; Engine configuration file.
; Godot 4 project for Compliance Audit Evidence Archiving Puzzle Game

config_version=5

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
DataManager="*res://scripts/autoload/DataManager.gd"
PermissionManager="*res://scripts/autoload/PermissionManager.gd"
TrainingRecordManager="*res://scripts/autoload/TrainingRecordManager.gd"

[application]

config/name="合规审计证据归档训练"
config/description="合规审计证据归档调度解谜游戏 - 岗位训练系统"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.18, 1)
