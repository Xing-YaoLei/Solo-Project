<% if recent_exports.present? %>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">导出类型</th>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">状态</th>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">操作人</th>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">文件大小</th>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">创建时间</th>
          <th class="px-4 py-2.5 text-left font-medium text-gray-500 text-xs uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% recent_exports.each do |record| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-4 py-3 font-medium text-gray-900">
              <%= record.export_type.humanize %>
            </td>
            <td class="px-4 py-3">
              <% status_classes = {
                "completed" => "bg-green-100 text-green-700",
                "processing" => "bg-blue-100 text-blue-700",
                "pending" => "bg-yellow-100 text-yellow-700",
                "failed" => "bg-red-100 text-red-700"
              } %>
              <% status_icons = {
                "completed" => "check-circle",
                "processing" => "loader",
                "pending" => "clock",
                "failed" => "x-circle"
              } %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium <%= status_classes[record.status] %>">
                <%= record.status.humanize %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= record.user&.name %></td>
            <td class="px-4 py-3 text-gray-600 text-xs"><%= record.file_size_human || "-" %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= record.created_at.strftime("%m-%d %H:%M") %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <%= link_to export_record_path(record), class: "text-xs text-gray-600 hover:text-indigo-600 transition-colors" do %>
                  详情
                <% end %>
                <% if record.downloadable? %>
                  <%= link_to download_report_path(record), class: "text-xs text-indigo-600 hover:text-indigo-800 font-medium transition-colors" do %>
                    下载
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="py-8 text-center text-gray-500 text-sm">
    暂无导出记录
  </div>
<% end %>
