<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">新建订单</h1>
      <% if @performance %>
        <p class="mt-1 text-sm text-gray-500">演出：<%= @performance.name %></p>
      <% end %>
    </div>
  </div>

  <div class="mt-6 max-w-3xl">
    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-base font-semibold text-gray-900">订单信息</h2>
      </div>
      <div class="px-6 py-5">
        <%= render "shared/error_messages", object: @order %>

        <%= form_with model: @order, url: (@performance ? performance_orders_path(@performance) : orders_path), local: true do |f| %>
          <div class="space-y-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :customer_name, "客户姓名", class: "block text-sm font-medium text-gray-700" %>
                <%= f.text_field :customer_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
              <div>
                <%= f.label :customer_phone, "客户电话", class: "block text-sm font-medium text-gray-700" %>
                <%= f.text_field :customer_phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :customer_email, "客户邮箱", class: "block text-sm font-medium text-gray-700" %>
                <%= f.email_field :customer_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
              <div>
                <%= f.label :total_amount, "金额", class: "block text-sm font-medium text-gray-700" %>
                <div class="mt-1 relative rounded-md shadow-sm">
                  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <span class="text-gray-500 sm:text-sm">¥</span>
                  </div>
                  <%= f.number_field :total_amount, step: "0.01", class: "block w-full rounded-md border-gray-300 pl-7 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <%= f.label :payment_method, "支付方式", class: "block text-sm font-medium text-gray-700" %>
                <%= f.select :payment_method, options_for_select([["现金", "cash"], ["微信", "wechat"], ["支付宝", "alipay"], ["银行卡", "card"]], @order.payment_method), {}, class: "mt-1 block w-full rounded-md border-gray-300 bg-white py-2 pl-3 pr-10 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
              </div>
            </div>

            <div>
              <%= f.label :notes, "备注", class: "block text-sm font-medium text-gray-700" %>
              <%= f.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>

            <% if @performance && @ticket_types.any? %>
              <div class="border-t border-gray-200 pt-5">
                <h3 class="text-sm font-semibold text-gray-900 mb-3">选择票种</h3>
                <div class="space-y-3">
                  <% @ticket_types.each do |tt| %>
                    <label class="flex items-center gap-3 rounded-lg border border-gray-200 p-4 hover:bg-gray-50 cursor-pointer">
                      <div class="flex-1 flex items-center gap-3">
                        <%= check_box_tag "ticket_types[#{tt.id}][selected]", "1", false, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 ticket-type-checkbox", data: { ticket_type_id: tt.id } %>
                        <div>
                          <span class="text-sm font-medium text-gray-900"><%= tt.name %></span>
                          <span class="ml-2 text-sm text-gray-500">¥<%= number_with_precision(tt.price, precision: 2) %></span>
                        </div>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-400">数量</span>
                        <%= number_field_tag "ticket_types[#{tt.id}][quantity]", 1, min: 1, max: (tt.remaining_count || 10), class: "ticket-type-quantity w-20 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", disabled: true, data: { ticket_type_id: tt.id } %>
                        <% if tt.remaining_count %>
                          <span class="text-xs text-gray-400">剩余 <%= tt.remaining_count %> 张</span>
                        <% end %>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>

              <script>
                document.addEventListener("DOMContentLoaded", function() {
                  document.querySelectorAll(".ticket-type-checkbox").forEach(function(checkbox) {
                    checkbox.addEventListener("change", function() {
                      var ticketTypeId = this.dataset.ticketTypeId;
                      var quantityField = document.querySelector(".ticket-type-quantity[data-ticket-type-id='" + ticketTypeId + "']");
                      if (quantityField) {
                        quantityField.disabled = !this.checked;
                        if (this.checked) {
                          quantityField.focus();
                        }
                      }
                    });
                  });
                });
              </script>
            <% end %>

            <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
              <%= link_to "取消", orders_path, class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
              <%= f.submit "创建订单", class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
