<div class="page-header flex items-center justify-between">
  <div>
    <%= link_to "← 返回列表", exams_path, class: "btn-secondary mb-4" %>
    <h1 class="page-title">📝 <%= @exam.name %></h1>
    <p class="page-subtitle"><%= @exam.exam_type %> · <%= @exam.community&.name || "通用考试" %> · 考试日期：<%= @exam.exam_date %></p>
  </div>
  <div class="flex space-x-2">
    <%= link_to "编辑", edit_exam_path(@exam), class: "btn-primary" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">
  <div class="stat-card col-span-1 md:col-span-2">
    <p class="stat-label">整体通过率</p>
    <p class="stat-value <%= @pass_rate >= 60 ? 'text-green-600' : 'text-red-600' %>"><%= @pass_rate %>%</p>
    <div class="mt-3 w-full bg-gray-200 rounded-full h-3">
      <div class="<%= @pass_rate >= 60 ? 'bg-green-500' : 'bg-red-500' %> h-3 rounded-full" style="width: <%= @pass_rate %>%"></div>
    </div>
  </div>
  <div class="stat-card">
    <p class="stat-label">平均分</p>
    <p class="stat-value text-blue-600"><%= @average_score %></p>
  </div>
  <div class="stat-card">
    <p class="stat-label">及格分数</p>
    <p class="stat-value"><%= @exam.passing_score %>分</p>
  </div>
  <div class="stat-card">
    <p class="stat-label">参考人数</p>
    <p class="stat-value text-purple-600"><%= @exam_results.count %></p>
  </div>
</div>

<div class="table-container">
  <div class="overflow-x-auto">
    <table class="data-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>学员ID</th>
          <th>学员姓名</th>
          <th>所属社群</th>
          <th>得分</th>
          <th>是否通过</th>
          <th>阅卷人</th>
          <th>阅卷时间</th>
          <th>备注</th>
        </tr>
      </thead>
      <tbody>
        <% @exam_results.each do |er| %>
          <tr class="<%= 'bg-red-50' unless er.passed %>">
            <td class="font-semibold text-center"><%= er.rank || "-" %></td>
            <td class="font-mono text-xs">#<%= er.student_id %></td>
            <td class="font-medium"><%= link_to er.student.name, student_path(er.student), class: "text-blue-600" %></td>
            <td><%= er.student.community&.name || "-" %></td>
            <td class="font-bold <%= er.passed ? 'text-green-600' : 'text-red-600' %> text-lg"><%= er.score %>分</td>
            <td><%= er.passed ? '<span class="badge-green">✅ 通过</span>'.html_safe : '<span class="badge-red">❌ 未通过</span>'.html_safe %></td>
            <td><%= er.reviewer&.name || "系统" %></td>
            <td class="text-xs"><%= er.reviewed_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="text-sm text-gray-600"><%= er.remarks %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
